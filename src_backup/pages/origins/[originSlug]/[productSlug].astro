---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import OriginMark from '../../../components/OriginMark.astro';

// 1. Generate paths for all products
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => {
    const originId = typeof product.data.originSlug === 'object' 
      ? product.data.originSlug.id 
      : product.data.originSlug;
      
    return {
      params: { 
        originSlug: originId, 
        productSlug: product.id 
      },
      props: { product }
    };
  });
}

// 2. Fetch the corresponding origin data for the matched product
const { product } = Astro.props;
const originId = typeof product.data.originSlug === 'object' 
  ? product.data.originSlug.id 
  : product.data.originSlug;
const origin = await getEntry('origins', originId);

if (!origin) {
  throw new Error(`Origin not found for product: ${product.id}`);
}

const ogImageUrl = origin.data.images?.specimen?.endsWith('.webp') 
  ? 'https://ourorigin.in/og-image.jpg' 
  : `https://ourorigin.in${origin.data.images?.specimen || '/og-image.jpg'}`;
---

<BaseLayout
  title={`${product.data.name} from ${origin.data.name} — OurOrigin`}
  description={`${product.data.name} from ${origin.data.name} — ${origin.data.elevation}, ${origin.data.bioregion}. OurOrigin.`}
  canonicalPath={`/origins/${origin.id}/${product.id}`}
  ogTitle={`${product.data.name} from ${origin.data.name} — OurOrigin`}
  ogDescription={product.data.specimenCopy?.slice(0, 160)}
  ogImage={ogImageUrl}
  navVariant="light"
  showFooter={false}
  bodyClass="cinematic-canvas-body"
>
    <!-- Product Page (Identical Visual System to Homepage Finale) -->
    <main class="cinematic-viewport product-viewport">
        
        <!-- The Background (Grayscaled Specimen, just like Homepage Scene 4) -->
        <div class="layer bg-mask-layer pedestal-mask">
            <div class="bg-image active" style={`background-image: url('${origin.data.images.specimen}'); filter: grayscale(100%) brightness(0.2);`}></div>
        </div>

        <div class="layer ui-layer product-ui">
            
            <a href="/" class="back-link">
                <OriginMark size={24} variant="gold" hideDot={true} />
                <span>Return to Journey</span>
            </a>

            <div class="product-cinematic-grid">
                
                <!-- Left Panel: The Facts (What/How/When/Why applied to Product) -->
                <div class="product-data-panel">
                    <h1 class="product-title">{product.data.name}</h1>
                    <div class="product-botanical">{product.data.botanicalName}</div>
                    
                    <div class="product-narrative">
                        <p>{product.data.specimenCopy}</p>
                    </div>

                    <div class="data-grid">
                        <div class="data-item">
                            <div class="data-label">Method</div>
                            <div class="data-value">{product.data.methodDescription}</div>
                        </div>
                        <div class="data-item">
                            <div class="data-label">Harvest</div>
                            <div class="data-value">{product.data.harvestMonth}</div>
                        </div>
                        {product.data.sensoryProfile && (
                            <>
                                <div class="data-item">
                                    <div class="data-label">Aroma</div>
                                    <div class="data-value">{product.data.sensoryProfile.aroma}</div>
                                </div>
                                <div class="data-item">
                                    <div class="data-label">Flavor</div>
                                    <div class="data-value">{product.data.sensoryProfile.flavor}</div>
                                </div>
                            </>
                        )}
                    </div>
                </div>

                <!-- Center Panel: The Artifact (Identical to Carousel view) -->
                <div class="product-artifact-panel">
                    <img src={product.data.images.product} alt={product.data.name} class="artifact-hero-image" />
                </div>

                <!-- Right Panel: The Ledger (Purchase) -->
                <div class="product-ledger-panel">
                    <div class="ledger-header">The Ledger</div>
                    <div class="ledger-origin">
                        <span class="origin-name">{origin.data.name}</span>
                        <span class="origin-region">{origin.data.bioregion}</span>
                        <span class="origin-coords">{origin.data.coordinates}</span>
                    </div>

                    <div class="sizes-container">
                        {product.data.sizes.map((size) => (
                            <button class="size-btn">
                                <span class="size-label">{size.label}</span>
                                <span class="size-price">₹{size.priceINR}</span>
                            </button>
                        ))}
                    </div>

                    <button class="btn-purchase">Honor the Harvest</button>
                </div>

            </div>
        </div>
    </main>
</BaseLayout>

<style>
    .product-viewport {
        pointer-events: auto; /* Enable clicks immediately on this page */
    }

    .pedestal-mask {
        clip-path: inset(85% 0% 0% 0% round 0px);
    }

    .back-link {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--color-gold);
        text-decoration: none;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        z-index: 100;
        transition: opacity 0.3s;
    }

    .back-link:hover {
        opacity: 0.7;
    }

    .product-cinematic-grid {
        display: grid;
        grid-template-columns: 1fr 400px 1fr;
        height: 100vh;
        width: 100vw;
        padding: 6rem 4rem;
        box-sizing: border-box;
        gap: 4rem;
        align-items: center;
    }

    /* Left Panel */
    .product-data-panel {
        color: var(--color-warm-cream);
        max-width: 400px;
    }

    .product-title {
        font-family: var(--font-evidence);
        font-size: 3rem;
        line-height: 1.1;
        margin: 0 0 0.5rem 0;
    }

    .product-botanical {
        font-family: var(--font-mono);
        font-size: 0.9rem;
        color: var(--color-gold);
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
    }

    .product-narrative {
        font-size: 1rem;
        line-height: 1.6;
        opacity: 0.8;
        margin-bottom: 3rem;
    }

    .data-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .data-item {
        border-left: 1px solid var(--color-gold);
        padding-left: 1rem;
    }

    .data-label {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--color-gold);
        letter-spacing: 0.1em;
        margin-bottom: 0.25rem;
    }

    .data-value {
        font-size: 0.9rem;
        line-height: 1.4;
    }

    /* Center Panel */
    .product-artifact-panel {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100%;
    }

    .artifact-hero-image {
        max-width: 100%;
        max-height: 70vh;
        object-fit: contain;
        filter: drop-shadow(0 30px 40px rgba(0,0,0,0.8));
    }

    /* Right Panel */
    .product-ledger-panel {
        color: var(--color-warm-cream);
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.1);
        padding: 2.5rem;
        max-width: 350px;
        backdrop-filter: blur(10px);
    }

    .ledger-header {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 1rem;
    }

    .ledger-origin {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        margin-bottom: 2rem;
    }

    .origin-name { font-size: 1.2rem; font-family: var(--font-evidence); }
    .origin-region { font-size: 0.9rem; opacity: 0.7; }
    .origin-coords { font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-gold); margin-top: 0.5rem; }

    .sizes-container {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 2rem;
    }

    .size-btn {
        display: flex;
        justify-content: space-between;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.2);
        color: var(--color-warm-cream);
        padding: 1rem;
        font-family: var(--font-mono);
        cursor: pointer;
        transition: all 0.3s;
    }

    .size-btn:hover {
        border-color: var(--color-gold);
        background: rgba(200,160,77,0.1);
    }

    .btn-purchase {
        width: 100%;
        padding: 1.25rem;
        background: var(--color-warm-cream);
        color: var(--color-void);
        border: none;
        font-family: var(--font-institutional);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        transition: background 0.3s;
    }

    .btn-purchase:hover {
        background: var(--color-gold);
        color: var(--color-warm-cream);
    }
</style>
