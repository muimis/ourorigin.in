---
// src/components/CustomCursor.astro
---

<div id="custom-cursor" class="custom-cursor"></div>
<div id="custom-cursor-dot" class="custom-cursor-dot"></div>

<style>
  /* Hide default cursor on desktop */
  @media (pointer: fine) {
    body {
      cursor: none;
    }
    
    /* Ensure interactive elements also hide default cursor */
    a, button, input, textarea, select {
      cursor: none !important;
    }

    .custom-cursor {
      position: fixed;
      top: 0;
      left: 0;
      width: 40px;
      height: 40px;
      border: 1px solid rgba(198, 156, 82, 0.4);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 999999;
      transition: width 0.3s cubic-bezier(0.25, 1, 0.5, 1), height 0.3s cubic-bezier(0.25, 1, 0.5, 1), border-color 0.3s ease, background-color 0.3s ease, mix-blend-mode 0.3s ease;
      will-change: transform;
    }

    .custom-cursor-dot {
      position: fixed;
      top: 0;
      left: 0;
      width: 6px;
      height: 6px;
      background-color: var(--color-gold);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 999999;
      transition: opacity 0.3s ease;
      will-change: transform;
    }

    /* Hover States */
    .custom-cursor.is-lens {
      width: 100px;
      height: 100px;
      background-color: var(--color-warm-cream);
      border-color: transparent;
      mix-blend-mode: difference;
    }

    .custom-cursor.is-magnetic {
      width: 60px;
      height: 60px;
      background-color: rgba(198, 156, 82, 0.1);
      border-color: var(--color-gold);
    }

    .custom-cursor-dot.is-hidden {
      opacity: 0;
    }
  }

  /* Disable on touch devices */
  @media (pointer: coarse) {
    .custom-cursor, .custom-cursor-dot {
      display: none;
    }
  }
</style>

<script>
  function initCursor() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const cursor = document.getElementById('custom-cursor');
    const dot = document.getElementById('custom-cursor-dot');
    
    if (!cursor || !dot) return;

    let mouseX = 0;
    let mouseY = 0;
    let cursorX = 0;
    let cursorY = 0;
    
    // Spring physics configuration
    const speed = 0.15; 

    // Mouse move tracking
    const onMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      
      // Dot instantly follows
      dot.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0) translate(-50%, -50%)`;
    };

    window.addEventListener('mousemove', onMouseMove);

    // Animation loop for spring physics on outer ring
    const render = () => {
      cursorX += (mouseX - cursorX) * speed;
      cursorY += (mouseY - cursorY) * speed;
      
      cursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(render);
    };
    render();

    // Interaction Observers
    const interactiveElements = document.querySelectorAll('a, button, .card-image-wrap, .hero-visual-col');

    interactiveElements.forEach(el => {
      el.addEventListener('mouseenter', () => {
        if (el.classList.contains('card-image-wrap') || el.classList.contains('hero-visual-col')) {
          cursor.classList.add('is-lens');
          dot.classList.add('is-hidden');
        } else {
          cursor.classList.add('is-magnetic');
        }
      });

      el.addEventListener('mouseleave', () => {
        cursor.classList.remove('is-lens', 'is-magnetic');
        dot.classList.remove('is-hidden');
      });
    });
  }

  // Handle Astro page transitions
  document.addEventListener('astro:page-load', initCursor);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCursor);
  } else {
    initCursor();
  }
</script>
