---
import Layout from '../layouts/Layout.astro';
import { EMAIL_ADDRESS } from '../utils/constants';
---

<Layout
  title="Privacy Policy — OurOrigin"
  description="How OurOrigin handles and respects your privacy. Privacy by design."
>
  <div class="legal-page">
    <div class="container-narrow">
      <header class="legal-header">
        <span class="badge-origin badge-gold">LEGAL</span>
        <h1 class="legal-title font-serif">Privacy Policy</h1>
        <p class="legal-meta font-mono">Effective: 2026 · Privacy by Design</p>
      </header>

      <div class="legal-content">
        <section class="legal-block">
          <h2 class="font-serif">01 · Local Data Retention</h2>
          <p>
            To respect your privacy and minimize server data tracking, OurOrigin utilizes standard browser local storage (<code>localStorage</code>) to save your harvest basket and optional delivery preferences. This information resides on your local device and is never automatically harvested or sent to external databases.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">02 · WhatsApp Direct Ordering</h2>
          <p>
            When you complete an order request, our site formats your harvest items and delivery address into a WhatsApp message. You maintain complete control: only when you click send within your WhatsApp client does the message reach our direct dispatch team.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">03 · Zero Data Selling</h2>
          <p>
            We do not sell, rent, or monetize your personal data. Information provided for fulfillment is strictly used to coordinate dispatch, verify payments, and deliver your single-origin harvest.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">04 · Inquiries</h2>
          <p>
            For any privacy inquiries or to request chat record deletion, write to us directly at <a href={`mailto:${EMAIL_ADDRESS}`} class="text-gold">{EMAIL_ADDRESS}</a>.
          </p>
        </section>

        <div class="legal-footer">
          <a href="/" class="btn-secondary btn-sm">← Return to Home</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .legal-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: 2.5rem;
  }

  .legal-title {
    font-size: var(--type-display);
    margin: 0;
  }

  .legal-meta {
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .legal-block h2 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .legal-block p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .legal-block code {
    font-family: var(--font-mono);
    background-color: var(--color-bone-warm);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.85em;
  }

  .legal-footer {
    padding-top: 1.5rem;
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
  }
</style>
