---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OriginMark from '../../../components/OriginMark.astro';
import { WHATSAPP_NUMBER } from '../../../utils/constants';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => {
    const originId = typeof product.data.originSlug === 'object'
      ? (product.data.originSlug as any).id
      : product.data.originSlug;
    return {
      params: { originSlug: originId, productSlug: product.id },
      props: { product }
    };
  });
}

const { product } = Astro.props;
const originId = typeof product.data.originSlug === 'object'
  ? (product.data.originSlug as any).id
  : product.data.originSlug;
const origin = await getEntry('origins', originId);

if (!origin) throw new Error(`Origin not found for product: ${product.id}`);

const sp = product.data.sensoryProfile;
const proof = product.data.proofSystem;
const defaultSize = product.data.sizes?.[0] || { label: '100g', priceINR: 199 };
const prodImg = product.data.images?.product || product.data.images?.packaging || '/assets/products/minimal-packaging-pouch.jpg';
const packImg = product.data.images?.packaging || product.data.images?.product || prodImg;
---

<Layout
  title={`${product.data.name} — ${origin.data.name} · OurOrigin`}
  description={`${product.data.name} from ${origin.data.name}, ${origin.data.elevation}. 100% single origin, unblended, shipped direct from first hands.`}
>
  <div class="product-page">
    <div class="container">
      
      <!-- Breadcrumbs -->
      <nav class="breadcrumb font-mono" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/#harvest">Harvests</a>
        <span>/</span>
        <a href={`/origins/${origin.id}`}>{origin.data.name}</a>
        <span>/</span>
        <span class="current-crumb">{product.data.name}</span>
      </nav>

      <!-- Main Product Grid -->
      <div class="product-layout-grid">
        
        <!-- Left: Imagery Gallery -->
        <div class="product-gallery">
          <div class="gallery-main-frame">
            <img 
              id="main-product-image"
              src={prodImg} 
              alt={product.data.name} 
              class="gallery-main-img"
              onerror="this.src='/assets/products/minimal-packaging-pouch.jpg'"
            />
            <span class="origin-tag font-mono">
              {origin.data.name.toUpperCase()} · {origin.data.elevation}
            </span>
          </div>

          <!-- Thumbnails -->
          <div class="gallery-thumbs">
            <button type="button" class="thumb-btn is-active" data-src={prodImg}>
              <img src={prodImg} alt="Product view" class="thumb-img" onerror="this.src='/assets/products/minimal-packaging-pouch.jpg'" />
            </button>
            {packImg && packImg !== prodImg && (
              <button type="button" class="thumb-btn" data-src={packImg}>
                <img src={packImg} alt="Packaging view" class="thumb-img" onerror="this.src='/assets/products/minimal-packaging-pouch.jpg'" />
              </button>
            )}
          </div>
        </div>

        <!-- Right: Purchasing & Provenance Details -->
        <div class="product-details-col">
          
          <!-- Header info -->
          <div class="product-header-block">
            <span class="badge-origin badge-gold">
              <OriginMark size={14} variant="gold" />
              <span>SINGLE-ORIGIN HARVEST</span>
            </span>

            <h1 class="product-main-title font-serif">{product.data.name}</h1>
            
            {product.data.botanicalName && (
              <div class="product-botanical-tag font-serif">{product.data.botanicalName}</div>
            )}
          </div>

          <!-- Price & Sizes -->
          <div class="product-purchase-box">
            <div class="price-display">
              <span class="currency-symbol">₹</span>
              <span id="active-price" class="price-amount font-mono">{defaultSize.priceINR}</span>
              <span id="active-size-label" class="price-size-label font-mono">/ {defaultSize.label}</span>
            </div>

            <!-- Size Options -->
            {product.data.sizes && product.data.sizes.length > 1 && (
              <div class="size-options-wrapper">
                <span class="options-label font-mono">SELECT HARVEST WEIGHT:</span>
                <div class="size-btn-group">
                  {product.data.sizes.map((s, idx) => (
                    <button 
                      type="button" 
                      class={`size-btn font-mono ${idx === 0 ? 'is-active' : ''}`}
                      data-size={s.label}
                      data-price={s.priceINR}
                    >
                      {s.label} — ₹{s.priceINR}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <!-- Add to Cart CTA -->
            <div class="action-buttons-group">
              <button 
                type="button" 
                id="add-to-basket-main"
                class="btn-primary btn-lg"
                data-product-id={product.id}
                data-product-name={product.data.name}
                data-origin={origin.data.name}
                data-origin-id={origin.id}
                data-image={prodImg}
                data-price={defaultSize.priceINR}
                data-size={defaultSize.label}
              >
                <span>Add to Harvest Basket</span>
                <span aria-hidden="true">+</span>
              </button>

              <button 
                type="button"
                id="order-whatsapp-direct"
                class="btn-secondary"
                data-product-name={product.data.name}
                data-origin={origin.data.name}
                data-whatsapp={WHATSAPP_NUMBER}
              >
                <span>Inquire on WhatsApp</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>
          </div>

          <!-- The First Hands Provenance Ledger Box -->
          <div class="provenance-ledger-card">
            <div class="ledger-card-header">
              <span class="ledger-tag font-mono">PROVENANCE LEDGER</span>
              <span class="batch-num font-mono">{product.data.batchRef || 'OG-BATCH-01'}</span>
            </div>

            <div class="ledger-rows">
              <div class="ledger-row">
                <span class="row-label font-mono">FIRST HANDS</span>
                <span class="row-val">{proof?.firstHands || 'Indigenous Grower Family'}</span>
              </div>
              <div class="ledger-row">
                <span class="row-label font-mono">DIRECT PRICE PAID</span>
                <span class="row-val text-gold font-mono">{proof?.directPricePaid || 'Direct premium above market'}</span>
              </div>
              <div class="ledger-row">
                <span class="row-label font-mono">TERROIR & ELEVATION</span>
                <span class="row-val">{origin.data.name} ({origin.data.elevation})</span>
              </div>
              <div class="ledger-row">
                <span class="row-label font-mono">GEO-COORDINATES</span>
                <span class="row-val font-mono">{origin.data.coordinates}</span>
              </div>
              <div class="ledger-row">
                <span class="row-label font-mono">METHOD & PURITY</span>
                <span class="row-val">{product.data.methodDescription || 'Hand-picked, sun-dried on mats, 100% unblended'}</span>
              </div>
            </div>
          </div>

          <!-- Sensory Profile -->
          {sp && (
            <div class="sensory-box">
              <h3 class="sensory-title font-serif">Sensory & Chemical Profile</h3>
              <div class="sensory-grid">
                {sp.aroma && (
                  <div class="sensory-item">
                    <span class="sensory-label font-mono">AROMA</span>
                    <p class="sensory-text">{sp.aroma}</p>
                  </div>
                )}
                {sp.flavor && (
                  <div class="sensory-item">
                    <span class="sensory-label font-mono">FLAVOR</span>
                    <p class="sensory-text">{sp.flavor}</p>
                  </div>
                )}
              </div>
            </div>
          )}

          {product.data.specimenCopy && (
            <div class="specimen-note">
              <p class="specimen-quote font-serif">"{product.data.specimenCopy}"</p>
            </div>
          )}

        </div>

      </div>

    </div>
  </div>
</Layout>

<style>
  .product-page {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .breadcrumb a:hover {
    color: var(--color-deep-forest);
  }

  .current-crumb {
    color: var(--color-deep-forest);
  }

  /* Grid */
  .product-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .product-layout-grid {
      grid-template-columns: 1.05fr 1.15fr;
      gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }
  }

  /* Gallery */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 5rem;
  }

  .gallery-main-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .origin-tag {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.3rem 0.65rem;
    background-color: rgba(18, 28, 19, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-bone);
    font-size: 0.6875rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .gallery-thumbs {
    display: flex;
    gap: 0.75rem;
  }

  .thumb-btn {
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background-color: var(--color-bone-card);
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .thumb-btn.is-active {
    border-color: var(--color-mark-gold);
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Details Column */
  .product-details-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .product-header-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .product-main-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.15;
    margin: 0;
    font-weight: 400;
  }

  .product-botanical-tag {
    font-size: 1.05rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  /* Purchase Box */
  .product-purchase-box {
    padding: 1.75rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: var(--shadow-subtle);
  }

  .price-display {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  .currency-symbol {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .price-amount {
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-deep-forest);
  }

  .price-size-label {
    font-size: 0.9375rem;
    color: var(--color-ink-whisper);
    margin-left: 0.35rem;
  }

  .size-options-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .options-label {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.08em;
  }

  .size-btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .size-btn {
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-border-medium);
    border-radius: 4px;
    background-color: var(--color-bone);
    font-size: 0.8125rem;
    color: var(--color-deep-forest);
    transition: all 0.2s ease;
  }

  .size-btn.is-active {
    background-color: var(--color-deep-forest);
    color: var(--color-bone);
    border-color: var(--color-deep-forest);
  }

  .action-buttons-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 500px) {
    .action-buttons-group {
      flex-direction: row;
    }
  }

  .btn-lg {
    flex-grow: 1;
    padding: 1rem 1.5rem;
    font-size: 0.9375rem;
  }

  /* Provenance Card */
  .provenance-ledger-card {
    padding: 1.75rem;
    background-color: var(--color-bone-warm);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ledger-card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .ledger-tag {
    font-size: 0.6875rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.08em;
  }

  .batch-num {
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
  }

  .ledger-rows {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ledger-row {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  @media (min-width: 500px) {
    .ledger-row {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
    }
  }

  .row-label {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.05em;
  }

  .row-val {
    font-size: 0.875rem;
    color: var(--color-deep-forest);
    text-align: right;
  }

  /* Sensory */
  .sensory-box {
    padding: 1.5rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sensory-title {
    font-size: 1.2rem;
    margin: 0;
  }

  .sensory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .sensory-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sensory-label {
    font-size: 0.6875rem;
    color: var(--color-mark-gold);
  }

  .sensory-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Specimen */
  .specimen-note {
    padding: 1.5rem;
    border-left: 3px solid var(--color-mark-gold);
    background-color: var(--color-bone-warm);
    border-radius: 0 6px 6px 0;
  }

  .specimen-quote {
    font-size: 1.05rem;
    line-height: 1.6;
    font-style: italic;
    color: var(--color-deep-forest);
    margin: 0;
  }
</style>

<script>
  function initProductPage() {
    let currentPrice = 0;
    let currentSize = '';

    const priceEl = document.getElementById('active-price');
    const sizeLabelEl = document.getElementById('active-size-label');
    const sizeBtns = document.querySelectorAll<HTMLButtonElement>('.size-btn');
    const addToBasketBtn = document.getElementById('add-to-basket-main');
    const whatsappBtn = document.getElementById('order-whatsapp-direct');
    const mainImg = document.getElementById('main-product-image') as HTMLImageElement;
    const thumbBtns = document.querySelectorAll<HTMLButtonElement>('.thumb-btn');

    // Thumbnail switching
    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.dataset.src;
        if (src && mainImg) {
          mainImg.src = src;
          thumbBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
        }
      });
    });

    // Size switching
    sizeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        sizeBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        currentSize = btn.dataset.size || '';
        currentPrice = Number(btn.dataset.price) || 0;

        if (priceEl) priceEl.textContent = String(currentPrice);
        if (sizeLabelEl) sizeLabelEl.textContent = `/ ${currentSize}`;

        if (addToBasketBtn) {
          addToBasketBtn.dataset.price = String(currentPrice);
          addToBasketBtn.dataset.size = currentSize;
        }
      });
    });

    // Initialize current price/size from active button or defaults
    const activeSizeBtn = document.querySelector<HTMLButtonElement>('.size-btn.is-active');
    if (activeSizeBtn) {
      currentSize = activeSizeBtn.dataset.size || '';
      currentPrice = Number(activeSizeBtn.dataset.price) || 0;
    } else if (addToBasketBtn) {
      currentSize = addToBasketBtn.dataset.size || '100g';
      currentPrice = Number(addToBasketBtn.dataset.price) || 0;
    }

    // Add to Basket
    if (addToBasketBtn) {
      addToBasketBtn.addEventListener('click', () => {
        const product = {
          id: `${addToBasketBtn.dataset.productId}-${currentSize}`,
          productId: addToBasketBtn.dataset.productId,
          name: addToBasketBtn.dataset.productName,
          origin: addToBasketBtn.dataset.origin,
          originId: addToBasketBtn.dataset.originId,
          price: Number(addToBasketBtn.dataset.price),
          size: currentSize,
          weight: currentSize,
          image: addToBasketBtn.dataset.image,
          quantity: 1
        };

        try {
          const stored = localStorage.getItem('ourorigin_basket');
          let items = stored ? JSON.parse(stored) : [];
          
          const existingIndex = items.findIndex((item: any) => item.id === product.id);
          if (existingIndex > -1) {
            items[existingIndex].quantity = (items[existingIndex].quantity || 1) + 1;
          } else {
            items.push(product);
          }

          localStorage.setItem('ourorigin_basket', JSON.stringify(items));
          window.dispatchEvent(new CustomEvent('basket-updated'));
          window.dispatchEvent(new CustomEvent('open-basket'));

          const originalText = addToBasketBtn.innerHTML;
          addToBasketBtn.innerHTML = '<span>Added to Basket ✓</span>';
          setTimeout(() => {
            addToBasketBtn.innerHTML = originalText;
          }, 1500);
        } catch (err) {
          console.error(err);
        }
      });
    }

    // Direct WhatsApp Inquiry
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const prodName = whatsappBtn.dataset.productName;
        const originName = whatsappBtn.dataset.origin;
        const waNum = whatsappBtn.dataset.whatsapp;
        const message = `Hello OurOrigin, I'd like to reserve ${prodName} (${currentSize || '100g'} - ₹${currentPrice}) from ${originName}.`;
        const url = `https://wa.me/${waNum}?text=${encodeURIComponent(message)}`;
        window.open(url, '_blank');
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initProductPage);
  document.addEventListener('astro:page-load', initProductPage);
</script>
