---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OriginMark from '../../../components/OriginMark.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => {
    const originId = typeof product.data.originSlug === 'object' 
      ? (product.data.originSlug as any).id 
      : product.data.originSlug;
      
    return {
      params: { 
        originSlug: originId, 
        productSlug: product.id 
      },
      props: { product }
    };
  });
}

const { product } = Astro.props;
const originId = typeof product.data.originSlug === 'object' 
  ? (product.data.originSlug as any).id 
  : product.data.originSlug;
const origin = await getEntry('origins', originId);

if (!origin) {
  throw new Error(`Origin not found for product: ${product.id}`);
}

const ogImageUrl = origin.data.images?.specimen?.endsWith('.webp') 
  ? 'https://ourorigin.in/og-image.jpg' 
  : `https://ourorigin.in${origin.data.images?.specimen || '/og-image.jpg'}`;
---

<Layout
  title={`${product.data.name} from ${origin.data.name} — OurOrigin`}
  description={`${product.data.name} from ${origin.data.name} — ${origin.data.elevation}, ${origin.data.bioregion}. ${product.data.specimenCopy?.slice(0, 120) || ''}`}
  ogImage={ogImageUrl}
  noHeaderPadding={true}
>
  <main class="museum-viewport">
    <a href="/" class="back-link">
      <OriginMark size={20} variant="gold" hideDot={true} />
      <span>Back to Origins</span>
    </a>

    <div class="museum-grid">
      
      <!-- Left Panel: Pinned Artifact -->
      <div class="museum-visual-container">
        <div class="museum-visual" id="museum-visual">
          <div class="spotlight"></div>
          {product.data.images.product ? (
            <img 
              src={product.data.images.product} 
              alt={`${product.data.name} — ${product.data.sensoryProfile?.appearance || 'product image'}`} 
              class="museum-artifact" 
            />
          ) : product.data.images.packaging ? (
            <img 
              src={product.data.images.packaging} 
              alt={`${product.data.name} packaging`} 
              class="museum-artifact" 
            />
          ) : (
            <div class="artifact-placeholder">
              <OriginMark size={60} variant="gold" />
            </div>
          )}
        </div>
      </div>

      <!-- Right Panel: Scrolling Narrative -->
      <div class="museum-narrative" id="museum-narrative">
        
        <div class="narrative-section narrative-header">
          <h1 class="product-title">{product.data.name}</h1>
          <div class="product-evidence-line">
            {origin.data.elevation} · {origin.data.bioregion}
            {product.data.batchRef && <span class="batch-ref"> · {product.data.batchRef}</span>}
          </div>
        </div>

        {product.data.specimenCopy && (
          <div class="narrative-section" data-reveal="blur">
            <div class="data-label">The Soil's Record</div>
            <div class="data-value narrative-text">{product.data.specimenCopy}</div>
          </div>
        )}

        {product.data.methodDescription && (
          <div class="narrative-section" data-reveal="blur">
            <div class="data-label">The Human Touch</div>
            <div class="data-value">{product.data.methodDescription}</div>
          </div>
        )}

        {product.data.sensoryProfile && (
          <div class="narrative-section" data-reveal="blur">
            <div class="data-label">The Breath</div>
            <div class="data-grid-small">
              {product.data.sensoryProfile.aroma && (
                <div class="data-cell">
                  <span class="cell-label">Aroma</span>
                  <span class="cell-value">{product.data.sensoryProfile.aroma}</span>
                </div>
              )}
              {product.data.sensoryProfile.flavor && (
                <div class="data-cell">
                  <span class="cell-label">Flavor</span>
                  <span class="cell-value">{product.data.sensoryProfile.flavor}</span>
                </div>
              )}
            </div>
          </div>
        )}

        {(product.data.botanicalName || product.data.chemistry?.activeCompound) && (
          <div class="narrative-section" data-reveal="blur">
            <div class="data-label">The Living Forest</div>
            <div class="data-value">
              {product.data.botanicalName && <span class="botanical-name">{product.data.botanicalName}</span>}
              {product.data.botanicalName && product.data.chemistry?.activeCompound && <br/>}
              {product.data.chemistry?.activeCompound}
            </div>
          </div>
        )}

        <!-- The Climax: Offering -->
        <div class="narrative-section offering-section" data-reveal="up">
          <div class="ledger-header">The Offering</div>
          
          <div class="sizes-container">
            {product.data.sizes.map((size, i) => (
              <button 
                class:list={["size-btn", "add-to-ledger-btn", { "size-btn--selected": i === 0 }]} 
                data-product={JSON.stringify({
                  id: product.id + '-' + size.label,
                  productId: product.id,
                  name: product.data.name,
                  origin: origin.data.name,
                  originId: origin.id,
                  size: size.label,
                  price: size.priceINR,
                  quantity: 1
                })}
              >
                <span class="size-label">{size.label}</span>
                <span class="size-price">₹{size.priceINR}</span>
              </button>
            ))}
          </div>

          <button class="btn-purchase" id="purchase-cta" type="button">
            Honor the Decision
          </button>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initMuseumExperience() {
    // Reveal animations for narrative sections
    const reveals = document.querySelectorAll('[data-reveal="blur"]');
    reveals.forEach(el => {
      gsap.fromTo(el, 
        { 
          y: 40,
          opacity: 0,
          filter: 'blur(10px)'
        },
        {
          y: 0,
          opacity: 1,
          filter: 'blur(0px)',
          duration: 1.2,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
          }
        }
      );
    });

    const upReveals = document.querySelectorAll('[data-reveal="up"]');
    upReveals.forEach(el => {
      gsap.fromTo(el, 
        { y: 30, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 1, ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
          }
        }
      );
    });

    // Wire up Add to Ledger buttons
    const btns = document.querySelectorAll('.add-to-ledger-btn');
    btns.forEach(btn => {
      // clone and replace to avoid duplicate listeners on SPA navigation
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        const productData = JSON.parse(newBtn.getAttribute('data-product') || '{}');
        
        window.dispatchEvent(new CustomEvent('add-to-ledger', { detail: {
          id: productData.id,
          productId: productData.productId,
          name: productData.name,
          origin: productData.origin,
          originId: productData.originId,
          size: productData.size,
          price: productData.price,
          quantity: 1
        }}));

        // Visual feedback
        newBtn.style.background = 'rgba(198, 156, 82, 0.2)';
        newBtn.style.borderColor = 'var(--color-gold)';
        
        // Select this size
        document.querySelectorAll('.size-btn').forEach(b => b.classList.remove('size-btn--selected'));
        newBtn.classList.add('size-btn--selected');
        
        setTimeout(() => {
          newBtn.style.background = '';
          newBtn.style.borderColor = '';
        }, 800);
      });
    });

    // Purchase CTA
    const purchaseBtn = document.getElementById('purchase-cta');
    if (purchaseBtn) {
      const newPurchaseBtn = purchaseBtn.cloneNode(true) as HTMLElement;
      purchaseBtn.parentNode?.replaceChild(newPurchaseBtn, purchaseBtn);

      newPurchaseBtn.addEventListener('click', () => {
        const selectedBtn = document.querySelector('.size-btn--selected') || document.querySelector('.add-to-ledger-btn');
        if (selectedBtn) {
          (selectedBtn as HTMLElement).click();
        }
        setTimeout(() => {
          document.getElementById('ledger-trigger')?.click();
        }, 200);
      });
    }
  }

  // Initialize on load and view transitions
  initMuseumExperience();
  document.addEventListener('astro:after-swap', initMuseumExperience);
</script>

<style>
  .museum-viewport {
    background-color: var(--color-void);
    color: var(--color-warm-cream);
    min-height: 100vh;
    position: relative;
  }

  .back-link {
    position: fixed;
    top: 30px;
    left: 30px;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    color: var(--color-gold);
    text-decoration: none;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: opacity var(--duration-standard) var(--ease-settle);
  }

  .back-link:hover {
    opacity: 0.7;
  }

  .museum-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }

  /* Left Panel - Sticky Visual */
  .museum-visual-container {
    position: relative;
    border-right: 1px solid rgba(245, 240, 232, 0.05);
  }

  .museum-visual {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-4xl);
  }

  .spotlight {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(198, 156, 82, 0.08) 0%, transparent 60%);
    z-index: 0;
  }

  .museum-artifact {
    position: relative;
    z-index: 1;
    max-width: 80%;
    max-height: 80vh;
    object-fit: contain;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.8));
    animation: slowFloat 8s ease-in-out infinite alternate;
  }

  @keyframes slowFloat {
    0% { transform: translateY(0px) scale(1); }
    100% { transform: translateY(-15px) scale(1.02); }
  }

  .artifact-placeholder {
    position: relative;
    z-index: 1;
    opacity: 0.3;
  }

  /* Right Panel - Scrolling Narrative */
  .museum-narrative {
    padding: 20vh 10vw 20vh 5vw;
    display: flex;
    flex-direction: column;
    gap: 15vh;
  }

  .narrative-section {
    max-width: 600px;
  }

  .product-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: var(--line-height-tight);
    font-weight: 400;
    margin: 0 0 var(--space-md) 0;
  }

  .product-evidence-line {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(245, 240, 232, 0.5);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .batch-ref {
    color: var(--color-gold);
  }

  .data-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    text-transform: uppercase;
    color: var(--color-gold);
    letter-spacing: 0.2em;
    margin-bottom: var(--space-lg);
  }

  .data-value {
    font-family: var(--font-narrative);
    font-size: var(--type-statement);
    line-height: 1.5;
    font-weight: 300;
    color: rgba(245, 240, 232, 0.85);
  }

  .narrative-text {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1.6;
  }

  .botanical-name {
    font-style: italic;
    color: var(--color-warm-cream);
  }

  .data-grid-small {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }

  .data-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .cell-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(245, 240, 232, 0.4);
  }

  .cell-value {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
  }

  /* The Climax: Offering */
  .offering-section {
    background: rgba(245, 240, 232, 0.02);
    border: 1px solid rgba(198, 156, 82, 0.15);
    padding: var(--space-3xl);
  }

  .ledger-header {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: var(--space-2xl);
    color: var(--color-gold);
    border-bottom: 1px solid rgba(198, 156, 82, 0.2);
    padding-bottom: var(--space-lg);
  }

  .sizes-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
  }

  .size-btn {
    display: flex;
    justify-content: space-between;
    background: transparent;
    border: 1px solid rgba(245, 240, 232, 0.15);
    color: var(--color-warm-cream);
    padding: var(--space-lg) var(--space-xl);
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    cursor: pointer;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .size-btn:hover,
  .size-btn--selected {
    border-color: var(--color-gold);
    background: rgba(198, 156, 82, 0.1);
  }

  .btn-purchase {
    width: 100%;
    padding: var(--space-xl);
    background: var(--color-gold);
    color: var(--color-void);
    border: none;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: background var(--duration-standard) var(--ease-settle);
  }

  .btn-purchase:hover {
    background: var(--color-warm-cream);
  }

  @media (max-width: 900px) {
    .museum-grid {
      grid-template-columns: 1fr;
    }
    .museum-visual-container {
      border-right: none;
      border-bottom: 1px solid rgba(245, 240, 232, 0.05);
    }
    .museum-visual {
      height: 60vh;
      position: relative;
    }
    .museum-narrative {
      padding: var(--space-4xl) var(--space-xl);
      gap: 10vh;
    }
    .back-link {
      background: rgba(5,8,4,0.5);
      backdrop-filter: blur(4px);
      padding: 10px;
      border-radius: 4px;
    }
  }
</style>
