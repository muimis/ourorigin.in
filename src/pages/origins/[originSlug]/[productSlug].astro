---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OriginMark from '../../../components/OriginMark.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => {
    const originId = typeof product.data.originSlug === 'object'
      ? (product.data.originSlug as any).id
      : product.data.originSlug;
    return {
      params: { originSlug: originId, productSlug: product.id },
      props: { product }
    };
  });
}

const { product } = Astro.props;
const originId = typeof product.data.originSlug === 'object'
  ? (product.data.originSlug as any).id
  : product.data.originSlug;
const origin = await getEntry('origins', originId);

if (!origin) throw new Error(`Origin not found for product: ${product.id}`);

const ogImageUrl = origin.data.images?.specimen?.endsWith('.webp')
  ? 'https://ourorigin.in/og-image.jpg'
  : `https://ourorigin.in${origin.data.images?.specimen || '/og-image.jpg'}`;

const sp = product.data.sensoryProfile;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${product.data.name} — ${origin.data.name}`,
  "image": ogImageUrl,
  "description": `${product.data.botanicalName ? product.data.botanicalName + '. ' : ''}${origin.data.elevation}. ${product.data.batchRef ? 'Batch ' + product.data.batchRef + '.' : ''}`,
  "brand": {
    "@type": "Brand",
    "name": "OurOrigin"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "INR",
    "price": product.data.sizes?.[0]?.priceINR || "0",
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "OurOrigin"
    }
  },
  "additionalProperty": [
    ...(product.data.botanicalName ? [{ "@type": "PropertyValue", "name": "Botanical Name", "value": product.data.botanicalName }] : []),
    ...(origin.data.elevation ? [{ "@type": "PropertyValue", "name": "Elevation", "value": origin.data.elevation }] : []),
    ...(product.data.batchRef ? [{ "@type": "PropertyValue", "name": "Batch", "value": product.data.batchRef }] : [])
  ]
};
---
<Layout
  title={`${product.data.name} — ${origin.data.name} · OurOrigin`}
  description={`${sp?.aroma || ''} ${sp?.flavor || ''} — ${product.data.name} from ${origin.data.name}, ${origin.data.elevation}.`}
  ogImage={ogImageUrl}
  noHeaderPadding={true}
>
  <main class="product-viewport">

    <!-- Back -->
    <a href="/" class="back-link" aria-label="Back to all yields">
      <OriginMark size={18} variant="gold" />
    </a>

    <!-- ══ HERO: Full-bleed image takes over the screen ══ -->
    <section class="product-hero" aria-label={product.data.name}>
      <div class="hero-img-wrap" id="hero-img-wrap">
        {product.data.images.product ? (
          <img
            src={product.data.images.product}
            alt={`${product.data.name}`}
            class="hero-img"
            style={`view-transition-name: yield-img-${product.id}`}
          />
        ) : product.data.images.packaging ? (
          <img
            src={product.data.images.packaging}
            alt={`${product.data.name} packaging`}
            class="hero-img"
            style={`view-transition-name: yield-img-${product.id}`}
          />
        ) : (
          <div class="hero-img-placeholder">
            <OriginMark size={64} variant="gold" />
          </div>
        )}
        <!-- Dark gradient overlay so text is legible -->
        <div class="hero-veil" aria-hidden="true"></div>
      </div>

      <!-- Product name overlaps bottom of image -->
      <div class="hero-identity">
        <div class="hero-origin-tag">
          <OriginMark size={14} variant="gold" />
          <span class="hero-origin-name">{origin.data.name}</span>
          <span class="hero-origin-elev">{origin.data.elevation}</span>
        </div>
        <h1 class="hero-product-name" style={`view-transition-name: yield-title-${product.id}`}>
          {product.data.name}
        </h1>
        {product.data.botanicalName && (
          <p class="hero-botanical">{product.data.botanicalName}</p>
        )}
      </div>
    </section>

    <!-- ══ SENSORY: First thing after the image — what does it taste like? ══ -->
    {sp && (sp.aroma || sp.flavor || sp.appearance) && (
      <section class="sense-section" data-reveal>
        <div class="sense-inner">
          {sp.aroma && (
            <div class="sense-item">
              <span class="field-label">Aroma</span>
              <p class="field-body">{sp.aroma}</p>
            </div>
          )}
          {sp.flavor && (
            <div class="sense-item">
              <span class="field-label">Flavor</span>
              <p class="field-body">{sp.flavor}</p>
            </div>
          )}
          {sp.appearance && (
            <div class="sense-item sense-item--wide">
              <span class="field-label">Appearance</span>
              <p class="field-body">{sp.appearance}</p>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- ══ THE PROOF SYSTEM: Transfer Ledger ══ -->
    <section class="proof-section" data-reveal>
      <div class="proof-inner">
        <div class="proof-ledger">
          <div class="proof-row">
            <span class="proof-label">Crop:</span>
            <span class="proof-value">{product.data.name}</span>
          </div>
          <div class="proof-row">
            <span class="proof-label">First Hands:</span>
            <span class="proof-value">{product.data.proofSystem?.firstHands || '---'}</span>
          </div>
          <div class="proof-row">
            <span class="proof-label">Direct Price Paid:</span>
            <span class="proof-value">{product.data.proofSystem?.directPricePaid || '---'}</span>
          </div>
          <div class="proof-row">
            <span class="proof-label">Nature's Share:</span>
            <span class="proof-value">{product.data.proofSystem?.naturesShare || '---'}</span>
          </div>
          <div class="proof-row">
            <span class="proof-label">Proof:</span>
            <span class="proof-value proof-links">
              {product.data.proofSystem?.proofCert ? <a href={product.data.proofSystem.proofCert} target="_blank" rel="noreferrer">[FSSAI Cert]</a> : '---'}
              <span class="proof-dot">·</span>
              {product.data.proofSystem?.proofPhoto ? <a href={product.data.proofSystem.proofPhoto} target="_blank" rel="noreferrer">[Batch Photo]</a> : '---'}
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ THE OFFERING: Size picker + giant CTA ══ -->
    <section class="offering-section" data-reveal>
      <div class="offering-inner">
        {product.data.batchRef && (
          <div class="batch-ref">BATCH · {product.data.batchRef}</div>
        )}

        <div class="sizes-row">
          {product.data.sizes.map((size: any, i: number) => (
            <button
              class:list={["size-pill", { "size-pill--active": i === 0 }]}
              data-product={JSON.stringify({
                id: product.id + '-' + size.label,
                productId: product.id,
                name: product.data.name,
                origin: origin.data.name,
                originId: origin.id,
                size: size.label,
                price: size.priceINR,
                quantity: 1
              })}
              type="button"
            >
              <span class="size-qty">{size.label}</span>
              <span class="size-price">₹{size.priceINR}</span>
            </button>
          ))}
        </div>

        <button class="ledger-cta" id="purchase-cta" type="button">
          Add to Ledger
        </button>
      </div>
    </section>

  </main>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initProduct() {
    // Scroll reveal
    document.querySelectorAll('[data-reveal]').forEach((el, i) => {
      gsap.fromTo(el,
        { y: 32, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 0.75, ease: 'power2.out',
          delay: i * 0.05,
          scrollTrigger: { trigger: el, start: 'top 90%' }
        }
      );
    });

    // Hero image parallax — image drifts upward as you scroll
    const heroImg = document.querySelector('.hero-img') as HTMLElement;
    if (heroImg) {
      gsap.to(heroImg, {
        yPercent: -18,
        ease: 'none',
        scrollTrigger: {
          trigger: '.product-hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      });
    }

    // Size selection
    const sizePills = document.querySelectorAll('.size-pill');
    sizePills.forEach(btn => {
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', () => {
        document.querySelectorAll('.size-pill').forEach(b => b.classList.remove('size-pill--active'));
        newBtn.classList.add('size-pill--active');
        // Also dispatch cart event on size select
        const data = JSON.parse(newBtn.dataset.product || '{}');
        window.dispatchEvent(new CustomEvent('add-to-ledger', { detail: {
          id: data.id, productId: data.productId, name: data.name,
          origin: data.origin, originId: data.originId,
          size: data.size, price: data.price, quantity: 1
        }}));
      });
    });

    // Purchase CTA
    const purchaseBtn = document.getElementById('purchase-cta');
    if (purchaseBtn) {
      const newBtn = purchaseBtn.cloneNode(true) as HTMLElement;
      purchaseBtn.parentNode?.replaceChild(newBtn, purchaseBtn);
      newBtn.addEventListener('click', () => {
        const selected = document.querySelector('.size-pill--active') as HTMLElement
          || document.querySelector('.size-pill') as HTMLElement;
        if (selected) selected.click();
        setTimeout(() => {
          document.getElementById('ledger-trigger')?.click();
        }, 150);
      });
    }
  }

  initProduct();
  document.addEventListener('astro:after-swap', initProduct);
</script>

<style>
  .product-viewport {
    background: var(--color-deep-forest);
    color: var(--color-bone);
  }

  /* ── Back link ── */
  .back-link {
    position: fixed;
    top: 24px;
    left: 24px;
    z-index: 200;
    color: var(--color-mark-gold);
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.2s;
    mix-blend-mode: screen;
  }
  .back-link:hover { opacity: 1; }

  /* ══════════════════════════════
     HERO — full bleed, 85vh tall
  ══════════════════════════════ */
  .product-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero-img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-img {
    width: 100%;
    height: 115%; /* Extra height for parallax travel */
    object-fit: cover;
    object-position: center;
    transform-origin: center top;
    will-change: transform;
    filter: saturate(0.88) contrast(1.08);
  }

  .hero-img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-forest-surface);
    opacity: 0.3;
  }

  /* Gradient: transparent top → deep bottom so text is readable */
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6,4,3,0.1) 0%,
      rgba(6,4,3,0.15) 40%,
      rgba(6,4,3,0.75) 72%,
      rgba(6,4,3,0.97) 100%
    );
  }

  /* Product identity: anchored to the bottom of the hero */
  .hero-identity {
    position: relative;
    z-index: 2;
    padding: 0 clamp(1.5rem, 5vw, 5rem) clamp(2rem, 5vh, 3.5rem);
    width: 100%;
    max-width: 900px;
  }

  .hero-origin-tag {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .hero-origin-name {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mark-gold);
  }

  .hero-origin-elev {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-bone-whisper);
  }

  .hero-product-name {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6.5vw, 6rem);
    font-weight: 400;
    line-height: 1.0;
    margin: 0 0 0.4rem 0;
    letter-spacing: 0.01em;
    color: var(--color-bone);
    opacity: 1;
  }

  .hero-botanical {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: clamp(0.9rem, 1.6vw, 1.1rem);
    color: var(--color-bone-muted);
    margin: 0;
  }

  /* ══════════════════════════════
     SENSORY SECTION
  ══════════════════════════════ */
  .sense-section {
    padding: clamp(3rem, 6vh, 5rem) clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .sense-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
    max-width: 900px;
  }

  .sense-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sense-item--wide {
    grid-column: 1 / -1;
  }

  /* ══════════════════════════════
     PROOF SYSTEM SECTION
  ══════════════════════════════ */
  .proof-section {
    padding: clamp(3rem, 6vh, 5rem) clamp(1.5rem, 5vw, 5rem);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .proof-inner {
    max-width: 900px;
    background: rgba(240, 234, 214, 0.03);
    padding: clamp(1.5rem, 4vw, 3rem);
    border-left: 2px solid var(--color-mark-gold);
  }

  .proof-ledger {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: var(--font-evidence); /* JetBrains Mono */
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    line-height: 1.6;
    color: var(--color-bone);
  }

  .proof-row {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .proof-row {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .proof-label {
    width: 220px;
    flex-shrink: 0;
    color: var(--color-mark-gold);
    opacity: 0.8;
  }

  .proof-value {
    flex: 1;
    color: rgba(239, 230, 211, 0.9); /* bone color */
  }

  .proof-links a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(239, 230, 211, 0.3);
    transition: color 0.2s, border-color 0.2s;
  }

  .proof-links a:hover {
    color: var(--color-mark-gold);
    border-color: var(--color-mark-gold);
  }

  .proof-dot {
    margin: 0 0.75rem;
    opacity: 0.4;
  }

  /* ══════════════════════════════
     SHARED FIELD LABELS
  ══════════════════════════════ */
  .field-label {
    font-family: var(--font-evidence);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-mark-gold);
    opacity: 0.6;
  }

  .field-body {
    font-family: var(--font-narrative);
    font-size: clamp(1rem, 1.9vw, 1.2rem);
    line-height: 1.5;
    color: var(--color-bone-muted);
    margin: 0;
  }

  .field-note-link {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-bone-whisper);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
    display: inline-block;
    align-self: flex-start;
  }
  .field-note-link:hover { color: var(--color-mark-gold); }

  /* ══════════════════════════════
     OFFERING / BUY SECTION
  ══════════════════════════════ */
  .offering-section {
    padding: clamp(3rem, 6vh, 5rem) clamp(1.5rem, 5vw, 5rem) clamp(4rem, 10vh, 7rem);
  }

  .offering-inner {
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .batch-ref {
    font-family: var(--font-evidence);
    font-size: 9px;
    letter-spacing: 0.22em;
    color: var(--color-bone-whisper);
    text-transform: uppercase;
  }

  .sizes-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .size-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    border: 1px solid rgba(240, 234, 214, 0.12);
    color: var(--color-bone);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 46px;
  }

  .size-pill:hover,
  .size-pill--active {
    border-color: var(--color-mark-gold);
    background: rgba(212, 139, 22, 0.08);
    color: var(--color-mark-gold);
  }

  .size-qty { letter-spacing: 0.06em; }

  .size-price {
    color: var(--color-bone-muted);
    font-size: var(--type-whisper);
    transition: color 0.2s;
  }

  .size-pill--active .size-price,
  .size-pill:hover .size-price { color: var(--color-mark-gold); }

  /* THE GOLD BUTTON — unmissable */
  .ledger-cta {
    width: 100%;
    padding: 1.1rem 2rem;
    background: var(--color-mark-gold);
    color: var(--color-deep-forest);
    border: none;
    font-family: var(--font-evidence);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    cursor: pointer;
    transition: background 0.25s, transform 0.12s;
    min-height: 56px;
  }

  .ledger-cta:hover {
    background: var(--color-bone);
    transform: translateY(-2px);
  }

  .ledger-cta:active { transform: translateY(0); }

  /* ══════════════════════════════
     MOBILE
  ══════════════════════════════ */
  @media (max-width: 768px) {
    .product-hero {
      height: 65vh;
      min-height: 360px;
    }

    .hero-product-name {
      font-size: clamp(2rem, 9vw, 3.5rem);
    }

    .sense-inner {
      grid-template-columns: 1fr 1fr;
    }

    .sense-item--wide {
      grid-column: 1 / -1;
    }

    .back-link {
      top: 16px;
      left: 16px;
    }

    .offering-section {
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 480px) {
    .sense-inner {
      grid-template-columns: 1fr;
    }

    .sizes-row {
      flex-direction: column;
    }

    .size-option {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
