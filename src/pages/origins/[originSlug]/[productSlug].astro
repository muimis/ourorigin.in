---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OriginMark from '../../../components/OriginMark.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => {
    const originId = typeof product.data.originSlug === 'object' 
      ? (product.data.originSlug as any).id 
      : product.data.originSlug;
      
    return {
      params: { 
        originSlug: originId, 
        productSlug: product.id 
      },
      props: { product }
    };
  });
}

const { product } = Astro.props;
const originId = typeof product.data.originSlug === 'object' 
  ? (product.data.originSlug as any).id 
  : product.data.originSlug;
const origin = await getEntry('origins', originId);

if (!origin) {
  throw new Error(`Origin not found for product: ${product.id}`);
}

const ogImageUrl = origin.data.images?.specimen?.endsWith('.webp') 
  ? 'https://ourorigin.in/og-image.jpg' 
  : `https://ourorigin.in${origin.data.images?.specimen || '/og-image.jpg'}`;
---

<Layout
  title={`${product.data.name} from ${origin.data.name} — OurOrigin`}
  description={`${product.data.name} from ${origin.data.name} — ${origin.data.elevation}, ${origin.data.bioregion}.`}
>
  <main class="product-viewport">
      
    <!-- Background Layer (Grayscaled Specimen) -->
    <div class="layer bg-mask-layer pedestal-mask">
      <div class="bg-image active" style={`background-image: url('${origin.data.images.specimen || origin.data.images.canopy}'); filter: grayscale(100%) brightness(0.2);`}></div>
    </div>

    <div class="layer ui-layer product-ui">
        
      <a href={`/origins/${origin.id}`} class="back-link">
        <OriginMark size={24} variant="gold" hideDot={true} />
        <span>Back to {origin.data.name}</span>
      </a>

      <div class="product-content-grid">
          
        <!-- Left Panel: Product Data -->
        <div class="product-data-panel">
          <h1 class="product-title">{product.data.name}</h1>
          {product.data.botanicalName && <div class="product-botanical">{product.data.botanicalName}</div>}
          
          {product.data.specimenCopy && (
            <div class="product-narrative">
              <p>{product.data.specimenCopy}</p>
            </div>
          )}

          <div class="data-grid">
            {product.data.methodDescription && (
              <div class="data-item">
                <div class="data-label">Method</div>
                <div class="data-value">{product.data.methodDescription}</div>
              </div>
            )}
            {product.data.harvestMonth && (
              <div class="data-item">
                <div class="data-label">Harvest</div>
                <div class="data-value">{product.data.harvestMonth}</div>
              </div>
            )}
            {product.data.sensoryProfile && (
              <>
                {product.data.sensoryProfile.aroma && (
                  <div class="data-item">
                    <div class="data-label">Aroma</div>
                    <div class="data-value">{product.data.sensoryProfile.aroma}</div>
                  </div>
                )}
                {product.data.sensoryProfile.flavor && (
                  <div class="data-item">
                    <div class="data-label">Flavor</div>
                    <div class="data-value">{product.data.sensoryProfile.flavor}</div>
                  </div>
                )}
              </>
            )}
          </div>
        </div>

        <!-- Center Panel: The Artifact Image -->
        <div class="product-artifact-panel">
          {product.data.images.product ? (
            <img src={product.data.images.product} alt={product.data.name} class="artifact-hero-image" />
          ) : (
            <div class="artifact-placeholder">Image arriving soon</div>
          )}
        </div>

        <!-- Right Panel: The Ledger (Purchase) -->
        <div class="product-ledger-panel">
          <div class="ledger-header">The Ledger</div>
          <div class="ledger-origin">
            <span class="origin-name">{origin.data.name}</span>
            <span class="origin-region">{origin.data.bioregion}</span>
            <span class="origin-coords">{origin.data.coordinates}</span>
          </div>

          <div class="sizes-container">
            {product.data.sizes.map((size) => (
              <button class="size-btn add-to-ledger-btn" data-product={JSON.stringify({
                id: product.id,
                name: product.data.name,
                origin: origin.data.name,
                originId: origin.id,
                size: size.label,
                price: size.priceINR
              })}>
                <span class="size-label">{size.label}</span>
                <span class="size-price">₹{size.priceINR}</span>
              </button>
            ))}
          </div>

          <button class="btn-purchase" onclick="document.querySelector('.add-to-ledger-btn').click(); document.getElementById('ledger-trigger')?.click();">
            Honor the Harvest
          </button>
        </div>

      </div>
    </div>
  </main>
</Layout>

<script>
  // Wire up Add to Ledger buttons specific to this page
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.add-to-ledger-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productData = JSON.parse(btn.getAttribute('data-product') || '{}');
        
        const item = {
          id: productData.id + '-' + productData.size,
          productId: productData.id,
          name: productData.name,
          origin: productData.origin,
          originId: productData.originId,
          size: productData.size,
          price: productData.price,
          quantity: 1
        };
        
        window.dispatchEvent(new CustomEvent('add-to-ledger', { detail: item }));

        // Visual feedback
        const originalBg = (btn as HTMLElement).style.background;
        const originalBorder = (btn as HTMLElement).style.borderColor;
        
        (btn as HTMLElement).style.background = 'rgba(198, 156, 82, 0.2)';
        (btn as HTMLElement).style.borderColor = 'var(--color-gold)';
        
        setTimeout(() => {
          (btn as HTMLElement).style.background = originalBg;
          (btn as HTMLElement).style.borderColor = originalBorder;
        }, 800);
      });
    });
  });
</script>

<style>
  .product-viewport {
    position: relative;
    min-height: 100vh;
    width: 100vw;
    pointer-events: auto;
    overflow-x: hidden;
    color: var(--color-warm-cream);
  }

  .pedestal-mask {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: -1;
  }
  
  .bg-image {
    width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
  }

  .ui-layer {
    padding: 8rem 5vw 4rem 5vw;
    max-width: 1600px;
    margin: 0 auto;
  }

  .back-link {
    position: absolute;
    top: 2rem;
    left: 5vw;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-gold);
    text-decoration: none;
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    z-index: 100;
    transition: opacity 0.3s;
  }

  .back-link:hover {
    opacity: 0.7;
  }

  .product-content-grid {
    display: grid;
    grid-template-columns: 1fr 400px 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 70vh;
  }

  @media (max-width: 1100px) {
    .product-content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  /* Left Panel */
  .product-data-panel {
    max-width: 450px;
  }

  .product-title {
    font-family: 'Cinzel', serif;
    font-size: 3rem;
    line-height: 1.1;
    margin: 0 0 0.5rem 0;
  }

  .product-botanical {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    color: var(--color-gold);
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }

  .product-narrative {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(245, 237, 216, 0.8);
    margin-bottom: 3rem;
  }

  .data-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .data-item {
    border-left: 1px solid var(--color-gold);
    padding-left: 1rem;
  }

  .data-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--color-gold);
    letter-spacing: 0.1em;
    margin-bottom: 0.25rem;
  }

  .data-value {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  /* Center Panel */
  .product-artifact-panel {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
  }

  .artifact-hero-image {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.8));
  }

  .artifact-placeholder {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    color: rgba(245, 237, 216, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 4rem;
    border: 1px dashed rgba(245, 237, 216, 0.2);
    border-radius: 50%;
  }

  /* Right Panel */
  .product-ledger-panel {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2.5rem;
    max-width: 350px;
    backdrop-filter: blur(10px);
    margin-left: auto;
  }

  .ledger-header {
    font-family: 'Cinzel', serif;
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding-bottom: 1rem;
  }

  .ledger-origin {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 2rem;
  }

  .origin-name { font-size: 1.2rem; font-family: 'Cinzel', serif; }
  .origin-region { font-size: 0.9rem; opacity: 0.7; font-family: 'Inter', sans-serif; }
  .origin-coords { font-family: 'DM Mono', monospace; font-size: 0.7rem; color: var(--color-gold); margin-top: 0.5rem; }

  .sizes-container {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .size-btn {
    display: flex;
    justify-content: space-between;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-warm-cream);
    padding: 1rem;
    font-family: 'DM Mono', monospace;
    cursor: pointer;
    transition: all 0.3s;
  }

  .size-btn:hover {
    border-color: var(--color-gold);
    background: rgba(198, 156, 82, 0.1);
  }

  .btn-purchase {
    width: 100%;
    padding: 1.25rem;
    background: var(--color-warm-cream);
    color: var(--color-forest-deep);
    border: none;
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.3s;
  }

  .btn-purchase:hover {
    background: var(--color-gold);
    color: var(--color-warm-cream);
  }
</style>
