---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import OriginMark from '../../../components/OriginMark.astro';

export async function getStaticPaths() {
  const origins = await getCollection('origins');
  return origins.map((origin) => {
    return {
      params: { originSlug: origin.id },
      props: { origin },
    };
  });
}

const { origin } = Astro.props;

// Get all products for this origin
const allProducts = await getCollection('products');
const originProducts = allProducts.filter((product) => {
  const pOriginId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
  return pOriginId === origin.id;
});

const canopyImg = origin.data.images?.canopy || origin.data.images?.hand || '/assets/images/gesture_hands.png';
---

<Layout
  title={`${origin.data.name} Terroir — OurOrigin`}
  description={`Single-origin harvests and ecological profile of ${origin.data.name} — ${origin.data.elevation}, ${origin.data.bioregion}.`}
>
  <div class="origin-page">
    
    <!-- Hero Header -->
    <header class="origin-hero">
      <div class="container">
        
        <!-- Breadcrumb -->
        <nav class="breadcrumb font-mono" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/#origins">Origins</a>
          <span>/</span>
          <span class="current-crumb">{origin.data.name}</span>
        </nav>

        <div class="origin-hero-grid">
          <div class="origin-hero-content">
            <span class="badge-origin badge-gold">
              <OriginMark size={14} variant="gold" />
              <span>{origin.data.bioregion} TERROIR</span>
            </span>

            <h1 class="origin-title font-serif">{origin.data.name}</h1>
            
            <div class="origin-stats-row font-mono">
              <span class="stat-pill">▲ {origin.data.elevation}</span>
              <span class="stat-pill">{origin.data.coordinates}</span>
            </div>

            {origin.data.soil && (
              <p class="origin-soil-meta font-mono">
                SOIL: {origin.data.soil}
              </p>
            )}
          </div>

          <!-- Canopy Image -->
          <div class="origin-hero-media">
            <img 
              src={canopyImg} 
              alt={`${origin.data.name} forest canopy`} 
              class="origin-canopy-img" 
              onerror="this.src='/assets/images/gesture_hands.png'"
            />
          </div>
        </div>

      </div>
    </header>

    <div class="container origin-main-content">
      
      <!-- Ecological Narrative -->
      <section class="narrative-section">
        <h2 class="section-heading font-serif">The Terroir & Ecology</h2>
        
        <div class="narrative-grid">
          {origin.data.narrative?.canopy && (
            <div class="narrative-card">
              <span class="card-kicker font-mono">CANOPY & CLIMATE</span>
              <p>{origin.data.narrative.canopy}</p>
            </div>
          )}

          {origin.data.narrative?.land && (
            <div class="narrative-card">
              <span class="card-kicker font-mono">SOIL & MOISTURE</span>
              <p>{origin.data.narrative.land}</p>
            </div>
          )}

          {origin.data.narrative?.hand && (
            <div class="narrative-card">
              <span class="card-kicker font-mono">THE FIRST HANDS</span>
              <p>{origin.data.narrative.hand}</p>
            </div>
          )}
        </div>
      </section>

      <!-- Products from this Origin -->
      <section class="origin-yields-section">
        <div class="yields-header">
          <div>
            <span class="badge-origin badge-gold">TERROIR HARVESTS</span>
            <h2 class="section-heading font-serif">Yields from {origin.data.name}</h2>
          </div>
          <span class="font-mono text-whisper">{originProducts.length} ACTIVE BATCHES</span>
        </div>

        <div class="origin-products-grid">
          {originProducts.map(product => {
            const firstSize = product.data.sizes[0];
            const prodImg = product.data.images?.product || product.data.images?.packaging || '/assets/products/minimal-packaging-pouch.jpg';

            const itemPayload = JSON.stringify({
              id: `${product.id}-${firstSize.label}`,
              productId: product.id,
              name: product.data.name,
              origin: origin.data.name,
              originId: origin.id,
              price: firstSize.priceINR,
              size: firstSize.label,
              weight: firstSize.label,
              image: prodImg,
              quantity: 1
            });

            return (
              <article class="product-item-card">
                <a href={`/origins/${origin.id}/${product.id}`} class="prod-img-link">
                  <div class="prod-media">
                    <img 
                      src={prodImg} 
                      alt={product.data.name} 
                      class="prod-img" 
                      loading="lazy"
                      onerror="this.src='/assets/products/minimal-packaging-pouch.jpg'"
                    />
                  </div>
                </a>

                <div class="prod-details">
                  <div class="prod-title-wrap">
                    <h3 class="prod-title font-serif">
                      <a href={`/origins/${origin.id}/${product.id}`}>{product.data.name}</a>
                    </h3>
                    {product.data.botanicalName && (
                      <span class="prod-botanical font-serif">{product.data.botanicalName}</span>
                    )}
                  </div>

                  <div class="prod-footer">
                    <span class="prod-price font-mono">₹{firstSize.priceINR} <small class="text-whisper">/ {firstSize.label}</small></span>
                    
                    <button
                      type="button"
                      class="btn-add-harvest"
                      data-product-json={itemPayload}
                      aria-label={`Add ${product.data.name} to basket`}
                    >
                      + Add
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>

    </div>

  </div>
</Layout>

<style>
  .origin-page {
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .origin-hero {
    padding: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-bone-warm) 0%, var(--color-bone) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a:hover {
    color: var(--color-deep-forest);
  }

  .current-crumb {
    color: var(--color-deep-forest);
  }

  .origin-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 860px) {
    .origin-hero-grid {
      grid-template-columns: 1.2fr 1fr;
      gap: 3.5rem;
    }
  }

  .origin-hero-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .origin-title {
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    margin: 0;
    line-height: 1.1;
    font-weight: 350;
  }

  .origin-stats-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .stat-pill {
    padding: 0.3rem 0.65rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    color: var(--color-deep-forest);
  }

  .origin-soil-meta {
    font-size: 0.75rem;
    color: var(--color-proof-green);
    letter-spacing: 0.05em;
    margin: 0;
  }

  .origin-hero-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-forest-dark);
    box-shadow: var(--shadow-card);
  }

  .origin-canopy-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Content */
  .origin-main-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .section-heading {
    font-size: var(--type-title);
    font-weight: 450;
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .narrative-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .narrative-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .narrative-card {
    padding: 1.75rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-subtle);
  }

  .card-kicker {
    font-size: 0.6875rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.08em;
  }

  .narrative-card p {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Yields Section */
  .yields-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .origin-products-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 580px) {
    .origin-products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .origin-products-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .product-item-card {
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth);
  }

  .product-item-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  .prod-img-link {
    display: block;
  }

  .prod-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-bone-warm);
    overflow: hidden;
  }

  .prod-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .prod-details {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    gap: 1rem;
  }

  .prod-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .prod-title {
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0;
  }

  .prod-botanical {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .prod-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .prod-price {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .btn-add-harvest {
    padding: 0.4rem 0.85rem;
    background-color: var(--color-bone-warm);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-deep-forest);
    transition: all var(--duration-base) var(--ease-smooth);
  }

  .btn-add-harvest:hover {
    background-color: var(--color-mark-gold);
    color: #0C150A;
  }
</style>

<script>
  function initOriginAddBtns() {
    document.querySelectorAll<HTMLButtonElement>('.btn-add-harvest').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const jsonStr = btn.dataset.productJson;
        if (!jsonStr) return;

        try {
          const product = JSON.parse(jsonStr);
          const stored = localStorage.getItem('ourorigin_basket');
          let items = stored ? JSON.parse(stored) : [];
          
          const existingIndex = items.findIndex((item: any) => item.id === product.id);
          if (existingIndex > -1) {
            items[existingIndex].quantity = (items[existingIndex].quantity || 1) + 1;
          } else {
            items.push(product);
          }

          localStorage.setItem('ourorigin_basket', JSON.stringify(items));
          window.dispatchEvent(new CustomEvent('basket-updated'));
          window.dispatchEvent(new CustomEvent('open-basket'));

          btn.innerHTML = '<span>Added ✓</span>';
          setTimeout(() => {
            btn.innerHTML = '+ Add';
          }, 1500);
        } catch (err) {}
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initOriginAddBtns);
  document.addEventListener('astro:page-load', initOriginAddBtns);
</script>
