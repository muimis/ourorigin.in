---
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';
import { WHATSAPP_NUMBER, EMAIL_ADDRESS } from '../utils/constants';

const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hello OurOrigin, I'd like to inquire about your single-origin harvests.")}`;
const formattedPhone = '+91 96455 55668';
---

<Layout
  title="Contact & Direct Inquiries — OurOrigin"
  description="Reach OurOrigin for direct trade inquiries, harvest reservations, or provenance questions."
>
  <div class="contact-page">
    
    <!-- Hero Header -->
    <header class="contact-hero">
      <div class="container-narrow">
        <span class="badge-origin badge-gold">
          <OriginMark size={14} variant="gold" />
          <span>DIRECT CONTACT</span>
        </span>
        <h1 class="contact-headline font-serif">Reach the Origin</h1>
        <p class="contact-intro text-muted">
          Our dispatch and operations are rooted in Thiruvananthapuram, Kerala. If you wish to trace an origin batch, discuss bulk culinary orders, or connect directly with our team, we are here.
        </p>
      </div>
    </header>

    <div class="container-narrow contact-grid">
      
      <!-- Contact Cards -->
      <div class="contact-cards">
        
        <!-- WhatsApp Direct -->
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="contact-channel-card">
          <div class="channel-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-label font-mono">WHATSAPP DIRECT</span>
            <span class="channel-val font-mono">{formattedPhone}</span>
            <span class="channel-hint">Instant messaging & direct order reservations</span>
          </div>
          <span class="channel-arrow" aria-hidden="true">→</span>
        </a>

        <!-- Email Direct -->
        <a href={`mailto:${EMAIL_ADDRESS}`} class="contact-channel-card">
          <div class="channel-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="channel-info">
            <span class="channel-label font-mono">EMAIL DIRECT</span>
            <span class="channel-val font-mono">{EMAIL_ADDRESS}</span>
            <span class="channel-hint">Grower partnerships, institutional sourcing & press</span>
          </div>
          <span class="channel-arrow" aria-hidden="true">→</span>
        </a>

      </div>

      <!-- Information & Location Box -->
      <div class="contact-location-card">
        <h3 class="location-title font-serif">Provenance & Dispatch Hub</h3>
        <p class="location-desc text-muted">
          All seasonal spices, orthodox teas, and millets are gathered at their Western Ghats origin, sun-dried, quality verified, and packed for direct dispatch from Thiruvananthapuram, Kerala.
        </p>
        <div class="location-meta font-mono">
          <span>8°29′N, 76°57′E</span> · <span>KERALA, INDIA</span>
        </div>
      </div>

    </div>

  </div>
</Layout>

<style>
  .contact-page {
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .contact-hero {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-bone-warm) 0%, var(--color-bone) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .contact-headline {
    font-size: var(--type-display);
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-weight: 350;
  }

  .contact-intro {
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0;
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .contact-cards {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-channel-card {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--duration-base) var(--ease-smooth), border-color var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth);
  }

  .contact-channel-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-mark-gold);
  }

  .channel-icon {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    background-color: var(--color-bone-warm);
    color: var(--color-mark-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex-grow: 1;
  }

  .channel-label {
    font-size: 0.6875rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.08em;
  }

  .channel-val {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  .channel-hint {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
  }

  .channel-arrow {
    font-size: 1.25rem;
    color: var(--color-ink-whisper);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .contact-channel-card:hover .channel-arrow {
    transform: translateX(4px);
    color: var(--color-deep-forest);
  }

  /* Location Card */
  .contact-location-card {
    padding: 2rem;
    background-color: var(--color-forest-dark);
    color: var(--color-bone);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-card);
  }

  .location-title {
    font-size: 1.35rem;
    font-weight: 450;
    margin: 0;
    color: var(--color-bone);
  }

  .location-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-forest-muted);
    margin: 0;
  }

  .location-meta {
    font-size: 0.75rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.05em;
    padding-top: 0.5rem;
  }
</style>
