---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER, EMAIL_ADDRESS } from '../utils/constants';

const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}`;
const formattedPhone = '+91 96455 55668';
---

<Layout
  title="Contact — OurOrigin"
  description="Reach OurOrigin for inquiries, harvest reservations, or questions about our origins."
>
  <main class="contact-page">
    
    <div class="contact-bg"></div>
    <div class="contact-thread" aria-hidden="true"></div>

    <div class="contact-content">
      <h1 class="contact-title">Reach the Origin</h1>

      <p class="contact-body">
        Our operations are based in Thiruvananthapuram, Kerala. If you want to trace an origin, understand the journey of a yield, or simply connect — we are here.
      </p>

      <div class="contact-links">
        <a href={whatsappLink} class="contact-link" target="_blank" rel="noopener noreferrer">
          <span class="link-label">WhatsApp</span>
          <span class="link-value">{formattedPhone}</span>
        </a>
        <a href={`mailto:${EMAIL_ADDRESS}`} class="contact-link">
          <span class="link-label">Email</span>
          <span class="link-value">{EMAIL_ADDRESS}</span>
        </a>
      </div>

      <p class="contact-bulk">For orders of 50 units or more, reach us on the same number.</p>

      <a href="/" class="back-link">← Back to Home</a>
    </div>

  </main>
</Layout>

<style>
  .contact-page {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    padding: var(--space-4xl) clamp(1.5rem, 5vw, 4rem);
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .contact-thread {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100%;
    background-color: var(--color-gold);
    opacity: 0.04;
    pointer-events: none;
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(198, 156, 82, 0.08) 0%, transparent 70%);
    animation: slowPulse 12s ease-in-out infinite alternate;
    pointer-events: none;
  }

  @keyframes slowPulse {
    0% { transform: scale(1); opacity: 0.3; }
    100% { transform: scale(1.3); opacity: 0.8; }
  }

  .contact-content {
    position: relative;
    z-index: 1;
  }

  .contact-title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 400;
    margin: 0 0 var(--space-2xl) 0;
    color: var(--color-warm-cream);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: var(--line-height-tight);
  }

  .contact-body {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    line-height: var(--line-height-loose);
    margin: 0 0 var(--space-3xl) 0;
    color: rgba(245, 240, 232, 0.85);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    text-decoration: none;
    transition: opacity var(--duration-standard) var(--ease-settle);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid rgba(245, 240, 232, 0.06);
  }

  .contact-link:hover {
    opacity: 0.8;
  }

  .link-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }

  .link-value {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-warm-cream);
  }

  .contact-bulk {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(245, 240, 232, 0.35);
    letter-spacing: 0.05em;
    line-height: var(--line-height-base);
    margin: 0 0 var(--space-3xl) 0;
  }

  .back-link {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(245, 240, 232, 0.4);
    text-decoration: none;
    letter-spacing: 0.05em;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .back-link:hover {
    color: var(--color-warm-cream);
  }
</style>
