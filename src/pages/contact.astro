---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER, EMAIL_ADDRESS } from '../utils/constants';

const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}`;
const formattedPhone = '+91 96455 55668';
---

<Layout
  title="Inquiry Dispatch — OurOrigin"
  description="Reach out to OurOrigin for inquiries, harvest reservations, or questions about our origins."
>
    <main id="main-content" class="page-container">
        <!-- The 12km Thread -->
        <div class="contact-thread"></div>

        <h1>Reach the Origin</h1>

        <div class="contact-details">
            <p>Our operations are based in Thiruvananthapuram, Kerala. If you want to trace an origin, understand the journey of a yield, or simply connect — we are here.</p>
            <a href={whatsappLink} class="contact-link" target="_blank" rel="noopener noreferrer">{formattedPhone}</a>
            <a href={`mailto:${EMAIL_ADDRESS}`} class="contact-link">{EMAIL_ADDRESS}</a>
        </div>

        <p class="contact-gifting">For orders of 50 or more, reach us on the same number.</p>

        <a href="/" class="nav-link">← Back to Home</a>
    </main>
</Layout>

<style>
    .page-container {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        padding-top: max(140px, 20vh);
        padding-left: clamp(1.5rem, 5vw, 4rem);
        padding-right: clamp(1.5rem, 5vw, 4rem);
        padding-bottom: 10vh;
        display: flex;
        flex-direction: column;
    }

    .contact-thread {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 1px;
        height: 100%;
        background-color: var(--color-gold);
        opacity: 0.06;
        pointer-events: none;
    }

    h1 {
        font-family: var(--font-institutional);
        font-size: var(--text-massive);
        margin: 0 0 var(--space-xl) 0;
        font-weight: 400;
        color: var(--color-warm-cream);
        text-transform: uppercase;
        line-height: var(--line-height-tight);
    }

    .contact-details p {
        font-family: var(--font-display);
        font-size: var(--text-lead);
        line-height: var(--line-height-loose);
        margin: 0 0 var(--space-2xl) 0;
        opacity: 0.9;
        color: var(--color-warm-cream);
    }

    .contact-link {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-warm-cream);
        text-decoration: none;
        display: block;
        margin-bottom: var(--space-md);
        opacity: 0.6;
        transition: opacity 0.3s ease;
    }

    .contact-link:hover {
        opacity: 1;
        color: var(--color-gold);
    }

    .contact-gifting {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: rgba(245, 237, 216, 0.4);
        margin-top: var(--space-3xl);
        letter-spacing: 0.05em;
        line-height: var(--line-height-base);
    }

    .nav-link {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: rgba(245, 237, 216, 0.5);
        text-decoration: none;
        letter-spacing: 0.05em;
        margin-top: var(--space-3xl);
        display: inline-block;
        transition: color 0.3s ease;
        align-self: flex-start;
    }

    .nav-link:hover {
        color: var(--color-warm-cream);
    }
</style>
