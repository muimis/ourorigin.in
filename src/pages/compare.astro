---
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';
import OrganicMark from '../components/OrganicMark.astro';
---

<Layout title="Compare Marks" description="Compare the geometric and organic origin marks.">
  <div class="compare-container">
    <div class="mark-wrapper">
      <h2 class="compare-title">Geometric (Original)</h2>
      <OriginMark size={160} variant="gold" />
    </div>
    
    <div class="mark-wrapper">
      <h2 class="compare-title">Organic (Tally)</h2>
      <OrganicMark size={160} />
    </div>
  </div>
</Layout>

<style>
  .compare-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    gap: 120px;
    background-color: var(--color-void);
  }

  .mark-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
  }

  .compare-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-warm-cream);
    text-align: center;
    letter-spacing: 0.1em;
  }
</style>
