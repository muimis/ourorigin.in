---
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const origins = await getCollection('origins');
const originMap = Object.fromEntries(origins.map(o => [o.id, o.data]));

// Extract public proof records from products
const proofRecords = products.filter(p => p.data.proofSystem).map(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  const origin = originMap[originId];
  return {
    id: p.id,
    name: p.data.name,
    originName: origin ? origin.name : originId,
    coordinates: origin?.coordinates || 'Western Ghats',
    elevation: origin?.elevation || '',
    batchRef: p.data.batchRef || 'OG-2025',
    firstHands: p.data.proofSystem?.firstHands || 'Native Farming Family',
    directPricePaid: p.data.proofSystem?.directPricePaid || 'Direct premium over market',
    naturesShare: p.data.proofSystem?.naturesShare || 'Canopy preserved · Sun-dried'
  };
});
---

<Layout
  title="The Open Ledger & Proof System — OurOrigin"
  description="Transparent provenance records. Direct prices paid to growers, GPS coordinates, and harvest origin ledgers."
>
  <div class="ledger-page">
    
    <!-- Hero Header -->
    <header class="ledger-hero">
      <div class="container">
        <span class="badge-origin badge-gold">
          <OriginMark size={14} variant="gold" />
          <span>OPEN PROVENANCE LEDGER</span>
        </span>
        <h1 class="ledger-headline font-serif">The Ledger of First Hands</h1>
        <p class="ledger-intro text-muted">
          We believe honesty is a ledger of facts, not marketing adjectives. Every batch is traceable to the exact hill, the named grower family, and the direct price paid.
        </p>
      </div>
    </header>

    <div class="container ledger-content">
      
      <!-- Public Origin Batches Table -->
      <section class="ledger-section">
        <div class="section-title-wrap">
          <h2 class="section-title font-serif">Active Harvest Batches</h2>
          <span class="font-mono text-whisper">WESTERN GHATS LEDGER</span>
        </div>

        <div class="ledger-table-wrap">
          <table class="ledger-table">
            <thead>
              <tr>
                <th class="font-mono">HARVEST</th>
                <th class="font-mono">ORIGIN & ELEVATION</th>
                <th class="font-mono">COORDINATES</th>
                <th class="font-mono">FIRST HANDS</th>
                <th class="font-mono">DIRECT PRICE PAID</th>
              </tr>
            </thead>
            <tbody>
              {proofRecords.map(record => (
                <tr>
                  <td class="td-product">
                    <span class="product-name font-serif">{record.name}</span>
                    <span class="batch-pill font-mono">{record.batchRef}</span>
                  </td>
                  <td class="td-origin">
                    <span class="origin-name">{record.originName}</span>
                    <span class="origin-elev font-mono">{record.elevation}</span>
                  </td>
                  <td class="td-coords font-mono">{record.coordinates}</td>
                  <td class="td-grower font-serif">{record.firstHands}</td>
                  <td class="td-price font-mono text-gold">{record.directPricePaid}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Personal History Section -->
      <section class="personal-ledger-section">
        <div class="section-title-wrap">
          <h2 class="section-title font-serif">Your Order History</h2>
          <span class="font-mono text-whisper">LOCAL DEVICE RECORDS</span>
        </div>

        <div id="personal-ledger-entries" class="personal-ledger-grid">
          <!-- Populated by JS -->
        </div>

        <div id="personal-ledger-empty" class="personal-ledger-empty">
          <p class="font-serif">No local transfer records found on this device.</p>
          <a href="/#harvest" class="btn-secondary btn-sm">Explore Season's Harvest</a>
        </div>
      </section>

    </div>

  </div>
</Layout>

<style>
  .ledger-page {
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .ledger-hero {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-bone-warm) 0%, var(--color-bone) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .ledger-headline {
    font-size: var(--type-display);
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-weight: 350;
  }

  .ledger-intro {
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 680px;
    margin: 0;
  }

  .ledger-content {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .section-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .section-title {
    font-size: var(--type-title);
    margin: 0;
  }

  /* Table */
  .ledger-table-wrap {
    width: 100%;
    overflow-x: auto;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    box-shadow: var(--shadow-subtle);
  }

  .ledger-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 700px;
  }

  .ledger-table th {
    padding: 1rem 1.25rem;
    background-color: var(--color-bone-warm);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-whisper);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .ledger-table td {
    padding: 1.25rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.875rem;
    vertical-align: middle;
  }

  .ledger-table tr:last-child td {
    border-bottom: none;
  }

  .ledger-table tr:hover td {
    background-color: rgba(197, 154, 90, 0.03);
  }

  .td-product {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .product-name {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .batch-pill {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
  }

  .td-origin {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .origin-elev {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
  }

  .td-coords {
    font-size: 0.75rem;
    color: var(--color-ink-muted);
  }

  .td-grower {
    font-size: 0.9375rem;
  }

  .td-price {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* Personal Ledger */
  .personal-ledger-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .personal-ledger-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .personal-ledger-empty {
    padding: 3rem 1.5rem;
    background-color: var(--color-bone-card);
    border: 1px dashed var(--color-border-medium);
    border-radius: 8px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
  }
</style>

<script>
  function initPersonalLedger() {
    const entriesContainer = document.getElementById('personal-ledger-entries');
    const emptyState = document.getElementById('personal-ledger-empty');

    if (!entriesContainer || !emptyState) return;

    let ledger = [];
    try {
      const raw = localStorage.getItem('ourorigin_ledger_v1');
      if (raw) ledger = JSON.parse(raw);
    } catch (e) {}

    if (ledger.length === 0) {
      emptyState.style.display = 'flex';
      entriesContainer.style.display = 'none';
      return;
    }

    emptyState.style.display = 'none';
    entriesContainer.style.display = 'grid';
    entriesContainer.innerHTML = '';

    ledger.forEach((entry: any) => {
      const card = document.createElement('div');
      card.className = 'personal-card';
      card.style.cssText = 'padding: 1.5rem; background: var(--color-bone-card); border: 1px solid var(--color-border-subtle); border-radius: 6px; display: flex; flex-direction: column; gap: 0.75rem;';
      card.innerHTML = `
        <div style="display:flex; justify-content:space-between; font-size:0.75rem; color:var(--color-ink-whisper); font-family:var(--font-mono);">
          <span>${new Date(entry.date || Date.now()).toLocaleDateString('en-IN')}</span>
          <span>${entry.origin || ''}</span>
        </div>
        <h4 style="font-family:var(--font-serif); font-size:1.15rem; margin:0;">${entry.name}</h4>
        <div style="font-size:0.8125rem; color:var(--color-ink-muted);">Quantity: ${entry.quantity || 1} · Size: ${entry.size || ''}</div>
      `;
      entriesContainer.appendChild(card);
    });
  }

  document.addEventListener('DOMContentLoaded', initPersonalLedger);
  document.addEventListener('astro:page-load', initPersonalLedger);
</script>
