---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="OurOrigin — Transfer Ledger"
  description="Your history of transfers."
>
  <main class="ledger-page">
    <div class="ledger-container">
      <header class="ledger-header">
        <h1 class="ledger-title">Your Ledger</h1>
        <p class="ledger-subtitle">The evidentiary record of your transfers.</p>
      </header>

      <div id="ledger-entries" class="ledger-entries">
        <!-- Entries populated by JS -->
      </div>

      <div id="ledger-empty" class="ledger-empty hidden">
        <p class="empty-text">Your ledger is currently blank.</p>
        <a href="/#origins" class="btn-return">Explore the Origins</a>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const entriesContainer = document.getElementById('ledger-entries');
    const emptyState = document.getElementById('ledger-empty');

    if (!entriesContainer || !emptyState) return;

    let ledger = [];
    try {
      const raw = localStorage.getItem('ourorigin_ledger_v1');
      if (raw) ledger = JSON.parse(raw);
    } catch (e) {}

    if (ledger.length === 0) {
      emptyState.classList.remove('hidden');
      return;
    }

    // Sort by date descending
    ledger.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

    let html = '';
    ledger.forEach(entry => {
      const dateObj = new Date(entry.date);
      const dateStr = dateObj.toLocaleDateString('en-IN', {
        year: 'numeric', month: 'short', day: 'numeric'
      });

      html += `
        <div class="ledger-card">
          <div class="ledger-card-header">
            <span class="card-date">${dateStr}</span>
            <span class="card-origin">${entry.origin}</span>
          </div>
          <div class="card-product">
            <h2 class="product-name">${entry.name}</h2>
            <p class="product-size">${entry.quantity} &times; ${entry.size}</p>
          </div>
          <div class="proof-grid">
            <div class="proof-row">
              <span class="proof-label">First Hands</span>
              <span class="proof-value">${entry.firstHands}</span>
            </div>
            <div class="proof-row">
              <span class="proof-label">Direct Price Paid</span>
              <span class="proof-value">${entry.directPricePaid}</span>
            </div>
            <div class="proof-row">
              <span class="proof-label">Nature's Share</span>
              <span class="proof-value">${entry.naturesShare}</span>
            </div>
          </div>
        </div>
      `;
    });

    entriesContainer.innerHTML = html;
  });
</script>

<style>
  .ledger-page {
    min-height: 100vh;
    padding: 120px 5vw 4rem;
    background-color: var(--color-deep-forest);
    color: var(--color-bone);
  }

  .ledger-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .ledger-header {
    margin-bottom: 4rem;
    text-align: center;
    border-bottom: 1px dashed var(--color-border-subtle);
    padding-bottom: 2rem;
  }

  .ledger-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem 0;
  }

  .ledger-subtitle {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-narrative);
    color: var(--color-bone-muted);
    margin: 0;
  }

  .ledger-entries {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .ledger-card {
    background: rgba(12, 21, 9, 0.3);
    border: 1px solid var(--color-proof-green);
    border-radius: 4px;
    padding: 2rem;
    transition: border-color var(--duration-standard) var(--ease-settle);
  }

  .ledger-card:hover {
    border-color: rgba(74, 122, 78, 0.8);
  }

  .ledger-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-bone-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px dashed var(--color-border-subtle);
    padding-bottom: 1rem;
  }

  .card-product {
    margin-bottom: 2rem;
  }

  .product-name {
    font-family: var(--font-display);
    font-size: var(--type-statement);
    margin: 0 0 0.5rem 0;
  }

  .product-size {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-mark-gold);
    margin: 0;
  }

  .proof-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-forest-surface);
    padding: 1.5rem;
  }

  .proof-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px dashed var(--color-border-subtle);
    padding-bottom: 0.8rem;
  }

  .proof-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .proof-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-bone-whisper);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    width: 35%;
  }

  .proof-value {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-proof-green);
    width: 60%;
    text-align: right;
  }

  .ledger-empty {
    text-align: center;
    padding: 4rem 0;
  }

  .empty-text {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-statement);
    color: var(--color-bone-muted);
    margin-bottom: 2rem;
  }

  .btn-return {
    display: inline-block;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-deep-forest);
    background: var(--color-bone);
    padding: 1rem 2rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: var(--radius);
    transition: background var(--duration-standard) var(--ease-settle);
  }

  .btn-return:hover {
    background: var(--color-mark-gold);
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 600px) {
    .proof-row {
      flex-direction: column;
      gap: 0.5rem;
    }
    .proof-label, .proof-value {
      width: 100%;
      text-align: left;
    }
    .ledger-card-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
