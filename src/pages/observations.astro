---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="The Truth — OurOrigin"
  description="Physical facts from the harvest."
  canonicalPath="/observations"
  navVariant="light"
  showFooter={true}
  bodyClass="void-canvas-body"
>
    <main class="story-scroll-container">
        
        <!-- Graphic Transition Element (Vertical Stripe) -->
        <div class="graphic-element" id="obs-transition-stripe">
             <svg viewBox="0 0 100 100" width="100%" height="100%" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                 <path d="M 50 0 Q 55 50 45 100" fill="none" stroke="var(--color-gold)" stroke-width="2" />
             </svg>
        </div>

        <!-- SCENE 1: HEADER -->
        <section class="story-scene" id="obs-scene-1">
            <div class="scene-content">
                <h1 class="indigenous-truth">
                    The Truth.
                </h1>
                <p class="obs-intro">Physical facts recorded in the distance between the forest and the yield.</p>
            </div>
        </section>

        <!-- SCENE 2: OBS 1 -->
        <section class="story-scene" id="obs-scene-2">
            <div class="scene-content obs-content">
                <span class="obs-number">01</span>
                <h2 class="indigenous-truth">
                    The berry was never black.
                </h2>
                <p class="obs-body">Black pepper starts green. The colour change happens entirely after harvest, during sun-drying. The colour you've associated with pepper your entire life is the colour of what happens to the plant after it's picked.</p>
            </div>
        </section>

        <!-- SCENE 3: OBS 2 -->
        <section class="story-scene" id="obs-scene-3">
            <div class="scene-content obs-content">
                <span class="obs-number">02</span>
                <h2 class="indigenous-truth">
                    Shade is a production input.
                </h2>
                <p class="obs-body">Most spice plants are planted in cleared ground. Cardamom is not. It grows under a canopy — deliberately left intact. The tall trees above a cardamom garden are not vestiges of forest. They are part of the cultivation.</p>
            </div>
        </section>

        <!-- SCENE 4: OBS 3 -->
        <section class="story-scene" id="obs-scene-4">
            <div class="scene-content obs-content">
                <span class="obs-number">03</span>
                <h2 class="indigenous-truth">
                    The yield dictates the harvest.
                </h2>
                <p class="obs-body">True forest polyculture does not have a set harvest date. The picker returns to the same plants multiple times, taking only what has ripened since the last visit. The decision of what is ready is made alone, in shade, far from a supervisor.</p>
            </div>
        </section>

    </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Set initial states
  gsap.set("#obs-scene-2 .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#obs-scene-3 .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#obs-scene-4 .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#obs-transition-stripe", { scaleY: 0, transformOrigin: "top center", autoAlpha: 0 });

  // Master Narrative Timeline
  const tl = gsap.timeline({
      scrollTrigger: {
          trigger: ".story-scroll-container",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
      }
  });

  // Scene 1 -> 2
  tl.to("#obs-scene-1 .scene-content", { autoAlpha: 0, y: -50, ease: "power1.inOut" }, 0)
  .to("#obs-transition-stripe", { scaleY: 1, autoAlpha: 1, ease: "power2.inOut" }, 0.1)
  .to("#obs-scene-2 .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.2);

  // Scene 2 -> 3
  tl.to("#obs-scene-2 .scene-content", { autoAlpha: 0, y: -50 }, 0.3)
  .to("#obs-scene-3 .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.4);

  // Scene 3 -> 4
  tl.to("#obs-scene-3 .scene-content", { autoAlpha: 0, y: -50 }, 0.5)
  .to("#obs-scene-4 .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.6)
  .to("#obs-transition-stripe", { scaleY: 0, transformOrigin: "bottom center", ease: "power2.inOut" }, 0.7);

</script>

<style>
    .story-scroll-container {
        position: relative;
        background-color: var(--color-void);
        color: var(--color-warm-cream);
        min-height: 400vh;
    }

    .graphic-element {
        position: fixed;
        pointer-events: none;
        z-index: 5;
        will-change: transform;
    }

    #obs-transition-stripe {
        top: 0;
        left: 50%;
        width: 2px;
        height: 100vh;
        transform: translateX(-50%);
    }

    .story-scene {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .scene-content {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        max-width: 800px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        z-index: 10;
        pointer-events: none;
    }

    .indigenous-truth {
        font-family: var(--font-institutional);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: 0.02em;
        color: var(--color-warm-cream);
        margin: 0 0 1rem 0;
    }

    .obs-intro {
        font-family: var(--font-mono);
        color: var(--color-gold);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-top: 1rem;
    }

    .obs-number {
        font-family: var(--font-mono);
        font-size: 1.5rem;
        color: var(--color-gold);
        margin-bottom: 2rem;
        display: block;
    }

    .obs-body {
        font-family: var(--font-evidence);
        font-size: 1.25rem;
        line-height: 1.6;
        color: rgba(245, 237, 216, 0.8);
        max-width: 600px;
        margin-top: 2rem;
    }
</style>
