---
import Layout from '../layouts/Layout.astro';

// Observations: Real field entries, not generic blog posts
const observations = [
  {
    date: "01 OCT 2026",
    title: "The First Harvest of Attappady",
    body: "The Black Pepper harvest has begun. The density of the peppercorns this year is remarkable — a direct result of the extended dry spell followed by sudden, intense monsoons. The soil retained more moisture than usual, and the vines responded.",
    size: "large"
  },
  {
    date: "15 SEP 2026",
    title: "Sun-drying and Essential Oils",
    body: "Why we insist on ambient sun-drying. Industrial dryers strip away the volatile compounds that give our spices their signature aroma and therapeutic properties. The difference is measurable.",
    size: "medium"
  },
  {
    date: "28 AUG 2026",
    title: "Nilgiris Frost Line",
    body: "The frost line moved 50 metres downhill this January. The tea that grows below it now has a different character — a sharper note in the first flush that wasn't there two years ago.",
    size: "small"
  },
  {
    date: "10 AUG 2026",
    title: "Wayanad Canopy Report",
    body: "The pepper vines in Wayanad grow on living trees. This season the canopy cover was measured at 72% — enough to slow the morning light but not block it. The vines that grew under this specific cover produced berries with 5.8% piperine content.",
    size: "large"
  },
  {
    date: "22 JUL 2026",
    title: "Monsoon Arrival",
    body: "The southwest monsoon arrived 11 days late this year. Every day of delay changes what the harvest will be.",
    size: "small"
  },
  {
    date: "05 JUL 2026",
    title: "Idukki Cardamom Assessment",
    body: "The cardamom in Idukki is entering its flowering cycle. The capsules are forming with good density. The essential oil percentage from last season's yield tested at 6.7% — well above market average of 4%.",
    size: "medium"
  }
];
---

<Layout 
  title="Field Notes — OurOrigin" 
  description="Observations from the forest, the ledger, and the changing seasons."
>
  <main class="observations-page">
    <div class="observations-container">
      
      <div class="page-header" data-reveal="fade">
        <h1 class="page-title">Field Notes</h1>
        <p class="page-subtitle">
          Observations from the forest, the ledger, and the changing seasons. Not marketing. Documentation.
        </p>
      </div>

      <div class="bento-grid" data-reveal="stagger">
        {observations.map((entry) => (
          <div class={`bento-tile bento-tile--${entry.size}`}>
            <span class="tile-date">{entry.date}</span>
            <h2 class="tile-title">{entry.title}</h2>
            <p class="tile-body">{entry.body}</p>
          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>

<style>
  .observations-page {
    min-height: 100vh;
    background-color: var(--color-void);
    background-image: radial-gradient(circle at center top, rgba(198, 156, 82, 0.05) 0%, transparent 60%);
    color: var(--color-warm-cream);
    padding: 0 var(--space-xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }
  
  .observations-page::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: url('/noise.png') repeat;
    opacity: 0.03;
    pointer-events: none;
    z-index: 0;
  }

  .observations-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding-top: var(--space-4xl);
  }

  .page-header {
    margin-bottom: var(--space-4xl);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 400;
    margin: 0 0 var(--space-lg) 0;
    letter-spacing: 0.03em;
  }

  .page-subtitle {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    color: rgba(245, 240, 232, 0.6);
    margin: 0;
    max-width: 600px;
    line-height: var(--line-height-loose);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .bento-tile {
    padding: var(--space-2xl);
    background: rgba(245, 240, 232, 0.02);
    border: 1px solid rgba(198, 156, 82, 0.1);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .bento-tile:hover {
    border-color: rgba(198, 156, 82, 0.3);
    background: rgba(245, 240, 232, 0.04);
    transform: translateY(-2px);
  }

  /* Size variations */
  .bento-tile--large {
    grid-column: span 2;
  }

  .bento-tile--small .tile-body {
    font-size: var(--type-evidence);
    line-height: var(--line-height-base);
  }

  .tile-date {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.1em;
    color: rgba(245, 240, 232, 0.35);
    text-transform: uppercase;
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    line-height: 1.2;
  }

  .tile-body {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    color: rgba(245, 240, 232, 0.65);
    line-height: var(--line-height-loose);
    margin: 0;
  }

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
    }

    .bento-tile--large {
      grid-column: span 1;
    }

    .observations-page {
      padding: 0 var(--space-lg) var(--space-3xl);
    }
  }
</style>
