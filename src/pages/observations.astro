---
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';

const observations = [
  {
    date: "01 OCT 2026",
    origin: "Attappady · 750m",
    title: "The First Harvest of Attappady",
    body: "The native millet harvest has begun. The density of the grains this year is remarkable — a direct result of the extended dry spell followed by sudden, intense monsoons. The soil retained more moisture than usual, and the crop responded.",
    author: "Field Dispatch"
  },
  {
    date: "15 SEP 2026",
    origin: "Wayanad · 1,100m",
    title: "Sun-drying and Essential Oils",
    body: "Why we insist on ambient sun-drying on natural mats. Industrial dryers strip away the volatile compounds that give spices their signature aroma and therapeutic properties. The difference is immediately apparent in the volatile oil test.",
    author: "Terroir Note"
  },
  {
    date: "28 AUG 2026",
    origin: "The Nilgiris · 2,600m",
    title: "The Shola Frost Line",
    body: "The frost line moved 50 metres downhill this winter. The tea that grows below it now has a different character — a sharper citrus note in the first flush that wasn't there two years ago.",
    author: "Grower Observation"
  },
  {
    date: "10 AUG 2026",
    origin: "Wayanad · 1,100m",
    title: "Canopy Shade Cover Report",
    body: "The pepper vines in Wayanad climb living native trees. This season the canopy cover was measured at 72% — enough to filter the morning light without starving the vine. The berries tested at 5.8% natural piperine content.",
    author: "Ecology Record"
  },
  {
    date: "22 JUL 2026",
    origin: "Western Ghats",
    title: "Southwest Monsoon Arrival",
    body: "The southwest monsoon arrived 11 days late this year. In conventional agriculture that is a crisis; in a natural biodiverse forest canopy, the root systems hold the groundwater and balance the cycle naturally.",
    author: "Weather Ledger"
  },
  {
    date: "05 JUL 2026",
    origin: "Idukki · 1,200m",
    title: "Idukki Cardamom Assessment",
    body: "The wild cardamom in Idukki is entering its flowering cycle. The capsules are forming with high oil density. The essential oil percentage from last season's yield tested at 6.7% — well above the commercial average of 4%.",
    author: "Harvest Report"
  }
];
---

<Layout 
  title="Field Notes & Dispatches — OurOrigin" 
  description="Observations from the forest, the ledger, and the changing seasons."
>
  <div class="observations-page">
    
    <!-- Hero Header -->
    <header class="obs-hero">
      <div class="container">
        <span class="badge-origin badge-gold">
          <OriginMark size={14} variant="gold" />
          <span>WESTERN GHATS DISPATCHES</span>
        </span>
        <h1 class="obs-headline font-serif">Field Notes & Observations</h1>
        <p class="obs-intro text-muted">
          Observations from the forest canopy, the drying mats, and the changing seasons. Documentation, not advertising.
        </p>
      </div>
    </header>

    <!-- Dispatches Grid -->
    <div class="container obs-grid">
      {observations.map((entry) => (
        <article class="obs-card">
          <div class="obs-meta">
            <span class="obs-date font-mono">{entry.date}</span>
            <span class="obs-origin font-mono">{entry.origin}</span>
          </div>

          <h2 class="obs-title font-serif">{entry.title}</h2>
          <p class="obs-body text-muted">{entry.body}</p>

          <div class="obs-footer">
            <span class="obs-author font-mono">{entry.author}</span>
            <span class="obs-mark font-mono text-gold">VERIFIED · FIRST HANDS</span>
          </div>
        </article>
      ))}
    </div>

  </div>
</Layout>

<style>
  .observations-page {
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .obs-hero {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 4vw, 3.5rem);
    background: linear-gradient(180deg, var(--color-bone-warm) 0%, var(--color-bone) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .obs-headline {
    font-size: var(--type-display);
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-weight: 350;
  }

  .obs-intro {
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 640px;
    margin: 0;
  }

  .obs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .obs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1040px) {
    .obs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .obs-card {
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth);
  }

  .obs-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-medium);
  }

  .obs-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
  }

  .obs-origin {
    color: var(--color-mark-gold);
  }

  .obs-title {
    font-size: 1.35rem;
    font-weight: 450;
    margin: 0;
    line-height: 1.3;
    color: var(--color-deep-forest);
  }

  .obs-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
    flex-grow: 1;
  }

  .obs-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
    font-size: 0.6875rem;
  }

  .obs-author {
    color: var(--color-ink-muted);
  }
</style>
