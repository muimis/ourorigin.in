---
import Layout from '../layouts/Layout.astro';
import { EMAIL_ADDRESS, FSSAI_NUMBER } from '../utils/constants';
---

<Layout
  title="Terms of Trade — OurOrigin"
  description="Terms governing orders, seasonal harvests, and direct fulfillment from OurOrigin."
>
  <div class="legal-page">
    <div class="container-narrow">
      <header class="legal-header">
        <span class="badge-origin badge-gold">LEGAL</span>
        <h1 class="legal-title font-serif">Terms of Trade</h1>
        <p class="legal-meta font-mono">Effective: 2026 · Ethical Direct Trade</p>
      </header>

      <div class="legal-content">
        <section class="legal-block">
          <h2 class="font-serif">01 · Seasonal Direct Trade</h2>
          <p>
            OurOrigin operates as an ethical conduit between native farming families in the Western Ghats and conscious consumers. All yields are genuine single-origin harvests. Because our products are forest-canopy grown and unblended, natural seasonal variations in aroma, color, and density are authentic hallmarks of quality.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">02 · Order Inquiries & Availability</h2>
          <p>
            Because harvests are gathered in finite seasonal batches, checkout requests initialized on this website represent direct order reservations confirmed manually with our team on WhatsApp before dispatch.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">03 · Dispatch & Delivery</h2>
          <p>
            Orders are carefully packed at origin and dispatched from Thiruvananthapuram, Kerala, within 2 to 3 business days of payment confirmation.
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">04 · Compliance & Standards</h2>
          <p>
            Our operations comply with local food safety standards under the Food Safety and Standards Authority of India (FSSAI Reg. No. {FSSAI_NUMBER}).
          </p>
        </section>

        <section class="legal-block">
          <h2 class="font-serif">05 · Contact & Bulk Orders</h2>
          <p>
            For institutional, restaurant, or bulk harvest inquiries (above 25kg), contact us directly at <a href={`mailto:${EMAIL_ADDRESS}`} class="text-gold">{EMAIL_ADDRESS}</a>.
          </p>
        </section>

        <div class="legal-footer">
          <a href="/" class="btn-secondary btn-sm">← Return to Home</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bone);
  }

  .legal-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: 2.5rem;
  }

  .legal-title {
    font-size: var(--type-display);
    margin: 0;
  }

  .legal-meta {
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .legal-block h2 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .legal-block p {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .legal-footer {
    padding-top: 1.5rem;
  }

  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.8125rem;
  }
</style>
