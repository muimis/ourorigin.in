---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Why This Exists — OurOrigin" 
  description="OurOrigin is a proof system. Not a spice company. Not a supply chain. A proof system."
  noHeaderPadding={true}
>
  <main class="manifesto-viewport">
    
    <div class="manifesto-bg"></div>

    <div class="manifesto-track" id="manifesto-track">
      
      <!-- Beat 1 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h1 class="massive-statement">We are not a spice company.</h1>
        </div>
      </section>

      <!-- Beat 2 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">We are a proof system.</h2>
          <p class="qualifier-text">Proving that something real happened between a place and the person who understood it.</p>
        </div>
      </section>

      <!-- Beat 3 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">The forest is distant.</h2>
          <p class="qualifier-text">The hands that grow the world's most exceptional yields are the ones farthest from its reward. We exist to collapse that distance.</p>
        </div>
      </section>

      <!-- Beat 4 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">Not a supply chain.</h2>
          <p class="qualifier-text">A transfer of dignity, directly from the soil to you.</p>
        </div>
      </section>

      <!-- Beat 5: Dimensions -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="blur-in">
          <div class="dimension-grid">
            <span>Geography</span>
            <span>Biology</span>
            <span>Community</span>
            <span>Method</span>
            <span>Observation</span>
            <span>Time</span>
            <span>Product</span>
          </div>
          <p class="qualifier-text text-center">Seven dimensions. Each one verified. Each one traceable. Together, they are the definition of an origin.</p>
        </div>
      </section>

      <!-- Beat 6: Closer -->
      <section class="manifesto-beat beat-closer">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">The origin remains the protagonist.</h2>
          <p class="closer-text">Always.</p>
          <a href="/" class="return-link">← Return to Origins</a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initManifesto() {
    const scaleElements = document.querySelectorAll('[data-cinematic="scale-down"]');
    
    scaleElements.forEach((el) => {
      // Create a cinematic effect where the text starts massive and blurred,
      // and as you scroll it scales down, comes into focus, and then fades out as you leave.
      gsap.fromTo(el,
        {
          scale: 1.8,
          opacity: 0,
          filter: 'blur(20px)'
        },
        {
          scale: 1,
          opacity: 1,
          filter: 'blur(0px)',
          duration: 1.5,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            end: "center center",
            scrub: 1, // Smooth scrubbing
          }
        }
      );

      // Fade out on scroll past
      gsap.to(el, {
        opacity: 0,
        filter: 'blur(10px)',
        y: -100,
        scrollTrigger: {
          trigger: el,
          start: "center center",
          end: "bottom top",
          scrub: 1
        }
      });
    });

    const blurElements = document.querySelectorAll('[data-cinematic="blur-in"]');
    blurElements.forEach(el => {
      gsap.fromTo(el,
        { opacity: 0, filter: 'blur(10px)', y: 50 },
        {
          opacity: 1, filter: 'blur(0px)', y: 0,
          scrollTrigger: {
            trigger: el,
            start: "top 70%",
            end: "center center",
            scrub: 1
          }
        }
      );
    });
  }

  // Initialize on load and view transitions
  initManifesto();
  document.addEventListener('astro:after-swap', initManifesto);
</script>

<style>
  .manifesto-viewport {
    background-color: var(--color-void);
    color: var(--color-warm-cream);
    position: relative;
    overflow: hidden;
  }

  .manifesto-bg {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, rgba(12, 21, 9, 0.4) 0%, var(--color-void) 100%);
    z-index: 0;
  }

  .manifesto-track {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .manifesto-beat {
    min-height: 120vh; /* Extra height to allow for long scrolling */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .beat-content {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    will-change: transform, opacity, filter;
  }

  .massive-statement {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7rem);
    line-height: 1;
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .qualifier-text {
    font-family: var(--font-narrative);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    color: rgba(245, 240, 232, 0.7);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }

  .closer-text {
    font-family: var(--font-narrative);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-style: italic;
    color: var(--color-gold);
    margin: 0;
  }

  .dimension-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    justify-content: center;
    margin-bottom: var(--space-xl);
  }

  .dimension-grid span {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    padding: var(--space-md) var(--space-xl);
    border: 1px solid rgba(198, 156, 82, 0.3);
  }

  .text-center {
    text-align: center;
  }

  .beat-closer {
    min-height: 100vh;
  }

  .return-link {
    margin-top: 15vh;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(245, 240, 232, 0.4);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .return-link:hover {
    color: var(--color-gold);
  }
</style>
