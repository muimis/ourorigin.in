---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="The Record — OurOrigin"
  description="We know the person who grew this. We know the hill it came from. We know what the soil looks like in January."
  noHeaderPadding={true}
>
  <main class="manifesto-viewport">

    <div class="manifesto-track">

      <!-- Beat 1 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h1 class="massive-statement">We know the person<br/>who grew this.</h1>
        </div>
      </section>

      <!-- Beat 2 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">We know the hill<br/>it came from.</h2>
          <p class="qualifier-text">11°36′N, 76°04′E — not a region. A place.</p>
        </div>
      </section>

      <!-- Beat 3 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">That is not normal.</h2>
          <p class="qualifier-text">A product usually passes through six hands before yours.<br/>Each one trims a little more of the story down to a price.</p>
        </div>
      </section>

      <!-- Beat 4 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">By the time it reaches you,<br/>the soil is gone.</h2>
          <p class="qualifier-text">The name is gone. The season is gone.<br/>What remains is just inventory.</p>
        </div>
      </section>

      <!-- Beat 5 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">First Hands.</h2>
          <p class="qualifier-text">The person who grew this was the first person to handle it for money.<br/>No broker before them. Their count is the first count.</p>
          <p class="qualifier-text tally-note" aria-hidden="true">That is why the mark is a tally gate.</p>
        </div>
      </section>

      <!-- Beat 6: Closer -->
      <section class="manifesto-beat beat-closer">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">We are not a brand.</h2>
          <p class="closer-text">We are a ledger.</p>
          <a href="/" class="return-link">← Return to the Archive</a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initManifesto() {
    document.querySelectorAll('[data-cinematic="scale-down"]').forEach((el) => {
      gsap.fromTo(el,
        { scale: 1.12, opacity: 0, filter: 'blur(16px)' },
        {
          scale: 1, opacity: 1, filter: 'blur(0px)',
          duration: 1.2, ease: 'power2.out',
          scrollTrigger: {
            trigger: el, start: 'top 80%', end: 'center center', scrub: 0.8,
          }
        }
      );
      gsap.to(el, {
        opacity: 0, filter: 'blur(8px)', scale: 0.94,
        scrollTrigger: {
          trigger: el, start: 'center center', end: 'bottom top', scrub: 0.8
        }
      });
    });
  }

  initManifesto();
  document.addEventListener('astro:after-swap', initManifesto);
</script>

<style>
  .manifesto-viewport {
    background-color: var(--color-void);
    color: var(--color-warm-cream);
    position: relative;
    overflow: hidden;
  }

  .manifesto-track {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .manifesto-beat {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) clamp(1.5rem, 6vw, 5rem);
    text-align: center;
  }

  .beat-content {
    max-width: 900px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    will-change: transform, opacity, filter;
  }

  .massive-statement {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 5rem);
    line-height: 1.1;
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .qualifier-text {
    font-family: var(--font-narrative);
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    color: rgba(240, 234, 214, 0.5);
    line-height: 1.7;
    max-width: 580px;
    margin: 0;
    font-weight: 300;
  }

  .tally-note {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(255, 69, 0, 0.45);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-top: var(--space-sm);
  }

  .closer-text {
    font-family: var(--font-narrative);
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    font-style: italic;
    color: var(--color-gold);
    margin: 0;
  }

  .beat-closer {
    min-height: 100vh;
  }

  .return-link {
    margin-top: 12vh;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(240, 234, 214, 0.3);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: color var(--duration-standard) var(--ease-settle);
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
  }

  .return-link:hover {
    color: var(--color-gold);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .manifesto-beat {
      min-height: 90vh;
      padding: var(--space-3xl) var(--space-lg);
    }

    .massive-statement {
      font-size: clamp(1.8rem, 8vw, 3.5rem);
    }

    .qualifier-text {
      font-size: clamp(0.95rem, 4vw, 1.2rem);
    }

    .return-link {
      margin-top: 8vh;
    }
  }
</style>
