---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="The Ledger of Truth — OurOrigin" 
  description="We believe there is an invisible, profound exchange of dignity between the earth and the people who truly understand it."
  noHeaderPadding={true}
>
  <main class="manifesto-viewport">
    
    <div class="manifesto-bg"></div>

    <div class="manifesto-track" id="manifesto-track">
      
      <!-- Beat 1 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h1 class="massive-statement">The modern world takes without asking.</h1>
        </div>
      </section>

      <!-- Beat 2 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">It strips the context.<br/>It erases the hands.<br/>It silences the soil.</h2>
          <p class="qualifier-text">What remains is just inventory. Empty of memory.</p>
        </div>
      </section>

      <!-- Beat 3 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">OurOrigin exists to refuse this.</h2>
        </div>
      </section>

      <!-- Beat 4 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">We believe there is an invisible, profound exchange of dignity...</h2>
          <p class="qualifier-text">...between the earth and the people who truly understand it.</p>
        </div>
      </section>

      <!-- Beat 5 -->
      <section class="manifesto-beat">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">When you hold one of our yields, you are holding the physical proof of that dignity.</h2>
        </div>
      </section>

      <!-- Beat 6: Closer -->
      <section class="manifesto-beat beat-closer">
        <div class="beat-content" data-cinematic="scale-down">
          <h2 class="massive-statement">We are not a company.</h2>
          <p class="closer-text">We are a ledger of truth.</p>
          <a href="/" class="return-link">← Return to the Yields</a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initManifesto() {
    const scaleElements = document.querySelectorAll('[data-cinematic="scale-down"]');
    
    scaleElements.forEach((el) => {
      gsap.fromTo(el,
        {
          scale: 1.2,
          opacity: 0,
          filter: 'blur(20px)'
        },
        {
          scale: 1,
          opacity: 1,
          filter: 'blur(0px)',
          duration: 1.5,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 80%",
            end: "center center",
            scrub: 1,
          }
        }
      );

      // Fade out on scroll past
      gsap.to(el, {
        opacity: 0,
        filter: 'blur(10px)',
        scale: 0.9,
        scrollTrigger: {
          trigger: el,
          start: "center center",
          end: "bottom top",
          scrub: 1
        }
      });
    });
  }

  // Initialize on load and view transitions
  initManifesto();
  document.addEventListener('astro:after-swap', initManifesto);
</script>

<style>
  .manifesto-viewport {
    background-color: var(--color-void);
    color: var(--color-warm-cream);
    position: relative;
    overflow: hidden;
  }

  .manifesto-bg {
    position: fixed;
    inset: 0;
    background: radial-gradient(circle at center, rgba(12, 21, 9, 0.4) 0%, var(--color-void) 100%);
    z-index: 0;
  }

  .manifesto-track {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  .manifesto-beat {
    min-height: 120vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) clamp(2rem, 5vw, 4rem);
    text-align: center;
  }

  .beat-content {
    max-width: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    will-change: transform, opacity, filter;
  }

  .massive-statement {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 1.1;
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .qualifier-text {
    font-family: var(--font-narrative);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    color: rgba(245, 240, 232, 0.7);
    line-height: 1.6;
    max-width: 600px;
    margin: 0;
  }

  .closer-text {
    font-family: var(--font-narrative);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-style: italic;
    color: var(--color-gold);
    margin: 0;
  }

  .beat-closer {
    min-height: 100vh;
  }

  .return-link {
    margin-top: 15vh;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(245, 240, 232, 0.4);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .return-link:hover {
    color: var(--color-gold);
  }
</style>
