---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import CipherGlyphs from '../components/CipherGlyphs.astro';
import OriginMark from '../components/OriginMark.astro';

// Load content
const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

// Active products (exclude Malabar Coast items if any, and filter out ones without sizes)
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});

// The narrative beats
const dimensions = [
  { dim: 'method', statement: 'The yield was shaped by the method. Sun-dried. Hand-sorted. Zero synthetics.' },
  { dim: 'community', statement: 'The method requires a community. First Hands, fluent in the soil.' },
  { dim: 'time', statement: 'The community submits to time. The monsoon decides. We wait.' },
  { dim: 'bio', statement: 'Time answers to biology. An ancient canopy, breathing for millennia.' },
  { dim: 'geo', statement: 'Biology is anchored by geography. The deep, violent slopes of the Western Ghats.' },
];
---

<Layout 
  title="OurOrigin — The Proof System" 
  description="Single-origin yields from the Western Ghats, ethically sourced by the First Hands. A proof system for indigenous food."
  noHeaderPadding={true}
>

  <!-- ACT I: The Hook -->
  <section class="the-hook">
    <div class="hook-visual">
      {activeProducts[0] && activeProducts[0].data.images?.product ? (
        <img src={activeProducts[0].data.images.product} alt="Our Yield" loading="eager" class="hook-image" />
      ) : (
        <div class="hook-placeholder"><OriginMark size={60} variant="gold" /></div>
      )}
    </div>
    <div class="hook-overlay"></div>
    <div class="hook-content">
      <h1 class="hook-title">You are not looking at a spice.</h1>
      <p class="hook-subtitle">You are looking at the cross-section of an entire ecosystem.</p>
      <div class="scroll-indicator">
        <span class="scroll-line"></span>
        <span class="scroll-text">Unpack the Origin</span>
      </div>
    </div>
  </section>

  <!-- ACT II & III: Unpacking the Origin -->
  <section class="opening-sequence" id="opening-sequence" aria-label="The unpacking of an origin">
    <div class="progress-bar" id="sequence-progress" aria-hidden="true">
      {dimensions.map((_, i) => (
        <div class="progress-segment" data-index={i}></div>
      ))}
      <div class="progress-segment" data-index="resolution"></div>
    </div>

    <div class="beats-viewport" id="beats-viewport">
      {dimensions.map((d, i) => (
        <div class="beat" data-beat={i} data-dim={d.dim}>
          <div class="beat-glyph">
            <CipherGlyphs dim={d.dim as any} size={120} />
          </div>
          <p class="beat-statement">
            {d.statement.split(' ').map((word, wi) => (
              <span class="beat-word" style={`--word-delay: ${wi * 60}ms`}>{word} </span>
            ))}
          </p>
          <span class="beat-marker" aria-hidden="true">·</span>
        </div>
      ))}

      <!-- Resolution Beat (Climax & Proof System) -->
      <div class="beat beat--resolution" data-beat="resolution">
        <div class="resolution-glyphs">
          {dimensions.map(d => (
            <CipherGlyphs dim={d.dim as any} size={28} active={true} />
          ))}
          <CipherGlyphs dim="product" size={28} active={true} />
        </div>
        <p class="resolution-statement">Origin is not a pin on a map.</p>
        <p class="resolution-climax">It is a fragile convergence. Compromise one element, and the system shatters.</p>
        <div class="resolution-divider"></div>
        <p class="resolution-promise">We are not merchants. We are a proof system.</p>
        <p class="resolution-promise-final">The yield in your hand is the evidence. If it doesn't prove the origin, it is nothing.</p>
      </div>
    </div>
  </section>

  <!-- ACT IV: The Yields -->
  <section class="the-yields" id="the-yields" aria-label="The Active Yields">
    <div class="yields-header">
      <h2 class="yields-title" data-reveal="fade">The Yields</h2>
      <p class="yields-subtitle" data-reveal="fade">The physical proof that survived the system this season.</p>
    </div>

    <div class="yields-grid">
      {activeProducts.map(product => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const originObj = allOrigins.find(o => o.id === originId);
        const originName = originObj ? originObj.data.name : originId;

        return (
          <div class="product-card" data-reveal="up">
            <a href={`/origins/${originId}/${product.id}`} class="product-card-link">
              <div class="product-card-image">
                {product.data.images?.product ? (
                  <img 
                    src={product.data.images.product} 
                    alt={product.data.name} 
                    loading="lazy" 
                  />
                ) : product.data.images?.packaging ? (
                  <img 
                    src={product.data.images.packaging} 
                    alt={product.data.name} 
                    loading="lazy" 
                  />
                ) : (
                  <div class="product-card-placeholder">
                    <OriginMark size={24} variant="gold" />
                  </div>
                )}
              </div>
              <div class="product-card-content">
                <div class="product-card-meta">
                  <span class="product-origin">{originName}</span>
                </div>
                <h3 class="product-card-name">{product.data.name}</h3>
                <div class="product-card-price">
                  ₹{product.data.sizes[0]?.priceINR} <span class="product-card-size">/ {product.data.sizes[0]?.label}</span>
                </div>
              </div>
            </a>
            <div class="product-card-actions">
              <button 
                class="btn-add-quick add-to-ledger-btn" 
                type="button"
                data-product={JSON.stringify({
                  id: product.id + '-' + product.data.sizes[0]?.label,
                  productId: product.id,
                  name: product.data.name,
                  origin: originName,
                  originId: originId,
                  size: product.data.sizes[0]?.label,
                  price: product.data.sizes[0]?.priceINR,
                  quantity: 1
                })}
              >
                Honor the Decision
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ACT V: The Walk -->
  <section class="the-walk" aria-label="The walk">
    <div class="walk-bg" style="background-image: url('/images/prefooter.webp')"></div>
    <div class="walk-overlay"></div>
    <div class="walk-content" data-reveal="fade">
      <p class="walk-statement">
        The origin doesn't end at the farm gate. It extends to where the road begins, and continues to where you're reading this now.
      </p>
      <a href="/about" class="walk-link">Read the manifesto →</a>
    </div>
  </section>
</Layout>

<style>
  /* ════════════════════════════════════════════════════════════
     ACT I: THE HOOK
     ════════════════════════════════════════════════════════════ */
  .the-hook {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: var(--color-void);
    overflow: hidden;
  }

  .hook-visual {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    opacity: 0.6;
  }

  .hook-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%) contrast(1.1);
    transform-origin: center;
    animation: slowBreathing 20s ease-in-out infinite alternate;
  }

  @keyframes slowBreathing {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }

  .hook-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .hook-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(5,8,4,0.3) 0%, rgba(5,8,4,0.8) 70%, var(--color-forest-deep) 100%);
    z-index: 2;
  }

  .hook-content {
    position: relative;
    z-index: 3;
    padding: var(--space-2xl);
    max-width: 800px;
    margin-top: auto;
    margin-bottom: 15vh;
  }

  .hook-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-md) 0;
    line-height: 1.1;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .hook-subtitle {
    font-family: var(--font-narrative);
    font-size: var(--type-statement);
    color: rgba(245, 240, 232, 0.9);
    font-style: italic;
    margin: 0;
    line-height: 1.4;
  }

  .scroll-indicator {
    position: absolute;
    bottom: -10vh;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--color-gold) 0%, transparent 100%);
    animation: scrollLine 2s infinite ease-in-out;
  }

  .scroll-text {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  @keyframes scrollLine {
    0% { transform: scaleY(0); transform-origin: top; opacity: 0; }
    50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
    50.1% { transform: scaleY(1); transform-origin: bottom; opacity: 1; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* ════════════════════════════════════════════════════════════
     ACT II & III: OPENING SEQUENCE (THE UNPACKING)
     ════════════════════════════════════════════════════════════ */
  .opening-sequence {
    position: relative;
    min-height: 100vh;
    background-color: var(--color-forest-deep);
    overflow: hidden;
  }

  .progress-bar {
    position: fixed;
    top: var(--space-xl);
    left: var(--space-xl);
    right: var(--space-xl);
    height: 3px;
    display: flex;
    gap: 4px;
    z-index: 100;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease-settle);
  }

  .progress-bar.is-visible {
    opacity: 1;
  }

  .progress-segment {
    flex: 1;
    background: rgba(245, 240, 232, 0.15);
    transition: background var(--duration-standard) var(--ease-settle);
  }

  .progress-segment.is-filled {
    background: var(--color-gold);
  }

  .beats-viewport {
    position: relative;
    width: 100%;
  }

  .beat {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-4xl) var(--space-xl);
    opacity: 0;
    transition: opacity var(--duration-cinematic) var(--ease-settle);
  }

  .beat.is-active {
    opacity: 1;
  }

  .beat-glyph {
    margin-bottom: var(--space-3xl);
  }

  .beat-statement {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-statement);
    font-weight: 300;
    line-height: 1.3;
    color: var(--color-warm-cream);
    max-width: 600px;
    margin: 0;
  }

  .beat-word {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    transform: translateY(12px);
    transition: opacity 0.8s var(--ease-settle), transform 0.8s var(--ease-settle), filter 0.8s var(--ease-settle);
    transition-delay: var(--word-delay);
  }

  .beat.is-active .beat-word {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  .beat-marker {
    margin-top: var(--space-3xl);
    font-size: 11px;
    color: var(--color-warm-cream);
    opacity: 0.3;
  }

  .beat--resolution {
    padding-bottom: 20vh;
  }

  .resolution-glyphs {
    display: flex;
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
    justify-content: center;
    flex-wrap: wrap;
  }

  .resolution-statement {
    font-family: var(--font-narrative);
    font-size: var(--type-display);
    font-weight: 300;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-md) 0;
  }

  .resolution-climax {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-statement);
    color: rgba(245, 240, 232, 0.8);
    margin: 0 0 var(--space-2xl) 0;
    max-width: 600px;
  }

  .resolution-divider {
    width: 40px;
    height: 1px;
    background: var(--color-gold);
    margin: 0 auto var(--space-2xl);
  }

  .resolution-promise {
    font-family: var(--font-evidence);
    font-size: var(--type-narrative);
    color: var(--color-warm-cream);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    max-width: 700px;
    margin: 0 0 var(--space-lg) 0;
    line-height: 1.6;
  }

  .resolution-promise-final {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    letter-spacing: 0.1em;
    margin: 0;
  }


  /* ════════════════════════════════════════════════════════════
     ACT IV: THE YIELDS
     ════════════════════════════════════════════════════════════ */
  .the-yields {
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-forest-deep);
    min-height: 100vh;
  }

  .yields-header {
    text-align: center;
    margin-bottom: var(--space-4xl);
  }

  .yields-title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-lg) 0;
    letter-spacing: 0.05em;
  }

  .yields-subtitle {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    color: rgba(245, 240, 232, 0.7);
    max-width: 540px;
    margin: 0 auto;
    line-height: var(--line-height-loose);
  }

  .yields-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid rgba(198, 156, 82, 0.1);
    background: rgba(245, 240, 232, 0.01);
    transition: transform var(--duration-standard) var(--ease-settle),
                border-color var(--duration-standard) var(--ease-settle);
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(198, 156, 82, 0.3);
  }

  .product-card-link {
    text-decoration: none;
    color: inherit;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .product-card-image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(245, 240, 232, 0.03);
    border-bottom: 1px solid rgba(245, 240, 232, 0.05);
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-xl);
    filter: grayscale(20%) brightness(0.9);
    transition: filter var(--duration-standard) var(--ease-settle),
                transform var(--duration-slow) var(--ease-settle);
  }

  .product-card:hover .product-card-image img {
    filter: grayscale(0%) brightness(1);
    transform: scale(1.05);
  }

  .product-card-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .product-card-content {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex-grow: 1;
  }

  .product-card-meta {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .product-card-name {
    font-family: var(--font-display);
    font-size: var(--type-statement);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    line-height: 1.2;
  }

  .product-card-price {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-warm-cream);
    margin-top: auto;
  }

  .product-card-size {
    color: rgba(245, 240, 232, 0.5);
  }

  .product-card-actions {
    padding: 0 var(--space-xl) var(--space-xl);
  }

  .btn-add-quick {
    width: 100%;
    padding: var(--space-md) var(--space-lg);
    background: transparent;
    border: 1px solid rgba(198, 156, 82, 0.4);
    color: var(--color-gold);
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .btn-add-quick:hover {
    background: rgba(198, 156, 82, 0.15);
    border-color: var(--color-gold);
  }

  /* ════════════════════════════════════════════════════════════
     ACT V: THE WALK
     ════════════════════════════════════════════════════════════ */
  .the-walk {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .walk-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(40%) brightness(0.35);
  }

  .walk-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-forest-deep) 0%, transparent 40%, transparent 60%, var(--color-void) 100%);
  }

  .walk-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 600px;
    padding: var(--space-4xl) var(--space-xl);
  }

  .walk-statement {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-statement);
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-3xl) 0;
  }

  .walk-link {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity var(--duration-standard) var(--ease-settle);
  }

  .walk-link:hover {
    opacity: 0.7;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initOpeningSequence() {
    const sequence = document.getElementById('opening-sequence');
    const viewport = document.getElementById('beats-viewport');
    const beats = document.querySelectorAll('.beat');
    const progressBar = document.getElementById('sequence-progress');
    const progressSegments = document.querySelectorAll('.progress-segment');

    if (!sequence || !viewport || beats.length === 0) return;

    // Pin the viewport while scrolling through the beats
    ScrollTrigger.create({
      trigger: sequence,
      start: "top top",
      end: `+=${beats.length * 100}%`,
      pin: viewport,
      pinSpacing: true,
      onEnter: () => progressBar?.classList.add('is-visible'),
      onLeaveBack: () => progressBar?.classList.remove('is-visible'),
      onLeave: () => progressBar?.classList.remove('is-visible'),
      onEnterBack: () => progressBar?.classList.add('is-visible'),
      onUpdate: (self) => {
        // Calculate which beat is active
        const progress = self.progress;
        const totalBeats = beats.length;
        const activeIndex = Math.min(
          Math.floor(progress * totalBeats),
          totalBeats - 1
        );

        // Update beats
        beats.forEach((beat, i) => {
          if (i === activeIndex) {
            beat.classList.add('is-active');
            // reset transform for scrolling effect
            gsap.set(beat, { y: 0 });
          } else if (i < activeIndex) {
            beat.classList.remove('is-active');
            // move up out of view
            gsap.set(beat, { y: -100 });
          } else {
            beat.classList.remove('is-active');
            // stay down
            gsap.set(beat, { y: 100 });
          }
        });

        // Update progress bar
        progressSegments.forEach((seg, i) => {
          if (i <= activeIndex) {
            seg.classList.add('is-filled');
          } else {
            seg.classList.remove('is-filled');
          }
        });
      }
    });

    // Simple reveal animations for other sections
    const reveals = document.querySelectorAll('[data-reveal]');
    reveals.forEach(el => {
      const type = el.getAttribute('data-reveal');
      
      gsap.fromTo(el, 
        { 
          y: type === 'up' ? 30 : 0,
          opacity: 0 
        },
        {
          y: 0,
          opacity: 1,
          duration: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
          }
        }
      );
    });
  }

  // Initialize on load and view transitions
  initOpeningSequence();
  document.addEventListener('astro:after-swap', initOpeningSequence);
</script>
