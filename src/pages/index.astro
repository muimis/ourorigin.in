---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';

// Load content
const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

// Active products only
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});

// Build origin lookup for coordinate display
const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));
---

<Layout
  title="OurOrigin — Single-Origin Yields from the Western Ghats"
  description="Direct from the first hands. Single-origin spices, millets and teas from indigenous farming communities of the Western Ghats."
  noHeaderPadding={true}
>

  <!-- Coordinate datum — updates on row hover -->
  <div class="coord-datum" id="coord-datum" aria-live="polite">
    <span class="coord-dot"></span>
    <span class="coord-text" id="coord-text">WESTERN GHATS · FIRST HANDS · DIRECT</span>
  </div>

  <!-- THE ARCHIVE -->
  <section class="the-archive" id="the-yields" aria-label="The Registry">

    <div class="archive-header" aria-hidden="true">
      <!-- Tally gate as index marker -->
      <div class="archive-label archive-label--mark">
        <OriginMark size={18} variant="gold" />
      </div>
      <span class="archive-label">ORIGIN</span>
      <span class="archive-label">YIELD</span>
      <span class="archive-label archive-label--right">AVAILABLE</span>
    </div>

    <div class="archive-list">
      {activeProducts.map((product, index) => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const origin = originMap[originId];
        const originName = origin ? origin.name : originId;
        const imgUrl = product.data.images?.product || product.data.images?.packaging || '';
        // Build coordinate string for this product
        const coordStr = origin?.coordinates
          ? `${origin.coordinates} · ${originName.toUpperCase()} · ${origin.elevation || ''}`
          : `${originName.toUpperCase()}`;

        return (
          <a
            href={`/origins/${originId}/${product.id}`}
            class="archive-row"
            data-coord={coordStr}
            data-img={imgUrl}
          >
            {imgUrl && (
              <img
                src={imgUrl}
                alt={product.data.name}
                class="archive-hover-img"
                style={`view-transition-name: yield-img-${product.id}`}
                loading="lazy"
              />
            )}

            <div class="archive-cell archive-index" aria-hidden="true">
              <!-- Single tally stroke per row -->
              <svg width="10" height="24" viewBox="0 0 10 30" fill="none" aria-hidden="true">
                <path d="M 5 2 C 4 10, 6 20, 5 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="archive-cell archive-origin">{originName}</div>
            <div class="archive-cell archive-specimen">
              <span style={`view-transition-name: yield-title-${product.id}`}>{product.data.name}</span>
            </div>
            <div class="archive-cell archive-status" aria-label="Available">
              <span class="status-tally" aria-hidden="true">
                <!-- One live tally mark = one active harvest -->
                <svg width="12" height="24" viewBox="0 0 12 30" fill="none">
                  <path d="M 5 2 C 4 10, 6 20, 5 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

  </section>

</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initArchive() {
    const coordEl = document.getElementById('coord-text');
    const defaultCoord = 'WESTERN GHATS · FIRST HANDS · DIRECT';

    // Row coordinate & image reveal on hover
    const rows = document.querySelectorAll<HTMLElement>('.archive-row');
    rows.forEach(row => {
      const coord = row.dataset.coord || defaultCoord;

      row.addEventListener('mouseenter', () => {
        if (coordEl) coordEl.textContent = coord;
      });
      row.addEventListener('mouseleave', () => {
        if (coordEl) coordEl.textContent = defaultCoord;
      });
    });

    // Staggered row entrance
    gsap.fromTo('.archive-row',
      { y: 16, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.55,
        ease: 'power2.out',
        stagger: 0.06,
        scrollTrigger: {
          trigger: '.archive-list',
          start: 'top 88%',
        }
      }
    );

    // Coord datum fade in
    gsap.fromTo('#coord-datum',
      { opacity: 0, y: -8 },
      { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', delay: 0.3 }
    );
  }

  initArchive();
  document.addEventListener('astro:after-swap', initArchive);
</script>

<style>
  /* ─── Coordinate Datum ─── */
  .coord-datum {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    /* Sits just below the header */
    padding: 72px var(--space-xl) var(--space-sm);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0.7) 0%, transparent 100%);
  }

  .coord-dot {
    width: 5px;
    height: 5px;
    background: var(--color-gold);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 6px var(--color-gold);
  }

  .coord-text {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(240, 234, 214, 0.5);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  /* ─── Archive ─── */
  .the-archive {
    position: relative;
    padding: 100px var(--space-xl) var(--space-4xl);
    background-color: var(--color-void);
    min-height: 100vh;
    z-index: 10;
  }

  .archive-header {
    display: grid;
    grid-template-columns: 56px 1fr 2fr 80px;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(240, 234, 214, 0.12);
    margin-bottom: var(--space-lg);
    align-items: center;
  }

  .archive-label {
    font-family: var(--font-evidence);
    font-size: 9px;
    color: rgba(240, 234, 214, 0.3);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .archive-label--mark {
    display: flex;
    align-items: center;
  }

  .archive-label--right {
    text-align: right;
  }

  /* ─── Rows ─── */
  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px 1fr 2fr 80px;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid rgba(240, 234, 214, 0.07);
    text-decoration: none;
    color: var(--color-warm-cream);
    transition: color 0.18s ease;
    align-items: center;
    overflow: hidden;
  }

  .archive-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255, 69, 0, 0.03);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .archive-row:hover::before {
    opacity: 1;
  }

  .archive-cell {
    display: flex;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    position: relative;
    z-index: 2;
  }

  .archive-index {
    gap: var(--space-sm);
    color: rgba(240, 234, 214, 0.25);
  }

  .index-num {
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .archive-origin {
    font-size: var(--type-whisper);
    letter-spacing: 0.08em;
    color: rgba(240, 234, 214, 0.45);
    text-transform: uppercase;
  }

  .archive-specimen {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.8rem);
    letter-spacing: 0.02em;
    font-weight: 400;
  }

  .archive-status {
    justify-content: flex-end;
    color: var(--color-gold);
    opacity: 0.6;
  }

  .status-tally {
    display: flex;
    align-items: center;
  }

  /* Hover reveal */
  .archive-hover-img {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 55vw;
    max-width: 600px;
    height: 55vh;
    transform: translate(-50%, -50%) scale(0.92);
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.38s ease, transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    filter: grayscale(60%);
  }

  .archive-row:hover .archive-hover-img {
    opacity: 0.25;
    transform: translate(-50%, -50%) scale(1);
    filter: grayscale(0%);
  }

  .archive-row:hover .archive-cell {
    color: var(--color-warm-cream);
  }

  .archive-row:hover .archive-specimen {
    color: var(--color-gold);
  }

  .archive-row:hover .archive-origin {
    color: rgba(240, 234, 214, 0.7);
  }

  .archive-row:hover .archive-status {
    opacity: 1;
  }

  /* ═══════════════════════════════
     MOBILE — Perfect
  ═══════════════════════════════ */
  @media (max-width: 768px) {
    .coord-datum {
      padding: 64px var(--space-lg) var(--space-xs);
    }

    .coord-text {
      font-size: 8px;
      letter-spacing: 0.08em;
    }

    .the-archive {
      padding: 88px var(--space-lg) var(--space-3xl);
    }

    /* Mobile: hide header row labels */
    .archive-header {
      display: none;
    }

    .archive-row {
      /* Stack: full-width product name + origin below, status right */
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      gap: 2px var(--space-sm);
      padding: var(--space-lg) 0;
      align-items: start;
    }

    .archive-index {
      display: none;
    }

    .archive-specimen {
      grid-column: 1;
      grid-row: 1;
      font-size: clamp(1.1rem, 5vw, 1.6rem);
    }

    .archive-origin {
      grid-column: 1;
      grid-row: 2;
      font-size: 8px;
      letter-spacing: 0.1em;
      padding-bottom: 2px;
    }

    .archive-status {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      justify-content: flex-end;
    }

    /* On mobile, show a subtle image behind tapped row */
    .archive-hover-img {
      display: none;
    }
  }
</style>
