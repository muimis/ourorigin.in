  <!-- INTERACTIVE CLIENT SCRIPTS (Canvas Animation + Slider Logic + Flip Cipher) -->
  <script>
    import { gsap } from 'gsap';

    // 1. BACKGROUND CANVAS ANIMATION (Floating Organic Particles & Light)
    const canvas = document.getElementById('canvas') as HTMLCanvasElement;
    if (canvas) {
      const ctx = canvas.getContext('2d');
      let width = (canvas.width = window.innerWidth);
      let height = (canvas.height = window.innerHeight);

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      interface Particle {
        x: number;
        y: number;
        radius: number;
        vx: number;
        vy: number;
        alpha: number;
      }

      const particles: Particle[] = Array.from({ length: 45 }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 2 + 1,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4,
        alpha: Math.random() * 0.5 + 0.2
      }));

      function renderCanvas() {
        if (!ctx) return;
        ctx.clearRect(0, 0, width, height);

        // Draw glowing ambient gradient
        const grad = ctx.createRadialGradient(width / 2, height / 2, 50, width / 2, height / 2, width * 0.7);
        grad.addColorStop(0, 'rgba(20, 32, 16, 0.4)');
        grad.addColorStop(1, 'rgba(12, 21, 9, 0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, width, height);

        // Draw floating particles
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(198, 156, 82, ${p.alpha})`;
          ctx.fill();
        });

        requestAnimationFrame(renderCanvas);
      }
      renderCanvas();
    }

    // 2. INTERACTIVE TEMPERATURE / SOURCING SLIDER
    const sliderOptions = document.querySelectorAll('.features-temperature-slider__text');
    const sliderBar = document.getElementById('features-temperature-slider__bar');
    const sliderReadout = document.getElementById('slider-readout');

    const methodData: Record<string, { barWidth: string, text: string }> = {
      '10': { barWidth: '100%', text: 'Active Method: Wild Harvest (Wayanad Canopy) · Active Compound: 5.8% Piperine' },
      '1': { barWidth: '50%', text: 'Active Method: Shade Grown (Idukki High Altitude) · Active Compound: 6.2% Cineole' },
      '0.1': { barWidth: '15%', text: 'Active Method: Traditional Agrarian (Sun Dried) · Moisture: 9.5%' }
    };

    sliderOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        sliderOptions.forEach(o => o.classList.remove('is-active'));
        opt.classList.add('is-active');
        const val = opt.getAttribute('data-val') || '10';
        if (sliderBar && methodData[val]) {
          sliderBar.style.width = methodData[val].barWidth;
        }
        if (sliderReadout && methodData[val]) {
          sliderReadout.textContent = methodData[val].text;
        }
      });
    });

    // 3. SMART FLIP CIPHER ENCRYPTION TOOL
    const cipherInput = document.getElementById('encryption-field-input') as HTMLInputElement;
    const flipBtn = document.getElementById('encryption-field-flip-btn');
    const btnText = document.getElementById('encryption-btn-text');
    let isEncoded = false;
    let originalText = 'WYD-BP-001';

    const glyphMap: Record<string, string> = {
      'A': 'Δ', 'B': 'β', 'C': '©', 'D': '∂', 'E': 'Ξ', 'F': 'ƒ', 'G': 'γ',
      'H': 'Ħ', 'I': '∫', 'J': '⌠', 'K': 'κ', 'L': 'λ', 'M': 'μ', 'N': 'π',
      'O': 'Ω', 'P': 'φ', 'Q': 'θ', 'R': '®', 'S': 'Σ', 'T': 'τ', 'U': 'υ',
      'V': '√', 'W': 'ω', 'X': 'χ', 'Y': '¥', 'Z': 'ζ', '0': '∅', '1': 'Ⅰ',
      '2': 'Ⅱ', '3': 'Ⅲ', '4': 'Ⅳ', '5': 'Ⅴ', '6': 'Ⅵ', '7': 'Ⅶ', '8': 'Ⅷ', '9': 'Ⅸ', '-': '·'
    };

    if (flipBtn && cipherInput && btnText) {
      flipBtn.addEventListener('click', () => {
        const val = cipherInput.value.toUpperCase();
        
        // Flip GSAP animation
        gsap.to(cipherInput, {
          rotateX: 90,
          duration: 0.25,
          onComplete: () => {
            if (!isEncoded) {
              originalText = cipherInput.value;
              cipherInput.value = val.split('').map(char => glyphMap[char] || char).join('');
              btnText.textContent = 'Decode Batch Code';
              isEncoded = true;
            } else {
              cipherInput.value = originalText;
              btnText.textContent = 'Encode Batch Code';
              isEncoded = false;
            }
            gsap.to(cipherInput, { rotateX: 0, duration: 0.25 });
          }
        });
      });
    }

    // 4. ADD TO CART / TRANSFER LEDGER BUTTON LISTENERS
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const id = target.getAttribute('data-id');
        const name = target.getAttribute('data-name');
        const price = parseFloat(target.getAttribute('data-price') || '0');
        const size = target.getAttribute('data-size');

        if (window.CartStore) {
          window.CartStore.addItem({
            id: id || 'item',
            name: name || 'Yield Item',
            priceINR: price,
            sizeLabel: size || '100g',
            quantity: 1
          });
        }
      });
    });
  </script>
</BaseLayout>
