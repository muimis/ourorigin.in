---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import OriginMark from '../components/OriginMark.astro';

const products = await getCollection('products');
const origins = await getCollection('origins');

function getOriginForProduct(product: any) {
  const originId = typeof product.data.originSlug === 'object' ? product.data.originSlug?.id : product.data.originSlug;
  return origins.find(o => o.id === originId);
}
---

<BaseLayout
  title="OurOrigin | The Truth is in the Soil"
  description="We do not make. We walk. Deep into the Western Ghats."
  canonicalPath="/"
  ogTitle="OurOrigin"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={true}
  bodyClass="void-canvas-body"
>
    <main class="story-scroll-container">
        
        <!-- The Traveling Element (Golden Thread) -->
        <div id="golden-thread">
            <svg viewBox="0 0 120 120" width="120" height="120">
                <path d="M 90 22 C 93 18, 98 22, 97 26 C 96 30, 90 32, 87 27 C 84 22, 87 19, 90 22 Z" fill="var(--color-gold)" />
            </svg>
        </div>

        <!-- SCENE 1: THE ORIGIN -->
        <section class="story-scene" id="scene-hero">
            <div class="scene-content">
                <div id="hero-mark-container">
                    <!-- Mark without the dot, since the dot is overlaid as the golden thread -->
                    <OriginMark size={120} variant="gold" hideDot={true} />
                </div>
                <h1 class="indigenous-truth hero-headline">
                    We do not make. We walk.
                </h1>
            </div>
        </section>

        <!-- SCENE 2: THE SOIL -->
        <section class="story-scene" id="scene-soil">
            <div class="scene-content">
                <h2 class="indigenous-truth">
                    Deep into the Western Ghats, where the soil is older than memory.<br/><br/>
                    The harvest is not taken; it is yielded. We take only what the forest gives, and leave what belongs to the earth.
                </h2>
            </div>
        </section>

        <!-- SCENE 3: THE HANDS -->
        <section class="story-scene" id="scene-hands">
            <div class="scene-bg" id="hands-bg" style="background-image: url('/assets/origins/idukki-hand.webp')"></div>
            <div class="scene-content">
                <h2 class="indigenous-truth">
                    The true cost is the distance walked.<br/>
                    The true value is the dignity of the hands that gathered it.
                </h2>
            </div>
        </section>

        <!-- SCENE 4: THE YIELD (PRODUCTS) -->
        <section class="story-scene product-arrival" id="scene-yield">
            <div class="scene-content yield-content">
                <h2 class="indigenous-truth section-title">Honor the harvest.</h2>
                
                <div class="yield-grid">
                    {products.map(product => {
                        const origin = getOriginForProduct(product);
                        const originName = origin ? origin.data.name : 'Unknown Origin';
                        return (
                            <article class="yield-card">
                                <div class="yield-image-wrapper">
                                    <img src={product.data.image} alt={product.data.name} loading="lazy" />
                                </div>
                                <div class="yield-meta">
                                    <h3>{product.data.name}</h3>
                                    <span class="origin-tag">{originName}</span>
                                    <div class="yield-action">
                                        <span class="price">₹{product.data.price}</span>
                                        <button class="honor-decision-btn"
                                            data-product-id={product.id}
                                            data-product-name={product.data.name}
                                            data-product-price={product.data.price}
                                            data-product-image={product.data.image}
                                        >
                                            [ Honor ]
                                        </button>
                                    </div>
                                </div>
                            </article>
                        )
                    })}
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Initialize the traveling dot position to exactly overlay the OriginMark's hidden dot
  // The OriginMark is 120x120. The dot is centered around (90, 22) in the SVG coordinates.
  // We overlay the golden-thread SVG perfectly on top of it, so it looks like one piece.

  // Set initial states
  gsap.set("#scene-soil .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#scene-hands .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#scene-yield .scene-content", { autoAlpha: 0, y: 100 });
  gsap.set("#hands-bg", { autoAlpha: 0, scale: 1.1 });

  // The Golden Thread Animation
  const tl = gsap.timeline({
      scrollTrigger: {
          trigger: ".story-scroll-container",
          start: "top top",
          end: "bottom bottom",
          scrub: 1, // Smooth scrub like Oryzo
      }
  });

  // Scene 1 to Scene 2: Dot travels down, scales slightly, text fades
  tl.to("#golden-thread", {
      y: "30vh", // Move down
      scale: 1.5,
      ease: "power1.inOut"
  }, 0)
  .to(".hero-headline", { autoAlpha: 0, y: -50 }, 0)
  .to("#scene-soil .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.1);

  // Scene 2 to Scene 3: Dot travels further, background fades in
  tl.to("#golden-thread", {
      y: "60vh",
      scale: 2,
      ease: "power1.inOut"
  }, 0.3)
  .to("#scene-soil .scene-content", { autoAlpha: 0, y: -50 }, 0.3)
  .to("#hands-bg", { autoAlpha: 0.3, scale: 1, ease: "power2.out" }, 0.4)
  .to("#scene-hands .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.4);

  // Scene 3 to Scene 4 (Yield): Dot settles in the center, reveals products
  tl.to("#golden-thread", {
      y: "85vh",
      scale: 1,
      ease: "power1.inOut"
  }, 0.6)
  .to("#scene-hands .scene-content", { autoAlpha: 0, y: -50 }, 0.6)
  .to("#hands-bg", { autoAlpha: 0 }, 0.6)
  .to("#scene-yield .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out", pointerEvents: "auto" }, 0.7);

  // Cart Logic
  document.querySelectorAll('.honor-decision-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      
      const originalText = target.innerText;
      target.innerText = '[ Honored ✓ ]';
      target.style.color = 'var(--color-gold)';
      target.style.borderColor = 'var(--color-gold)';
      
      setTimeout(() => {
        target.innerText = originalText;
        target.style.color = '';
        target.style.borderColor = '';
      }, 2000);

      const event = new CustomEvent('cart-add', {
        detail: {
          id: target.dataset.productId,
          name: target.dataset.productName,
          price: parseInt(target.dataset.productPrice || '0', 10),
          image: target.dataset.productImage,
          quantity: 1
        }
      });
      window.dispatchEvent(event);
    });
  });
</script>

<style>
    .story-scroll-container {
        position: relative;
        background-color: var(--color-void);
        color: var(--color-warm-cream);
        min-height: 400vh; /* Allow enough scrolling space for the timeline */
    }

    /* The Traveling Dot */
    #golden-thread {
        position: fixed;
        /* Start perfectly centered in the viewport, assuming the hero mark is centered */
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 120px;
        z-index: 100;
        pointer-events: none; /* Let clicks pass through */
    }

    .story-scene {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    /* The content wrappers are absolutely positioned in the viewport to allow cross-fading while scrolling */
    .scene-content {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        max-width: 1000px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        z-index: 10;
        pointer-events: none; /* Only allow pointer events when fully visible */
    }

    #scene-hero .scene-content {
        /* Hero is visible at start */
    }
    
    .scene-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-size: cover;
        background-position: center;
        z-index: 1;
        filter: grayscale(80%) contrast(1.2);
    }

    #hero-mark-container {
        margin-bottom: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .indigenous-truth {
        font-family: var(--font-institutional);
        font-size: clamp(1.8rem, 4vw, 3.5rem);
        font-weight: 300;
        line-height: 1.3;
        letter-spacing: 0.02em;
        color: var(--color-warm-cream);
        margin: 0;
    }

    .section-title {
        margin-bottom: 4rem;
        color: var(--color-gold);
    }

    /* YIELD GRID */
    .yield-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 3rem;
        width: 100%;
        max-width: 1200px;
    }

    .yield-card {
        background: transparent;
        border: 1px solid rgba(198, 156, 82, 0.2);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: border-color 0.3s ease;
    }
    
    .yield-card:hover {
        border-color: rgba(198, 156, 82, 0.6);
    }

    .yield-image-wrapper {
        width: 100%;
        aspect-ratio: 1;
        margin-bottom: 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .yield-image-wrapper img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
    }

    .yield-meta h3 {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        margin: 0 0 0.5rem 0;
        font-weight: 400;
    }

    .origin-tag {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(245, 237, 216, 0.6);
        display: block;
        margin-bottom: 1.5rem;
    }

    .yield-action {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .price {
        font-family: var(--font-mono);
        font-size: 1.2rem;
    }

    .honor-decision-btn {
        background: transparent;
        border: none;
        color: var(--color-warm-cream);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        padding: 0.5rem 1rem;
        transition: color 0.3s ease;
    }

    .honor-decision-btn:hover {
        color: var(--color-gold);
    }
</style>
