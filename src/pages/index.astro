---
import BaseLayout from '../components/BaseLayout.astro';
import OriginZone from '../components/OriginZone.astro';
import YieldZone from '../components/YieldZone.astro';
---

<BaseLayout
  title="OurOrigin — The Absolute Truth of the Soil"
  description="OurOrigin connects you to pure natural ingredients, community-harvested directly from their soil of origin. Traceable to the community who harvested them."
  canonicalPath="/"
  ogTitle="OurOrigin — The Absolute Truth of the Soil"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={false}
  bodyClass="homepage-body split-reality-body"
>
    <main class="split-reality-container">
        <!-- The Left Hemisphere (Philosophy / The Forest) -->
        <OriginZone />
        
        <!-- The Right Hemisphere (Commerce / The Yield) -->
        <YieldZone />
    </main>
</BaseLayout>

<style is:global>
    body.split-reality-body {
        margin: 0;
        padding: 0;
        overflow: hidden; /* Prevent body scrolling, allow zones to scroll independently */
        background-color: var(--color-forest-deep);
    }
    
    @media (max-width: 900px) {
        body.split-reality-body {
            overflow: auto; /* Allow normal scrolling on mobile */
        }
    }
</style>

<style>
    .split-reality-container {
        display: flex;
        flex-direction: row;
        width: 100vw;
        height: 100vh;
    }

    @media (max-width: 900px) {
        .split-reality-container {
            flex-direction: column;
            height: auto;
        }
    }
</style>
