---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import OriginMark from '../components/OriginMark.astro';
import Wordmark from '../components/Wordmark.astro';

const products = await getCollection('products');
const origins = await getCollection('origins');

// Helper to get origin data for a product
function getOriginForProduct(product: any) {
  const originId = typeof product.data.originSlug === 'object' ? product.data.originSlug?.id : product.data.originSlug;
  return origins.find(o => o.id === originId);
}
---

<BaseLayout
  title="OurOrigin | The Truth is in the Soil"
  description="The product is not the soul. The soul is the profound, invisible exchange of dignity and effort from one human being to another."
  canonicalPath="/"
  ogTitle="OurOrigin"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={true}
  bodyClass="void-canvas-body"
>
    <main class="void-canvas">
        <div class="gesture-bg" id="global-spotlight-bg"></div>

        <!-- ACT I: THE ORIGIN -->
        <section class="gsap-section gsap-hero" id="section-void">
            <div class="hero-content">
                <div id="hero-mark">
                    <OriginMark size={120} variant="gold" animate={true} />
                    <Wordmark className="hero-wordmark" />
                </div>
                <h1 class="absolute-truth" id="hero-text-1">
                    The product is not the soul.
                </h1>
            </div>
            <div class="scroll-indicator" id="hero-scroll-indicator">
                <div class="scroll-line"></div>
                <span class="scroll-text">UNEARTH</span>
            </div>
        </section>

        <!-- ACT II: THE TRUTH -->
        <section class="gsap-section gsap-truth" id="section-truth">
            <div class="truth-bg" id="truth-bg-image"></div>
            <div class="truth-content">
                <h2 class="absolute-truth" id="hero-text-2">
                    The soul is the profound, invisible exchange of dignity and effort from one human being to another.
                </h2>
            </div>
        </section>

        <!-- ACT III: THE EXHIBITION (HORIZONTAL SCROLL) -->
        <section class="gsap-section gsap-exhibition" id="section-exhibition">
            <div class="horizontal-scroll-container" id="horizontal-container">
                {products.map((product, index) => {
                    const origin = getOriginForProduct(product);
                    const originName = origin ? origin.data.name : 'Unknown Origin';
                    
                    return (
                        <article class="exhibition-panel">
                            <div class="exhibition-bg-text" aria-hidden="true">
                                {product.data.name.split(' ')[0]}
                            </div>
                            
                            <div class="exhibition-content">
                                <div class="exhibition-image-wrapper">
                                    <img src={product.data.image} alt={product.data.name} class="exhibition-image" loading="lazy" />
                                </div>
                                
                                <div class="exhibition-meta">
                                    <h3 class="exhibition-title">{product.data.name}</h3>
                                    <div class="exhibition-data">
                                        <div class="data-row">
                                            <span class="data-label">Origin</span>
                                            <span class="data-value">{originName}</span>
                                        </div>
                                        <div class="data-row">
                                            <span class="data-label">Harvest</span>
                                            <span class="data-value">{product.data.harvest_method || 'Selective'}</span>
                                        </div>
                                        <div class="data-row">
                                            <span class="data-label">Value</span>
                                            <span class="data-value">₹{product.data.price} <span class="unit">/ {product.data.unit}</span></span>
                                        </div>
                                    </div>
                                    
                                    <button 
                                        class="honor-decision-btn"
                                        data-product-id={product.id}
                                        data-product-name={product.data.name}
                                        data-product-price={product.data.price}
                                        data-product-image={product.data.image}
                                    >
                                        [ Honor the Harvest ]
                                    </button>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>
        </section>
        
        <!-- ACT IV: THE HARVEST (MINIMAL LIST) -->
        <section class="gsap-section gsap-ledger" id="section-ledger">
            <div class="ledger-header">
                <h2>The Harvest</h2>
                <p>Receive the purest yield directly from its soil of origin.</p>
            </div>
            
            <div class="ledger-list">
                {products.map(product => {
                    const origin = getOriginForProduct(product);
                    const originName = origin ? origin.data.name : 'Unknown Origin';
                    return (
                        <div class="ledger-item">
                            <div class="ledger-item-info">
                                <h3>{product.data.name}</h3>
                                <span>{originName}</span>
                            </div>
                            <div class="ledger-item-action">
                                <span class="price">₹{product.data.price}</span>
                                <button class="honor-decision-btn inline"
                                    data-product-id={product.id}
                                    data-product-name={product.data.name}
                                    data-product-price={product.data.price}
                                    data-product-image={product.data.image}
                                >+</button>
                            </div>
                        </div>
                    )
                })}
            </div>
        </section>
    </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Spotlight Effect (Mouse and Touch)
  function updateSpotlight(e: MouseEvent | TouchEvent) {
    const bg = document.getElementById('global-spotlight-bg');
    if (bg) {
      let clientX, clientY;
      if (window.TouchEvent && e instanceof TouchEvent) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else {
        clientX = (e as MouseEvent).clientX;
        clientY = (e as MouseEvent).clientY;
      }
      bg.style.setProperty('--cursor-x', `${clientX}px`);
      bg.style.setProperty('--cursor-y', `${clientY}px`);
    }
  }

  document.addEventListener('mousemove', updateSpotlight);
  document.addEventListener('touchmove', updateSpotlight, { passive: true });

  // GSAP SCROLL ANIMATIONS
  
  // 1. Hero Exit
  gsap.to('#hero-text-1', {
    opacity: 0,
    y: -50,
    scrollTrigger: {
      trigger: '#section-void',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });
  
  gsap.to('#hero-mark', {
    scale: 0.5,
    y: -100,
    opacity: 0,
    scrollTrigger: {
      trigger: '#section-void',
      start: 'top top',
      end: 'bottom top',
      scrub: true
    }
  });

  gsap.to('#hero-scroll-indicator', {
    opacity: 0,
    scrollTrigger: {
      trigger: '#section-void',
      start: 'top top',
      end: '+=300',
      scrub: true
    }
  });

  // 2. The Truth Sequence (Pinned)
  const truthTl = gsap.timeline({
    scrollTrigger: {
      trigger: '#section-truth',
      start: 'top top',
      end: '+=200%', // Pin for 2 viewport heights
      pin: true,
      scrub: true
    }
  });

  truthTl.fromTo('#hero-text-2', { opacity: 0, scale: 0.95, y: 50 }, { opacity: 1, scale: 1, y: 0, duration: 1 })
         .fromTo('#truth-bg-image', { opacity: 0, scale: 1.1 }, { opacity: 0.4, scale: 1, duration: 2 }, "-=0.5")
         .to('#hero-text-2', { opacity: 0, y: -50, filter: 'blur(10px)', duration: 1 });

  // 3. The Horizontal Exhibition
  const container = document.getElementById('horizontal-container');
  const panels = gsap.utils.toArray('.exhibition-panel') as HTMLElement[];

  if (container && panels.length > 0) {
      gsap.to(panels, {
        xPercent: -100 * (panels.length - 1),
        ease: "none",
        scrollTrigger: {
          trigger: '#section-exhibition',
          pin: true,
          scrub: 1, // Smooth scrubbing
          snap: 1 / (panels.length - 1),
          // End after scrolling the width of all panels
          end: () => "+=" + container.scrollWidth
        }
      });
      
      // Add subtle parallax to images within the horizontal scroll
      panels.forEach((panel) => {
          const img = panel.querySelector('.exhibition-image');
          if (img) {
              gsap.fromTo(img, 
                { x: 100, rotation: 5 },
                { 
                  x: -100, 
                  rotation: -5,
                  ease: "none",
                  scrollTrigger: {
                      trigger: panel,
                      containerAnimation: gsap.getById(ScrollTrigger.getAll()[3]?.vars.id) || null, // Need to link to the horizontal tween if possible, or just use standard scrub based on viewport
                      start: "left right",
                      end: "right left",
                      scrub: true,
                      horizontal: true // Tell ScrollTrigger to track horizontal position
                  }
                }
              );
          }
      });
  }

  // Cart Logic
  document.querySelectorAll('.honor-decision-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      
      const originalText = target.innerText;
      target.innerText = '[ Harvest Honored ✓ ]';
      target.style.color = 'var(--color-gold)';
      target.style.borderColor = 'var(--color-gold)';
      
      setTimeout(() => {
        target.innerText = originalText;
        target.style.color = '';
        target.style.borderColor = '';
      }, 2000);

      const event = new CustomEvent('cart-add', {
        detail: {
          id: target.dataset.productId,
          name: target.dataset.productName,
          price: parseInt(target.dataset.productPrice || '0', 10),
          image: target.dataset.productImage,
          quantity: 1
        }
      });
      window.dispatchEvent(event);
    });
  });
</script>

<style is:global>
    body.void-canvas-body {
        margin: 0;
        padding: 0;
        background-color: var(--color-forest-deep);
        color: var(--color-warm-cream);
        overflow-x: hidden;
    }
</style>

<style>
    .void-canvas {
        width: 100vw;
        overflow-x: hidden;
    }

    .gsap-section {
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .gesture-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-image: url('/assets/origins/idukki-hand.webp');
        background-size: cover;
        background-position: center;
        opacity: 0.2;
        filter: grayscale(80%) contrast(1.2);
        z-index: 0;
        pointer-events: none;
        
        --cursor-x: 50vw;
        --cursor-y: 50vh;
        mask-image: radial-gradient(circle 400px at var(--cursor-x) var(--cursor-y), rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
        -webkit-mask-image: radial-gradient(circle 400px at var(--cursor-x) var(--cursor-y), rgba(0,0,0,1) 0%, rgba(0,0,0,0) 100%);
    }

    /* --- ACT I: HERO --- */
    .hero-content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4rem;
        text-align: center;
    }
    
    #hero-mark {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2.5rem;
    }

    :global(.hero-wordmark .wordmark-text) {
        font-size: clamp(2rem, 5vw, 4.5rem);
    }

    .absolute-truth {
        font-family: var(--font-institutional);
        font-size: clamp(1.8rem, 5vw, 4.5rem);
        font-weight: 300;
        line-height: 1.2;
        color: var(--color-warm-cream);
        margin: 0;
        letter-spacing: -0.02em;
        max-width: 1000px;
        padding: 0 1.5rem;
    }

    .scroll-indicator {
        position: absolute;
        bottom: 3rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        z-index: 2;
    }

    .scroll-line {
        width: 1px;
        height: 80px;
        background: linear-gradient(to bottom, rgba(245, 237, 216, 0.8) 0%, rgba(245, 237, 216, 0) 100%);
        animation: pulseLine 2s infinite;
    }

    .scroll-text {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.3em;
        color: var(--color-gold);
    }

    @keyframes pulseLine {
        0% { transform: scaleY(1); transform-origin: top; }
        50% { transform: scaleY(0.5); transform-origin: top; }
        100% { transform: scaleY(1); transform-origin: top; }
    }

    /* --- ACT II: THE TRUTH --- */
    .truth-content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .truth-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        background-image: url('/assets/origins/attappady-landscape.webp');
        background-size: cover;
        background-position: center;
        opacity: 0;
        z-index: 1;
        filter: grayscale(50%) contrast(1.1);
    }

    /* --- ACT III: EXHIBITION --- */
    .gsap-exhibition {
        align-items: flex-start;
        justify-content: flex-start;
    }

    .horizontal-scroll-container {
        display: flex;
        width: max-content;
        height: 100vh;
        height: 100dvh;
    }

    .exhibition-panel {
        position: relative;
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        overflow: hidden;
    }

    .exhibition-bg-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-family: var(--font-institutional);
        font-size: clamp(10rem, 25vw, 30rem);
        font-weight: 700;
        color: rgba(245, 237, 216, 0.03);
        white-space: nowrap;
        z-index: 1;
        pointer-events: none;
    }

    .exhibition-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 6rem;
        max-width: 1400px;
        width: 100%;
    }

    .exhibition-image-wrapper {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 60vh;
    }

    .exhibition-image {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        filter: drop-shadow(0 30px 50px rgba(0,0,0,0.8));
    }

    .exhibition-meta {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .exhibition-title {
        font-family: var(--font-institutional);
        font-size: clamp(3rem, 5vw, 5rem);
        font-weight: 300;
        color: var(--color-warm-cream);
        margin: 0;
        line-height: 1.1;
    }

    .exhibition-data {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        border-top: 1px solid rgba(245, 237, 216, 0.2);
        border-bottom: 1px solid rgba(245, 237, 216, 0.2);
        padding: 2rem 0;
    }

    .data-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .data-label {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.2em;
        color: rgba(245, 237, 216, 0.5);
        text-transform: uppercase;
    }

    .data-value {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        color: var(--color-gold);
    }

    .data-value .unit {
        font-size: 1rem;
        color: var(--color-warm-cream);
    }

    .honor-decision-btn {
        background: transparent;
        border: 1px solid var(--color-gold);
        color: var(--color-gold);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 1.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        width: 100%;
    }

    .honor-decision-btn:hover {
        background: var(--color-gold);
        color: var(--color-forest-deep);
    }

    /* --- ACT IV: LEDGER --- */
    .gsap-ledger {
        flex-direction: column;
        height: auto;
        min-height: 100vh;
        padding: 10rem 2rem;
        background: #080c06; /* Slightly darker than void to contrast */
        z-index: 10; /* Above the horizontal scroll */
    }

    .ledger-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .ledger-header h2 {
        font-family: var(--font-institutional);
        font-size: 3rem;
        font-weight: 300;
        margin: 0 0 1rem 0;
        color: var(--color-warm-cream);
    }

    .ledger-header p {
        font-family: var(--font-mono);
        color: var(--color-gold);
        letter-spacing: 0.1em;
        font-size: 12px;
        text-transform: uppercase;
    }

    .ledger-list {
        width: 100%;
        max-width: 800px;
        display: flex;
        flex-direction: column;
    }

    .ledger-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        border-bottom: 1px solid rgba(245, 237, 216, 0.1);
        transition: background 0.3s ease;
    }

    .ledger-item:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .ledger-item-info h3 {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        font-weight: 300;
        margin: 0 0 0.5rem 0;
        color: var(--color-warm-cream);
    }

    .ledger-item-info span {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        color: rgba(245, 237, 216, 0.5);
        text-transform: uppercase;
    }

    .ledger-item-action {
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .ledger-item-action .price {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        color: var(--color-gold);
    }

    .honor-decision-btn.inline {
        padding: 0.5rem 1rem;
        width: auto;
        font-size: 1rem;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .exhibition-content {
            flex-direction: column;
            gap: 2rem;
            text-align: center;
        }
        
        .exhibition-image-wrapper {
            height: 35vh;
        }

        .exhibition-title {
            font-size: clamp(2.5rem, 8vw, 4rem);
        }

        .exhibition-data {
            padding: 1rem 0;
            gap: 1rem;
        }

        .data-row {
            flex-direction: column;
            gap: 0.25rem;
            align-items: center;
        }

        .ledger-header h2 {
            font-size: 2rem;
        }

        .ledger-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.5rem;
        }
        
        .ledger-item-action {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>
