---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import OriginMark from '../components/OriginMark.astro';

const products = await getCollection('products');
const origins = await getCollection('origins');

function getOriginForProduct(product: any) {
  const originId = typeof product.data.originSlug === 'object' ? product.data.originSlug?.id : product.data.originSlug;
  return origins.find(o => o.id === originId);
}

// Ensure products have valid images and origin data
const validProducts = products.filter(p => getOriginForProduct(p) && p.data.images?.product);

// Sort yields for the cinematic carousel
const yields = validProducts.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout
  title="OurOrigin | The Truth is in the Soil"
  description="We do not make. We walk. Deep into the Western Ghats."
  canonicalPath="/"
  ogTitle="OurOrigin"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={false}
  bodyClass="cinematic-canvas-body"
>
    <!-- The Master Scroll Container -->
    <!-- This provides the vertical scroll height to drive the timeline. -->
    <div class="scroll-rig"></div>

    <!-- The Pinned Viewport -->
    <!-- This stays fixed on screen, acting like a WebGL canvas -->
    <main class="cinematic-viewport">
        
        <!-- LAYER 0: The Base Void -->
        <div class="layer void-base"></div>

        <!-- LAYER 1: The Morphing Background Mask -->
        <!-- Starts as a small dot, morphs to reveal backgrounds -->
        <div class="layer bg-mask-layer" id="dynamic-mask">
            
            <!-- The specific cinematic backgrounds that crossfade inside the mask -->
            <div class="bg-image active" id="bg-canopy" style="background-image: url('/assets/origins/wayanad-canopy.webp')"></div>
            <div class="bg-image" id="bg-hand" style="background-image: url('/assets/origins/wayanad-hand.webp')"></div>
            <div class="bg-image" id="bg-specimen" style="background-image: url('/assets/origins/wayanad-specimen.webp')"></div>
            
            <!-- Golden overlay for when it's just the "tally dot" -->
            <div class="gold-fill" id="mask-gold-fill"></div>
        </div>

        <!-- LAYER 2: The Typography & Interface -->
        <!-- Absolute positioned text blocks that fade in and out -->
        <div class="layer ui-layer">
            
            <!-- SCENE 1: HERO -->
            <div class="scene-ui" id="ui-hero">
                <div class="hero-center">
                    <OriginMark size={120} variant="gold" id="hero-origin-mark" hideDot={true} />
                    <h1 class="hero-wordmark">OurOrigin</h1>
                </div>
            </div>

            <!-- SCENE 2: ORIGIN (WHY) -->
            <div class="scene-ui" id="ui-origin">
                <div class="placard placard-left">
                    <div class="placard-label">Bioregion</div>
                    <div class="placard-value">Western Ghats</div>
                    <div class="placard-line"></div>
                </div>
                <div class="placard placard-right">
                    <div class="placard-label">Ecosystem</div>
                    <div class="placard-value">Forest Loam<br/>2,500mm Rainfall</div>
                </div>
            </div>

            <!-- SCENE 3: METHOD (HOW) -->
            <div class="scene-ui" id="ui-method">
                <div class="placard placard-center">
                    <div class="placard-label">The Method</div>
                    <div class="placard-value massive">Traditional Agrarian</div>
                    <div class="placard-desc">The vines climb living trees. The picker carries back only what the forest gave that morning.</div>
                </div>
            </div>

            <!-- SCENE 4: SEASON (WHEN) -->
            <div class="scene-ui" id="ui-season">
                <div class="placard placard-bottom">
                    <div class="placard-label">The Constraint</div>
                    <div class="placard-value">Harvest January</div>
                    <div class="placard-desc">We wait for the forest. We do not force it.</div>
                </div>
            </div>
            
        </div>

        <!-- LAYER 3: The Artifact Carousel (WHAT) -->
        <!-- Starts off-screen, slides in when the mask flattens into a pedestal -->
        <div class="layer carousel-layer" id="artifact-carousel">
            <h2 class="carousel-title" id="carousel-title">The Artifacts</h2>
            <div class="carousel-track" id="carousel-track">
                {yields.map((product) => {
                    const origin = getOriginForProduct(product);
                    const originName = origin ? origin.data.name : 'Unknown Origin';
                    return (
                        <div class="artifact-card">
                            <div class="artifact-image-container">
                                <img src={product.data.images.product} alt={product.data.name} loading="lazy" decoding="async" />
                            </div>
                            <div class="artifact-data">
                                <div class="artifact-meta">
                                    <span class="artifact-origin">{originName}</span>
                                    <span class="artifact-botanical">{product.data.botanicalName}</span>
                                </div>
                                <h3 class="artifact-name">{product.data.name}</h3>
                                <div class="artifact-actions">
                                    <a href={`/products/${product.slug}`} class="btn-honor">View Evidence</a>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>

    </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Setup Initial States
  // The dynamic mask starts exactly where the OriginMark dot would be
  // Assuming OriginMark is center screen, the dot is bottom right of the mark.
  gsap.set("#dynamic-mask", {
      clipPath: "circle(6px at 53% 53%)",
      autoAlpha: 1
  });
  
  gsap.set(".scene-ui", { autoAlpha: 0 });
  gsap.set("#ui-hero", { autoAlpha: 1 });
  
  gsap.set("#artifact-carousel", { autoAlpha: 0, pointerEvents: "none" });
  gsap.set("#carousel-track", { x: "20vw" }); // Start slightly offset

  // The Master Timeline
  const tl = gsap.timeline({
      scrollTrigger: {
          trigger: ".scroll-rig",
          start: "top top",
          end: "bottom bottom",
          scrub: 1, // Smooth cinematic scrubbing
      }
  });

  // SCENE 1: Hero to Origin (The Dot expands into a Window)
  tl.to("#ui-hero", { autoAlpha: 0, y: -50, duration: 1 }, 0)
    .to("#mask-gold-fill", { autoAlpha: 0, duration: 0.5 }, 0.5) // Reveal the canopy image inside
    .to("#dynamic-mask", { clipPath: "circle(25vmax at 50% 50%)", duration: 2, ease: "power2.inOut" }, 0.5)
    .to("#ui-origin", { autoAlpha: 1, duration: 1 }, 2);

  // SCENE 2: Origin to Method (The Window morphs to a tall portrait crop for the Hand)
  tl.to("#ui-origin", { autoAlpha: 0, y: -50, duration: 1 }, 4)
    .to("#bg-canopy", { autoAlpha: 0, duration: 1 }, 4.5)
    .to("#bg-hand", { autoAlpha: 1, duration: 1 }, 4.5)
    .to("#dynamic-mask", { clipPath: "inset(10% 30% 10% 30% round 20px)", duration: 2, ease: "power2.inOut" }, 4.5)
    .to("#ui-method", { autoAlpha: 1, duration: 1 }, 6);

  // SCENE 3: Method to Season (The crop widens into a cinematic letterbox for the Specimen)
  tl.to("#ui-method", { autoAlpha: 0, y: -50, duration: 1 }, 8)
    .to("#bg-hand", { autoAlpha: 0, duration: 1 }, 8.5)
    .to("#bg-specimen", { autoAlpha: 1, duration: 1 }, 8.5)
    .to("#dynamic-mask", { clipPath: "inset(30% 10% 30% 10% round 10px)", duration: 2, ease: "power2.inOut" }, 8.5)
    .to("#ui-season", { autoAlpha: 1, duration: 1 }, 10);

  // SCENE 4: Season to Artifact Carousel (The mask drops to the bottom and becomes the pedestal)
  tl.to("#ui-season", { autoAlpha: 0, y: -50, duration: 1 }, 12)
    .to("#dynamic-mask", { clipPath: "inset(85% 0% 0% 0% round 0px)", duration: 2, ease: "power3.inOut" }, 12.5)
    .to("#bg-specimen", { filter: "grayscale(100%) brightness(0.2)", duration: 2 }, 12.5)
    
    // Bring in the Carousel
    .to("#artifact-carousel", { autoAlpha: 1, pointerEvents: "auto", duration: 1 }, 14)
    // Horizontal scroll logic tied to the main vertical scroll
    // We calculate how far the track needs to move based on its width vs screen width
    .to("#carousel-track", { 
        x: () => {
            const track = document.getElementById("carousel-track");
            return track ? -(track.scrollWidth - window.innerWidth + 100) : 0;
        }, 
        ease: "none", 
        duration: 8 
    }, 14);

</script>

<style>
    /* GLOBAL BODY OVERRIDE */
    :global(body.cinematic-canvas-body) {
        background-color: #000 !important; /* Absolute void */
        margin: 0;
        overflow-x: hidden;
    }

    /* THE RIG */
    .scroll-rig {
        height: 800vh; /* Massive scroll height for pacing */
        width: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
    }

    .cinematic-viewport {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 2;
        overflow: hidden;
        pointer-events: none; /* Let clicks pass to scroll-rig if needed, though we will enable pointer events on specific layers */
    }

    .layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
    }

    /* THE VOID */
    .void-base {
        background-color: var(--color-void, #0a0a0a);
        z-index: 1;
    }

    /* THE DYNAMIC MASK (The traveling element) */
    .bg-mask-layer {
        z-index: 5;
        will-change: clip-path;
        /* clip-path set by GSAP */
    }

    .bg-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        opacity: 0; /* Managed by GSAP */
        will-change: opacity, filter;
    }

    .bg-image.active {
        opacity: 1;
    }

    .gold-fill {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: var(--color-gold, #c8a04d);
        z-index: 10;
        will-change: opacity;
    }

    /* TYPOGRAPHY / UI LAYER */
    .ui-layer {
        z-index: 10;
    }

    .scene-ui {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        will-change: opacity, transform;
    }

    .hero-center {
        margin: auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
    }

    .hero-wordmark {
        font-family: var(--font-institutional);
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: 0.1em;
        color: var(--color-warm-cream);
        text-transform: uppercase;
        margin: 0;
    }

    /* Museum Placards */
    .placard {
        position: absolute;
        color: var(--color-warm-cream);
        font-family: var(--font-evidence);
        max-width: 300px;
    }

    .placard-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--color-gold);
        margin-bottom: 0.5rem;
    }

    .placard-value {
        font-size: 1.5rem;
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    .placard-value.massive {
        font-family: var(--font-institutional);
        font-size: clamp(2rem, 5vw, 4rem);
        white-space: nowrap;
    }

    .placard-desc {
        font-size: 0.9rem;
        line-height: 1.5;
        opacity: 0.7;
    }

    .placard-left { top: 40%; left: 10%; }
    .placard-right { top: 60%; right: 10%; text-align: right; }
    .placard-center { top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; }
    .placard-bottom { bottom: 15%; left: 50%; transform: translateX(-50%); text-align: center; }

    /* CAROUSEL LAYER */
    .carousel-layer {
        z-index: 20;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .carousel-title {
        position: absolute;
        top: 10%;
        left: 5%;
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        color: var(--color-warm-cream);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .carousel-track {
        display: flex;
        gap: 8vw;
        padding: 0 10vw;
        align-items: center;
        height: 60vh;
        will-change: transform;
    }

    .artifact-card {
        flex: 0 0 auto;
        width: 300px;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        pointer-events: auto; /* Enable clicks */
    }

    .artifact-image-container {
        width: 100%;
        aspect-ratio: 1/1;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .artifact-image-container img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
    }

    .artifact-meta {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        color: var(--color-gold);
        margin-bottom: 0.5rem;
    }

    .artifact-name {
        font-family: var(--font-evidence);
        font-size: 2rem;
        color: var(--color-warm-cream);
        margin: 0 0 1.5rem 0;
        line-height: 1.1;
    }

    .btn-honor {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-void);
        background-color: var(--color-warm-cream);
        padding: 0.75rem 1.5rem;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

    .btn-honor:hover {
        background-color: var(--color-gold);
    }
</style>
