---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';

// Load content
const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

// Active products
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});
---

<Layout 
  title="OurOrigin — The Proof System" 
  description="The Western Ghats are speaking. We are just recording it."
  noHeaderPadding={true}
>

  <!-- ACT I: The Interrogation -->
  <section class="interrogation-hook">
    <div class="hook-content" data-reveal="up">
      <div class="hook-data">SYS.COORD [ 11.605° N, 76.083° E ]</div>
      <h1 class="hook-statement">The Western Ghats are speaking. <br/>We are just recording it.</h1>
      <p class="hook-sub">Not a brand. Not a middleman. Only the First Hands.</p>
    </div>
  </section>

  <!-- ACT II: The Archive -->
  <section class="the-archive" id="the-yields" aria-label="The Registry">
    <div class="archive-header">
      <span class="archive-label">INDEX</span>
      <span class="archive-label">ORIGIN</span>
      <span class="archive-label">SPECIMEN</span>
      <span class="archive-label">STATUS</span>
    </div>

    <div class="archive-list">
      {activeProducts.map((product, index) => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const originObj = allOrigins.find(o => o.id === originId);
        const originName = originObj ? originObj.data.name : originId;
        const imgUrl = product.data.images?.product || product.data.images?.packaging || '';

        return (
          <a href={`/origins/${originId}/${product.id}`} class="archive-row" data-reveal="up">
            
            {/* The Background Hover Reveal */}
            {imgUrl && (
              <img 
                src={imgUrl} 
                alt={product.data.name} 
                class="archive-hover-img"
                style={`view-transition-name: yield-img-${product.id}`}
              />
            )}

            <div class="archive-cell archive-index">00{index + 1}</div>
            <div class="archive-cell archive-origin">{originName}</div>
            <div class="archive-cell archive-specimen">
              <span style={`view-transition-name: yield-title-${product.id}`}>{product.data.name}</span>
            </div>
            <div class="archive-cell archive-status">
              <span class="status-dot"></span> ACTIVE
            </div>
          </a>
        );
      })}
    </div>
  </section>

</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initArchive() {
    // Standard reveal animations
    const reveals = document.querySelectorAll('[data-reveal]');
    reveals.forEach(el => {
      gsap.fromTo(el, 
        { y: 30, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 0.8, ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 90%",
          }
        }
      );
    });
  }

  // Init on load and after view transitions
  initArchive();
  document.addEventListener('astro:after-swap', initArchive);
</script>

<style>
  /* ════════════════════════════════════════════════════════════
     ACT I: THE INTERROGATION
     ════════════════════════════════════════════════════════════ */
  .interrogation-hook {
    width: 100%;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding: var(--space-4xl) var(--space-xl);
    background: var(--color-void);
    border-bottom: 1px solid rgba(240, 234, 214, 0.1);
  }

  .hook-content {
    max-width: 900px;
    margin-top: 10vh;
  }

  .hook-data {
    font-family: var(--font-evidence);
    color: var(--color-gold);
    font-size: var(--type-evidence);
    letter-spacing: 0.1em;
    margin-bottom: var(--space-xl);
  }

  .hook-statement {
    font-family: var(--font-narrative);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 400;
    color: var(--color-warm-cream);
    line-height: 1.1;
    margin: 0 0 var(--space-lg) 0;
  }

  .hook-sub {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: rgba(240, 234, 214, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ════════════════════════════════════════════════════════════
     ACT II: THE ARCHIVE (BRUTALIST REGISTRY)
     ════════════════════════════════════════════════════════════ */
  .the-archive {
    position: relative;
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-void);
    min-height: 100vh;
    z-index: 10;
  }

  .archive-header {
    display: grid;
    grid-template-columns: 100px 1fr 2fr 150px;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(240, 234, 214, 0.2);
    margin-bottom: var(--space-xl);
  }

  .archive-label {
    font-family: var(--font-evidence);
    font-size: 10px;
    color: rgba(240, 234, 214, 0.4);
    letter-spacing: 0.1em;
  }

  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-row {
    position: relative;
    display: grid;
    grid-template-columns: 100px 1fr 2fr 150px;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid rgba(240, 234, 214, 0.1);
    text-decoration: none;
    color: var(--color-warm-cream);
    transition: color 0.2s ease;
  }

  .archive-cell {
    display: flex;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    position: relative;
    z-index: 2; /* Sit above the hover image */
  }

  .archive-specimen {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: 0.02em;
  }

  .archive-status {
    color: rgba(240, 234, 214, 0.5);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold);
    border-radius: 50%;
    display: inline-block;
    margin-right: var(--space-sm);
    box-shadow: 0 0 10px var(--color-gold);
  }

  /* The Hover Reveal Magic */
  .archive-hover-img {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 60vw;
    height: 60vh;
    transform: translate(-50%, -50%) scale(0.9);
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    filter: grayscale(100%);
  }

  .archive-row:hover .archive-hover-img {
    opacity: 0.3;
    transform: translate(-50%, -50%) scale(1);
    filter: grayscale(0%);
  }

  .archive-row:hover .archive-cell {
    color: var(--color-gold);
  }

  .archive-row:hover .archive-status {
    color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .archive-header {
      display: none;
    }
    .archive-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
      padding: var(--space-2xl) 0;
    }
    .archive-cell {
      justify-content: flex-start;
    }
    .archive-index {
      font-size: 10px;
      color: rgba(240, 234, 214, 0.4);
    }
    .archive-hover-img {
      width: 100vw;
      height: 100vh;
      object-fit: cover;
    }
  }
</style>
