---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';

// Load content
const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

// Active products
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});
---

<Layout 
  title="OurOrigin — The Proof System" 
  description="Physical proof of an invisible exchange between the Western Ghats and the First Hands."
  noHeaderPadding={true}
>

  <!-- ACT I: The Hook & Cinematic Sequence -->
  <section class="cinema-track" id="cinema-track">
    
    <!-- The Background Void & Artifact -->
    <div class="cinema-visual">
      {activeProducts[0] && activeProducts[0].data.images?.product ? (
        <img src={activeProducts[0].data.images.product} alt="The Artifact" class="cinema-artifact" />
      ) : (
        <div class="cinema-placeholder"><OriginMark size={80} variant="gold" /></div>
      )}
      <div class="cinema-vignette"></div>
    </div>

    <!-- UX Bypass -->
    <a href="#the-yields" class="ux-bypass">View the Yields</a>

    <!-- The Beats -->
    <div class="cinema-beats-container">
      
      <!-- Beat 0 (Hero) -->
      <div class="cinema-beat">
        <h1 class="cinema-title">This is not just a harvest.</h1>
        <p class="cinema-subtitle">It is physical proof of an invisible exchange.</p>
        <div class="scroll-cue">
          <span class="scroll-line"></span>
        </div>
      </div>

      <!-- Beat 1 -->
      <div class="cinema-beat">
        <h2 class="cinema-title">An exchange of dignity.</h2>
        <p class="cinema-subtitle">Between the ancient slopes of the Western Ghats, and the First Hands who understand them.</p>
      </div>

      <!-- Beat 2 -->
      <div class="cinema-beat">
        <h2 class="cinema-title">They do not force the earth.<br/>They do not take too much.</h2>
        <p class="cinema-subtitle">They wait for the monsoon. They listen to the soil. They take only what is offered.</p>
      </div>

      <!-- Beat 3 -->
      <div class="cinema-beat">
        <h2 class="cinema-title">Everything is origin.</h2>
        <p class="cinema-subtitle">If you alter the soil, you erase the truth. If you exploit the hands, you lose the soul.</p>
      </div>

      <!-- Beat 4 (Climax) -->
      <div class="cinema-beat">
        <h2 class="cinema-title">We are a proof system.</h2>
        <p class="cinema-subtitle cinema-gold">We exist to ensure this exchange reaches you, completely unbroken.</p>
      </div>

    </div>
  </section>

  <!-- ACT II: The Yields -->
  <section class="the-yields" id="the-yields" aria-label="The Artifacts">
    <div class="yields-header">
      <h2 class="yields-title" data-reveal="fade">The Yields</h2>
      <p class="yields-subtitle" data-reveal="fade">The physical proof that survived the system this season.</p>
    </div>

    <div class="yields-grid-compact">
      {activeProducts.map(product => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const originObj = allOrigins.find(o => o.id === originId);
        const originName = originObj ? originObj.data.name : originId;

        return (
          <div class="product-row" data-reveal="up">
            <a href={`/origins/${originId}/${product.id}`} class="product-row-link">
              <div class="product-row-image">
                {product.data.images?.product ? (
                  <img 
                    src={product.data.images.product} 
                    alt={product.data.name} 
                    loading="lazy" 
                    style={`view-transition-name: yield-img-${product.id}`}
                  />
                ) : product.data.images?.packaging ? (
                  <img 
                    src={product.data.images.packaging} 
                    alt={product.data.name} 
                    loading="lazy" 
                    style={`view-transition-name: yield-img-${product.id}`}
                  />
                ) : (
                  <div class="product-row-placeholder">
                    <OriginMark size={20} variant="gold" />
                  </div>
                )}
              </div>
              
              <div class="product-row-details">
                <span class="product-row-meta">{originName}</span>
                <h3 class="product-row-name" style={`view-transition-name: yield-title-${product.id}`}>{product.data.name}</h3>
              </div>
              
              <div class="product-row-price">
                ₹{product.data.sizes[0]?.priceINR} <span>/ {product.data.sizes[0]?.label}</span>
              </div>
              
              <div class="product-row-action">
                <span class="btn-buy-now">Buy Now</span>
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ACT III: The Walk -->
  <section class="the-walk" aria-label="The walk">
    <div class="walk-bg" style="background-image: url('/images/prefooter.webp')"></div>
    <div class="walk-overlay"></div>
    <div class="walk-content" data-reveal="fade">
      <p class="walk-statement">
        The origin doesn't end at the farm gate. It extends to where the road begins, and continues to where you're reading this now.
      </p>
      <a href="/about" class="walk-link">Read the manifesto →</a>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCinemaSequence() {
    const track = document.getElementById('cinema-track');
    const beats = document.querySelectorAll('.cinema-beat');
    const visual = document.querySelector('.cinema-visual');

    if (!track || beats.length === 0) return;

    // Reset styles for SPA nav
    gsap.set(beats, { opacity: 0, filter: 'blur(15px)', scale: 1.05 });
    
    // Mobile / Desktop logic via matchMedia
    let mm = gsap.matchMedia();

    mm.add("(min-width: 800px)", () => {
      // The Master Timeline (Desktop: Pinned)
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          start: "top top",
          end: `+=${beats.length * 100}%`,
          scrub: 1,
          pin: true,
        }
      });

      tl.to(visual, { opacity: 0, scale: 0.9, duration: beats.length * 2 }, 0);

      beats.forEach((beat, i) => {
        tl.to(beat, 
          { opacity: 1, filter: 'blur(0px)', scale: 1, duration: 1, ease: "power2.out" },
          i === 0 ? 0 : "+=0.2"
        );
        if (i < beats.length - 1) {
          tl.to(beat, 
            { opacity: 0, filter: 'blur(10px)', scale: 0.95, duration: 1, ease: "power2.in" },
            "+=1.5"
          );
        }
      });
    });

    mm.add("(max-width: 799px)", () => {
      // Mobile Timeline (No pinning, just sequential reveals as you scroll)
      beats.forEach((beat) => {
        gsap.to(beat, {
          opacity: 1,
          filter: 'blur(0px)',
          scale: 1,
          duration: 1,
          ease: "power2.out",
          scrollTrigger: {
            trigger: beat,
            start: "top 75%",
            end: "top 25%",
            toggleActions: "play reverse play reverse"
          }
        });
      });
    });

    // Standard reveal animations for yields
    const reveals = document.querySelectorAll('[data-reveal]');
    reveals.forEach(el => {
      const type = el.getAttribute('data-reveal');
      gsap.fromTo(el, 
        { y: type === 'up' ? 30 : 0, opacity: 0 },
        {
          y: 0, opacity: 1, duration: 1, ease: "power2.out",
          scrollTrigger: {
            trigger: el,
            start: "top 85%",
          }
        }
      );
    });
  }

  // Init on load and after view transitions
  initCinemaSequence();
  document.addEventListener('astro:after-swap', initCinemaSequence);
</script>

<style>
  /* ════════════════════════════════════════════════════════════
     ACT I: THE CINEMATIC TRACK
     ════════════════════════════════════════════════════════════ */
  .cinema-track {
    position: relative;
    width: 100%;
    height: 100vh;
    background: var(--color-void);
    overflow: hidden;
  }

  .cinema-visual {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    opacity: 0.7;
  }

  .cinema-artifact {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(20%) contrast(1.1);
    transform-origin: center;
    animation: slowBreathing 20s ease-in-out infinite alternate;
  }

  .cinema-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 0%, var(--color-void) 80%);
    z-index: 2;
  }

  @keyframes slowBreathing {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }

  /* The Escape Hatch */
  .ux-bypass {
    position: absolute;
    top: 30px;
    right: 30px;
    z-index: 100;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(198, 156, 82, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid rgba(198, 156, 82, 0.3);
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .ux-bypass:hover {
    color: var(--color-gold);
    border-color: var(--color-gold);
    background: rgba(198, 156, 82, 0.1);
  }

  .cinema-beats-container {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cinema-beat {
    position: absolute;
    text-align: center;
    max-width: 900px;
    padding: 0 var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    will-change: transform, opacity, filter;
  }
  
  @media (max-width: 799px) {
    .cinema-beats-container {
      position: relative;
      flex-direction: column;
      padding: 20vh 0;
      gap: 50vh;
    }
    .cinema-beat {
      position: relative;
    }
    .cinema-track {
      height: auto;
    }
    .cinema-visual {
      position: sticky;
      top: 0;
      height: 100vh;
    }
  }

  .cinema-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }

  .cinema-subtitle {
    font-family: var(--font-narrative);
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    color: rgba(245, 240, 232, 0.7);
    margin: 0;
    line-height: 1.5;
    letter-spacing: 0.05em;
  }

  .cinema-gold {
    color: var(--color-gold);
    font-style: italic;
  }

  .scroll-cue {
    margin-top: 5vh;
    height: 80px;
    width: 1px;
    position: relative;
    overflow: hidden;
  }

  .scroll-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, transparent, var(--color-gold), transparent);
    animation: scrollDraw 2s ease-in-out infinite;
  }

  @keyframes scrollDraw {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  /* ════════════════════════════════════════════════════════════
     ACT II: THE YIELDS (Simplified CSS)
     ════════════════════════════════════════════════════════════ */
  .the-yields {
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-forest-deep);
    min-height: 100vh;
    position: relative;
    z-index: 20; /* Sit above the pinned cinema track */
  }

  .yields-header {
    text-align: center;
    margin-bottom: var(--space-4xl);
  }

  .yields-title {
    font-family: var(--font-display);
    font-size: var(--type-display);
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-lg) 0;
    letter-spacing: 0.05em;
  }

  .yields-subtitle {
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    color: rgba(245, 240, 232, 0.7);
    max-width: 540px;
    margin: 0 auto;
    line-height: var(--line-height-loose);
  }

  .yields-grid-compact {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(198, 156, 82, 0.2);
  }

  .product-row {
    border-bottom: 1px solid rgba(198, 156, 82, 0.2);
    transition: background var(--duration-standard) var(--ease-settle);
  }

  .product-row:hover {
    background: rgba(198, 156, 82, 0.05);
  }

  .product-row-link {
    display: grid;
    grid-template-columns: 80px 1fr auto auto;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-md) var(--space-lg);
    text-decoration: none;
    color: inherit;
  }

  .product-row-image {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(245, 240, 232, 0.03);
    border-radius: 4px;
    overflow: hidden;
  }

  .product-row-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: var(--space-sm);
    filter: grayscale(20%) brightness(0.9);
    transition: transform var(--duration-standard) var(--ease-settle);
  }

  .product-row:hover .product-row-image img {
    transform: scale(1.1);
    filter: grayscale(0%) brightness(1);
  }

  .product-row-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-row-meta {
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .product-row-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-warm-cream);
    margin: 0;
  }

  .product-row-price {
    font-family: var(--font-evidence);
    font-size: 1.1rem;
    color: var(--color-warm-cream);
  }

  .product-row-price span {
    font-size: 0.8rem;
    color: rgba(245, 240, 232, 0.4);
  }

  .btn-buy-now {
    font-family: var(--font-evidence);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    border: 1px solid rgba(198, 156, 82, 0.4);
    padding: 8px 16px;
    border-radius: 20px;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .product-row:hover .btn-buy-now {
    background: var(--color-gold);
    color: var(--color-void);
  }

  @media (max-width: 768px) {
    .product-row-link {
      grid-template-columns: 60px 1fr;
      grid-template-rows: auto auto;
      gap: var(--space-md);
      padding: var(--space-md) 0;
    }
    
    .product-row-image {
      width: 60px;
      height: 60px;
      grid-row: span 2;
    }
    
    .product-row-price {
      grid-column: 2;
      font-size: 1rem;
    }
    
    .product-row-action {
      display: none; /* Hide button on mobile, whole row is clickable */
    }
  }

  /* ════════════════════════════════════════════════════════════
     ACT III: THE WALK
     ════════════════════════════════════════════════════════════ */
  .the-walk {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .walk-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(40%) brightness(0.35);
  }

  .walk-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-forest-deep) 0%, transparent 40%, transparent 60%, var(--color-void) 100%);
  }

  .walk-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 600px;
    padding: var(--space-4xl) var(--space-xl);
  }

  .walk-statement {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-statement);
    font-weight: 300;
    line-height: 1.4;
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-3xl) 0;
  }

  .walk-link {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity var(--duration-standard) var(--ease-settle);
  }

  .walk-link:hover {
    opacity: 0.7;
  }
</style>
