---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import OriginMark from '../components/OriginMark.astro';

const products = await getCollection('products');
const origins = await getCollection('origins');

function getOriginForProduct(product: any) {
  const originId = typeof product.data.originSlug === 'object' ? product.data.originSlug?.id : product.data.originSlug;
  return origins.find(o => o.id === originId);
}
---

<BaseLayout
  title="OurOrigin | The Truth is in the Soil"
  description="We do not make. We walk. Deep into the Western Ghats."
  canonicalPath="/"
  ogTitle="OurOrigin"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={true}
  bodyClass="void-canvas-body"
>
    <main class="story-scroll-container">
        
        <!-- SCENE 1: THE ORIGIN -->
        <section class="story-scene" id="scene-hero">
            <div class="scene-content">
                <div id="hero-mark-wrapper">
                    <OriginMark size={150} variant="gold" id="hero-mark-svg" />
                </div>
                <h1 class="indigenous-truth hero-headline">
                    We do not make. We walk.
                </h1>
            </div>
        </section>

        <!-- Graphic Transition Element 1 (The Long Distance Stripe) -->
        <div class="graphic-element" id="transition-stripe">
             <svg viewBox="0 0 100 100" width="100%" height="100%" preserveAspectRatio="none">
                 <path d="M 50 0 Q 55 50 45 100" fill="none" stroke="var(--color-gold)" stroke-width="2" />
             </svg>
        </div>

        <!-- SCENE 2: THE SOIL -->
        <section class="story-scene" id="scene-soil">
            <div class="scene-content">
                <h2 class="indigenous-truth">
                    Deep in the Western Ghats. Laterite and forest loam built from centuries of undisturbed decay.<br/><br/>
                    The harvest is not taken; it is yielded. We take only what the forest gives, and leave what belongs to the earth.
                </h2>
            </div>
        </section>

        <!-- Graphic Transition Element 2 (The Enlarged Yield Dot) -->
        <div class="graphic-element" id="transition-dot">
            <svg viewBox="0 0 120 120" width="100%" height="100%">
                <path d="M 90 22 C 93 18, 98 22, 97 26 C 96 30, 90 32, 87 27 C 84 22, 87 19, 90 22 Z" fill="var(--color-gold)" opacity="0.15" />
            </svg>
        </div>

        <!-- SCENE 3: THE HANDS -->
        <section class="story-scene" id="scene-hands">
            <div class="scene-bg" id="hands-bg" style="background-image: url('/assets/origins/idukki-hand.webp')"></div>
            <div class="scene-content">
                <h2 class="indigenous-truth">
                    The true cost is the distance walked.<br/>
                    The true value is the dignity of the hands that gathered it.
                </h2>
            </div>
        </section>

        <!-- Graphic Transition Element 3 (Horizontal Stripes) -->
        <div class="graphic-element" id="transition-horizontal-stripe">
             <svg viewBox="0 0 100 10" width="100%" height="100%" preserveAspectRatio="none">
                 <path d="M 0 5 Q 50 0 100 8" fill="none" stroke="var(--color-gold)" stroke-width="2" />
             </svg>
        </div>

        <!-- SCENE 4: THE YIELD (PRODUCTS) -->
        <section class="story-scene product-arrival" id="scene-yield">
            <div class="scene-content yield-content">
                <h2 class="indigenous-truth section-title">Honor the harvest.</h2>
                
                <div class="yield-grid">
                    {products.map(product => {
                        const origin = getOriginForProduct(product);
                        const originName = origin ? origin.data.name : 'Unknown Origin';
                        return (
                            <article class="yield-card">
                                <div class="yield-image-wrapper">
                                    <img src={product.data.image} alt={product.data.name} loading="lazy" />
                                </div>
                                <div class="yield-meta">
                                    <h3>{product.data.name}</h3>
                                    <span class="origin-tag">{originName}</span>
                                    <div class="yield-action">
                                        <span class="price">₹{product.data.price}</span>
                                        <button class="honor-decision-btn"
                                            data-product-id={product.id}
                                            data-product-name={product.data.name}
                                            data-product-price={product.data.price}
                                            data-product-image={product.data.image}
                                        >
                                            [ Honor ]
                                        </button>
                                    </div>
                                </div>
                            </article>
                        )
                    })}
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Initial States
  gsap.set("#scene-soil .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#scene-hands .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#scene-yield .scene-content", { autoAlpha: 0, y: 100 });
  gsap.set("#hands-bg", { autoAlpha: 0, scale: 1.1 });
  
  gsap.set("#transition-stripe", { scaleY: 0, transformOrigin: "top center", autoAlpha: 0 });
  gsap.set("#transition-dot", { scale: 0, autoAlpha: 0 });
  gsap.set("#transition-horizontal-stripe", { scaleX: 0, transformOrigin: "left center", autoAlpha: 0 });

  // Master Narrative Timeline
  const tl = gsap.timeline({
      scrollTrigger: {
          trigger: ".story-scroll-container",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
      }
  });

  // Scene 1 -> 2: Mark scales down, Stripe grows
  tl.to("#hero-mark-wrapper", { scale: 0.5, y: -50, autoAlpha: 0, ease: "power1.inOut" }, 0)
  .to(".hero-headline", { autoAlpha: 0, y: -50 }, 0)
  .to("#transition-stripe", { scaleY: 1, autoAlpha: 1, ease: "power2.inOut" }, 0.1)
  .to("#scene-soil .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.2);

  // Scene 2 -> 3: Stripe shrinks, Dot expands massively
  tl.to("#scene-soil .scene-content", { autoAlpha: 0, y: -50 }, 0.3)
  .to("#transition-stripe", { scaleY: 0, autoAlpha: 0, transformOrigin: "bottom center", ease: "power2.inOut" }, 0.3)
  .to("#transition-dot", { scale: 20, autoAlpha: 1, ease: "power2.inOut" }, 0.35) // Enormous dot acting as a texture
  .to("#hands-bg", { autoAlpha: 0.3, scale: 1, ease: "power2.out" }, 0.4)
  .to("#scene-hands .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.4);

  // Scene 3 -> 4: Dot fades, Horizontal stripe wipes across
  tl.to("#scene-hands .scene-content", { autoAlpha: 0, y: -50 }, 0.6)
  .to("#hands-bg", { autoAlpha: 0 }, 0.6)
  .to("#transition-dot", { autoAlpha: 0, scale: 0, ease: "power2.inOut" }, 0.6)
  .to("#transition-horizontal-stripe", { scaleX: 1, autoAlpha: 1, ease: "power2.inOut" }, 0.65)
  .to("#scene-yield .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out", pointerEvents: "auto" }, 0.7);

  // Cart Logic
  document.querySelectorAll('.honor-decision-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      
      const originalText = target.innerText;
      target.innerText = '[ Honored ✓ ]';
      target.style.color = 'var(--color-gold)';
      target.style.borderColor = 'var(--color-gold)';
      
      setTimeout(() => {
        target.innerText = originalText;
        target.style.color = '';
        target.style.borderColor = '';
      }, 2000);

      const event = new CustomEvent('cart-add', {
        detail: {
          id: target.dataset.productId,
          name: target.dataset.productName,
          price: parseInt(target.dataset.productPrice || '0', 10),
          image: target.dataset.productImage,
          quantity: 1
        }
      });
      window.dispatchEvent(event);
    });
  });
</script>

<style>
    .story-scroll-container {
        position: relative;
        background-color: var(--color-void);
        color: var(--color-warm-cream);
        min-height: 400vh;
    }

    .graphic-element {
        position: fixed;
        pointer-events: none;
        z-index: 5;
    }

    #transition-stripe {
        top: 0;
        left: 50%;
        width: 2px;
        height: 100vh;
        transform: translateX(-50%);
    }

    #transition-dot {
        top: 50%;
        left: 50%;
        width: 120px;
        height: 120px;
        transform: translate(-50%, -50%);
    }

    #transition-horizontal-stripe {
        top: 50%;
        left: 0;
        width: 100vw;
        height: 2px;
        transform: translateY(-50%);
    }

    .story-scene {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .scene-content {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        max-width: 1000px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        z-index: 10;
        pointer-events: none;
    }

    #scene-yield .scene-content {
        pointer-events: auto;
        position: relative;
        transform: none;
        top: auto;
        left: auto;
        margin-top: 50vh;
    }

    .scene-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-size: cover;
        background-position: center;
        z-index: 1;
        opacity: 0;
        filter: grayscale(80%) contrast(1.2);
    }

    #hero-mark-wrapper {
        margin-bottom: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .indigenous-truth {
        font-family: var(--font-institutional);
        font-size: clamp(1.8rem, 4vw, 3.5rem);
        font-weight: 300;
        line-height: 1.3;
        letter-spacing: 0.02em;
        color: var(--color-warm-cream);
        margin: 0;
    }

    .section-title {
        margin-bottom: 4rem;
        color: var(--color-gold);
    }

    /* YIELD GRID */
    .yield-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 3rem;
        width: 100%;
        max-width: 1200px;
    }

    .yield-card {
        background: transparent;
        border: 1px solid rgba(198, 156, 82, 0.2);
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: border-color 0.3s ease;
    }
    
    .yield-card:hover {
        border-color: rgba(198, 156, 82, 0.6);
    }

    .yield-image-wrapper {
        width: 100%;
        aspect-ratio: 1;
        margin-bottom: 2rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .yield-image-wrapper img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5));
    }

    .yield-meta h3 {
        font-family: var(--font-institutional);
        font-size: 1.5rem;
        margin: 0 0 0.5rem 0;
        font-weight: 400;
    }

    .origin-tag {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(245, 237, 216, 0.6);
        display: block;
        margin-bottom: 1.5rem;
    }

    .yield-action {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }

    .price {
        font-family: var(--font-mono);
        font-size: 1.2rem;
    }

    .honor-decision-btn {
        background: transparent;
        border: none;
        color: var(--color-warm-cream);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        padding: 0.5rem 1rem;
        transition: color 0.3s ease;
    }

    .honor-decision-btn:hover {
        color: var(--color-gold);
    }
</style>
