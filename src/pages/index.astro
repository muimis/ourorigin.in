---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';
import HeroSection from '../components/home/HeroSection.astro';
import HandSection from '../components/home/HandSection.astro';
import SustainabilitySection from '../components/home/SustainabilitySection.astro';
import TestimoniesSection from '../components/home/TestimoniesSection.astro';
import SoilCanvas from '../components/SoilCanvas.astro';

// Load content
const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

// Active products only
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});

// Build origin lookup for coordinate display
const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));
---

<Layout
  title="OurOrigin — Recorded at the source"
  description="A provenance record for what the land gives. Every yield carries its coordinate, its community, its batch reference. Currently sourcing from the Western Ghats."
  noHeaderPadding={true}
>

  <!-- ═══ ATMOSPHERE: soil particles fixed beneath everything ═══ -->
  <SoilCanvas />

  <!-- ═══ ACT I: THE LAND ═══ -->
  <HeroSection />

  <!-- ═══ ACT II: THE HAND ═══ -->
  <HandSection />

  <!-- ═══ ACT III: THE ARCHIVE — now earned ═══ -->
  <section class="the-archive" id="the-yields" aria-label="What the forest gave this season">

    <!-- Archive orientation — story-framed, not column headers -->
    <div class="archive-orientation" data-reveal="fade">
      <div class="orientation-mark">
        <OriginMark size={16} variant="gold" />
      </div>
      <div class="orientation-copy">
        <p class="orientation-statement">What the forest gave this season</p>
        <p class="orientation-note">Each yield carries its coordinate, its community, its batch reference.</p>
      </div>
      <div class="archive-meta" aria-label="Active harvests">
        <span class="meta-count">{activeProducts.length}</span>
        <span class="meta-label">active<br>harvests</span>
      </div>
    </div>

    <!-- The coordinate datum — updates on row hover -->
    <div class="coord-datum" id="coord-datum" aria-live="polite">
      <span class="coord-dot"></span>
      <span class="coord-text" id="coord-text">WESTERN GHATS · FIRST HANDS · DIRECT</span>
    </div>

    <div class="archive-list">
      {activeProducts.map((product, index) => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const origin = originMap[originId];
        const originName = origin ? origin.name : originId;
        const imgUrl = product.data.images?.product || product.data.images?.packaging || '';
        const coordStr = origin?.coordinates
          ? `${origin.coordinates} · ${originName.toUpperCase()} · ${origin.elevation || ''}`
          : `${originName.toUpperCase()}`;
        // specimenCopy — already written, now finally shown on hover
        const specimenCopy = (product.data as any).specimenCopy || '';

        return (
          <a
            href={`/origins/${originId}/${product.id}`}
            class="archive-row"
            data-coord={coordStr}
            data-img={imgUrl}
            data-specimen={specimenCopy}
          >
            {imgUrl && (
              <img
                src={imgUrl}
                alt={product.data.name}
                class="archive-hover-img"
                style={`view-transition-name: yield-img-${product.id}`}
                loading="lazy"
              />
            )}

            <div class="archive-cell archive-index" aria-hidden="true">
              <svg width="10" height="24" viewBox="0 0 10 30" fill="none" aria-hidden="true">
                <path d="M 5 2 C 4 10, 6 20, 5 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
            </div>

            <div class="archive-cell archive-origin">{originName}</div>

            <div class="archive-cell archive-specimen">
              <span style={`view-transition-name: yield-title-${product.id}`}>{product.data.name}</span>
            </div>

            {/* Micro-narrative: the specimenCopy, shown on hover desktop only */}
            {specimenCopy && (
              <div class="archive-micro" aria-hidden="true">
                <p class="micro-text">{specimenCopy}</p>
              </div>
            )}

            <div class="archive-cell archive-status" aria-label="Available">
              <span class="status-tally" aria-hidden="true">
                <svg width="12" height="24" viewBox="0 0 12 30" fill="none">
                  <path d="M 5 2 C 4 10, 6 20, 5 28" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Archive closer — bridge to the why -->
    <div class="archive-closer" data-reveal="fade">
      <a href="/about" class="closer-link">
        <span>Why these hands? Why this record?</span>
        <span class="closer-arrow">→</span>
      </a>
    </div>

  </section>

  <!-- ═══ ACT IV: THE WHY ═══ -->
  <SustainabilitySection />
  <TestimoniesSection />

</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initArchive() {
    const coordEl = document.getElementById('coord-text');
    const defaultCoord = 'WESTERN GHATS · FIRST HANDS · DIRECT';

    // Row coordinate & image reveal on hover
    const rows = document.querySelectorAll<HTMLElement>('.archive-row');
    rows.forEach(row => {
      const coord = row.dataset.coord || defaultCoord;
      const micro = row.querySelector<HTMLElement>('.archive-micro');

      row.addEventListener('mouseenter', () => {
        if (coordEl) coordEl.textContent = coord;
        if (micro) {
          gsap.to(micro, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' });
        }
      });
      row.addEventListener('mouseleave', () => {
        if (coordEl) coordEl.textContent = defaultCoord;
        if (micro) {
          gsap.to(micro, { opacity: 0, y: 8, duration: 0.3, ease: 'power2.in' });
        }
      });
    });

    // Orientation block reveals
    gsap.fromTo('.archive-orientation',
      { opacity: 0, y: 16 },
      {
        opacity: 1, y: 0,
        duration: 0.9, ease: 'power2.out',
        scrollTrigger: {
          trigger: '.the-archive',
          start: 'top 82%',
        }
      }
    );

    // Staggered row entrance
    gsap.fromTo('.archive-row',
      { y: 18, opacity: 0 },
      {
        y: 0,
        opacity: 1,
        duration: 0.55,
        ease: 'power2.out',
        stagger: 0.06,
        scrollTrigger: {
          trigger: '.archive-list',
          start: 'top 88%',
        }
      }
    );

    // Coord datum fade in
    gsap.fromTo('#coord-datum',
      { opacity: 0 },
      { opacity: 1, duration: 0.6, ease: 'power2.out', delay: 0.2,
        scrollTrigger: { trigger: '.archive-list', start: 'top 90%' }
      }
    );
  }

  initArchive();
  document.addEventListener('astro:after-swap', initArchive);
</script>

<style>
  /* ═══════════════════════════
     ACT III — THE ARCHIVE
  ═══════════════════════════ */

  .the-archive {
    position: relative;
    padding: clamp(4rem, 8vh, 7rem) clamp(1.5rem, 6vw, 5rem) clamp(4rem, 8vh, 6rem);
    background-color: var(--color-void);
    min-height: 60vh;
    z-index: 10;
    border-top: 1px solid rgba(240, 234, 214, 0.05);
  }

  /* ─── Archive orientation ─── */
  .archive-orientation {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: clamp(2.5rem, 5vh, 4rem);
    padding-bottom: clamp(1.5rem, 3vh, 2.5rem);
    border-bottom: 1px solid rgba(240, 234, 214, 0.08);
    opacity: 0; /* GSAP reveals */
  }

  .orientation-mark {
    padding-top: 3px;
    flex-shrink: 0;
  }

  .orientation-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .orientation-statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: var(--color-warm-cream);
    font-weight: 400;
    line-height: 1.2;
  }

  .orientation-note {
    margin: 0;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(240, 234, 214, 0.28);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .archive-meta {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-shrink: 0;
    text-align: right;
  }

  .meta-count {
    font-family: var(--font-evidence);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: rgba(255, 69, 0, 0.4);
    line-height: 1;
  }

  .meta-label {
    font-family: var(--font-evidence);
    font-size: 8px;
    color: rgba(240, 234, 214, 0.2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  /* ─── Coordinate datum ─── */
  .coord-datum {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: clamp(1rem, 2vh, 1.5rem);
    opacity: 0; /* GSAP reveals */
  }

  .coord-dot {
    width: 5px;
    height: 5px;
    background: var(--color-gold);
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 6px var(--color-gold);
  }

  .coord-text {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(240, 234, 214, 0.35);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: opacity 0.25s ease;
  }

  /* ─── Rows ─── */
  .archive-list {
    display: flex;
    flex-direction: column;
  }

  .archive-row {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr 2fr 1fr 72px;
    padding: var(--space-xl) 0;
    border-bottom: 1px solid rgba(240, 234, 214, 0.06);
    text-decoration: none;
    color: var(--color-warm-cream);
    transition: color 0.18s ease;
    align-items: center;
    overflow: hidden;
    min-height: 72px;
  }

  /* Warm ground-level sweep on hover */
  .archive-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(255, 69, 0, 0.04) 0%,
      rgba(255, 69, 0, 0.02) 60%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .archive-row:hover::before {
    opacity: 1;
  }

  .archive-cell {
    display: flex;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    position: relative;
    z-index: 2;
  }

  .archive-index {
    gap: var(--space-sm);
    color: rgba(240, 234, 214, 0.18);
  }

  .index-num {
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .archive-origin {
    font-size: var(--type-whisper);
    letter-spacing: 0.08em;
    color: rgba(240, 234, 214, 0.35);
    text-transform: uppercase;
  }

  .archive-specimen {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.7rem);
    letter-spacing: 0.02em;
    font-weight: 400;
    position: relative;
    z-index: 2;
  }

  /* ─── Micro-narrative (the specimenCopy, revealed on hover) ─── */
  .archive-micro {
    position: relative;
    z-index: 2;
    padding: 0 clamp(0.5rem, 1.5vw, 1.5rem);
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  .micro-text {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: clamp(0.78rem, 1.2vw, 0.9rem);
    font-style: italic;
    color: rgba(240, 234, 214, 0.38);
    line-height: 1.55;
    font-weight: 300;
    /* Clamp to two lines */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .archive-status {
    justify-content: flex-end;
    color: var(--color-gold);
    opacity: 0.5;
  }

  .status-tally {
    display: flex;
    align-items: center;
  }

  /* Hover states */
  .archive-row:hover .archive-cell {
    color: var(--color-warm-cream);
  }

  .archive-row:hover .archive-specimen {
    color: var(--color-gold);
  }

  .archive-row:hover .archive-origin {
    color: rgba(240, 234, 214, 0.6);
  }

  .archive-row:hover .archive-status {
    opacity: 1;
  }

  .archive-row:hover .archive-index {
    color: rgba(240, 234, 214, 0.35);
  }

  /* Hover image — more theatrical now */
  .archive-hover-img {
    position: fixed;
    top: 50%;
    left: 50%;
    width: 52vw;
    max-width: 560px;
    height: 52vh;
    transform: translate(-50%, -50%) scale(0.9);
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.45s ease;
    filter: grayscale(80%) brightness(0.7);
  }

  .archive-row:hover .archive-hover-img {
    opacity: 0.45;
    transform: translate(-50%, -50%) scale(1);
    filter: grayscale(20%) brightness(0.95);
  }

  /* ─── Archive closer ─── */
  .archive-closer {
    margin-top: clamp(2.5rem, 5vh, 4rem);
    padding-top: clamp(1.5rem, 3vh, 2rem);
    border-top: 1px solid rgba(240, 234, 214, 0.05);
  }

  .closer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(240, 234, 214, 0.25);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.25s ease;
    min-height: 44px;
  }

  .closer-link:hover {
    color: var(--color-gold);
  }

  .closer-arrow {
    transition: transform 0.25s ease;
  }

  .closer-link:hover .closer-arrow {
    transform: translateX(4px);
  }

  /* ═══════════════════════════
     MOBILE
  ═══════════════════════════ */
  @media (max-width: 768px) {
    .the-archive {
      padding: clamp(3rem, 6vh, 5rem) 1.5rem clamp(3rem, 6vh, 4rem);
    }

    .archive-orientation {
      flex-wrap: wrap;
    }

    .archive-row {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto auto;
      gap: 2px var(--space-sm);
      padding: var(--space-lg) 0;
      align-items: start;
      min-height: auto;
    }

    .archive-index {
      display: none;
    }

    .archive-specimen {
      grid-column: 1;
      grid-row: 1;
      font-size: clamp(1.05rem, 5vw, 1.5rem);
    }

    .archive-origin {
      grid-column: 1;
      grid-row: 2;
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    .archive-micro {
      grid-column: 1 / -1;
      grid-row: 3;
      padding: 0;
      display: none; /* Hidden on mobile — tap to navigate */
    }

    .archive-status {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      justify-content: flex-end;
    }

    .archive-hover-img {
      display: none;
    }

    .coord-datum {
      display: none;
    }
  }
</style>
