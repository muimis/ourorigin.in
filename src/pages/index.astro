---
import BaseLayout from '../components/BaseLayout.astro';
import ThePortal from '../components/ThePortal.astro';
import TheManifesto from '../components/TheManifesto.astro';
import TheCore from '../components/TheCore.astro';
import TheObservationsList from '../components/TheObservationsList.astro';
---

<BaseLayout
  title="OurOrigin — The Absolute Truth of the Soil"
  description="OurOrigin connects you to pure natural ingredients, community-harvested directly from their soil of origin. Traceable to the community who harvested them."
  canonicalPath="/"
  ogTitle="OurOrigin — The Absolute Truth of the Soil"
  ogDescription="Pure natural ingredients, community-harvested directly from their soil of origin."
  navVariant="light"
  showFooter={true}
  bodyClass="homepage-body"
>
    <main>
        <!-- Act I: The Arrival -->
        <ThePortal />
        
        <!-- Act II: The Story -->
        <TheManifesto />

        <!-- Act III: The Yield -->
        <TheCore />

        <!-- Act IV: Field Notes from the Forest -->
        <TheObservationsList />
    </main>
</BaseLayout>

<style is:global>
    body.homepage-body {
        background-color: #010201 !important;
        overflow-x: hidden !important;
        width: 100%;
    }
</style>

<style>
    main {
        position: relative;
        width: 100%;
        background-color: var(--color-forest-deep);
    }
</style>
