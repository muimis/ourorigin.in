---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Not Found — OurOrigin"
  description="The trail ends here. But the origin continues."
>
    <main class="page-container">
        <h1>404</h1>
        <p>The trail ends here. But the origin continues.</p>
        <a href="/#the-core" class="nav-link">← Back to The Core</a>
    </main>
</Layout>

<style>
    .page-container {
        min-height: 80vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 0 5vw;
    }

    h1 {
        font-family: var(--font-display);
        font-size: clamp(6rem, 15vw, 10rem);
        margin: 0;
        font-weight: 400;
        opacity: 0.06;
        color: var(--color-warm-cream);
        line-height: 1;
    }

    p {
        font-family: var(--font-narrative);
        font-size: var(--type-narrative);
        line-height: var(--line-height-loose);
        margin: 0;
        color: var(--color-warm-cream);
        opacity: 0.7;
    }

    .nav-link {
        font-family: var(--font-evidence);
        font-size: var(--type-evidence);
        color: rgba(245, 240, 232, 0.4);
        text-decoration: none;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-top: 3rem;
        display: inline-block;
        transition: color var(--duration-standard) var(--ease-settle);
    }

    .nav-link:hover {
        color: var(--color-warm-cream);
    }
</style>
