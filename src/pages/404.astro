---
import Layout from '../layouts/Layout.astro';
import OriginMark from '../components/OriginMark.astro';
---

<Layout
  title="Page Not Found — OurOrigin"
  description="The trail ends here, but the origin continues."
>
  <div class="not-found-page">
    <div class="container-narrow not-found-content">
      <OriginMark size={36} variant="gold" />
      <span class="badge-origin badge-gold">404 ERROR</span>
      <h1 class="not-found-title font-serif">The Trail Ends Here</h1>
      <p class="not-found-desc text-muted">
        The page you are looking for has moved or does not exist. The harvests and origins remain intact.
      </p>
      <a href="/" class="btn-primary">← Return to Season's Harvest</a>
    </div>
  </div>
</Layout>

<style>
  .not-found-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4rem, 8vw, 6rem) 0;
    background-color: var(--color-bone);
  }

  .not-found-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
  }

  .not-found-title {
    font-size: var(--type-display);
    margin: 0;
  }

  .not-found-desc {
    font-size: 1rem;
    max-width: 360px;
    margin: 0;
  }
</style>
