---
import OriginMark from './OriginMark.astro';
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="OurOrigin Home">
      <div class="brand-lockup">
        <OriginMark size={28} variant="reversed" />
        <span class="brand-name">OurOrigin</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary Navigation">
      <a href="/#harvest" class="nav-item">Harvests</a>
      <a href="/#origins" class="nav-item">Origins</a>
      <a href="/about" class="nav-item">Our Ethos</a>
      <a href="/ledger" class="nav-item">The Ledger</a>
      <a href="/observations" class="nav-item">Field Notes</a>
      <a href="/contact" class="nav-item">Contact</a>
    </nav>

    <!-- Header Actions (Cart & Mobile Hamburger) -->
    <div class="header-actions">
      <!-- Harvest Basket Trigger -->
      <button 
        type="button" 
        class="basket-btn" 
        id="global-basket-trigger"
        aria-label="Open Harvest Basket"
      >
        <span class="basket-icon-svg" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </span>
        <span class="basket-text">Harvest</span>
        <span class="basket-count" id="header-basket-count">0</span>
      </button>

      <!-- Mobile Menu Toggle -->
      <button 
        type="button" 
        class="mobile-toggle-btn" 
        id="mobile-toggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Navigation -->
  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <nav class="mobile-nav-links">
        <a href="/#harvest" class="mobile-nav-link">Harvests</a>
        <a href="/#origins" class="mobile-nav-link">Origins</a>
        <a href="/about" class="mobile-nav-link">Our Ethos</a>
        <a href="/ledger" class="mobile-nav-link">The Ledger</a>
        <a href="/observations" class="mobile-nav-link">Field Notes</a>
        <a href="/contact" class="mobile-nav-link">Contact</a>
      </nav>
      <div class="mobile-drawer-footer">
        <p class="mobile-footer-text">
          Real Food from Wild Earth · Direct from First Hands
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    background-color: rgba(250, 247, 242, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background-color var(--duration-base) var(--ease-smooth);
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1rem var(--gutter-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-deep-forest);
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 860px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-item {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 450;
    color: var(--color-ink-muted);
    transition: color var(--duration-base) var(--ease-smooth);
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-item:hover {
    color: var(--color-deep-forest);
  }

  .nav-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 1.5px;
    background-color: var(--color-mark-gold);
    transition: width var(--duration-base) var(--ease-smooth);
  }

  .nav-item:hover::after {
    width: 100%;
  }

  /* Header Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .basket-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 9999px;
    color: var(--color-deep-forest);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: var(--shadow-subtle);
    transition: all var(--duration-base) var(--ease-smooth);
  }

  .basket-btn:hover {
    border-color: var(--color-mark-gold);
    transform: translateY(-1px);
  }

  .basket-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.25rem;
    background-color: var(--color-mark-gold);
    color: #0C150A;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    border-radius: 9999px;
  }

  /* Mobile Toggle */
  .mobile-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    border-radius: 4px;
    background: transparent;
    border: none;
  }

  @media (min-width: 860px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .hamburger-bar {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-deep-forest);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-toggle-btn.is-active .hamburger-bar:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle-btn.is-active .hamburger-bar:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile Drawer */
  .mobile-drawer {
    display: none;
    position: fixed;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: var(--color-bone);
    border-bottom: 1px solid var(--color-border-subtle);
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-drawer-inner {
    padding: 1.5rem var(--gutter-x) 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-deep-forest);
    padding: 0.25rem 0;
  }

  .mobile-drawer-footer {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .mobile-footer-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
    margin: 0;
  }
</style>

<script>
  function setupHeader() {
    const mobileToggle = document.getElementById('mobile-toggle');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const basketTrigger = document.getElementById('global-basket-trigger');

    if (mobileToggle && mobileDrawer) {
      mobileToggle.addEventListener('click', () => {
        const isOpen = mobileDrawer.classList.toggle('is-open');
        mobileToggle.classList.toggle('is-active', isOpen);
        mobileToggle.setAttribute('aria-expanded', String(isOpen));
        mobileDrawer.setAttribute('aria-hidden', String(!isOpen));
      });

      // Close mobile menu on navigation link click
      mobileDrawer.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileDrawer.classList.remove('is-open');
          mobileToggle.classList.remove('is-active');
          mobileToggle.setAttribute('aria-expanded', 'false');
          mobileDrawer.setAttribute('aria-hidden', 'true');
        });
      });
    }

    if (basketTrigger) {
      basketTrigger.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('toggle-basket'));
      });
    }

    // Sync header basket count from localStorage
    function updateHeaderCount() {
      try {
        const stored = localStorage.getItem('ourorigin_basket');
        const items = stored ? JSON.parse(stored) : [];
        const totalCount = items.reduce((acc: number, item: any) => acc + (Number(item.quantity) || 1), 0);
        const countEl = document.getElementById('header-basket-count');
        if (countEl) {
          countEl.textContent = String(totalCount);
        }
      } catch (e) {
        // Fallback
      }
    }

    updateHeaderCount();
    window.addEventListener('basket-updated', updateHeaderCount);
  }

  document.addEventListener('DOMContentLoaded', setupHeader);
  document.addEventListener('astro:page-load', setupHeader);
</script>
