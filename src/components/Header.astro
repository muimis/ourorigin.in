---
import OriginMark from './OriginMark.astro';
import TallyCounter from './TallyCounter.astro';
---
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="OurOrigin — Home">
      <div class="brand-lockup" style="view-transition-name: origin-mark-global;">
        <OriginMark size={28} variant="gold" />
        <span class="brand-name">OurOrigin</span>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="main-nav desktop-nav" aria-label="Main navigation">
      <a href="/" class="nav-link">Home</a>
      <a href="/#origins" class="nav-link">Origins</a>
      <a href="/observations" class="nav-link">Field Notes</a>
      <a href="/about" class="nav-link">Why</a>
      <a href="/contact" class="nav-link">Contact</a>
      <button class="nav-link nav-link--yields" id="all-yields-trigger" type="button" aria-label="Browse the live soil">
        The Soil (Live)
      </button>
    </nav>

    <!-- Ledger Count (always visible) -->
    <button class="ledger-indicator" id="ledger-trigger" type="button" aria-label="Open your ledger">
      <span class="ledger-count" id="ledger-count-wrapper">
        <TallyCounter count={0} size={24} />
      </span>
    </button>

    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-toggle" aria-label="Toggle menu" id="mobile-menu-toggle" aria-expanded="false">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>

  <!-- Mobile Nav Menu -->
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <a href="/" class="mobile-nav-link">Home</a>
    <a href="/#origins" class="mobile-nav-link">Origins</a>
    <a href="/observations" class="mobile-nav-link">Field Notes</a>
    <a href="/about" class="mobile-nav-link">Why</a>
    <a href="/contact" class="mobile-nav-link">Contact</a>
    <button class="mobile-nav-link mobile-nav-link--yields" id="mobile-yields-trigger" type="button">
      The Soil (Live) →
    </button>
  </nav>
</header>

<script>
  function renderTallySvg(count: number) {
    if (count <= 0) {
      return `<span class="tally-zero" style="font-family:var(--font-evidence);font-size:12px;color:var(--color-bone-muted);">0</span>`;
    }
    const fullGroups = Math.floor(count / 5);
    const remainder = count % 5;
    let html = `<div class="tally-counter-live" style="display:inline-flex;align-items:center;gap:3px;height:18px;color:var(--color-mark-gold);">`;
    
    for (let i = 0; i < fullGroups; i++) {
      html += `<svg width="26" height="18" viewBox="0 0 60 40" fill="none" style="display:inline-block;">
        <g stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
          <path d="M 10 6 C 8 18, 12 30, 9 36" />
          <path d="M 22 4 C 19 18, 23 30, 20 38" />
          <path d="M 34 8 C 37 18, 32 28, 35 36" />
          <path d="M 46 4 C 43 16, 47 30, 44 38" />
          <path d="M 2 34 C 18 24, 35 14, 54 6" />
        </g>
      </svg>`;
    }

    if (remainder > 0) {
      const w = remainder * 7 + 8;
      html += `<svg width="${w}" height="18" viewBox="0 0 ${remainder * 14 + 10} 40" fill="none" style="display:inline-block;">
        <g stroke="currentColor" stroke-width="4.5" stroke-linecap="round">
          ${remainder >= 1 ? '<path d="M 8 6 C 6 18, 10 30, 7 36" />' : ''}
          ${remainder >= 2 ? '<path d="M 20 4 C 17 18, 21 30, 18 38" />' : ''}
          ${remainder >= 3 ? '<path d="M 32 8 C 35 18, 30 28, 33 36" />' : ''}
          ${remainder >= 4 ? '<path d="M 44 4 C 41 16, 45 30, 42 38" />' : ''}
        </g>
      </svg>`;
    }
    
    html += `</div>`;
    return html;
  }

  function initHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');

    if (toggleBtn && mobileNav) {
      const newToggle = toggleBtn.cloneNode(true) as HTMLElement;
      toggleBtn.parentNode?.replaceChild(newToggle, toggleBtn);

      newToggle.addEventListener('click', () => {
        const isExpanded = newToggle.getAttribute('aria-expanded') === 'true';
        newToggle.setAttribute('aria-expanded', (!isExpanded).toString());
        mobileNav.classList.toggle('is-open');
        newToggle.classList.toggle('is-active');
      });

      mobileNav.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileNav.classList.remove('is-open');
          newToggle.classList.remove('is-active');
          newToggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    // Update tally counter on cart updates
    const updateTally = (totalItems: number) => {
      const countWrapper = document.getElementById('ledger-count-wrapper');
      if (countWrapper) {
        countWrapper.innerHTML = renderTallySvg(totalItems);
      }
    };

    window.addEventListener('cart-updated', ((e: CustomEvent) => {
      if (e.detail) {
        updateTally(e.detail.totalItems || 0);
      }
    }) as EventListener);

    // Initial check from localStorage
    try {
      const stored = localStorage.getItem('ourorigin_cart');
      if (stored) {
        const items = JSON.parse(stored);
        const total = items.reduce((sum: number, i: any) => sum + (i.quantity || 1), 0);
        updateTally(total);
      }
    } catch (_) {}

    // Mobile yields trigger → open the All Yields panel
    const mobileYields = document.getElementById('mobile-yields-trigger');
    if (mobileYields) {
      mobileYields.addEventListener('click', () => {
        document.getElementById('all-yields-trigger')?.click();
        const toggle = document.getElementById('mobile-menu-toggle');
        const nav = document.getElementById('mobile-nav');
        nav?.classList.remove('is-open');
        toggle?.classList.remove('is-active');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initHeader);
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: var(--space-lg) var(--space-xl);
    background: linear-gradient(to bottom, rgba(12, 21, 9, 0.95) 0%, rgba(12, 21, 9, 0) 100%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1001;
  }

  .brand {
    text-decoration: none;
    color: var(--color-bone);
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    transition: opacity 0.1s;
  }

  .brand-name {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(240, 234, 214, 0.6);
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .brand:hover .brand-name {
    color: var(--color-mark-gold);
  }

  :global(body.is-splashing) .brand-lockup {
    opacity: 0;
  }

  .desktop-nav {
    display: flex;
    gap: var(--space-2xl);
    align-items: center;
  }

  .nav-link {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-bone-muted);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .nav-link:hover {
    color: var(--color-mark-gold);
  }

  .nav-link--yields {
    color: var(--color-mark-gold);
    border: 1px solid var(--color-gold-muted);
    padding: var(--space-xs) var(--space-lg);
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .nav-link--yields:hover {
    border-color: var(--color-mark-gold);
    background: var(--color-gold-muted);
  }

  /* Ledger Indicator */
  .ledger-indicator {
    position: relative;
    background: none;
    border: 1px solid var(--color-bone-whisper);
    color: var(--color-bone);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    transition: border-color var(--duration-standard) var(--ease-settle);
  }

  .ledger-indicator:hover {
    border-color: var(--color-mark-gold);
    color: var(--color-mark-gold);
  }

  .ledger-count {
    font-variant-numeric: tabular-nums;
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: var(--space-sm);
    min-height: 44px;
    min-width: 44px;
    align-items: center;
    justify-content: center;
  }

  .hamburger-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-bone);
    transition: transform var(--duration-standard) var(--ease-settle), opacity 0.2s;
  }

  .mobile-toggle.is-active .hamburger-line:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .mobile-toggle.is-active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.is-active .hamburger-line:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Nav Container */
  .mobile-nav {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: var(--color-deep-forest);
    padding: 8rem var(--space-xl) var(--space-xl);
    padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom, 0px));
    flex-direction: column;
    gap: var(--space-xl);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-10px);
    transition: all var(--duration-standard) var(--ease-settle);
    z-index: 999;
  }

  .mobile-nav.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-bone);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: var(--space-sm) 0;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .mobile-nav-link:hover {
    color: var(--color-mark-gold);
  }

  .mobile-nav-link--yields {
    color: var(--color-mark-gold);
    margin-top: var(--space-xl);
    border-top: 1px solid var(--color-gold-muted);
    padding-top: var(--space-xl);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: var(--space-md) var(--space-lg);
    }

    .desktop-nav {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .mobile-nav {
      display: flex;
    }

    .ledger-indicator {
      margin-right: var(--space-sm);
    }
  }
</style>
