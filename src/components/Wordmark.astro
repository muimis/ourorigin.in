---
export interface Props {
  className?: string;
  id?: string;
}

const { 
  className = '',
  id = Math.random().toString(36).substring(7),
} = Astro.props;
---

<div id={`wordmark-${id}`} class={`wordmark-container ${className}`}>
  <!-- The Accumulating Weight Wordmark -->
  <!-- Represents the long distance through the physical weight of the letters -->
  <div class="wordmark-text" aria-label="OurOrigin">
    <span class="char" style="font-weight: 200; opacity: 0.7;">O</span>
    <span class="char" style="font-weight: 300; opacity: 0.75;">u</span>
    <span class="char" style="font-weight: 300; opacity: 0.8;">r</span>
    <span class="char" style="font-weight: 400; opacity: 0.85;">O</span>
    <span class="char" style="font-weight: 500; opacity: 0.9;">r</span>
    <span class="char" style="font-weight: 600; opacity: 0.95;">i</span>
    <span class="char" style="font-weight: 700; opacity: 1.0;">g</span>
    <span class="char" style="font-weight: 800; opacity: 1.0;">i</span>
    <span class="char" style="font-weight: 900; opacity: 1.0;">n</span>
  </div>
</div>

<style>
  .wordmark-container {
    display: inline-block;
  }
  
  .wordmark-text {
    font-family: var(--font-institutional);
    font-size: inherit;
    display: flex;
    align-items: baseline;
    line-height: 1;
    color: var(--color-warm-cream);
    letter-spacing: 0.02em; /* Slight tracking */
  }

  .char {
    display: inline-block;
    transition: color 0.3s ease;
  }
</style>
