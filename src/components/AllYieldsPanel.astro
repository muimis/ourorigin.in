---
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const origins = await getCollection('origins');
const originMap = new Map();
origins.forEach(o => {
  originMap.set(o.id, {
    name: o.data.name,
    elevation: o.data.elevation
  });
});

const groupedProducts: Record<string, any> = {};

// We want to sort origins by elevation, same as LivingMatrix.
const orderedSlugs = ['nilgiris', 'idukki', 'wayanad', 'thiruvananthapuram'];
const orderedOriginIds = orderedSlugs.map(slug => origins.find(o => o.data.slug === slug)?.id).filter(Boolean);

orderedOriginIds.forEach(originId => {
  if(originId) {
    groupedProducts[originId] = {
      originInfo: originMap.get(originId),
      products: []
    };
  }
});

products.forEach(p => {
  const originId = typeof p.data.originSlug === 'object' ? p.data.originSlug.id : p.data.originSlug;
  if (groupedProducts[originId]) {
    groupedProducts[originId].products.push(p);
  }
});

// Helper to get highest elevation from string like "100m - 1500m"
function getHighestElevation(elevationString: string) {
  if (!elevationString) return '';
  const cleanStr = elevationString.replace(/,/g, '');
  const matches = cleanStr.match(/\d+/g);
  if (matches) {
    return Math.max(...matches.map(Number));
  }
  return cleanStr.replace(/[^0-9]/g, '');
}
---


<!-- Slide-in Panel -->
<div id="all-yields-panel" class="all-yields-panel hidden" aria-hidden="true">
  <div class="yields-header">
    <h2>ALL YIELDS</h2>
    <button id="all-yields-close" aria-label="Close all yields panel">✕</button>
  </div>
  <div class="yields-content">
    {orderedOriginIds.map(originId => {
      if(!originId) return null;
      const group = groupedProducts[originId];
      if (!group || group.products.length === 0) return null;
      
      const elevation = getHighestElevation(group.originInfo.elevation);
      
      return (
        <div class="yield-group">
          <h3>{group.originInfo.name.toUpperCase()} &nbsp;·&nbsp; {elevation}M</h3>
          <div class="yield-products">
            {group.products.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((product) => (
              <div class="yield-product-row">
                <div class="yield-product-name">{product.data.name}</div>
                <div class="yield-product-sizes">
                  {product.data.isAnchorProduct ? (
                    <div class="anchor-product-wrapper" data-explore-key={`ourorigin_explored_${originId}_${product.id}`}>
                      <div class="anchor-first-time">
                        <a href={`/origins/${originId}/${product.id}`} class="yield-action-btn enter-origin-btn">Enter this origin &rarr;</a>
                      </div>
                      <div class="anchor-returning hidden">
                        <p class="returning-note">You've been here before.</p>
                        {product.data.sizes.map((sizeObj) => (
                          <div class="yield-size-row">
                            <div class="yield-size-price">
                              {sizeObj.label} &nbsp;₹{sizeObj.priceINR}
                            </div>
                            <button class="yield-action-btn add-to-ledger-btn" data-product={JSON.stringify({
                              id: product.id,
                              name: product.data.name,
                              origin: group.originInfo.name,
                              originId: originId,
                              size: sizeObj.label,
                              price: sizeObj.priceINR
                            })}>Add</button>
                          </div>
                        ))}
                      </div>
                    </div>
                  ) : (
                    product.data.sizes.map((sizeObj) => (
                      <div class="yield-size-row">
                        <div class="yield-size-price">
                          {sizeObj.label} &nbsp;₹{sizeObj.priceINR}
                        </div>
                        <button class="yield-action-btn add-to-ledger-btn" data-product={JSON.stringify({
                          id: product.id,
                          name: product.data.name,
                          origin: group.originInfo.name,
                          originId: originId,
                          size: sizeObj.label,
                          price: sizeObj.priceINR
                        })}>Add</button>
                      </div>
                    ))
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}
    <div class="panel-fssai">FSSAI Reg. No. 21326135000354</div>
  </div>
</div>

<div id="all-yields-backdrop" class="yields-backdrop hidden"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('all-yields-panel');
    const closeBtn = document.getElementById('all-yields-close');
    const backdrop = document.getElementById('all-yields-backdrop');

    const openPanel = () => {
      // Evaluate returning visitor state for anchor products
      document.querySelectorAll('.anchor-product-wrapper').forEach(wrapper => {
        const key = wrapper.getAttribute('data-explore-key');
        if (localStorage.getItem(key) === 'true') {
          wrapper.querySelector('.anchor-first-time').classList.add('hidden');
          wrapper.querySelector('.anchor-returning').classList.remove('hidden');
        } else {
          wrapper.querySelector('.anchor-first-time').classList.remove('hidden');
          wrapper.querySelector('.anchor-returning').classList.add('hidden');
        }
      });

      panel.classList.remove('hidden');
      void panel.offsetWidth;
      panel.classList.add('open');
      backdrop.classList.remove('hidden');
      void backdrop.offsetWidth;
      backdrop.classList.add('visible');
      panel.setAttribute('aria-hidden', 'false');
    };

    const closePanel = () => {
      panel.classList.remove('open');
      backdrop.classList.remove('visible');
      panel.setAttribute('aria-hidden', 'true');
      setTimeout(() => {
        panel.classList.add('hidden');
        backdrop.classList.add('hidden');
      }, 400); 
    };

    if (closeBtn) closeBtn.addEventListener('click', closePanel);
    if (backdrop) backdrop.addEventListener('click', closePanel);
    
    // Listen for global event from DepthExperience
    window.addEventListener('open-all-yields-panel', openPanel);
    
    // Wiring Add buttons
    document.querySelectorAll('.add-to-ledger-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const productData = JSON.parse(btn.getAttribute('data-product') || '{}');
        
        const item = {
          id: productData.id + '-' + productData.size,
          productId: productData.id,
          name: productData.name,
          origin: productData.origin,
          originId: productData.originId,
          size: productData.size,
          price: productData.price,
          quantity: 1
        };
        
        window.dispatchEvent(new CustomEvent('add-to-ledger', { detail: item }));

        // Dynamic feedback
        const originalText = btn.textContent;
        btn.textContent = 'Honored \u2713';
        btn.classList.add('is-added');
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('is-added');
        }, 1200);
      });
    });
  });
</script>

<style>
  .all-yields-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 360px;
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-forest-deep);
    border-left: 1px dashed rgba(245, 240, 232, 0.2);
    z-index: 1100;
    transform: translateX(100%);
    transition: transform var(--duration-standard) var(--ease-settle);
    display: flex;
    flex-direction: column;
    color: var(--color-warm-cream);
  }
  
  @media (max-width: 768px) {
    .all-yields-panel {
      max-width: 100vw;
    }
  }
  
  .all-yields-panel.open {
    transform: translateX(0);
  }

  .yields-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(12, 21, 9, 0.6);
    backdrop-filter: blur(4px);
    z-index: 1050;
    opacity: 0;
    transition: opacity var(--duration-standard) var(--ease-settle);
    pointer-events: none;
  }
  .yields-backdrop.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .yields-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2xl) var(--space-xl);
    border-bottom: 1px dashed rgba(245, 240, 232, 0.2);
  }
  .yields-header h2 {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(245, 240, 232, 0.4);
    font-weight: 400;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .yields-header button {
    background: none;
    border: none;
    color: var(--color-warm-cream);
    font-size: 1rem;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity var(--duration-standard) var(--ease-settle);
    padding: var(--space-sm);
    min-height: 44px;
    min-width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .yields-header button:hover {
    opacity: 1;
  }

  .yields-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-xl);
  }
  
  .yield-group {
    margin-bottom: var(--space-3xl);
  }
  .yield-group h3 {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.3em;
    color: rgba(245, 240, 232, 0.5);
    margin: 0 0 var(--space-lg) 0;
    font-weight: 400;
    text-transform: uppercase;
  }
  
  .yield-products {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  
  .yield-product-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }
  
  .yield-product-name {
    font-family: var(--font-display);
    font-size: var(--type-narrative);
    color: rgba(245, 240, 232, 0.9);
    flex: 1;
    padding-right: var(--space-lg);
    line-height: var(--line-height-tight);
  }
  
  .yield-product-sizes {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 140px;
  }
  
  .yield-size-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .yield-size-price {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    white-space: pre;
  }
  
  .yield-action-btn {
    font-family: var(--font-narrative);
    font-size: var(--type-evidence);
    font-style: italic;
    color: rgba(245, 240, 232, 0.6);
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0 var(--space-xs);
    min-height: 44px;
    display: inline-flex;
