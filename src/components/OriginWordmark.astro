---
export interface Props {
  size?: number;
  variant?: "primary" | "reversed" | "forest";
  id?: string;
}

const { 
  size = 400, 
  variant = "forest", 
  id = Math.random().toString(36).substring(7)
} = Astro.props;

const colorMap = {
  primary: "var(--color-bone, #EFE6D3)",
  reversed: "var(--color-deep-forest, #0C1509)",
  forest: "var(--color-deep-forest, #0C1509)"
};
const textColor = colorMap[variant] || colorMap.forest;
// The background color behind the text, used to mask the original dot
const bgColor = variant === "primary" ? "var(--color-deep-forest, #0C1509)" : "var(--color-bone, #EFE6D3)";

---

<svg 
  id={`origin-wordmark-${id}`}
  class={`origin-wordmark variant-${variant}`} 
  width={size} 
  viewBox="0 0 460 110" 
  aria-label="OurOrigin"
  overflow="visible"
  style={`height: auto; max-width: ${size}px; display: block;`}
>
  <text 
    id={`wm-t-${id}`} 
    x="0" 
    y="86"
    font-family="'Cormorant Garamond', serif"
    font-size="94" 
    font-weight="400" 
    letter-spacing="-1"
    fill={textColor}
  >OurOrigin</text>
  <g id={`tt-g-${id}`} data-bg={bgColor}></g>
</svg>

<script>
  // ─────────────────────────────────────────────────────────────────────────────
  // TALLY TITTLE INJECTION
  // The dot above each lowercase 'i' in "OurOrigin" is replaced by
  // a short gold diagonal at 45° — the tally cross stroke, miniaturised.
  // ─────────────────────────────────────────────────────────────────────────────
  
  const GOLD = 'var(--color-mark-gold, #C99A5B)';

  function injectTittles(svgEl: SVGSVGElement) {
    if (svgEl.hasAttribute('data-tittles-injected')) return;
    
    const textEl = svgEl.querySelector('text');
    const groupEl = svgEl.querySelector('g');
    
    if (!textEl || !groupEl) return;
    
    const word = textEl.textContent || "";
    const bgFill = groupEl.getAttribute('data-bg') || '#EFE6D3';

    for (let i = 0; i < word.length; i++) {
      if (word[i] !== 'i') continue;
      
      try {
        const ext = textEl.getExtentOfChar(i);
        const cx = ext.x + ext.width * 0.50;
        const dotCy = ext.y + ext.height * 0.07;
        const cr = ext.height * 0.105;
        
        // Cover original dot
        const cover = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        cover.setAttribute('x', (cx - cr).toFixed(2));
        cover.setAttribute('y', (dotCy - cr * 0.9).toFixed(2));
        cover.setAttribute('width', (cr * 2).toFixed(2));
        cover.setAttribute('height', (cr * 2).toFixed(2));
        cover.setAttribute('fill', bgFill);
        groupEl.appendChild(cover);
        
        // Draw gold 45° diagonal
        const L = ext.height * 0.088;
        const c = 0.7071;
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        line.setAttribute('x1', (cx - L * c).toFixed(2));
        line.setAttribute('y1', (dotCy + L * c).toFixed(2));
        line.setAttribute('x2', (cx + L * c).toFixed(2));
        line.setAttribute('y2', (dotCy - L * c).toFixed(2));
        line.setAttribute('stroke', GOLD);
        line.setAttribute('stroke-width', (ext.height * 0.050).toFixed(2));
        line.setAttribute('stroke-linecap', 'round');
        groupEl.appendChild(line);
      } catch (e) {
        // getExtentOfChar might fail if SVG is not rendered yet, handled by fonts.ready
      }
    }
    
    svgEl.setAttribute('data-tittles-injected', 'true');
  }

  function initWordmarks() {
    document.fonts.ready.then(() => {
      // requestAnimationFrame ensures text layout is fully resolved
      requestAnimationFrame(() => requestAnimationFrame(() => {
        document.querySelectorAll('.origin-wordmark').forEach((svg) => {
          injectTittles(svg as SVGSVGElement);
        });
      }));
    });
  }

  // Play entrance on load
  if (!(window as any)["originWordmarkInit"]) {
    (window as any)["originWordmarkInit"] = true;
    document.addEventListener("DOMContentLoaded", initWordmarks);
    document.addEventListener("astro:page-load", initWordmarks);
  } else {
    document.addEventListener("astro:page-load", initWordmarks);
  }
</script>
