---
// src/components/OpeningSequence.astro
// A lightning-fast, emotional "blink to breath" experience.
---

<div id="blink-sequence" class="blink-sequence-container">
  <div class="blink-content">
    <h1 class="blink-title">OurOrigin</h1>
    <p class="blink-subtitle">The Absolute Truth of the Soil</p>
  </div>
</div>

<style>
  .blink-sequence-container {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #010201;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: opacity 1.5s var(--ease-fluid), visibility 1.5s;
  }

  .blink-sequence-container.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  .blink-content {
    text-align: center;
    color: var(--color-warm-cream, #F5EDD8);
    opacity: 0;
    transform: scale(0.95) translateY(10px);
    filter: blur(10px);
    transition: 
      opacity 1.8s var(--ease-fluid), 
      transform 2s var(--ease-fluid),
      filter 1.5s var(--ease-fluid);
  }

  .blink-content.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
    filter: blur(0px);
  }

  .blink-title {
    font-family: var(--font-narrative, 'Cormorant Garamond', serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 300;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem 0;
  }

  .blink-subtitle {
    font-family: var(--font-sans, 'Inter', sans-serif);
    font-size: 11px;
    letter-spacing: 0.25em;
    color: var(--color-gold, #A67C3C);
    margin: 0;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('blink-sequence');
    const content = container?.querySelector('.blink-content');

    if (container && content) {
      // 1. Organic breath in (blur reveal)
      requestAnimationFrame(() => {
        content.classList.add('is-visible');
      });

      // 2. Breath out (fade out container gently)
      setTimeout(() => {
        container.classList.add('is-hidden');
        setTimeout(() => {
          container.remove();
        }, 1500);
      }, 2000); // Linger slightly longer for mood
    }
  });
</script>
