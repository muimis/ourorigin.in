---
import { getCollection } from 'astro:content';

// Load products using Astro's content collections API
const productEntries = await getCollection('products');
const products = productEntries.map(p => ({
  ...p.data,
  slug: p.id
}));

// Select a few key products to showcase
const showcaseSlugs = ['black-pepper', 'cardamom', 'turmeric', 'cinnamon'];
const showcased = products.filter((p: any) => showcaseSlugs.includes(p.slug));
---

<section class="product-showcase-section" id="product-showcase">
  <div class="showcase-container">
    <div class="showcase-header">
      <h2 class="showcase-title">What the soil yielded this season.</h2>
      <p class="showcase-subtitle">Ready for you.</p>
    </div>

    <div class="product-grid">
      {showcased.map((product) => (
        <div class="product-card raw-panel ambient-glow">
          <div class="product-visual">
             <div class="product-placeholder"></div>
          </div>
          <div class="product-info">
            <h3 class="product-name">{product.name}</h3>
            <div class="product-origin">From {product.originSlug}</div>
            
            <div class="product-price">
              ₹{product.sizes[0].priceINR} <span class="product-size">/ {product.sizes[0].label}</span>
            </div>
            
            <button class="btn-primary buy-btn">
              <span class="btn-text">Bring Home</span>
              <span class="btn-arrow">&rarr;</span>
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .product-showcase-section {
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    z-index: 10;
    background: transparent;
  }

  .showcase-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: var(--space-4xl);
  }

  .showcase-title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    font-weight: 300;
    color: var(--color-warm-cream);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .showcase-subtitle {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    color: rgba(235, 229, 217, 0.7);
    margin-top: var(--space-md);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .product-card {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    transition: transform var(--duration-standard) var(--ease-settle);
  }
  
  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-visual {
    width: 100%;
    aspect-ratio: 1;
    background: rgba(255,255,255,0.02);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
  }

  .product-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(198, 156, 82, 0.1) 0%, rgba(12, 21, 9, 0.5) 100%);
    border: 1px solid rgba(198, 156, 82, 0.2);
    border-radius: 8px;
  }

  .product-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .product-name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    color: var(--color-warm-cream);
    margin: 0;
  }

  .product-origin {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-top: 0.5rem;
  }

  .product-price {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    color: var(--color-warm-cream);
    margin: var(--space-lg) 0;
  }

  .product-size {
    font-size: 0.9rem;
    color: rgba(235, 229, 217, 0.5);
  }

  .buy-btn {
    width: 100%;
    justify-content: center;
    padding: 1rem;
    font-size: 0.85rem;
  }
</style>
