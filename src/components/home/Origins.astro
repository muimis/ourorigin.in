---
// Origins.astro — Clean Terroir & Ecological Showcase
import { getCollection } from 'astro:content';

const allOrigins = await getCollection('origins');
const allProducts = await getCollection('products');

// Filter out malabar-coast if it has no products
const filteredOrigins = allOrigins.filter(o => o.id !== 'malabar-coast');

// Map products to origin
const productsByOrigin: Record<string, typeof allProducts> = {};
filteredOrigins.forEach(origin => {
  const originSlug = origin.data.slug;
  productsByOrigin[originSlug] = allProducts.filter(p => {
    const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any)?.id : p.data.originSlug;
    return originId === originSlug;
  });
});
---

<section class="origins-section" id="origins" aria-label="Origins and Terroirs">
  <div class="container">
    
    <!-- Section Header -->
    <div class="origins-header">
      <div class="origins-header-content">
        <span class="badge-origin badge-gold">TERROIR & MICRO-CLIMATES</span>
        <h2 class="origins-title font-serif">The Land That Shapes The Harvest</h2>
        <p class="origins-subtitle">
          Flavor is geography. Different elevations, monsoon currents, and soil structures give each harvest its unmistakable profile.
        </p>
      </div>
      <a href="/ledger" class="origins-ledger-link font-mono">
        <span>View Terroir Coordinates</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Origins Grid -->
    <div class="origins-grid">
      {filteredOrigins.map((origin) => {
        const yields = productsByOrigin[origin.data.slug] || [];
        const canopyImg = origin.data.images?.canopy || origin.data.images?.hand || '/assets/images/gesture_hands.png';
        const narrative = origin.data.narrative?.canopy || origin.data.soil || '';

        return (
          <article class="origin-card">
            <!-- Media Backdrop -->
            <div class="origin-card-media">
              <img 
                src={canopyImg} 
                alt={`${origin.data.name} terroir canopy`} 
                class="origin-img"
                loading="lazy"
                onerror="this.src='/assets/images/gesture_hands.png'"
              />
              <div class="origin-media-shade"></div>
              
              <div class="origin-media-meta">
                <span class="origin-elevation-badge font-mono">
                  ▲ {origin.data.elevation}
                </span>
                <span class="origin-coords-badge font-mono">
                  {origin.data.coordinates}
                </span>
              </div>
            </div>

            <!-- Content Area -->
            <div class="origin-card-body">
              <div class="origin-title-row">
                <h3 class="origin-name font-serif">{origin.data.name}</h3>
                <span class="origin-bioregion font-mono">{origin.data.bioregion}</span>
              </div>

              {origin.data.soil && (
                <div class="origin-soil-tag font-mono">
                  {origin.data.soil}
                </div>
              )}

              {narrative && (
                <p class="origin-story">
                  {narrative.length > 140 ? `${narrative.slice(0, 140)}...` : narrative}
                </p>
              )}

              <!-- Associated Yields -->
              <div class="origin-yields-wrapper">
                <span class="yields-label font-mono">KEY HARVESTS:</span>
                <div class="yields-pills">
                  {yields.slice(0, 4).map((item) => (
                    <a 
                      href={`/origins/${origin.data.slug}/${item.id}`} 
                      class="yield-pill"
                    >
                      {item.data.name}
                    </a>
                  ))}
                </div>
              </div>

              <!-- Explore Link -->
              <div class="origin-card-action">
                <a href={`/origins/${origin.data.slug}`} class="origin-explore-btn">
                  <span>Explore Terroir</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  .origins-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background-color: var(--color-bone-warm);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .origins-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 2rem;
  }

  @media (min-width: 860px) {
    .origins-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .origins-header-content {
    max-width: 600px;
  }

  .origins-title {
    font-size: var(--type-display);
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .origins-subtitle {
    font-size: 1rem;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .origins-ledger-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-deep-forest);
    font-weight: 500;
  }

  .origins-ledger-link:hover {
    color: var(--color-mark-gold);
  }

  /* Grid */
  .origins-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 720px) {
    .origins-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .origins-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Origin Card */
  .origin-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-subtle);
    transition: transform var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth);
  }

  .origin-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  .origin-card-media {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: var(--color-forest-dark);
    overflow: hidden;
  }

  .origin-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-smooth);
  }

  .origin-card:hover .origin-img {
    transform: scale(1.05);
  }

  .origin-media-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 21, 10, 0.15) 0%, rgba(12, 21, 10, 0.7) 100%);
  }

  .origin-media-meta {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    right: 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-bone);
    font-size: 0.6875rem;
  }

  .origin-elevation-badge {
    padding: 0.2rem 0.5rem;
    background-color: var(--color-mark-gold);
    color: #0C150A;
    font-weight: 600;
    border-radius: 4px;
  }

  .origin-coords-badge {
    opacity: 0.85;
    letter-spacing: 0.04em;
  }

  /* Card Body */
  .origin-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 1rem;
  }

  .origin-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .origin-name {
    font-size: 1.45rem;
    font-weight: 500;
    margin: 0;
    color: var(--color-deep-forest);
  }

  .origin-bioregion {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.05em;
  }

  .origin-soil-tag {
    font-size: 0.6875rem;
    color: var(--color-proof-green);
    letter-spacing: 0.06em;
  }

  .origin-story {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
    flex-grow: 1;
  }

  .origin-yields-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .yields-label {
    font-size: 0.625rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.08em;
  }

  .yields-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .yield-pill {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background-color: var(--color-bone-warm);
    border-radius: 4px;
    color: var(--color-deep-forest);
    transition: background-color var(--duration-base) var(--ease-smooth);
  }

  .yield-pill:hover {
    background-color: var(--color-mark-gold);
    color: #0C150A;
  }

  .origin-card-action {
    padding-top: 0.5rem;
  }

  .origin-explore-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  .origin-explore-btn:hover {
    color: var(--color-mark-gold);
  }
</style>
