---
// Origins.astro
import { getCollection } from 'astro:content';

const allOrigins = await getCollection('origins');
const allProducts = await getCollection('products');

function parseElevation(elevStr: string) {
  const match = String(elevStr || '').match(/[\d,]+/);
  return match ? parseInt(match[0].replace(/,/g, ''), 10) : 0;
}

// Sort: highest elevation first
const sortedOrigins = [...allOrigins].sort((a, b) => {
  return parseElevation(b.data.elevation) - parseElevation(a.data.elevation);
});

// Group products by origin
const productsByOrigin: Record<string, typeof allProducts> = {};
sortedOrigins.forEach(origin => {
  const originSlug = origin.data.slug;
  productsByOrigin[originSlug] = allProducts.filter(p => {
    const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any)?.id : p.data.originSlug;
    return originId === originSlug && p.data.sizes && p.data.sizes.length > 0;
  });
});
---

<section class="origins-section" id="origins" aria-label="Where It Grows">

  <div class="origins-header" data-reveal>
    <h2 class="section-title">Where It Grows</h2>
    <p class="section-desc">
      Different heights and climates produce different yields. From cold high-mountain teas and deep cardamom valleys to wild black pepper and ancestral millets.
    </p>
  </div>

  <div class="origins-container">
    {sortedOrigins.map((origin, index) => {
      const originProducts = productsByOrigin[origin.data.slug] || [];
      const canopyImg = origin.data.images?.canopy || '';
      const isFirst = index === 0;

      return (
        <div class="origin-node" data-realm={origin.data.slug} data-reveal>
          
          <button 
            type="button"
            class="origin-card" 
            aria-expanded={isFirst ? "true" : "false"}
            aria-controls={`yields-${origin.data.slug}`}
          >
            {canopyImg && (
              <div 
                class="origin-bg-image" 
                style={`background-image: url('${canopyImg}');`}
                aria-hidden="true"
              />
            )}
            <div class="origin-wash" aria-hidden="true"></div>

            <div class="origin-content">
              <span class="origin-elevation">
                <span class="elevation-icon" aria-hidden="true">▲</span>
                {origin.data.elevation}
              </span>
              <h3 class="origin-name">{origin.data.name}</h3>
              <p class="origin-soil">{origin.data.soil}</p>
            </div>

            <div class="origin-toggle">
              <span class="toggle-text">View Harvests</span>
              <span class="toggle-icon" aria-hidden="true">+</span>
            </div>
          </button>

          <!-- Drawer -->
          <div 
            id={`yields-${origin.data.slug}`} 
            class:list={["origin-yields", { "is-active": isFirst }]}
            aria-hidden={isFirst ? "false" : "true"}
          >
            <div class="yields-inner">
              <div class="yields-grid">
                {originProducts.length === 0 ? (
                  <p class="no-yields">Resting between seasons. Next harvest after the monsoon.</p>
                ) : (
                  originProducts.map((product) => {
                    const firstSize = product.data.sizes[0];
                    const prodImg = product.data.images?.product || product.data.images?.packaging || '';
                    const priceDisplay = product.data.sizes.length > 1
                      ? `₹${Math.min(...product.data.sizes.map(s => s.priceINR))} - ₹${Math.max(...product.data.sizes.map(s => s.priceINR))}`
                      : `₹${firstSize.priceINR}`;

                    const itemPayload = JSON.stringify({
                      id: `${product.id}-${firstSize.label}`,
                      productId: product.id,
                      name: product.data.name,
                      origin: origin.data.name,
                      originId: origin.id,
                      price: firstSize.priceINR,
                      size: firstSize.label,
                      weight: firstSize.label,
                      quantity: 1
                    });

                    return (
                      <div class="yield-card">
                        <a href={`/origins/${origin.data.slug}/${product.id}`} class="yield-img-link">
                          {prodImg && (
                            <img src={prodImg} alt={product.data.name} class="yield-img" loading="lazy" />
                          )}
                        </a>
                        <div class="yield-body">
                          <span class="yield-botanical">{product.data.botanicalName}</span>
                          <h4 class="yield-name">
                            <a href={`/origins/${origin.data.slug}/${product.id}`}>{product.data.name}</a>
                          </h4>
                          <div class="yield-footer">
                            <span class="yield-price">{priceDisplay}</span>
                            <button 
                              type="button"
                              class="btn-gather" 
                              data-product-json={itemPayload}
                            >
                              Add to Basket
                            </button>
                          </div>
                        </div>
                      </div>
                    );
                  })
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    const cardBtn = target.closest('.origin-card') as HTMLButtonElement | null;
    if (cardBtn) {
      e.preventDefault();
      const node = cardBtn.closest('.origin-node');
      if (!node) return;
      const panel = node.querySelector('.origin-yields');
      if (!panel) return;

      const isCurrentlyExpanded = cardBtn.getAttribute('aria-expanded') === 'true';
      const allNodes = document.querySelectorAll('.origin-node');

      allNodes.forEach((otherNode) => {
        const otherBtn = otherNode.querySelector('.origin-card');
        const otherPanel = otherNode.querySelector('.origin-yields');
        if (otherBtn && otherPanel) {
          otherBtn.setAttribute('aria-expanded', 'false');
          otherPanel.classList.remove('is-active');
          otherPanel.setAttribute('aria-hidden', 'true');
        }
      });

      if (!isCurrentlyExpanded) {
        cardBtn.setAttribute('aria-expanded', 'true');
        panel.classList.add('is-active');
        panel.setAttribute('aria-hidden', 'false');
      }
      return;
    }

    const addBtn = target.closest('.btn-gather') as HTMLElement | null;
    if (addBtn) {
      e.preventDefault();
      e.stopPropagation();

      const jsonStr = addBtn.dataset.productJson;
      if (!jsonStr) return;

      try {
        const item = JSON.parse(jsonStr);
        window.dispatchEvent(new CustomEvent('add-to-cart', { detail: item }));
        
        const originalText = addBtn.textContent;
        addBtn.textContent = 'Added';
        addBtn.classList.add('is-added');
        setTimeout(() => {
          addBtn.textContent = originalText;
          addBtn.classList.remove('is-added');
        }, 1400);
      } catch (err) {
        console.error('Error adding to harvest bundle:', err);
      }
    }
  });
</script>

<style>
  .origins-section {
    position: relative;
    z-index: 2;
    padding: clamp(5rem, 10vh, 8rem) clamp(1.5rem, 6vw, 6rem);
    background: var(--color-void);
  }

  .origins-header {
    max-width: 600px;
    margin-bottom: clamp(3rem, 6vh, 4.5rem);
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .section-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    color: var(--color-warm-cream);
    font-weight: 300;
  }

  .section-desc {
    margin: 1.5rem 0 0;
    font-family: var(--font-narrative);
    font-size: 1.1rem;
    color: var(--color-cream-muted);
    line-height: 1.7;
  }

  .origins-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .origin-node {
    background: transparent;
  }

  /* Organic Card Shape */
  .origin-card {
    position: relative;
    width: 100%;
    text-align: left;
    background: var(--color-forest-surface);
    border: 1px solid rgba(198, 156, 82, 0.2);
    /* Organic curving shape matching the logo's soft corners */
    border-radius: 40px 8px 40px 8px;
    padding: clamp(2rem, 4vw, 3.5rem);
    cursor: pointer;
    overflow: hidden;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-warm-cream);
    min-height: 200px;
    transition: all var(--duration-standard) ease;
  }

  .origin-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  .origin-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    transition: opacity var(--duration-slow) ease, transform var(--duration-slow) ease;
    z-index: 0;
    pointer-events: none;
  }

  .origin-card:hover .origin-bg-image,
  .origin-card[aria-expanded="true"] .origin-bg-image {
    opacity: 0.3;
    transform: scale(1.03);
  }

  .origin-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(8, 13, 6, 0.9) 0%, rgba(8, 13, 6, 0.5) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .origin-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .origin-elevation {
    color: var(--color-gold);
    font-family: var(--font-evidence);
    font-size: 13px;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .elevation-icon {
    font-size: 10px;
  }

  .origin-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-warm-cream);
    font-weight: 300;
  }

  .origin-soil {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: 15px;
    color: var(--color-cream-muted);
    font-style: italic;
  }

  .origin-toggle {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-evidence);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
  }

  .toggle-icon {
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .origin-card[aria-expanded="true"] .toggle-icon {
    transform: rotate(45deg);
  }

  /* Drawer */
  .origin-yields {
    display: none;
    margin-top: 1rem;
  }

  .origin-yields.is-active {
    display: block;
    animation: fadeIn 0.4s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .yields-inner {
    padding: 1rem 0 2rem;
  }

  .yields-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  /* Soft Organic Product Cards */
  .yield-card {
    background: transparent;
    border: 1px solid rgba(240, 234, 214, 0.1);
    border-radius: 8px 30px 8px 30px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all var(--duration-standard) ease;
  }

  .yield-card:hover {
    border-color: rgba(198, 156, 82, 0.4);
    background: rgba(198, 156, 82, 0.02);
  }

  .yield-img-link {
    height: 220px;
    background: #040603;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .yield-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) ease;
  }

  .yield-card:hover .yield-img {
    transform: scale(1.05);
  }

  .yield-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .yield-botanical {
    font-family: var(--font-narrative);
    font-style: italic;
    color: var(--color-gold);
    font-size: 13px;
    margin-bottom: 0.5rem;
  }

  .yield-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 300;
  }

  .yield-name a {
    color: var(--color-warm-cream);
    text-decoration: none;
  }

  .yield-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(240, 234, 214, 0.1);
  }

  .yield-price {
    font-family: var(--font-evidence);
    font-size: 14px;
    color: var(--color-warm-cream);
  }

  .btn-gather {
    background: transparent;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
    border-radius: 20px;
    padding: 0.4rem 1rem;
    font-family: var(--font-evidence);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-gather:hover {
    background: var(--color-gold);
    color: var(--color-void);
  }

  .btn-gather.is-added {
    background: var(--color-warm-cream);
    border-color: var(--color-warm-cream);
    color: var(--color-void);
  }

  .no-yields {
    color: var(--color-cream-muted);
    font-family: var(--font-narrative);
    font-style: italic;
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .origin-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
  }
</style>
