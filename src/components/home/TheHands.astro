---
// TheHands.astro — Editorial Light Mode Layout
import OriginMark from '../OriginMark.astro';
---

<section class="hands-section" id="the-hands" aria-label="Harvested by Hand">
  
  <div class="layout-pillar-grid">
    
    <!-- Pillar 1 & 2: The Photography -->
    <div class="hands-visual-col">
      <div class="hands-image-frame" id="hands-image-frame">
        <img
          src="/assets/origins/wayanad-hand-documentary.jpg"
          alt="Harvester's hands holding pepper and spices in Wayanad forest"
          class="hands-img"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <!-- Pillar 3 & 4: The Narrative -->
    <div class="hands-text-col">
      <div class="hands-narrative" id="hands-narrative">
        <div class="hands-label" data-reveal="fade">
          <span class="section-number">05</span>
          <div class="hero-line"></div>
          Picked by Hand
        </div>

        <blockquote class="hands-text" data-reveal>
          <p class="hands-lead">
            Whether harvesting whole tea leaves in the morning fog, climbing 40-foot trees for pepper, or cutting native millets with a sickle.
          </p>
          <p class="hands-para">
            Local farming families harvest only what nature gives willingly that morning: what is ripe, what is reachable, and what is ready.
          </p>
          <p class="hands-para hands-quiet">
            There is no corporate factory for this. Knowing which leaf, which berry, and which morning to pick is an instinct passed down through generations.
          </p>
        </blockquote>

        <div class="hands-bridge" data-reveal="fade">
          <div class="hands-mark-stamp">
            <OriginMark size={36} variant="primary" hideDot={true} />
            <div class="hands-mark-info">
              <span class="mark-label">THE TALLY GATE</span>
              <p class="bridge-text">The oldest proof on earth. They counted it first. Their count is the first count.</p>
            </div>
          </div>
          <a href="#harvest" class="bridge-link">
            Explore The Harvest →
          </a>
        </div>
      </div>
    </div>

  </div>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHands() {
    gsap.to('.hands-img', {
      yPercent: -8,
      ease: 'none',
      scrollTrigger: {
        trigger: '.hands-section',
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
      }
    });

    gsap.fromTo('#hands-image-frame',
      { opacity: 0, scale: 0.95 },
      {
        opacity: 1, scale: 1,
        duration: 1.2, ease: 'power2.out',
        scrollTrigger: {
          trigger: '#hands-image-frame',
          start: 'top 80%',
        }
      }
    );

    gsap.fromTo('.hands-para, .hands-lead, .hands-label, .hands-bridge',
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0,
        duration: 1.0, ease: 'power2.out',
        stagger: 0.15,
        scrollTrigger: {
          trigger: '.hands-narrative',
          start: 'top 75%',
        }
      }
    );
  }

  initHands();
  document.addEventListener('astro:after-swap', initHands);
  document.addEventListener('astro:page-load', initHands);
</script>

<style>
  .hands-section {
    position: relative;
    background-color: var(--color-bone);
    z-index: 2;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hands-visual-col {
    grid-column: span 2;
    border-right: 1px solid var(--color-border-subtle);
    padding: clamp(4rem, 8vh, 6rem) var(--space-xl);
  }

  .hands-text-col {
    grid-column: span 2;
    padding: clamp(4rem, 8vh, 6rem) var(--space-xl);
    display: flex;
    align-items: center;
  }

  .hands-image-frame {
    position: relative;
    overflow: hidden;
    height: clamp(400px, 60vh, 700px);
    width: 100%;
    background: transparent;
  }

  .hands-img {
    width: 100%;
    height: 110%;
    object-fit: cover;
    display: block;
    filter: grayscale(100%) contrast(1.1);
    transition: filter 0.6s ease;
  }

  .hands-section:hover .hands-img {
    filter: grayscale(80%) contrast(1.1);
  }

  .hands-narrative {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    max-width: 480px;
  }

  .section-number {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-mark-gold);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 4px;
  }

  .hero-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-mark-gold);
    margin-bottom: 12px;
  }

  .hands-label {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-deep-forest);
  }

  .hands-text {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hands-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    color: var(--color-deep-forest);
    font-weight: 300;
    line-height: 1.3;
  }

  .hands-para {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-deep-forest);
    opacity: 0.8;
  }

  .hands-quiet {
    font-style: italic;
    opacity: 0.6;
  }

  .hands-bridge {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .hands-mark-stamp {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hands-mark-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mark-label {
    font-family: var(--font-evidence);
    font-size: 11px;
    color: var(--color-mark-gold);
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .bridge-text {
    margin: 0;
    font-family: var(--font-evidence);
    font-size: 11px;
    color: var(--color-deep-forest);
    opacity: 0.7;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .bridge-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: 13px;
    color: var(--color-mark-gold);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .bridge-link:hover {
    color: var(--color-deep-forest);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hands-visual-col, .hands-text-col {
      grid-column: span 4;
      border-right: none;
    }
    .hands-visual-col {
      border-bottom: 1px solid var(--color-border-subtle);
      padding-bottom: 2rem;
    }
  }
</style>
