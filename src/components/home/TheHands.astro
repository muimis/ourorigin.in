---
// TheHands.astro — Clean Editorial Humanist Focus
import OriginMark from '../OriginMark.astro';
---

<section class="hands-section" id="the-hands" aria-label="Harvested by Hand">
  <div class="container">
    <div class="hands-grid">
      
      <!-- Photography Column -->
      <div class="hands-visual">
        <div class="hands-image-frame">
          <img
            src="/assets/origins/wayanad-hand-documentary.jpg"
            alt="Harvester's hands holding freshly picked spices in the forest"
            class="hands-img"
            loading="lazy"
          />
          <div class="hands-img-badge font-mono">
            <span>WESTERN GHATS · FIRST HANDS</span>
          </div>
        </div>
      </div>

      <!-- Narrative Column -->
      <div class="hands-narrative">
        <div class="hands-kicker">
          <span class="badge-origin badge-gold">
            <OriginMark size={14} variant="gold" />
            <span>HARVESTED BY HAND</span>
          </span>
        </div>

        <h2 class="hands-title font-serif">
          The knowledge is in the hands. Not a factory.
        </h2>

        <div class="hands-quote-body">
          <p class="hands-lead">
            Whether climbing 40-foot trees for forest pepper, plucking two leaves and a bud in morning mist, or cutting native millets with a hand sickle.
          </p>
          <p class="hands-body text-muted">
            Native farming families harvest only what nature yields willingly: what is ripe, reachable, and ready. There is no automated machinery for genuine terroir. The instinct of which morning to pick has been refined across generations.
          </p>
        </div>

        <div class="hands-footer">
          <div class="tally-box">
            <span class="tally-label font-mono">THE EARNED RECORD</span>
            <p class="tally-quote">They counted it first. Their count is the first count.</p>
          </div>
          <a href="#harvest" class="btn-primary">
            <span>Explore the Harvest</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hands-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background-color: var(--color-bone-card);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hands-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hands-grid {
      grid-template-columns: 1fr 1.15fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hands-visual {
    position: relative;
  }

  .hands-image-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-forest-dark);
    box-shadow: var(--shadow-card);
    aspect-ratio: 4 / 3.5;
  }

  .hands-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hands-img-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    padding: 0.35rem 0.75rem;
    background-color: rgba(18, 28, 19, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-bone);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    border-radius: 4px;
  }

  /* Narrative */
  .hands-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hands-title {
    font-size: var(--type-display);
    line-height: 1.2;
    margin: 0;
    color: var(--color-deep-forest);
  }

  .hands-quote-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hands-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-deep-forest);
    font-weight: 450;
    margin: 0;
  }

  .hands-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    margin: 0;
  }

  .hands-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 600px) {
    .hands-footer {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .tally-box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .tally-label {
    font-size: 0.625rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.08em;
  }

  .tally-quote {
    font-size: 0.8125rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>
