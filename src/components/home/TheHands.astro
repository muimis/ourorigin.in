---
// TheHands.astro
import OriginMark from '../OriginMark.astro';
---

<section class="hands-section" id="the-hands" aria-label="Harvested by Hand">

  <div class="hands-image-frame" id="hands-image-frame">
    <img
      src="/assets/origins/wayanad-hand.webp"
      alt="A harvester's hands among pepper vines in Wayanad, Western Ghats"
      class="hands-img"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="hands-narrative" id="hands-narrative">
    <div class="hands-label" data-reveal="fade">
      Picked by Hand
    </div>

    <blockquote class="hands-text" data-reveal>
      <p class="hands-lead">
        Whether plucking whole tea leaves in the morning fog, climbing 40-foot trees for wild pepper, or harvesting native millets by hand.
      </p>
      <p class="hands-para">
        Local farming families harvest only what nature gives willingly that morning: what is ripe, what is reachable, and what is ready.
      </p>
      <p class="hands-para hands-quiet">
        There is no corporate factory for this. Knowing which leaf, which berry, and which morning to pick is an instinct passed down through generations.
      </p>
    </blockquote>

    <div class="hands-bridge" data-reveal="fade">
      <div class="hands-mark-stamp">
        <OriginMark size={36} variant="gold" />
        <div class="hands-mark-info">
          <span class="mark-label">THE TALLY GATE</span>
          <p class="bridge-text">The oldest proof on earth. They counted it first. Their count is the first count.</p>
        </div>
      </div>
      <a href="#harvest" class="bridge-link">
        Explore The Harvest →
      </a>
    </div>
  </div>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHands() {
    gsap.to('.hands-img', {
      yPercent: -8,
      ease: 'none',
      scrollTrigger: {
        trigger: '.hands-section',
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1,
      }
    });

    gsap.fromTo('#hands-image-frame',
      { opacity: 0, scale: 0.95 },
      {
        opacity: 1, scale: 1,
        duration: 1.2, ease: 'power2.out',
        scrollTrigger: {
          trigger: '#hands-image-frame',
          start: 'top 80%',
        }
      }
    );

    gsap.fromTo('.hands-para, .hands-lead, .hands-label, .hands-bridge',
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0,
        duration: 1.0, ease: 'power2.out',
        stagger: 0.15,
        scrollTrigger: {
          trigger: '.hands-narrative',
          start: 'top 75%',
        }
      }
    );
  }

  initHands();
  document.addEventListener('astro:after-swap', initHands);
  document.addEventListener('astro:page-load', initHands);
</script>

<style>
  .hands-section {
    position: relative;
    min-height: 90vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 4rem;
    padding: clamp(4rem, 8vh, 6rem) clamp(2rem, 5vw, 6rem);
    background-color: var(--color-void);
    z-index: 2;
  }

  .hands-image-frame {
    position: relative;
    overflow: hidden;
    height: clamp(340px, 55vh, 560px);
    width: 100%;
    background: #040603;
    border-radius: var(--radius, 8px);
    border: 1px solid rgba(240, 234, 214, 0.08);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
  }

  .hands-img {
    width: 100%;
    height: 110%;
    object-fit: cover;
    display: block;
    filter: saturate(0.85) contrast(1.1);
    transition: filter 0.6s ease;
  }

  .hands-section:hover .hands-img {
    filter: saturate(1) contrast(1.05);
  }

  .hands-narrative {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    max-width: 550px;
  }

  .hands-label {
    font-family: var(--font-evidence);
    font-size: 13px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hands-text {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hands-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.2rem);
    color: var(--color-warm-cream);
    font-weight: 300;
    line-height: 1.3;
  }

  .hands-para {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--color-cream-muted);
  }

  .hands-quiet {
    font-style: italic;
    color: var(--color-cream-whisper);
  }

  .hands-bridge {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(212, 139, 22, 0.25);
  }

  .hands-mark-stamp {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .hands-mark-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mark-label {
    font-family: var(--font-evidence);
    font-size: 11px;
    color: var(--color-gold);
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .bridge-text {
    margin: 0;
    font-family: var(--font-evidence);
    font-size: 11px;
    color: var(--color-warm-cream);
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .bridge-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: 13px;
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .bridge-link:hover {
    color: var(--color-warm-cream);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hands-section {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 3rem 1.5rem;
    }
    .hands-image-frame {
      height: 280px;
    }
  }
</style>
