---
// HandSection.astro — Act IV: The First Hands & Ancestral Wisdom
---

<section class="hand-section" id="the-hands" aria-label="Ancestral Harvest & First Hands">

  <!-- Left: Chiaroscuro Harvest Imagery -->
  <div class="hand-image-frame" id="hand-image-frame">
    <img
      src="/assets/origins/wayanad-hand.webp"
      alt="A harvester's hands among pepper vines in Wayanad, Western Ghats"
      class="hand-img"
      loading="lazy"
      decoding="async"
    />
    <div class="hand-img-vignette" aria-hidden="true"></div>
  </div>

  <!-- Right: The Sacred Harvest Narrative -->
  <div class="hand-narrative" id="hand-narrative">

    <div class="hand-label" data-reveal="fade">
      <span class="label-pulse" aria-hidden="true"></span>
      <span>[ ACT IV · THE FIRST HANDS · INDIGENOUS INSTINCT ]</span>
    </div>

    <blockquote class="hand-text" data-reveal>
      <p class="hand-para hand-para--lead">
        The vines climb living trees — the ancient way, before plantations introduced a sterile geometry.
      </p>
      <p class="hand-para">
        Harvest comes once a year, in January. The picker carries back only what the forest gave willingly that morning: what was ripe, what was reachable, what was left after the birds took their share.
      </p>
      <p class="hand-para hand-para--quiet">
        There is no corporate standard operating procedure for this. The instinct of which berry, which vine, which morning — this was accumulated over generations in this specific rainforest, and belongs to the person who has it.
      </p>
    </blockquote>

    <div class="hand-bridge" data-reveal="fade">
      <p class="bridge-text">When you receive this, no hands have touched it before theirs.<br/>Their count is the first count.</p>
      <div class="bridge-rule" aria-hidden="true"></div>
      <a href="#specimen-vault" class="bridge-link">
        <span>Explore what the forest gave this season</span>
        <span class="bridge-arrow" aria-hidden="true">→</span>
      </a>
    </div>

  </div>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initHand() {
    gsap.to('.hand-img', {
      yPercent: -10,
      ease: 'none',
      scrollTrigger: {
        trigger: '.hand-section',
        start: 'top bottom',
        end: 'bottom top',
        scrub: 1.2,
      }
    });

    gsap.fromTo('#hand-image-frame',
      { opacity: 0, x: -30 },
      {
        opacity: 1, x: 0,
        duration: 1.2, ease: 'power2.out',
        scrollTrigger: {
          trigger: '#hand-image-frame',
          start: 'top 80%',
        }
      }
    );

    gsap.fromTo('.hand-para',
      { opacity: 0, y: 20 },
      {
        opacity: 1, y: 0,
        duration: 1.0, ease: 'power2.out',
        stagger: 0.2,
        scrollTrigger: {
          trigger: '.hand-narrative',
          start: 'top 75%',
        }
      }
    );
  }

  initHand();
  document.addEventListener('astro:after-swap', initHand);
  document.addEventListener('astro:page-load', initHand);
</script>

<style>
  .hand-section {
    position: relative;
    min-height: 90vh;
    display: grid;
    grid-template-columns: 55fr 45fr;
    align-items: stretch;
    overflow: hidden;
    background-color: var(--color-void);
    border-top: 1px solid var(--color-border-subtle);
    z-index: 2;
  }

  .hand-image-frame {
    position: relative;
    overflow: hidden;
    min-height: 70vh;
    background: #040603;
  }

  .hand-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    filter: saturate(0.8) contrast(1.1);
    transition: filter 0.6s ease;
  }

  .hand-section:hover .hand-img {
    filter: saturate(0.95) contrast(1.08);
  }

  .hand-img-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, transparent 60%, var(--color-void) 100%),
      linear-gradient(to bottom, var(--color-void) 0%, transparent 15%, transparent 85%, var(--color-void) 100%);
    pointer-events: none;
  }

  .hand-narrative {
    padding: clamp(3.5rem, 7vh, 6rem) clamp(2rem, 5vw, 5rem) clamp(3.5rem, 7vh, 6rem) clamp(1.5rem, 3vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.8rem, 3.5vh, 2.8rem);
    position: relative;
    z-index: 2;
  }

  .hand-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-gold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .label-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px var(--color-gold);
    flex-shrink: 0;
  }

  .hand-text {
    margin: 0;
    padding: 0;
    border: none;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .hand-para {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-cream-muted);
    opacity: 0;
  }

  .hand-para--lead {
    font-size: clamp(1.2rem, 2.2vw, 1.65rem);
    color: var(--color-warm-cream);
    font-weight: 400;
    line-height: 1.45;
  }

  .hand-para--quiet {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    color: var(--color-cream-whisper);
    font-style: italic;
  }

  .hand-bridge {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .bridge-text {
    margin: 0;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-cream-whisper);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.6;
  }

  .bridge-rule {
    height: 1px;
    width: 48px;
    background: var(--color-gold);
    opacity: 0.4;
  }

  .bridge-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color var(--duration-quick) ease, transform var(--duration-quick) ease;
  }

  .bridge-link:hover {
    color: var(--color-warm-cream);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .hand-section {
      grid-template-columns: 1fr;
    }
    .hand-image-frame {
      min-height: 45vh;
    }
    .hand-narrative {
      padding: 3rem 1.25rem 4rem;
    }
  }
</style>
