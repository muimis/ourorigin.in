---
// SpecimenVault.astro — Act III: The Sacred Specimen Vault
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));

// Active products only
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});
---

<section class="specimen-vault" id="specimen-vault" aria-label="The Sacred Specimen Vault">

  <!-- Vault Header -->
  <div class="vault-header" data-reveal>
    <div class="vault-meta-tag">
      <span class="vault-glyph">𐌐</span>
      <span>[ ACT III · THE HARVEST REGISTRY ]</span>
    </div>
    
    <h2 class="vault-title">The Sacred Yields</h2>
    <p class="vault-subtitle">
      Each yield is a finite biological specimen from a specific mountain coordinate. We do not blend. We do not standardize.
    </p>

    <!-- Origin Filter Pills -->
    <div class="vault-filters" role="tablist">
      <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
        ALL HARVESTS ({activeProducts.length})
      </button>
      <button class="filter-btn" data-filter="nilgiris" role="tab" aria-selected="false">
        NILGIRIS (2,600M)
      </button>
      <button class="filter-btn" data-filter="idukki" role="tab" aria-selected="false">
        IDUKKI (1,200M)
      </button>
      <button class="filter-btn" data-filter="wayanad" role="tab" aria-selected="false">
        WAYANAD (900M)
      </button>
      <button class="filter-btn" data-filter="thiruvananthapuram" role="tab" aria-selected="false">
        COASTAL (60M)
      </button>
    </div>
  </div>

  <!-- Specimen Grid -->
  <div class="vault-grid">
    {activeProducts.map((product) => {
      const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
      const origin = originMap[originId];
      const originName = origin ? origin.name : originId;
      const firstSize = product.data.sizes[0];
      const prodImg = product.data.images?.product || product.data.images?.packaging || '';
      
      const priceDisplay = product.data.sizes.length > 1
        ? `₹${Math.min(...product.data.sizes.map(s => s.priceINR))} - ₹${Math.max(...product.data.sizes.map(s => s.priceINR))}`
        : `₹${firstSize.priceINR}`;

      const sensoryNotes = product.data.sensoryProfile?.aroma || product.data.specimenCopy || '';
      const chemistry = product.data.chemistry?.activeCompound || '';

      const itemPayload = JSON.stringify({
        id: `${product.id}-${firstSize.label}`,
        productId: product.id,
        name: product.data.name,
        origin: originName,
        originId: originId,
        price: firstSize.priceINR,
        size: firstSize.label,
        weight: firstSize.label,
        quantity: 1,
        batchRef: product.data.batchRef || 'RECORDED'
      });

      return (
        <article class="specimen-card" data-origin={originId} data-reveal>
          
          <!-- Card Artifact Display -->
          <div class="specimen-display">
            <div class="specimen-backdrop"></div>
            
            {prodImg ? (
              <a href={`/origins/${originId}/${product.id}`} class="specimen-img-wrap">
                <img 
                  src={prodImg} 
                  alt={product.data.name} 
                  class="specimen-img"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="specimen-placeholder">
                <span>[ SACRED SPECIMEN ]</span>
              </div>
            )}

            <!-- Origin & Altitude Ribbon -->
            <div class="specimen-ribbon">
              <span class="ribbon-origin">{originName}</span>
              <span class="ribbon-elevation">{origin?.elevation || ''}</span>
            </div>
          </div>

          <!-- Specimen Evidence & Sensory Body -->
          <div class="specimen-info">
            <span class="specimen-botanical">{product.data.botanicalName || 'Indigenous Cultivar'}</span>
            
            <h3 class="specimen-name">
              <a href={`/origins/${originId}/${product.id}`}>{product.data.name}</a>
            </h3>

            {sensoryNotes && (
              <p class="specimen-sensory">
                "{sensoryNotes.length > 95 ? sensoryNotes.substring(0, 92) + '...' : sensoryNotes}"
              </p>
            )}

            <div class="specimen-telemetry-row">
              <span class="specimen-batch">BATCH: {product.data.batchRef || 'RECORDED'}</span>
              {chemistry && <span class="specimen-chem">{chemistry}</span>}
            </div>

            <!-- Price & Harvest Gathering Action -->
            <div class="specimen-footer">
              <div class="specimen-price-group">
                <span class="price-val">{priceDisplay}</span>
                <span class="price-unit">/ {firstSize.label}</span>
              </div>

              <div class="specimen-btn-group">
                <button 
                  type="button" 
                  class="btn-vault-add"
                  data-product-json={itemPayload}
                  aria-label={`Gather ${product.data.name}`}
                >
                  + GATHER
                </button>

                <a 
                  href={`/origins/${originId}/${product.id}`} 
                  class="btn-vault-inspect"
                  aria-label={`Inspect ${product.data.name}`}
                >
                  DETAILS →
                </a>
              </div>
            </div>

          </div>

        </article>
      );
    })}
  </div>

</section>

<script>
  function initVault() {
    const filterBtns = document.querySelectorAll('.vault-filters .filter-btn');
    const cards = document.querySelectorAll('.specimen-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter;
        
        filterBtns.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          const origin = (card as HTMLElement).dataset.origin;
          if (filter === 'all' || origin === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Vault Quick Add
    document.querySelectorAll('.btn-vault-add').forEach((addBtn) => {
      addBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const jsonStr = (addBtn as HTMLElement).dataset.productJson;
        if (!jsonStr) return;

        try {
          const item = JSON.parse(jsonStr);
          window.dispatchEvent(new CustomEvent('add-to-cart', { detail: item }));
          
          const orig = addBtn.textContent;
          addBtn.textContent = '✓ GATHERED';
          addBtn.classList.add('is-added');
          setTimeout(() => {
            addBtn.textContent = orig;
            addBtn.classList.remove('is-added');
          }, 1400);
        } catch (err) {
          console.error(err);
        }
      });
    });
  }

  initVault();
  document.addEventListener('astro:after-swap', initVault);
  document.addEventListener('astro:page-load', initVault);
</script>

<style>
  .specimen-vault {
    position: relative;
    z-index: 2;
    padding: clamp(5rem, 10vh, 8rem) clamp(1.5rem, 6vw, 6rem);
    border-top: 1px solid var(--color-border-subtle);
  }

  .vault-header {
    max-width: 860px;
    margin-bottom: clamp(2.5rem, 5vh, 4rem);
  }

  .vault-meta-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-gold);
    letter-spacing: 0.2em;
    margin-bottom: 0.75rem;
  }

  .vault-glyph {
    font-size: 14px;
  }

  .vault-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-display);
    line-height: 1.1;
    color: var(--color-warm-cream);
    font-weight: 400;
  }

  .vault-subtitle {
    margin: 1rem 0 0;
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    color: var(--color-cream-muted);
    line-height: 1.6;
    max-width: 680px;
  }

  /* Filter Pills */
  .vault-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .filter-btn {
    background: rgba(240, 234, 214, 0.03);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-cream-muted);
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.12em;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all var(--duration-quick) ease;
  }

  .filter-btn:hover {
    color: var(--color-warm-cream);
    border-color: var(--color-gold);
  }

  .filter-btn.is-active {
    background: rgba(212, 139, 22, 0.15);
    border-color: var(--color-gold);
    color: var(--color-gold-bright);
  }

  /* Grid */
  .vault-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

  /* Specimen Card */
  .specimen-card {
    background: var(--color-forest-surface);
    border: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .specimen-card:hover {
    border-color: rgba(212, 139, 22, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  /* Display Area */
  .specimen-display {
    position: relative;
    height: 250px;
    background: #030502;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow: hidden;
  }

  .specimen-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(212, 139, 22, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .specimen-img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    z-index: 1;
  }

  .specimen-img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform var(--duration-slow) var(--ease-settle);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.6));
  }

  .specimen-card:hover .specimen-img {
    transform: scale(1.08);
  }

  .specimen-ribbon {
    position: absolute;
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    font-family: var(--font-evidence);
    font-size: 10px;
    letter-spacing: 0.15em;
    z-index: 2;
  }

  .ribbon-origin {
    color: var(--color-gold);
    text-transform: uppercase;
    background: rgba(8, 13, 6, 0.8);
    padding: 2px 6px;
    border: 1px solid rgba(212, 139, 22, 0.3);
  }

  .ribbon-elevation {
    color: var(--color-cream-muted);
    background: rgba(8, 13, 6, 0.8);
    padding: 2px 6px;
    border: 1px solid var(--color-border-subtle);
  }

  /* Body */
  .specimen-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .specimen-botanical {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: 14px;
    color: var(--color-gold);
    margin-bottom: 0.3rem;
  }

  .specimen-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .specimen-name a {
    color: var(--color-warm-cream);
    text-decoration: none;
    transition: color var(--duration-quick) ease;
  }

  .specimen-name a:hover {
    color: var(--color-gold-bright);
  }

  .specimen-sensory {
    margin: 0.75rem 0 0;
    font-family: var(--font-narrative);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-cream-muted);
    font-style: italic;
    flex: 1;
  }

  .specimen-telemetry-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-cream-whisper);
    letter-spacing: 0.12em;
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(240, 234, 214, 0.06);
  }

  .specimen-chem {
    color: var(--color-gold);
  }

  /* Footer */
  .specimen-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .specimen-price-group {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-family: var(--font-evidence);
  }

  .price-val {
    font-size: 1.15rem;
    color: var(--color-warm-cream);
    font-weight: 500;
  }

  .price-unit {
    font-size: 11px;
    color: var(--color-cream-whisper);
  }

  .specimen-btn-group {
    display: flex;
    gap: 0.4rem;
  }

  .btn-vault-add,
  .btn-vault-inspect {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.1em;
    padding: 0.5rem 0.85rem;
    text-decoration: none;
    border: 1px solid var(--color-border-subtle);
    cursor: pointer;
    transition: all var(--duration-quick) ease;
  }

  .btn-vault-add {
    background: rgba(212, 139, 22, 0.18);
    border-color: var(--color-gold);
    color: var(--color-warm-cream);
    font-weight: 500;
  }

  .btn-vault-add:hover {
    background: var(--color-gold);
    color: var(--color-forest-deep);
  }

  .btn-vault-add.is-added {
    background: var(--color-laterite);
    border-color: var(--color-laterite);
    color: #fff;
  }

  .btn-vault-inspect {
    background: transparent;
    color: var(--color-cream-muted);
  }

  .btn-vault-inspect:hover {
    border-color: var(--color-warm-cream);
    color: var(--color-warm-cream);
  }

  @media (max-width: 768px) {
    .specimen-vault {
      padding: 4rem 1.25rem;
    }
    .vault-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
