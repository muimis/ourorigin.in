---
// SustainabilitySection.astro — Act V: The Primitive Earth Truths
---
<section class="truth-section" id="primitive-truths" aria-label="The Truth of this Soil">

  <!-- Opening cinematic statement -->
  <div class="truth-statement">
    <span class="truth-act-tag">[ ACT V · THE SACRED INTEGRITY ]</span>
    <p class="truth-line truth-line--age">25 million years of soil.</p>
    <p class="truth-line truth-line--zero">Zero synthetic interference.</p>
    <p class="truth-line truth-line--ever">Ever.</p>
  </div>

  <!-- Three truths -->
  <div class="truths-grid">

    <div class="truth-item" data-truth="0">
      <div class="truth-glyph" aria-hidden="true">
        <!-- Geological strata SVG — age of the earth -->
        <svg width="32" height="48" viewBox="0 0 32 48" fill="none">
          <line x1="0" y1="8"  x2="32" y2="8"  stroke="currentColor" stroke-width="1" opacity="0.8"/>
          <line x1="4" y1="16" x2="28" y2="16" stroke="currentColor" stroke-width="1" opacity="0.55"/>
          <line x1="0" y1="24" x2="32" y2="24" stroke="currentColor" stroke-width="1" opacity="0.35"/>
          <line x1="6" y1="32" x2="26" y2="32" stroke="currentColor" stroke-width="1" opacity="0.2"/>
          <line x1="0" y1="40" x2="32" y2="40" stroke="currentColor" stroke-width="1" opacity="0.1"/>
        </svg>
      </div>
      <div class="truth-value">25M</div>
      <div class="truth-label">Age of volcanic<br/>soil · years</div>
      <p class="truth-desc">The Western Ghats are older than the Himalayas. The volcanic loam holds millennia of unhurried memory.</p>
    </div>

    <div class="truth-item" data-truth="1">
      <div class="truth-glyph" aria-hidden="true">
        <!-- Rain / monsoon lines -->
        <svg width="32" height="48" viewBox="0 0 32 48" fill="none">
          <line x1="6"  y1="0" x2="2"  y2="48" stroke="currentColor" stroke-width="1" opacity="0.6"/>
          <line x1="16" y1="0" x2="12" y2="48" stroke="currentColor" stroke-width="1" opacity="0.4"/>
          <line x1="26" y1="0" x2="22" y2="48" stroke="currentColor" stroke-width="1" opacity="0.25"/>
        </svg>
      </div>
      <div class="truth-value">100%</div>
      <div class="truth-label">Harvest cycles<br/>monsoon-aligned</div>
      <p class="truth-desc">Each harvest follows the seasonal monsoon rhythm. No artificial forcing, no greenhouse acceleration. The sky decides.</p>
    </div>

    <div class="truth-item" data-truth="2">
      <div class="truth-glyph" aria-hidden="true">
        <!-- Empty circle — zero synthetic chemicals -->
        <svg width="32" height="48" viewBox="0 0 32 48" fill="none">
          <circle cx="16" cy="24" r="13" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        </svg>
      </div>
      <div class="truth-value">0%</div>
      <div class="truth-label">Synthetic chemicals<br/>or pesticides</div>
      <p class="truth-desc">Zero chemical sprays, preservatives, or artificial drying. What enters the soil returns to your hand unadulterated.</p>
    </div>

  </div>

</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initTruths() {
    gsap.fromTo('.truth-line',
      { opacity: 0, y: 24, filter: 'blur(4px)' },
      {
        opacity: 1, y: 0, filter: 'blur(0px)',
        duration: 1.1, ease: 'power2.out',
        stagger: 0.35,
        scrollTrigger: {
          trigger: '.truth-statement',
          start: 'top 80%',
        }
      }
    );

    document.querySelectorAll('.truth-item').forEach((item, i) => {
      gsap.fromTo(item,
        { opacity: 0, y: 36 },
        {
          opacity: 1, y: 0,
          duration: 0.9, ease: 'power2.out',
          delay: i * 0.2,
          scrollTrigger: {
            trigger: '.truths-grid',
            start: 'top 78%',
          }
        }
      );

      const valueEl = item.querySelector('.truth-value');
      if (!valueEl) return;
      const rawText = valueEl.textContent?.trim() || '';
      const numMatch = rawText.match(/[\d.]+/);
      if (!numMatch) return;
      const target = parseFloat(numMatch[0]);
      const suffix = rawText.replace(numMatch[0], '');

      ScrollTrigger.create({
        trigger: item,
        start: 'top 80%',
        once: true,
        onEnter: () => {
          gsap.fromTo({ val: 0 },
            { val: target },
            {
              val: target,
              duration: 1.4,
              ease: 'power1.out',
              delay: i * 0.2,
              onUpdate: function() {
                const v = this.targets()[0].val;
                valueEl.textContent = (target >= 1000000
                  ? Math.round(v / 1000000) + 'M'
                  : Math.round(v)) + suffix;
              }
            }
          );
        }
      });
    });
  }

  initTruths();
  document.addEventListener('astro:after-swap', initTruths);
  document.addEventListener('astro:page-load', initTruths);
</script>

<style>
  .truth-section {
    padding: clamp(5rem, 10vh, 8rem) clamp(1.5rem, 6vw, 6rem);
    background-color: var(--color-void);
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--color-border-subtle);
  }

  .truth-statement {
    max-width: 800px;
    margin: 0 0 clamp(4rem, 8vh, 5.5rem) 0;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .truth-act-tag {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-gold);
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .truth-line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.05;
    opacity: 0;
  }

  .truth-line--age {
    font-size: clamp(2.2rem, 5vw, 4.2rem);
    color: var(--color-warm-cream);
  }

  .truth-line--zero {
    font-size: clamp(1.8rem, 4vw, 3.4rem);
    color: var(--color-cream-muted);
    font-style: italic;
    font-family: var(--font-narrative);
  }

  .truth-line--ever {
    font-size: clamp(1.4rem, 2.5vw, 2.2rem);
    color: var(--color-gold-bright);
    letter-spacing: 0.04em;
  }

  .truths-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .truth-item {
    border-top: 1px solid var(--color-border-accent);
    padding-top: clamp(1.5rem, 3vh, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    opacity: 0;
  }

  .truth-glyph {
    color: var(--color-gold);
    opacity: 0.6;
    margin-bottom: 0.5rem;
    height: 48px;
    display: flex;
    align-items: flex-start;
  }

  .truth-value {
    font-family: var(--font-evidence);
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 300;
    color: var(--color-gold-bright);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .truth-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: var(--color-cream-whisper);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    line-height: 1.6;
    margin-bottom: 0.25rem;
  }

  .truth-desc {
    font-family: var(--font-narrative);
    font-size: clamp(0.95rem, 1.4vw, 1.1rem);
    color: var(--color-cream-muted);
    line-height: 1.65;
    margin: 0;
    font-weight: 300;
  }

  @media (max-width: 860px) {
    .truths-grid {
      grid-template-columns: 1fr;
      gap: clamp(2.5rem, 6vw, 3.5rem);
    }
  }
</style>
