---
// This section acts as a shell for the complex interactive gallery.
// The IDs and structure here match the original markup so existing JS can hook into it.
---
<section id="wearable" class="gallery-section section">
  <div class="gallery-container">
    <div id="wearable-copy" class="gallery-copy" data-reveal="fade">
      <h4 id="wearable-title" class="gallery-title">
        <span class="block">So pure,</span> 
        <span class="block">it's elemental</span>
      </h4>
      <div id="wearable-title-2-dummy"></div>
    </div>

    <!-- Main Interactive Area -->
    <div id="wearable-main" class="gallery-main">
      <div id="wearable-main-small"></div>
      <canvas id="wearable-main-canvas"></canvas>
      
      <div id="wearable-gallery-wrapper" class="gallery-wrapper">
        <div id="wearable-gallery-move-container" class="gallery-move-container">
          
          <div class="wearable-gallery-item" data-id="intro" data-type="intro" data-file="intro.webp">
            <div class="wearable-gallery-item-inner raw-panel">
              <div class="item-visual placeholder-intro"></div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="yoga" data-type="video" data-file="yoga.webp">
            <div class="wearable-gallery-item-inner raw-panel">
               <div class="item-visual placeholder-video"></div>
            </div>
            <div id="wearable-gallery-warning" class="gallery-warning raw-panel">
              <div id="wearable-gallery-warning-icon-wrapper" class="warning-icon sub2">
                <h5>Note</h5>
              </div>
              <div id="wearable-gallery-warning-message" class="warning-message">
                This grain travelled 48 hours to reach you.<br>Handle it like the rarity it is.
              </div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="shoulder" data-type="image" data-file="shoulder.webp">
            <div class="wearable-gallery-item-inner raw-panel">
               <div class="item-visual placeholder-img"></div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="bikini" data-type="image" data-file="bikini.webp">
            <div class="wearable-gallery-item-inner raw-panel">
              <div class="item-visual placeholder-img"></div>
              <div id="wearable-gallery-bikini-overlay"></div>
              <div id="wearable-gallery-bikini-message">
                <div id="wearable-gallery-bikini-prompt">Hey <span><span>@</span>ourorigin</span>, where does this come from?</div>
                <div id="wearable-gallery-bikini-send-btn-wrapper">
                  <button class="btn is-orange raw-panel">Ask</button>
                </div>
              </div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="glasses" data-type="image" data-file="glasses.webp">
            <div class="wearable-gallery-item-inner raw-panel">
               <div class="item-visual placeholder-img"></div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="bite" data-type="video" data-file="bite.webp">
            <div class="wearable-gallery-item-inner raw-panel">
               <div class="item-visual placeholder-video"></div>
            </div>
          </div>
          
          <div class="wearable-gallery-item" data-id="pocket" data-type="image" data-file="pocket.webp">
            <div class="wearable-gallery-item-inner raw-panel">
               <div class="item-visual placeholder-img"></div>
            </div>
          </div>
          
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-section {
    padding: var(--space-4xl) 0; /* Full bleed section */
    position: relative;
    z-index: 2;
    overflow: hidden;
    min-height: 80vh;
  }

  .gallery-container {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .gallery-copy {
    position: absolute;
    top: var(--space-2xl);
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 10;
    pointer-events: none;
  }

  .gallery-title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    font-weight: 300;
    line-height: var(--line-height-tight);
    color: var(--color-warm-cream);
    letter-spacing: -0.02em;
    margin: 0;
    text-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }
  
  .block {
    display: block;
  }

  /* HTML Shell for Canvas and Gallery */
  .gallery-main {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 600px;
    display: flex;
    align-items: center;
  }

  #wearable-main-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .gallery-wrapper {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
    position: relative;
    z-index: 2;
    padding: 0 5vw; /* Fluid side padding */
    scroll-snap-type: x mandatory;
  }

  .gallery-wrapper::-webkit-scrollbar {
    display: none;
  }

  .gallery-move-container {
    display: flex;
    gap: var(--space-2xl); /* Larger gap for cinematic breathing room */
    width: max-content;
    padding: var(--space-4xl) 0;
    align-items: center;
  }

  .wearable-gallery-item {
    position: relative;
    width: clamp(280px, 25vw, 400px); /* Fluid sizing */
    height: clamp(400px, 40vw, 600px);
    flex-shrink: 0;
    scroll-snap-align: center;
    transition: transform 0.5s var(--ease-settle);
  }

  .wearable-gallery-item:hover {
    transform: scale(1.02);
  }

  .wearable-gallery-item-inner {
    width: 100%;
    height: 100%;
    border-radius: 8px; /* Softer, sleeker border radius */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden; /* Ensure images don't break borders */
  }

  /* Placeholders until actual media is loaded */
  .item-visual {
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    transition: opacity 0.5s ease;
  }
  .wearable-gallery-item:hover .item-visual {
    opacity: 0.5;
  }
  .placeholder-intro { background-color: #1a1a1a; }
  .placeholder-video { background-color: #111; }
  .placeholder-img { background-color: #222; }

  /* Warnings and Overlays */
  .gallery-warning {
    position: absolute;
    bottom: var(--space-md);
    left: var(--space-md);
    right: var(--space-md);
    padding: var(--space-lg);
    border-left: 2px solid var(--color-gold);
    backdrop-filter: blur(20px);
  }

  .warning-icon {
    color: var(--color-gold);
    text-transform: uppercase;
    font-size: 0.75rem;
    margin-bottom: var(--space-xs);
    letter-spacing: 0.1em;
  }

  .warning-message {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(235, 229, 217, 0.9);
  }

  #wearable-gallery-bikini-message {
    position: absolute;
    bottom: var(--space-xl);
    left: var(--space-xl);
    right: var(--space-xl);
    text-align: center;
  }

  #wearable-gallery-bikini-prompt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 1rem;
    color: rgba(235, 229, 217, 0.8);
  }

  .btn.is-orange {
    background: transparent;
    color: var(--color-gold);
    border: 1px solid rgba(198, 156, 82, 0.5);
    padding: 0.8rem 2rem;
    border-radius: 30px;
    cursor: pointer;
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }

  .btn.is-orange:hover {
    background: rgba(198, 156, 82, 0.1);
    border-color: var(--color-gold);
  }

  @media (min-width: 1024px) {
    .gallery-copy {
      top: 50%;
      left: var(--space-4xl);
      transform: translateY(-50%);
      text-align: left;
    }
  }
</style>
