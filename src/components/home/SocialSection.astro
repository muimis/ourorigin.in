---
// SocialSection.astro — Seasonal Updates & Direct Connection
import { WHATSAPP_NUMBER, EMAIL_ADDRESS } from '../../utils/constants';
import OriginMark from '../OriginMark.astro';

const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hello OurOrigin, I'd like to inquire about this season's harvests.")}`;
---

<section class="connect-section" aria-label="Stay Connected">
  <div class="container">
    <div class="connect-card">
      <div class="connect-content">
        <div class="connect-mark">
          <OriginMark size={32} variant="gold" />
        </div>
        <span class="badge-origin badge-gold">SEASONAL NOTIFICATIONS</span>
        <h2 class="connect-title font-serif">
          Fresh harvests arrive with the seasons.
        </h2>
        <p class="connect-desc">
          We harvest in small, unblended batches aligned with monsoon and flowering cycles. Connect directly with us on WhatsApp or email for custom requests and fresh seasonal drop notifications.
        </p>

        <div class="connect-actions">
          <a href={whatsappLink} class="btn-gold" target="_blank" rel="noopener noreferrer">
            <span>Connect on WhatsApp</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href={`mailto:${EMAIL_ADDRESS}`} class="btn-secondary" style="border-color: rgba(250, 247, 242, 0.2); color: var(--color-bone);">
            <span>Email Us</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .connect-section {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0;
    background-color: var(--color-bone);
  }

  .connect-card {
    background-color: var(--color-forest-dark);
    color: var(--color-bone);
    border-radius: 8px;
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3.5rem);
    text-align: center;
    box-shadow: var(--shadow-card);
  }

  .connect-content {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .connect-mark {
    margin-bottom: 0.5rem;
  }

  .connect-title {
    font-size: var(--type-display);
    color: var(--color-bone);
    line-height: 1.2;
    margin: 0;
  }

  .connect-desc {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-forest-muted);
    margin: 0;
  }

  .connect-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
  }
</style>
