---
---
<section id="encryption" class="verification-section">
  <div class="verification-container">
    
    <div class="verification-main glass-panel">
      
      <div class="verification-header">
        <div class="tagline">Origin verification, simplified</div>
        <h2 class="title">
          <span class="block">Smart flip</span>
          <span class="block">verification</span>
        </h2>
        <p class="desc">
          Type a yield. Flip. Trace its origin — instantly. <br>
          Transparency at its most honest.
        </p>
      </div>

      <div class="verification-interaction">
        <div class="input-field-wrapper">
          <input type="text" id="encryption-field-input" class="verification-input" value="ORIGIN" maxlength="10">
          <div class="input-lines">
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
          </div>
        </div>

        <button id="encryption-field-flip-btn" class="verify-btn">
          <span class="btn-inner">
            <span class="btn-text">Verify Origin</span>
          </span>
        </button>
      </div>

    </div>

  </div>
</section>

<style>
  .verification-section {
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    z-index: 2;
  }

  .verification-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .verification-main {
    padding: var(--space-4xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
    border-radius: 16px;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-md);
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    font-weight: 300;
    line-height: var(--line-height-tight);
    color: var(--color-warm-cream);
    margin: 0 0 var(--space-lg) 0;
  }

  .block {
    display: block;
  }

  .desc {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    color: rgba(235, 229, 217, 0.7);
    line-height: 1.6;
    margin: 0;
  }

  .verification-interaction {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    align-items: flex-start;
  }

  .input-field-wrapper {
    position: relative;
    width: 100%;
    max-width: 300px;
  }

  .verification-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 2px solid rgba(198, 156, 82, 0.3);
    color: var(--color-warm-cream);
    font-family: var(--font-mono);
    font-size: 2rem;
    text-align: center;
    padding: var(--space-md) 0;
    outline: none;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: border-color var(--duration-standard) var(--ease-settle);
  }

  .verification-input:focus {
    border-bottom-color: var(--color-gold);
  }

  .verify-btn {
    background: var(--color-gold);
    color: var(--color-forest-deep);
    border: none;
    padding: var(--space-lg) var(--space-2xl);
    border-radius: 30px;
    font-family: var(--font-mono);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: transform var(--duration-standard) var(--ease-settle),
                box-shadow var(--duration-standard) var(--ease-settle);
  }

  .verify-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(198, 156, 82, 0.2);
  }

  @media (max-width: 768px) {
    .verification-main {
      grid-template-columns: 1fr;
      text-align: center;
      padding: var(--space-2xl);
    }

    .verification-interaction {
      align-items: center;
    }
  }
</style>
