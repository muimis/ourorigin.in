---
// Standards.astro — Proof bar mapped to the 4-pillar grid.
---

<section class="proof-bar" aria-label="Our Standards">
  <div class="layout-pillar-grid proof-inner">

    <div class="proof-item">
      <span class="proof-num">0</span>
      <span class="proof-label">Chemical<br/>inputs</span>
    </div>

    <div class="proof-item">
      <span class="proof-num">1st</span>
      <span class="proof-label">Hand.<br/>Direct from grower.</span>
    </div>

    <div class="proof-item">
      <span class="proof-num">100%</span>
      <span class="proof-label">Single origin,<br/>never blended</span>
    </div>

    <div class="proof-item proof-item-last">
      <div class="proof-stat">
        <span class="proof-num">48h</span>
        <span class="proof-label">Farm to<br/>packaging</span>
      </div>
      <a href="/about" class="proof-cta-link">
        OUR STANDARDS <span class="cta-arrow">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .proof-bar {
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-bone);
  }

  .proof-inner {
    /* layout-pillar-grid handles the 4 columns */
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 4vw, 3rem) var(--space-xl);
    border-right: 1px solid var(--color-border-subtle);
  }

  .proof-item:last-child {
    border-right: none;
  }

  .proof-item:first-child {
    border-left: 1px solid var(--color-border-subtle);
  }

  .proof-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 300;
    color: var(--color-deep-forest);
    line-height: 1.0;
    margin-bottom: var(--space-md);
  }

  .proof-label {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-deep-forest);
    opacity: 0.7;
    line-height: 1.5;
  }

  .proof-item-last {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .proof-stat {
    display: flex;
    flex-direction: column;
  }

  .proof-cta-link {
    font-family: var(--font-evidence);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-mark-gold);
    text-decoration: none;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    transition: color 0.3s;
  }

  .proof-cta-link:hover {
    color: var(--color-deep-forest);
  }

  @media (max-width: 1024px) {
    .proof-item {
      padding: 1.5rem var(--space-lg);
      border-right: none;
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .proof-item:first-child {
      border-left: none;
    }
    .proof-item:last-child {
      border-bottom: none;
    }
  }
</style>
