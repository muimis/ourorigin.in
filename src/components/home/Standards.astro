---
// Standards.astro — Proof bar. One line. No lecture.
---

<section class="proof-bar" aria-label="Our Standards">

  <div class="proof-inner">

    <div class="proof-item">
      <span class="proof-num">0</span>
      <span class="proof-label">Chemical<br/>inputs</span>
    </div>

    <div class="proof-divider" aria-hidden="true">—</div>

    <div class="proof-item">
      <span class="proof-num">1st</span>
      <span class="proof-label">Hand.<br/>Direct from grower.</span>
    </div>

    <div class="proof-divider" aria-hidden="true">—</div>

    <div class="proof-item">
      <span class="proof-num">100%</span>
      <span class="proof-label">Single<br/>origin, never blended</span>
    </div>

    <div class="proof-divider" aria-hidden="true">—</div>

    <div class="proof-item">
      <span class="proof-num">48h</span>
      <span class="proof-label">Farm to<br/>packaging</span>
    </div>

    <div class="proof-divider" aria-hidden="true">—</div>

    <div class="proof-item proof-item--cta">
      <a href="/about" class="proof-cta-link">
        Why this<br/>exists →
      </a>
    </div>

  </div>

</section>

<style>
  .proof-bar {
    background: var(--color-forest-surface);
    border-top: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem);
  }

  .proof-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 3vw, 3rem);
    max-width: 1200px;
    margin: 0 auto;
    flex-wrap: wrap;
  }

  .proof-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
    min-width: 100px;
  }

  .proof-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    color: var(--color-mark-gold);
    line-height: 1.0;
    letter-spacing: -0.01em;
  }

  .proof-label {
    font-family: var(--font-evidence);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bone-muted);
    line-height: 1.5;
  }

  .proof-divider {
    color: var(--color-bone-whisper);
    font-size: 1.5rem;
    font-family: var(--font-evidence);
    flex-shrink: 0;
    align-self: stretch;
    display: flex;
    align-items: center;
  }

  .proof-item--cta {
    align-items: flex-start;
  }

  .proof-cta-link {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: clamp(1rem, 1.8vw, 1.3rem);
    color: var(--color-bone-muted);
    text-decoration: none;
    line-height: 1.4;
    transition: color 0.2s;
    border-bottom: 1px solid var(--color-bone-whisper);
    padding-bottom: 2px;
  }

  .proof-cta-link:hover {
    color: var(--color-mark-gold);
    border-color: var(--color-mark-gold);
  }

  @media (max-width: 768px) {
    .proof-divider { display: none; }

    .proof-inner {
      gap: 1.5rem 2rem;
    }

    .proof-item {
      min-width: 120px;
      flex: 0 0 calc(50% - 1rem);
    }

    .proof-item--cta {
      flex: 0 0 100%;
      border-top: 1px solid var(--color-border-subtle);
      padding-top: 1rem;
    }
  }
</style>
