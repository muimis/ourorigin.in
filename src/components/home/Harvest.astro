---
// Harvest.astro — Editorial product grid
import { getCollection } from 'astro:content';
import OriginMark from '../OriginMark.astro';

const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));

const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
}).slice(0, 12); // Show first 12
---

<section class="harvest" id="harvest" aria-label="This Season's Harvest">

  <div class="harvest-head">
    <div class="harvest-head-left">
      <span class="harvest-kicker">04</span>
      <div class="hero-line"></div>
      <h2 class="harvest-title">The Harvest.</h2>
    </div>
    <p class="harvest-desc">
      Freshly gathered. Sun-dried. Packed at source.<br />
      No warehouses. No blending. No middlemen.
    </p>
  </div>

  <div class="layout-pillar-grid harvest-grid">
    {activeProducts.map((product, i) => {
      const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
      const origin = originMap[originId];
      const originName = origin ? origin.name : originId;
      const firstSize = product.data.sizes[0];
      const prodImg = product.data.images?.product || product.data.images?.packaging || '';

      const itemPayload = JSON.stringify({
        id: `${product.id}-${firstSize.label}`,
        productId: product.id,
        name: product.data.name,
        origin: originName,
        originId: originId,
        price: firstSize.priceINR,
        size: firstSize.label,
        weight: firstSize.label,
        quantity: 1
      });

      // Alternate tile sizes: 0,3,6,9 are large; rest normal
      const isLarge = i % 4 === 0;

      return (
        <article class:list={["tile", { "tile--large": isLarge }]} data-origin={originId}>
          <a href={`/origins/${originId}/${product.id}`} class="tile-img-link" tabindex="-1" aria-hidden="true">
            {prodImg ? (
              <img
                src={prodImg}
                alt={product.data.name}
                class="tile-img"
                loading={i < 4 ? "eager" : "lazy"}
              />
            ) : (
              <div class="tile-img-fallback">
                <OriginMark size={32} variant="primary" hideDot={true} />
              </div>
            )}
          </a>

          <!-- Overlay: always visible bottom strip -->
          <div class="tile-overlay">
            <div class="tile-meta">
              <span class="tile-origin">{originName.toUpperCase()}</span>
              <span class="tile-sep">·</span>
              <span class="tile-elevation">{origin?.elevation || ''}</span>
            </div>
            <div class="tile-bottom">
              <div class="tile-name-wrap">
                <a href={`/origins/${originId}/${product.id}`} class="tile-name">{product.data.name}</a>
                {product.data.botanicalName && (
                  <span class="tile-botanical">{product.data.botanicalName}</span>
                )}
              </div>
              <div class="tile-action">
                <span class="tile-price">₹{firstSize.priceINR}</span>
                <button
                  type="button"
                  class="tile-add"
                  data-product-json={itemPayload}
                  aria-label={`Add ${product.data.name} to basket`}
                >
                  + Add
                </button>
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>

</section>

<script>
  function initHarvest() {
    document.querySelectorAll('.tile-add').forEach(btn => {
      const fresh = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(fresh, btn);
      fresh.addEventListener('click', (e) => {
        e.preventDefault();
        const data = JSON.parse(fresh.dataset.productJson || '{}');
        window.dispatchEvent(new CustomEvent('add-to-cart', { detail: data }));
        // Flash feedback
        fresh.textContent = '✓ Added';
        fresh.classList.add('tile-add--done');
        setTimeout(() => {
          fresh.textContent = '+ Add';
          fresh.classList.remove('tile-add--done');
        }, 1400);
      });
    });
  }

  initHarvest();
  document.addEventListener('astro:after-swap', initHarvest);
</script>

<style>
  .harvest {
    padding: 0;
    background: var(--color-bone);
    border-top: 1px solid var(--color-border-subtle);
  }

  .harvest-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(3rem, 6vw, 5rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .harvest-head-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .harvest-kicker {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    letter-spacing: 0.1em;
    color: var(--color-mark-gold);
  }

  .hero-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-mark-gold);
    margin: 8px 0;
  }

  .harvest-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 300;
    color: var(--color-deep-forest);
    margin: 0;
    line-height: 1.0;
  }

  .harvest-desc {
    font-family: var(--font-narrative);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: var(--color-deep-forest);
    opacity: 0.8;
    line-height: 1.65;
    margin: 0;
    text-align: right;
    max-width: 440px;
  }

  /* ══ Grid ══ */
  .harvest-grid {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  /* ══ Individual tile ══ */
  .tile {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
    background: var(--color-bone);
    cursor: pointer;
    border-right: 1px solid var(--color-border-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .tile:nth-child(4n) {
    border-right: none;
  }

  /* Large tiles span 2 columns and are taller */
  .tile--large {
    grid-column: span 2;
    aspect-ratio: 5/4;
  }

  .tile-img-link {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                filter 0.5s ease;
    mix-blend-mode: multiply; /* Perfect for light background */
    filter: saturate(0.8) contrast(1.1);
  }

  .tile:hover .tile-img {
    transform: scale(1.05);
    filter: saturate(1) contrast(1.1);
  }

  .tile-img-fallback {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    opacity: 0.2;
  }

  /* ══ Overlay ══ */
  .tile-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Gradient from transparent → bone at bottom */
    background: linear-gradient(
      to bottom,
      rgba(239, 230, 211, 0) 30%,
      rgba(239, 230, 211, 0.9) 70%,
      rgba(239, 230, 211, 1) 100%
    );
    padding: 1.1rem 1.25rem 1.1rem;
    transition: background 0.4s ease;
  }

  .tile:hover .tile-overlay {
    background: linear-gradient(
      to bottom,
      rgba(239, 230, 211, 0) 20%,
      rgba(239, 230, 211, 0.95) 60%,
      rgba(239, 230, 211, 1) 100%
    );
  }

  .tile-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.4rem;
  }

  .tile-origin {
    font-family: var(--font-evidence);
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--color-mark-gold);
    font-weight: 500;
  }

  .tile-sep {
    color: var(--color-deep-forest);
    opacity: 0.3;
    font-size: 9px;
  }

  .tile-elevation {
    font-family: var(--font-evidence);
    font-size: 9px;
    letter-spacing: 0.1em;
    color: var(--color-deep-forest);
    opacity: 0.6;
  }

  .tile-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tile-name-wrap {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .tile-name {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 1.6vw, 1.2rem);
    font-weight: 400;
    color: var(--color-deep-forest);
    text-decoration: none;
    line-height: 1.15;
    letter-spacing: 0.01em;
    display: block;
  }

  .tile-name:hover {
    color: var(--color-mark-gold);
  }

  .tile-botanical {
    font-family: var(--font-narrative);
    font-size: 11px;
    font-style: italic;
    color: var(--color-deep-forest);
    opacity: 0.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Large tiles: bigger name */
  .tile--large .tile-name {
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
  }

  /* ══ Action area ══ */
  .tile-action {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    flex-shrink: 0;
  }

  .tile-price {
    font-family: var(--font-evidence);
    font-size: 11px;
    color: var(--color-deep-forest);
    font-weight: 500;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .tile-add {
    background: transparent;
    color: var(--color-deep-forest);
    border: 1px solid var(--color-deep-forest);
    font-family: var(--font-evidence);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.15em;
    padding: 0.45rem 0.85rem;
    cursor: pointer;
    white-space: nowrap;
    min-height: 32px;
    transition: background 0.2s, transform 0.1s;
  }

  .tile-add:hover {
    background: var(--color-deep-forest);
    color: var(--color-bone);
  }

  .tile-add--done {
    background: var(--color-mark-gold);
    color: var(--color-deep-forest);
    border-color: var(--color-mark-gold);
  }

  /* ══ Mobile ══ */
  @media (max-width: 900px) {
    .tile--large {
      aspect-ratio: 16/9;
    }
    .harvest-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .harvest-desc {
      text-align: left;
      max-width: 100%;
    }
  }

  @media (max-width: 520px) {
    .tile {
      aspect-ratio: 1/1;
    }
    .tile--large {
      aspect-ratio: 16/10;
    }
  }
</style>
