---
// Harvest.astro
import { getCollection } from 'astro:content';
import OriginMark from '../OriginMark.astro';

const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));

// Active products only
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});
---

<section class="harvest-section" id="harvest" aria-label="Current Harvest">

  <div class="harvest-header" data-reveal>
    <h2 class="harvest-title">This Season's Harvest</h2>
    <p class="harvest-subtitle">
      Freshly gathered, sun-dried, and packed at source. From whole-leaf mountain teas and native grains to wild forest spices.
    </p>

    <div class="harvest-filters" role="tablist">
      <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
        All Harvests
      </button>
      <button class="filter-btn" data-filter="nilgiris" role="tab" aria-selected="false">
        Nilgiris (Teas & Spices)
      </button>
      <button class="filter-btn" data-filter="idukki" role="tab" aria-selected="false">
        Idukki (Cardamom & Mace)
      </button>
      <button class="filter-btn" data-filter="wayanad" role="tab" aria-selected="false">
        Wayanad (Pepper & Turmeric)
      </button>
      <button class="filter-btn" data-filter="attappady" role="tab" aria-selected="false">
        Attappady (Native Millets)
      </button>
      <button class="filter-btn" data-filter="thiruvananthapuram" role="tab" aria-selected="false">
        Coastal (Dry Ginger)
      </button>
    </div>
  </div>

  <div class="harvest-grid">
    {activeProducts.map((product) => {
      const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
      const origin = originMap[originId];
      const originName = origin ? origin.name : originId;
      const firstSize = product.data.sizes[0];
      const prodImg = product.data.images?.product || product.data.images?.packaging || '';
      
      const priceDisplay = product.data.sizes.length > 1
        ? `₹${Math.min(...product.data.sizes.map(s => s.priceINR))} - ₹${Math.max(...product.data.sizes.map(s => s.priceINR))}`
        : `₹${firstSize.priceINR}`;

      const itemPayload = JSON.stringify({
        id: `${product.id}-${firstSize.label}`,
        productId: product.id,
        name: product.data.name,
        origin: originName,
        originId: originId,
        price: firstSize.priceINR,
        size: firstSize.label,
        weight: firstSize.label,
        quantity: 1
      });

      return (
        <article class="harvest-card" data-origin={originId} data-reveal>
          <div class="harvest-display">
            <div class="card-origin-seal" title="Verified Origin Count">
              <OriginMark size={16} variant="gold" />
            </div>

            <div class="origin-tag">
              {originName}
            </div>

            {prodImg ? (
              <a href={`/origins/${originId}/${product.id}`} class="img-wrap" aria-label={`View ${product.data.name}`}>
                <img src={prodImg} alt={product.data.name} class="product-img" loading="lazy" />
              </a>
            ) : (
              <div class="img-placeholder"></div>
            )}
          </div>

          <div class="harvest-info">
            <h3 class="product-name">
              <a href={`/origins/${originId}/${product.id}`}>{product.data.name}</a>
            </h3>
            
            <p class="product-desc">
              {product.data.botanicalName}
            </p>

            <div class="harvest-footer">
              <div class="price-wrap">
                <span class="price">{priceDisplay}</span>
                <span class="size-label">{firstSize.label}</span>
              </div>
              <button 
                type="button" 
                class="btn-gather"
                data-product-json={itemPayload}
                aria-label={`Add ${product.data.name} to basket`}
              >
                + Add
              </button>
            </div>
          </div>
        </article>
      );
    })}
  </div>

</section>

<script>
  function initHarvest() {
    const filterBtns = document.querySelectorAll('.harvest-filters .filter-btn');
    const cards = document.querySelectorAll('.harvest-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = (btn as HTMLElement).dataset.filter;
        
        filterBtns.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        cards.forEach((card) => {
          const origin = (card as HTMLElement).dataset.origin;
          if (filter === 'all' || origin === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    document.querySelectorAll('.btn-gather').forEach((addBtn) => {
      addBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const jsonStr = (addBtn as HTMLElement).dataset.productJson;
        if (!jsonStr) return;

        try {
          const item = JSON.parse(jsonStr);
          window.dispatchEvent(new CustomEvent('add-to-cart', { detail: item }));
          
          const orig = addBtn.textContent;
          addBtn.textContent = 'Added';
          addBtn.classList.add('is-added');
          setTimeout(() => {
            addBtn.textContent = orig;
            addBtn.classList.remove('is-added');
          }, 1400);
        } catch (err) {
          console.error(err);
        }
      });
    });
  }

  initHarvest();
  document.addEventListener('astro:after-swap', initHarvest);
  document.addEventListener('astro:page-load', initHarvest);
</script>

<style>
  .harvest-section {
    position: relative;
    z-index: 2;
    padding: clamp(3rem, 6vh, 4.5rem) clamp(1rem, 4vw, 4rem);
    background: var(--color-void);
  }

  .harvest-header {
    max-width: 700px;
    margin: 0 auto clamp(2rem, 4vh, 3rem);
    text-align: center;
  }

  .harvest-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-warm-cream);
    font-weight: 300;
  }

  .harvest-subtitle {
    margin: 1rem 0 0;
    font-family: var(--font-narrative);
    font-size: 1.05rem;
    color: var(--color-cream-muted);
    line-height: 1.5;
  }

  .harvest-filters {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid rgba(240, 234, 214, 0.15);
    color: var(--color-cream-muted);
    font-family: var(--font-evidence);
    font-size: 11px;
    border-radius: 4px;
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    letter-spacing: 0.05em;
  }

  .filter-btn:hover {
    color: var(--color-warm-cream);
    border-color: var(--color-gold);
  }

  .filter-btn.is-active {
    background: var(--color-gold);
    border-color: var(--color-gold);
    color: var(--color-void);
    font-weight: 600;
  }

  .harvest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .harvest-card {
    background: var(--color-forest-surface);
    border: 1px solid rgba(240, 234, 214, 0.08);
    border-radius: var(--radius, 8px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
  }

  .harvest-card:hover {
    border-color: rgba(212, 139, 22, 0.4);
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
  }

  .harvest-display {
    position: relative;
    height: 190px;
    background: #080605;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(240, 234, 214, 0.05);
  }

  .card-origin-seal {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    opacity: 0.85;
  }

  .img-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
  }

  .product-img {
    max-height: 85%;
    max-width: 85%;
    object-fit: contain;
    filter: drop-shadow(0 6px 14px rgba(0,0,0,0.5));
    transition: transform 0.4s ease;
  }

  .harvest-card:hover .product-img {
    transform: scale(1.06);
  }

  .origin-tag {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(18, 14, 11, 0.85);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(212, 139, 22, 0.2);
  }

  .harvest-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .product-name a {
    color: var(--color-warm-cream);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .product-name a:hover {
    color: var(--color-gold);
  }

  .product-desc {
    margin: 0.35rem 0 0;
    font-family: var(--font-narrative);
    font-size: 13px;
    color: var(--color-cream-muted);
    font-style: italic;
    flex: 1;
  }

  .harvest-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(240, 234, 214, 0.08);
  }

  .price-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .price {
    font-family: var(--font-evidence);
    font-size: 14px;
    color: var(--color-warm-cream);
    font-weight: 500;
  }

  .size-label {
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-cream-whisper);
    text-transform: uppercase;
  }

  .btn-gather {
    background: transparent;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
    border-radius: 4px;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-evidence);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-gather:hover {
    background: var(--color-gold);
    color: var(--color-void);
  }

  .btn-gather.is-added {
    background: var(--color-warm-cream);
    border-color: var(--color-warm-cream);
    color: var(--color-void);
  }

  @media (max-width: 768px) {
    .harvest-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .harvest-display {
      height: 140px;
      padding: 0.5rem;
    }

    .harvest-info {
      padding: 0.75rem;
    }

    .product-name {
      font-size: 1.05rem;
    }

    .product-desc {
      display: none;
    }

    .harvest-footer {
      margin-top: 0.75rem;
      padding-top: 0.5rem;
    }

    .price {
      font-size: 13px;
    }

    .btn-gather {
      padding: 0.35rem 0.65rem;
      font-size: 10px;
      min-height: 32px;
    }

    .filter-btn {
      font-size: 10px;
      padding: 0.35rem 0.75rem;
    }
  }
</style>
