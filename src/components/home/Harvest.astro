---
// Harvest.astro — Clean, Elegant Product Catalog
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
const allOrigins = await getCollection('origins');

const originMap = Object.fromEntries(allOrigins.map(o => [o.id, o.data]));

// Filter active products with valid sizes
const activeProducts = allProducts.filter(p => {
  const originId = typeof p.data.originSlug === 'object' ? (p.data.originSlug as any).id : p.data.originSlug;
  return originId !== 'malabar-coast' && p.data.sizes && p.data.sizes.length > 0;
});

// Helper for category classification
function getCategory(slug: string, originSlug: string): string {
  if (slug.includes('tea') || slug.includes('coffee')) return 'tea';
  if (slug.includes('millet')) return 'grain';
  return 'spice';
}
---

<section class="harvest-section" id="harvest" aria-label="This Season's Harvest">
  <div class="container">
    
    <!-- Section Header -->
    <div class="harvest-header">
      <div class="harvest-header-left">
        <span class="badge-origin badge-gold">SEASONAL HARVEST</span>
        <h2 class="harvest-title font-serif">Pure From First Hands</h2>
        <p class="harvest-subtitle">
          Sun-dried, unblended, and packaged directly at the origin.
        </p>
      </div>

      <!-- Filter Controls -->
      <div class="harvest-filters" role="tablist" aria-label="Harvest categories">
        <button type="button" class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
          All Yields ({activeProducts.length})
        </button>
        <button type="button" class="filter-btn" data-filter="spice" role="tab" aria-selected="false">
          Forest Spices
        </button>
        <button type="button" class="filter-btn" data-filter="tea" role="tab" aria-selected="false">
          Mountain Teas & Coffee
        </button>
        <button type="button" class="filter-btn" data-filter="grain" role="tab" aria-selected="false">
          Native Grains
        </button>
      </div>
    </div>

    <!-- Product Grid -->
    <div class="harvest-grid" id="harvest-grid">
      {activeProducts.map((product) => {
        const originId = typeof product.data.originSlug === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
        const origin = originMap[originId];
        const originName = origin ? origin.name : originId;
        const elevation = origin?.elevation || '';
        const firstSize = product.data.sizes[0];
        const category = getCategory(product.id, originId);
        const prodImg = product.data.images?.product || product.data.images?.packaging || '/assets/products/minimal-packaging-pouch.jpg';

        const itemPayload = JSON.stringify({
          id: `${product.id}-${firstSize.label}`,
          productId: product.id,
          name: product.data.name,
          origin: originName,
          originId: originId,
          price: firstSize.priceINR,
          size: firstSize.label,
          weight: firstSize.label,
          image: prodImg,
          quantity: 1
        });

        return (
          <article 
            class="harvest-card" 
            data-category={category} 
            data-product-id={product.id}
          >
            <!-- Image Frame -->
            <a 
              href={`/origins/${originId}/${product.id}`} 
              class="card-media-link" 
              aria-label={`View details for ${product.data.name}`}
            >
              <div class="card-media">
                <img
                  src={prodImg}
                  alt={product.data.name}
                  class="card-img"
                  loading="lazy"
                  onerror="this.src='/assets/products/minimal-packaging-pouch.jpg'"
                />
                <span class="card-origin-pill font-mono">
                  {originName.toUpperCase()} {elevation ? `· ${elevation}` : ''}
                </span>
              </div>
            </a>

            <!-- Card Info -->
            <div class="card-body">
              <div class="card-title-group">
                <h3 class="card-title font-serif">
                  <a href={`/origins/${originId}/${product.id}`} class="title-link">
                    {product.data.name}
                  </a>
                </h3>
                {product.data.botanicalName && (
                  <span class="card-botanical font-serif">{product.data.botanicalName}</span>
                )}
              </div>

              <!-- Price & Add Action -->
              <div class="card-footer">
                <div class="price-block">
                  <span class="price-currency">₹</span>
                  <span class="price-val font-mono">{firstSize.priceINR}</span>
                  <span class="price-unit">/ {firstSize.label}</span>
                </div>

                <button
                  type="button"
                  class="btn-add-harvest"
                  data-product-json={itemPayload}
                  aria-label={`Add ${product.data.name} to Harvest basket`}
                >
                  <span>+ Add</span>
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>

<style>
  .harvest-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background-color: var(--color-bone);
  }

  .harvest-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: 2rem;
  }

  @media (min-width: 900px) {
    .harvest-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .harvest-header-left {
    max-width: 540px;
  }

  .harvest-title {
    font-size: var(--type-display);
    margin-top: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .harvest-subtitle {
    font-size: 1rem;
    color: var(--color-ink-muted);
    margin: 0;
  }

  /* Filters */
  .harvest-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 500;
    border-radius: 9999px;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-ink-muted);
    transition: all var(--duration-base) var(--ease-smooth);
  }

  .filter-btn:hover {
    color: var(--color-deep-forest);
    border-color: var(--color-border-medium);
  }

  .filter-btn.is-active {
    background-color: var(--color-deep-forest);
    color: var(--color-bone);
    border-color: var(--color-deep-forest);
  }

  /* Grid */
  .harvest-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 580px) {
    .harvest-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .harvest-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1200px) {
    .harvest-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Card */
  .harvest-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-smooth), box-shadow var(--duration-base) var(--ease-smooth), border-color var(--duration-base) var(--ease-smooth);
  }

  .harvest-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
    border-color: var(--color-border-medium);
  }

  .card-media-link {
    text-decoration: none;
    display: block;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: var(--color-bone-warm);
    overflow: hidden;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s var(--ease-smooth);
  }

  .harvest-card:hover .card-img {
    transform: scale(1.04);
  }

  .card-origin-pill {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    background-color: rgba(18, 28, 19, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-bone);
    border-radius: 4px;
  }

  .card-body {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .card-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
  }

  .title-link:hover {
    color: var(--color-mark-gold);
  }

  .card-botanical {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .price-block {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
  }

  .price-currency {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-deep-forest);
  }

  .price-val {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  .price-unit {
    font-size: 0.75rem;
    color: var(--color-ink-whisper);
    margin-left: 0.15rem;
  }

  .btn-add-harvest {
    padding: 0.45rem 0.9rem;
    background-color: var(--color-bone-warm);
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-deep-forest);
    transition: all var(--duration-base) var(--ease-smooth);
  }

  .btn-add-harvest:hover {
    background-color: var(--color-mark-gold);
    color: #0C150A;
    border-color: var(--color-mark-gold);
  }

  .btn-add-harvest.is-added {
    background-color: var(--color-proof-green);
    color: #FFFFFF;
    border-color: var(--color-proof-green);
  }
</style>

<script>
  function initHarvestCatalog() {
    // Category Filtering
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.harvest-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'all';

        filterBtns.forEach(b => {
          b.classList.toggle('is-active', b === btn);
          b.setAttribute('aria-selected', String(b === btn));
        });

        cards.forEach(card => {
          const category = card.dataset.category || '';
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Add to Harvest Basket
    document.querySelectorAll<HTMLButtonElement>('.btn-add-harvest').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const jsonStr = btn.dataset.productJson;
        if (!jsonStr) return;

        try {
          const product = JSON.parse(jsonStr);
          const stored = localStorage.getItem('ourorigin_basket');
          let items = stored ? JSON.parse(stored) : [];
          
          const existingIndex = items.findIndex((item: any) => item.id === product.id);
          if (existingIndex > -1) {
            items[existingIndex].quantity = (items[existingIndex].quantity || 1) + 1;
          } else {
            items.push(product);
          }

          localStorage.setItem('ourorigin_basket', JSON.stringify(items));
          window.dispatchEvent(new CustomEvent('basket-updated'));
          window.dispatchEvent(new CustomEvent('open-basket'));

          // Visual feedback
          btn.classList.add('is-added');
          const originalText = btn.innerHTML;
          btn.innerHTML = '<span>Added ✓</span>';
          setTimeout(() => {
            btn.classList.remove('is-added');
            btn.innerHTML = originalText;
          }, 1500);

        } catch (err) {
          console.error('Error adding product to basket:', err);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initHarvestCatalog);
  document.addEventListener('astro:page-load', initHarvestCatalog);
</script>
