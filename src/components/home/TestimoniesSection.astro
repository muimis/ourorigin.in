---
// TestimoniesSection.astro — Verified Voices from the Field
const featuredTestimony = {
  quote: "My grandmother used to grow this pepper in Wayanad. I thought that true aroma was lost forever to commercial drying. OurOrigin brought it back.",
  author: "Meena R.",
  role: "Home Cook",
  location: "Thrissur, Kerala"
};

const otherVoices = [
  {
    quote: "I've cooked professionally for 15 years. This ragi and cardamon have an intensity you simply can't find in packaged retail.",
    author: "Chef Arjun S.",
    role: "Culinary Director",
    location: "Kochi"
  },
  {
    quote: "I source for specialty kitchens. OurOrigin is the only supplier where the farmer's name and direct payout are transparently documented.",
    author: "Riyaz M.",
    role: "Restaurateur",
    location: "Bangalore"
  },
  {
    quote: "The orthodox high-mountain tea is fragrant, crisp, and smells like the morning mist of the Nilgiris.",
    author: "Ananya K.",
    role: "Tea Sommelier",
    location: "Chennai"
  }
];
---

<section class="testimonies-section" aria-label="Field Notes & Testimonials">
  <div class="container">
    
    <!-- Section Header -->
    <div class="testimonies-header">
      <span class="badge-origin badge-gold">TESTIMONIES</span>
      <h2 class="testimonies-title font-serif">Voices of Provenance</h2>
    </div>

    <div class="testimonies-grid">
      <!-- Featured Quote Card -->
      <div class="featured-card">
        <div class="quote-mark font-serif" aria-hidden="true">“</div>
        <blockquote class="featured-quote">
          <p class="featured-text font-serif">{featuredTestimony.quote}</p>
          <footer class="featured-author">
            <span class="author-name font-sans">{featuredTestimony.author}</span>
            <span class="author-meta font-mono">{featuredTestimony.role} · {featuredTestimony.location}</span>
          </footer>
        </blockquote>
      </div>

      <!-- Secondary Voices Grid -->
      <div class="secondary-voices">
        {otherVoices.map((item) => (
          <div class="voice-card">
            <p class="voice-text">"{item.quote}"</p>
            <div class="voice-footer">
              <span class="voice-author">{item.author}</span>
              <span class="voice-meta font-mono">{item.role} · {item.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .testimonies-section {
    padding: clamp(4rem, 7vw, 6.5rem) 0;
    background-color: var(--color-bone);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .testimonies-header {
    text-align: center;
    max-width: 500px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .testimonies-title {
    font-size: var(--type-display);
    margin: 0;
  }

  .testimonies-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .testimonies-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: 2.5rem;
      align-items: stretch;
    }
  }

  /* Featured Card */
  .featured-card {
    position: relative;
    padding: clamp(2rem, 4vw, 3.5rem);
    background-color: var(--color-forest-dark);
    color: var(--color-bone);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-card);
  }

  .quote-mark {
    font-size: 5rem;
    line-height: 1;
    color: var(--color-mark-gold);
    opacity: 0.5;
    margin-bottom: -1.5rem;
  }

  .featured-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    flex-grow: 1;
    justify-content: space-between;
  }

  .featured-text {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.45;
    font-weight: 350;
    color: var(--color-bone);
    margin: 0;
  }

  .featured-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-top: 1px solid var(--color-border-dark);
    padding-top: 1.25rem;
  }

  .author-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-bone);
  }

  .author-meta {
    font-size: 0.75rem;
    color: var(--color-mark-gold);
  }

  /* Secondary Voices */
  .secondary-voices {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .voice-card {
    padding: 1.5rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-subtle);
  }

  .voice-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
    margin: 0;
  }

  .voice-footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .voice-author {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  .voice-meta {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
  }
</style>
