---
const features = [
  {
    id: "elevate",
    title: "The Mountain's Yield",
    tagline: "Grown near the clouds",
    desc: "Sourced high in the Western Ghats, where thinner air and cooler nights allow the plant to quietly concentrate everything into the seed.",
    icon: `<svg viewBox="0 0 64 64" fill="none"><path d="M 14 52 Q 22 28 32 12 Q 42 32 50 52" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M 22 36 Q 32 40 42 36" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>`
  },
  {
    id: "temperature",
    title: "Dried by the Sun",
    tagline: "Left to the elements",
    desc: "No machines. No haste. Just ambient sun-drying at natural temperatures, preserving the oils exactly as nature intended.",
    icon: `<svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="12" stroke="currentColor" stroke-width="3" stroke-dasharray="8 6" stroke-linecap="round"/><path d="M 32 8 L 32 14 M 32 50 L 32 56 M 8 32 L 14 32 M 50 32 L 56 32 M 15 15 L 19 19 M 45 45 L 49 49 M 15 49 L 19 45 M 45 15 L 49 19" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>`
  },
  {
    id: "curve",
    title: "A Single Source",
    tagline: "From one farm to you",
    desc: "Never mixed. Each offering is respectfully gathered from a single estate, keeping the connection to the hands that grew it intact.",
    icon: `<svg viewBox="0 0 64 64" fill="none"><path d="M 10 50 Q 20 20 40 40 T 50 15" stroke="currentColor" stroke-width="3" stroke-dasharray="6 6" stroke-linecap="round"/><circle cx="50" cy="15" r="5" fill="currentColor"/></svg>`
  }
];
---
<section class="features-section" data-reveal="up">
  <div class="features-container">
    <div class="features-grid">
      {features.map(feature => (
        <div class="feature-card raw-panel ambient-glow">
          <div class="feature-icon" set:html={feature.icon} />
          <div class="feature-tagline">{feature.tagline}</div>
          <div class="feature-divider"></div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    z-index: 2;
  }

  @media (max-width: 768px) {
    .features-section {
      padding: var(--space-2xl) var(--space-lg);
    }
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-grid {
    display: flex;
    flex-direction: column;
    gap: 30vh; /* Massive gaps so you read one feature at a time */
    margin-left: 50vw; /* Push to the right side of the screen */
    width: 45vw; /* Take up the right half */
    padding: 20vh 0;
  }

  .feature-card {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-xl);
    color: var(--color-gold);
  }

  .feature-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(235, 229, 217, 0.5);
    margin-bottom: var(--space-md);
  }

  .feature-divider {
    width: 30px;
    height: 1px;
    background: var(--color-gold);
    margin: var(--space-md) 0 var(--space-xl) 0;
    opacity: 0.5;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
    margin: 0 0 var(--space-lg) 0;
    color: var(--color-warm-cream);
    line-height: 1.1;
  }

  .feature-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(235, 229, 217, 0.7);
    margin: 0;
  }
</style>
