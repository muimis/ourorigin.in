---
const features = [
  {
    id: "elevate",
    title: "High Altitude Density",
    tagline: "Rise from the earth",
    desc: "Sourced from altitudes above 900m in the Western Ghats, where thinner air and cooler nights force the plant to concentrate everything into the seed.",
    icon: `<svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="32" fill="currentColor" opacity=".05"></circle><path fill="currentColor" stroke="currentColor" stroke-width="1.036" d="m24.019 26.764 7.917-10.11a.088.088 0 0 1 .139 0l7.917 10.11h-4.698v12.739h-6.577V26.764z"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="1.147" d="M28.769 42.148h6.378" opacity=".8"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="1.147" d="M28.769 44.797h6.378" opacity=".6"></path><path stroke="currentColor" stroke-linecap="square" stroke-width="1.147" d="M28.769 47.436h6.378" opacity=".4"></path><path stroke="currentColor" stroke-width=".723" d="M32.007 29.783c3.558 0 6.763.611 9.064 1.586 1.15.487 2.06 1.058 2.675 1.673.613.615.917 1.254.917 1.891s-.304 1.276-.917 1.89c-.616.615-1.524 1.186-2.675 1.674-2.301.974-5.506 1.586-9.064 1.586s-6.762-.612-9.063-1.586c-1.151-.488-2.06-1.059-2.675-1.674-.614-.614-.917-1.253-.917-1.89s.303-1.276.917-1.89c.615-.616 1.524-1.187 2.675-1.674 2.3-.975 5.505-1.586 9.063-1.586Z"></path></svg>`
  },
  {
    id: "temperature",
    title: "Essential Oil Retention",
    tagline: "Sun-dried, never processed",
    desc: "No industrial dryers. No chemicals. Ambient sun-drying at natural temperatures — preserving the volatile oils, natural pigments, and everything the soil encoded.",
    icon: `<svg viewBox="0 0 54 54" fill="none"><circle cx="27" cy="27" r="27" fill="currentColor" opacity=".05"></circle><path fill="currentColor" d="M20.544 21.697a.468.468 0 0 1 .767.36v1h-.004v12.706a5.686 5.686 0 0 0 11.37 0v-1.939h.8v1.939a6.485 6.485 0 0 1-12.971 0V22.96l-.304.355-.304-.26-.303-.26.893-1.043zm6.448-6.845a3.375 3.375 0 0 1 3.375 3.375v17.55a3.375 3.375 0 0 1-6.75 0v-17.55a3.375 3.375 0 0 1 3.375-3.375M24.29 34.764h2.7a.338.338 0 0 0 0-.676h-2.7zm0-2.024h1.35a.338.338 0 0 0 0-.675h-1.35zm2.703-20.992a6.486 6.486 0 0 1 6.485 6.486v12.803l.31-.361.304.26.303.26-.893 1.043-.057.056a.468.468 0 0 1-.766-.36v-13.7a5.686 5.686 0 0 0-11.371 0V20.2h-.801v-1.967a6.487 6.487 0 0 1 6.486-6.486M24.29 30.717h2.7a.338.338 0 0 0 0-.676h-2.7zm0-2.027h1.35a.338.338 0 0 0 0-.676h-1.35zm0-2.024h2.7a.337.337 0 0 0 0-.676h-2.7zm0-2.027h1.35a.338.338 0 0 0 0-.676h-1.35zm0-2.024h2.7a.337.337 0 0 0 0-.675h-2.7zm0-2.023h1.35a.338.338 0 0 0 0-.676h-1.35z"></path></svg>`
  },
  {
    id: "curve",
    title: "Absolute Traceability",
    tagline: "One farm, one batch",
    desc: "Never blended. Each pack is sourced from a single estate — traceable to a specific farm, a specific season, and specific hands.",
    icon: `<svg viewBox="0 0 54 54" fill="none"><circle cx="27" cy="27" r="27" fill="currentColor" opacity=".05"></circle><circle cx="27.001" cy="26.997" r="13.818" stroke="currentColor" stroke-width=".789"></circle><path fill="currentColor" d="M42 25.734v2.324h-2.324v-2.324zM14.328 25.734v2.324h-2.323v-2.324zM26.992 17.754a9.25 9.25 0 1 1-.002 18.5 9.25 9.25 0 0 1 .002-18.5m.532 10.336 1.632 1.632.558-.558-1.632-1.632zm-3.245 1.058.558.557 1.633-1.632-.559-.558zm.024-4.28 1.632 1.633.558-.559-1.633-1.631zm3.198 1.058.558.557 1.631-1.631-.557-.558zM25.828 11.961h2.324v2.324h-2.324zM25.828 39.711h2.324v2.324h-2.324z"></path></svg>`
  }
];
---
<section class="features-section" data-reveal="up">
  <div class="features-container">
    <div class="features-grid">
      {features.map(feature => (
        <div class="feature-card glass-panel ambient-glow">
          <div class="feature-icon" set:html={feature.icon} />
          <div class="feature-tagline">{feature.tagline}</div>
          <div class="feature-divider"></div>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    z-index: 2;
  }

  .features-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-2xl);
  }

  .feature-card {
    padding: var(--space-3xl) var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .feature-icon {
    width: 64px;
    height: 64px;
    margin-bottom: var(--space-xl);
    color: var(--color-gold);
  }

  .feature-tagline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(235, 229, 217, 0.5);
    margin-bottom: var(--space-md);
  }

  .feature-divider {
    width: 24px;
    height: 1px;
    background-color: var(--color-gold);
    margin: var(--space-md) 0 var(--space-xl) 0;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 400;
    margin: 0 0 var(--space-lg) 0;
    color: var(--color-warm-cream);
    line-height: 1.1;
  }

  .feature-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(235, 229, 217, 0.7);
    margin: 0;
  }
</style>
