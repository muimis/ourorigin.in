---
// HeroSection.astro — Controlled Maximalism Editorial Frame
---

<section class="hero-frame" id="hero" aria-label="The Land">
  <div class="layout-pillar-grid hero-grid">
    
    <!-- Pillar 1: Primary Narrative -->
    <div class="hero-col hero-col-text">
      <div class="hero-text-content" data-reveal="fade-up">
        <span class="hero-number">01</span>
        <div class="hero-line"></div>
        <h1 class="hero-title">
          Rooted<br/>in origin.<br/>Driven by<br/>humanity<span class="hero-title-dot">.</span>
        </h1>
        <div class="hero-line hero-line-large"></div>
        <p class="hero-subtitle">
          We work at the intersection of native growers, purpose and impact to build a more meaningful harvest.
        </p>
        <a href="#origins" class="hero-link">
          OUR STORY <span class="hero-link-arrow">→</span>
        </a>
      </div>
    </div>

    <!-- Pillar 2: The Void (Deep Forest Contrast) -->
    <div class="hero-col hero-col-void" aria-hidden="true" data-reveal="wipe">
      <!-- Just an empty dark pillar for structure -->
    </div>

    <!-- Pillar 3: The Reality (Documentary Photography) -->
    <div class="hero-col hero-col-visual" data-reveal="fade-in">
      <img src="/assets/images/gesture_hands.png" alt="Harvesters on the mountain" class="hero-image" />
    </div>

    <!-- Pillar 4: Secondary Narrative -->
    <div class="hero-col hero-col-text hero-col-secondary">
      <div class="hero-text-content" data-reveal="fade-up" style="margin-top: 40vh;">
        <span class="hero-number">02</span>
        <div class="hero-line"></div>
        <h2 class="hero-title hero-title-secondary">
          We partner.<br/>We build.<br/>We create impact<br/>that lasts.
        </h2>
        <a href="#harvest" class="hero-link">
          WHAT WE DO <span class="hero-link-arrow">→</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    const tl = gsap.timeline({ delay: 0.2 });

    // The Void wipes down
    tl.fromTo('.hero-col-void',
      { scaleY: 0, transformOrigin: "top" },
      { scaleY: 1, duration: 1.2, ease: "cubic-bezier(0.76, 0, 0.24, 1)" }
    );

    // Image fades in
    tl.fromTo('.hero-image',
      { opacity: 0, scale: 1.05 },
      { opacity: 1, scale: 1, filter: 'grayscale(100%) brightness(0.8)', duration: 2, ease: 'power2.out' },
      '-=0.8'
    );

    // Text elements stagger up
    tl.fromTo('[data-reveal="fade-up"] > *',
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 1, stagger: 0.1, ease: 'power3.out' },
      '-=1.5'
    );
  }

  if (!(window as any)["heroPillarInit"]) {
    (window as any)["heroPillarInit"] = true;
    document.addEventListener("DOMContentLoaded", initHero);
    document.addEventListener("astro:page-load", initHero);
  } else {
    document.addEventListener("astro:page-load", initHero);
  }
</script>

<style>
  .hero-frame {
    position: relative;
    width: 100%;
    min-height: 100vh;
    padding-top: 120px; /* Offset for header */
  }

  .hero-grid {
    min-height: calc(100vh - 120px);
    align-items: stretch;
  }

  .hero-col {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--space-2xl) var(--space-xl);
  }

  .hero-text-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 320px;
  }

  .hero-number {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-mark-gold);
    letter-spacing: 0.1em;
  }

  .hero-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-mark-gold);
    margin: -10px 0 10px 0;
  }

  .hero-line-large {
    width: 48px;
    margin: 20px 0;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1.05;
    color: var(--color-deep-forest);
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .hero-title-dot {
    color: var(--color-mark-gold);
  }

  .hero-title-secondary {
    font-size: clamp(2rem, 3.5vw, 3rem);
  }

  .hero-subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-narrative);
    line-height: 1.7;
    color: var(--color-deep-forest);
    opacity: 0.8;
  }

  .hero-link {
    margin-top: var(--space-xl);
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-deep-forest);
    font-weight: 500;
    border-bottom: 1px solid var(--color-deep-forest);
    padding-bottom: 4px;
    align-self: flex-start;
    transition: color 0.3s, border-color 0.3s;
  }

  .hero-link:hover {
    color: var(--color-mark-gold);
    border-color: var(--color-mark-gold);
  }

  .hero-link-arrow {
    color: var(--color-mark-gold);
    font-weight: 300;
  }

  .hero-col-void {
    background-color: var(--color-deep-forest);
    padding: 0;
  }

  .hero-col-visual {
    padding: 0;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: grayscale(100%) brightness(0.85) contrast(1.1);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-col-void {
      display: none;
    }
    .hero-col-visual {
      height: 60vh;
      order: -1;
    }
  }
</style>
