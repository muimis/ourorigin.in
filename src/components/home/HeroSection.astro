---
// HeroSection.astro — Clean Editorial Hero
import OriginMark from '../OriginMark.astro';
---

<section class="hero-section" id="hero" aria-label="OurOrigin Introduction">
  <div class="hero-container">
    
    <!-- Top Provenance Tag -->
    <div class="hero-top-badge">
      <span class="badge-origin badge-gold">
        <OriginMark size={14} variant="gold" />
        <span>Universal Ethical Direct Trade</span>
      </span>
      <span class="hero-coords font-mono text-whisper">11°36′N, 76°04′E · Western Ghats</span>
    </div>

    <!-- Main Editorial Headline -->
    <div class="hero-content">
      <h1 class="hero-headline font-serif">
        Real food from wild earth.<br />
        <span class="headline-italic">Direct from first hands.</span>
      </h1>
      
      <p class="hero-lead font-sans">
        Native grains, high-mountain teas, and forest spices. Sourced directly from indigenous farming families across the Western Ghats with zero middlemen, complete price transparency, and unblended single-origin integrity.
      </p>

      <!-- Action CTAs -->
      <div class="hero-actions">
        <a href="#harvest" class="btn-primary">
          <span>Explore Season’s Harvest</span>
          <span class="btn-arrow" aria-hidden="true">↓</span>
        </a>
        <a href="/about" class="btn-secondary">
          <span>Our Ethos & Origin</span>
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!-- Minimalist Visual Feature Strip -->
    <div class="hero-feature-card">
      <div class="hero-media-wrapper">
        <img 
          src="/assets/images/gesture_hands.png" 
          alt="Hands harvesting forest crop at source" 
          class="hero-media-img"
          loading="eager"
        />
        <div class="hero-media-overlay"></div>
      </div>

      <div class="hero-feature-meta">
        <div class="meta-item">
          <span class="meta-label font-mono">FIRST HANDS</span>
          <span class="meta-val">Named farming families</span>
        </div>
        <div class="meta-item">
          <span class="meta-label font-mono">TERROIR</span>
          <span class="meta-val">Forest Canopy & Shola mist</span>
        </div>
        <div class="meta-item">
          <span class="meta-label font-mono">PURITY</span>
          <span class="meta-val">100% Single-origin & unblended</span>
        </div>
        <div class="meta-item">
          <span class="meta-label font-mono">LEDGER</span>
          <span class="meta-val text-gold">Direct fair payout</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding: clamp(3rem, 6vw, 5.5rem) 0 clamp(3.5rem, 7vw, 6rem);
    background: linear-gradient(180deg, var(--color-bone) 0%, var(--color-bone-warm) 100%);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .hero-top-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-coords {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .hero-content {
    max-width: 920px;
  }

  .hero-headline {
    font-size: var(--type-hero);
    line-height: 1.1;
    font-weight: 350;
    color: var(--color-deep-forest);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .headline-italic {
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .hero-lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.65;
    color: var(--color-ink-muted);
    max-width: 760px;
    margin-bottom: 2rem;
    font-weight: 400;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-arrow {
    font-size: 1.1em;
    transition: transform 0.2s ease;
  }

  .btn-primary:hover .btn-arrow {
    transform: translateY(2px);
  }

  .btn-secondary:hover .btn-arrow {
    transform: translateX(3px);
  }

  /* Feature Banner Card */
  .hero-feature-card {
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .hero-media-wrapper {
    position: relative;
    width: 100%;
    height: clamp(240px, 35vw, 440px);
    background-color: var(--color-forest-dark);
    overflow: hidden;
  }

  .hero-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.95) contrast(1.05);
    transition: transform 0.8s var(--ease-smooth);
  }

  .hero-feature-card:hover .hero-media-img {
    transform: scale(1.02);
  }

  .hero-media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(12, 21, 10, 0.05) 0%, rgba(12, 21, 10, 0.35) 100%);
    pointer-events: none;
  }

  .hero-feature-meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 2.5rem);
    background-color: var(--color-bone-card);
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .hero-feature-meta {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-label {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.08em;
  }

  .meta-val {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-deep-forest);
  }
</style>
