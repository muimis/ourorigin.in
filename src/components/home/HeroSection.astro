---
// Act I — The Land Speaks
// Copy speaks to the act of growing and recording — not to any single origin.
// The specific yield in view right now is from the Western Ghats.
---

<section class="hero" id="hero" aria-label="The land">

  <!-- Coordinate pulse: arrives first, anchors the place -->
  <div class="hero-coord" id="hero-coord" aria-label="Geographic coordinates">
    <span class="coord-pulse" aria-hidden="true"></span>
    <span class="coord-string">11°36′N, 76°04′E</span>
    <span class="coord-label">· WESTERN GHATS · ELEVATION 900–1,100M</span>
  </div>

  <!-- The opening breath — from wayanad.json narrative.canopy -->
  <div class="hero-statement" id="hero-statement">
    <p class="hero-line hero-line--1" aria-label="The monsoon doesn't simply fall here.">
      The monsoon doesn't<br class="hero-break"> simply fall here.
    </p>
    <p class="hero-line hero-line--2">
      It moves through in layers —<br class="hero-break">
      <em>canopy first,</em><br class="hero-break">
      then the vine,<br class="hero-break">
      then the soil.
    </p>
    <p class="hero-line hero-line--3">
      In a sequence that repeats<br class="hero-break"> for months.
    </p>
  </div>

  <!-- The consequence — what that moisture becomes -->
  <div class="hero-consequence" id="hero-consequence">
    <p class="consequence-text">
      The humidity that results is not incidental<br> to what pepper becomes.<br>
      <span class="consequence-emphasis">It is, partly, what pepper <em>is.</em></span>
    </p>
  </div>

  <!-- Descent invitation -->
  <div class="hero-descent" id="hero-descent">
    <a href="#the-hand" class="descent-link" aria-label="Continue — meet the hands">
      <span class="descent-label">First Hands · Western Ghats</span>
      <span class="descent-arrow" aria-hidden="true">↓</span>
    </a>
  </div>

  <!-- Topographic/grain texture overlay — pure CSS, no asset needed -->
  <div class="hero-terrain" aria-hidden="true"></div>

</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    // Kill previous instances if navigating back
    gsap.killTweensOf([
      '#hero-coord',
      '.hero-line',
      '#hero-consequence',
      '#hero-descent',
    ]);

    const tl = gsap.timeline({ delay: 0.15 });

    // 1. Coordinates arrive — place is established
    tl.fromTo('#hero-coord',
      { opacity: 0, y: -12 },
      { opacity: 1, y: 0, duration: 1.1, ease: 'power3.out' }
    );

    // 2. First line drops in — the land's opening word
    tl.fromTo('.hero-line--1',
      { opacity: 0, y: 28, filter: 'blur(8px)' },
      { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.3, ease: 'power2.out' },
      '-=0.4'
    );

    // 3. Second line — the layered movement
    tl.fromTo('.hero-line--2',
      { opacity: 0, y: 20, filter: 'blur(6px)' },
      { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.4, ease: 'power2.out' },
      '-=0.7'
    );

    // 4. Third line — the repetition, the permanence
    tl.fromTo('.hero-line--3',
      { opacity: 0, y: 14 },
      { opacity: 1, y: 0, duration: 1.0, ease: 'power2.out' },
      '-=0.5'
    );

    // 5. Consequence rises
    tl.fromTo('#hero-consequence',
      { opacity: 0, y: 18 },
      { opacity: 1, y: 0, duration: 1.1, ease: 'power2.out' },
      '-=0.3'
    );

    // 6. Descent link — last, unhurried
    tl.fromTo('#hero-descent',
      { opacity: 0 },
      { opacity: 1, duration: 1.0, ease: 'power1.out' },
      '-=0.2'
    );

    // Breathing pulse on coord dot
    gsap.to('.coord-pulse', {
      scale: 1.8,
      opacity: 0,
      duration: 1.6,
      ease: 'power1.out',
      repeat: -1,
      repeatDelay: 0.8,
    });

    // Slow drift on the descent arrow
    gsap.to('.descent-arrow', {
      y: 5,
      duration: 1.4,
      ease: 'sine.inOut',
      yoyo: true,
      repeat: -1,
    });
  }

  initHero();
  document.addEventListener('astro:after-swap', initHero);
</script>

<style>
  /* ─── Hero: Full viewport, pure atmosphere ─── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(6rem, 12vh, 9rem) clamp(1.5rem, 6vw, 5rem) clamp(5rem, 10vh, 8rem);
    overflow: hidden;
    background-color: var(--color-void);
    z-index: 1;
  }

  /* ─── Topographic texture: radial grain from centre ─── */
  .hero-terrain {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 70% 50%,
        rgba(255, 69, 0, 0.04) 0%,
        transparent 70%),
      radial-gradient(ellipse 50% 80% at 30% 60%,
        rgba(240, 234, 214, 0.025) 0%,
        transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  /* Subtle horizontal rule — like a surveyor's horizon line */
  .hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(255, 69, 0, 0.2) 30%,
      rgba(255, 69, 0, 0.08) 70%,
      transparent 100%
    );
  }

  /* ─── Coordinate datum ─── */
  .hero-coord {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: clamp(3rem, 6vh, 5rem);
    opacity: 0; /* GSAP reveals */
  }

  .coord-pulse {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 0 8px var(--color-gold);
    flex-shrink: 0;
    transform-origin: center;
  }

  .coord-string {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    letter-spacing: 0.18em;
  }

  .coord-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    color: rgba(240, 234, 214, 0.28);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ─── Main statement block ─── */
  .hero-statement {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2.5vh, 2rem);
    max-width: 860px;
  }

  .hero-line {
    margin: 0;
    font-family: var(--font-display);
    line-height: 1.08;
    font-weight: 400;
    color: var(--color-warm-cream);
    opacity: 0; /* GSAP reveals */
  }

  .hero-line--1 {
    font-size: clamp(2.4rem, 6.5vw, 5.8rem);
    letter-spacing: -0.01em;
  }

  .hero-line--2 {
    font-size: clamp(1.6rem, 3.8vw, 3.4rem);
    color: rgba(240, 234, 214, 0.55);
    font-weight: 300;
    letter-spacing: 0.01em;
    padding-left: clamp(0.5rem, 2vw, 2rem); /* Slight indent — a breath inward */
  }

  .hero-line--2 em {
    font-style: italic;
    color: var(--color-gold);
    opacity: 0.8;
  }

  .hero-line--3 {
    font-size: clamp(1.2rem, 2.8vw, 2.4rem);
    color: rgba(240, 234, 214, 0.3);
    font-weight: 300;
    font-style: italic;
    font-family: var(--font-narrative);
  }

  .hero-break {
    display: block; /* Forced breaks are intentional rhythm */
  }

  /* ─── Consequence text ─── */
  .hero-consequence {
    position: relative;
    z-index: 2;
    margin-top: clamp(2.5rem, 5vh, 4rem);
    max-width: 560px;
    opacity: 0; /* GSAP reveals */
  }

  .consequence-text {
    margin: 0;
    font-family: var(--font-narrative);
    font-size: clamp(0.95rem, 1.8vw, 1.3rem);
    font-weight: 300;
    color: rgba(240, 234, 214, 0.42);
    line-height: 1.75;
  }

  .consequence-emphasis {
    display: block;
    margin-top: 0.5em;
    color: rgba(240, 234, 214, 0.65);
    font-style: italic;
  }

  .consequence-emphasis em {
    color: var(--color-warm-cream);
    font-style: italic;
  }

  /* ─── Descent invitation ─── */
  .hero-descent {
    position: relative;
    z-index: 2;
    margin-top: clamp(3rem, 7vh, 6rem);
    opacity: 0; /* GSAP reveals */
  }

  .descent-link {
    display: inline-flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: rgba(240, 234, 214, 0.35);
    transition: color 0.3s ease;
    cursor: pointer;
  }

  .descent-link:hover {
    color: var(--color-gold);
  }

  .descent-label {
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    display: block;
  }

  .descent-arrow {
    font-size: 1.3rem;
    display: block;
    line-height: 1;
    transform-origin: center;
  }

  /* ─── Mobile ─── */
  @media (max-width: 768px) {
    .hero {
      padding: 7rem 1.5rem 5rem;
      align-items: flex-start;
    }

    .coord-label {
      display: none;
    }

    .hero-line--2 {
      padding-left: 0;
    }

    .hero-break {
      display: inline; /* Let text flow naturally on small screens */
    }

    .hero-line--2 br,
    .hero-line--3 br {
      display: none;
    }
  }
</style>
