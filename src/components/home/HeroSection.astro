---
// HeroSection.astro — The Clipped Origin Mask
---

<section class="hero-frame" id="hero" aria-label="The Land">
  <!-- The main container holding both the mask and the gold sweep -->
  <div class="hero-logo-mask-wrapper" id="hero-logo-trigger">
    
    <!-- The Image masked by the 3 marks (defined in Layout.astro) -->
    <div class="hero-clip-layer">
      <div class="hero-media">
        <img src="/assets/images/gesture_hands.png" alt="Harvesters on the mountain" />
      </div>
    </div>
    
    <!-- The Gold Sweep & Dot perfectly overlaid -->
    <div class="hero-gold-layer">
      <svg viewBox="0 0 580 540" fill="none" class="hero-gold-svg">
        <path class="hero-dot" fill="var(--color-mark-gold)" d="M527,324 L515,330 L511,335 L507,345 L508,357 L510,362 L517,369 L525,373 L540,373 L553,363 L557,352 L557,344 L552,333 L541,325 Z"/>
        <path class="hero-sweep" fill="var(--color-mark-gold)" d="M519,269 L502,269 L473,274 L429,286 L424,286 L421,288 L416,288 L412,291 L409,290 L402,294 L399,293 L393,296 L391,295 L356,307 L342,310 L327,316 L310,320 L293,326 L291,328 L287,328 L279,332 L278,331 L271,335 L269,334 L262,338 L203,359 L200,362 L198,361 L195,364 L186,366 L180,370 L179,369 L176,372 L174,371 L172,374 L166,376 L165,375 L162,378 L154,380 L153,382 L152,381 L152,383 L149,383 L127,394 L94,413 L62,435 L51,446 L50,454 L52,457 L57,459 L70,456 L89,445 L158,412 L159,413 L169,407 L181,403 L234,378 L277,361 L283,357 L287,357 L307,349 L308,347 L310,348 L316,344 L348,333 L350,331 L365,327 L375,322 L386,320 L403,314 L404,312 L408,312 L411,309 L414,310 L419,307 L423,307 L425,305 L446,299 L474,288 L494,282 L499,279 L503,279 L519,272 Z"/>
      </svg>
    </div>

    <!-- The floating typography -->
    <div class="hero-floating-text hero-text-left" data-reveal="fade-up">
      <h1 class="hero-title">
        Rooted in origin.<br/>Driven by humanity.
      </h1>
      <p class="hero-subtitle">
        We work at the intersection of native growers, purpose and impact.
      </p>
    </div>

    <div class="hero-floating-text hero-text-right" data-reveal="fade-up">
      <a href="#origins" class="hero-link">
        OUR STORY <span class="hero-link-arrow">→</span>
      </a>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  function initHero() {
    gsap.registerPlugin(ScrollTrigger);

    const tl = gsap.timeline({ delay: 0.2 });

    // Entrance animation
    tl.fromTo('.hero-media img',
      { scale: 1.2, opacity: 0, filter: 'grayscale(100%)' },
      { scale: 1, opacity: 1, filter: 'grayscale(0%)', duration: 2, ease: 'power3.out' }
    );

    tl.fromTo('.hero-sweep',
      { opacity: 0, x: 20, y: -20 },
      { opacity: 1, x: 0, y: 0, duration: 1.2, ease: 'power2.out' },
      '-=1.5'
    );

    tl.fromTo('.hero-dot',
      { scale: 0, transformOrigin: '50% 50%' },
      { scale: 1, duration: 0.6, ease: 'back.out(2)' },
      '-=1'
    );

    tl.fromTo('[data-reveal="fade-up"]',
      { opacity: 0, y: 30 },
      { opacity: 1, y: 0, duration: 1, stagger: 0.2, ease: 'power3.out' },
      '-=1'
    );

    // Scroll animation: The mask scales up to reveal the world
    gsap.to('.hero-clip-layer', {
      scrollTrigger: {
        trigger: '.hero-frame',
        start: 'top top',
        end: '+=1500', // Pin for 1500px of scrolling
        scrub: 1,
        pin: true,
      },
      scale: 30, // Huge scale to reveal the image completely
      transformOrigin: '50% 50%', // Center
      ease: 'power1.inOut'
    });

    gsap.to('.hero-gold-layer, .hero-floating-text', {
      scrollTrigger: {
        trigger: '.hero-frame',
        start: 'top top',
        end: '+=500',
        scrub: true,
      },
      opacity: 0,
      y: -50,
    });
  }

  if (!(window as any)["heroClipInit"]) {
    (window as any)["heroClipInit"] = true;
    document.addEventListener("DOMContentLoaded", initHero);
    document.addEventListener("astro:page-load", initHero);
  } else {
    document.addEventListener("astro:page-load", initHero);
  }
</script>

<style>
  .hero-frame {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-bone);
    overflow: hidden; /* Keep the massive scaled mask from breaking horizontal scroll */
  }

  .hero-logo-mask-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px; /* Large cinematic size */
    aspect-ratio: 580 / 540;
    margin: 0 auto;
    margin-top: 5vh;
  }

  .hero-clip-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: url(#logo-mask); /* The 3 vertical marks from Layout.astro */
    z-index: 1;
  }

  .hero-media {
    width: 100%;
    height: 100%;
    background-color: var(--color-deep-forest);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-gold-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2; /* Sits exactly on top of the clipped image */
    pointer-events: none;
  }

  .hero-gold-svg {
    width: 100%;
    height: 100%;
  }

  .hero-floating-text {
    position: absolute;
    z-index: 3;
    max-width: 300px;
    pointer-events: auto;
  }

  .hero-text-left {
    top: 40%;
    left: -15%;
  }

  .hero-text-right {
    bottom: 10%;
    right: -10%;
  }

  .hero-title {
    margin: 0 0 var(--space-md) 0;
    font-family: var(--font-narrative);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    line-height: 1.05;
    color: var(--color-deep-forest);
    font-weight: 300;
  }

  .hero-subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--type-whisper);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.7;
    color: var(--color-deep-forest);
    opacity: 0.8;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-deep-forest);
    font-weight: 500;
    border-bottom: 1px solid var(--color-deep-forest);
    padding-bottom: 4px;
    transition: color 0.3s, border-color 0.3s;
  }

  .hero-link:hover {
    color: var(--color-mark-gold);
    border-color: var(--color-mark-gold);
  }

  .hero-link-arrow {
    color: var(--color-mark-gold);
    font-weight: 300;
  }

  @media (max-width: 1024px) {
    .hero-text-left {
      top: -10%;
      left: 5%;
    }
    .hero-text-right {
      bottom: -15%;
      right: 5%;
    }
    .hero-logo-mask-wrapper {
      max-width: 90vw;
    }
  }
</style>
