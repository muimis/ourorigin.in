---
---
<section class="hero-section">
  <!-- Background is now handled globally in index.astro for cinematic morphing -->

  <div class="hero-container">
    <div class="hero-content" data-reveal="stagger" data-delay="300">
      <div class="hero-tagline">
        <span class="tag-dot"></span> We asked the earth for nothing more than what it naturally gives.
      </div>

      <h1 class="hero-title">
        Untouched by machines.<br />
        <span class="title-accent">Carried by the hands that know the soil best.</span>
      </h1>
      
      <p class="hero-copy">
        From the soil to your hands, exactly as the earth offered it.
      </p>

      <div class="hero-actions">
        <a href="#yields" class="btn-primary" onclick="document.getElementById('all-yields-trigger')?.click(); return false;">
          <span class="btn-text">Explore the Yields</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Cinematic floating stats/evidence, no longer constrained by a box -->
  <div class="hero-evidence" data-reveal="fade" data-delay="600">
    <div class="evidence-stat">
      <span class="stat-value">Pure</span>
      <span class="stat-label">The Soil's Proof</span>
    </div>
    <div class="evidence-divider"></div>
    <div class="evidence-desc">
      A transparent journey from the Western Ghats to you.
    </div>
  </div>
</section>

<style>
  .hero-section {
    height: 100vh;
    min-height: 800px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    overflow: hidden;
  }



  .hero-container {
    max-width: 1200px;
    width: 100%;
    position: relative;
    z-index: 10;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px var(--color-gold);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    line-height: var(--line-height-tight);
    font-weight: 300;
    margin: 0;
    color: var(--color-warm-cream);
    letter-spacing: -0.02em;
  }

  .title-accent {
    font-style: italic;
    color: var(--color-gold);
  }

  .hero-copy {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: var(--line-height-loose);
    color: rgba(235, 229, 217, 0.8);
    max-width: 600px;
    margin: 1rem auto;
  }

  .hero-actions {
    margin-top: var(--space-2xl);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.2rem 2.5rem;
    background: transparent;
    border: 1px solid rgba(198, 156, 82, 0.4);
    color: var(--color-warm-cream);
    text-decoration: none;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.9rem;
    transition: all var(--duration-standard) var(--ease-settle);
    border-radius: 40px; /* Elegant pill shape */
  }

  .btn-primary:hover {
    background: rgba(198, 156, 82, 0.1);
    border-color: var(--color-gold);
    box-shadow: 0 0 20px rgba(198, 156, 82, 0.2);
    transform: translateY(-2px);
  }

  .btn-text, .btn-arrow {
    transition: transform var(--duration-standard) var(--ease-settle);
  }

  .btn-primary:hover .btn-arrow {
    transform: translateX(5px);
  }

  /* Cinematic floating evidence */
  .hero-evidence {
    position: absolute;
    bottom: var(--space-4xl);
    right: var(--space-4xl);
    max-width: 280px;
    z-index: 10;
    text-align: right;
  }

  .evidence-stat {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .stat-value {
    font-family: var(--font-institutional);
    font-size: 5rem;
    line-height: 0.8;
    color: var(--color-gold);
    font-weight: 300;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(235, 229, 217, 0.6);
  }

  .evidence-divider {
    height: 1px;
    width: 60px;
    background: var(--color-gold);
    margin: var(--space-lg) 0 var(--space-lg) auto;
    opacity: 0.5;
  }

  .evidence-desc {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: var(--line-height-base);
    color: rgba(235, 229, 217, 0.8);
  }

  @media (max-width: 1024px) {
    .hero-evidence {
      bottom: var(--space-2xl);
      right: var(--space-2xl);
      max-width: 220px;
    }
  }

  @media (max-width: 768px) {
    .hero-evidence {
      position: relative;
      bottom: auto;
      right: auto;
      text-align: center;
      margin-top: var(--space-4xl);
      max-width: 100%;
    }
    .evidence-stat {
      align-items: center;
    }
    .evidence-divider {
      margin: var(--space-lg) auto;
    }
  }
</style>
