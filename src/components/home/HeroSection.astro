---
// HeroSection.astro — Act I: The Ancient Soil & Forest Atmosphere
---

<section class="hero" id="hero" aria-label="The Ancient Land">

  <!-- Coordinate & Geological Datum -->
  <div class="hero-telemetry" id="hero-telemetry" data-reveal="fade">
    <span class="telemetry-pulse" aria-hidden="true"></span>
    <span class="telemetry-coord">11°36′N, 76°04′E</span>
    <span class="telemetry-sep">·</span>
    <span class="telemetry-soil">25 MILLION YEARS OF VOLCANIC SOIL</span>
    <span class="telemetry-sep">·</span>
    <span class="telemetry-status">LIVE RECORD</span>
  </div>

  <!-- Monumental Primeval Truth -->
  <div class="hero-core-statement">
    <span class="hero-ancient-tag" data-reveal="fade">THE WESTERN GHATS</span>
    
    <h1 class="hero-title" data-reveal>
      Before plantations.<br/>
      Before borders.<br/>
      <span class="hero-title-accent">Before trade routes.</span>
    </h1>

    <p class="hero-subtitle" data-reveal>
      The ancient rainforest gave this. We record the truth of the soil, the rhythm of the monsoon, and the dignity of the hands that gathered it.
    </p>
  </div>

  <!-- Dual Action Matrix: Descend or Instant Harvest -->
  <div class="hero-actions" data-reveal>
    <a href="#elevation-realms" class="btn-hero btn-hero--descend">
      <span class="btn-text">Descend Through the 4 Realms</span>
      <span class="btn-arrow" aria-hidden="true">↓</span>
    </a>

    <a href="#specimen-vault" class="btn-hero btn-hero--vault">
      <span class="btn-text">Explore Seasonal Yields</span>
      <span class="btn-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <!-- Elevation Gauge Indicator on Hero Bottom -->
  <div class="hero-gauge" data-reveal="fade">
    <div class="gauge-item">
      <span class="gauge-num">2,600M</span>
      <span class="gauge-label">NILGIRIS</span>
    </div>
    <div class="gauge-divider"></div>
    <div class="gauge-item">
      <span class="gauge-num">1,200M</span>
      <span class="gauge-label">IDUKKI</span>
    </div>
    <div class="gauge-divider"></div>
    <div class="gauge-item">
      <span class="gauge-num">900M</span>
      <span class="gauge-label">WAYANAD</span>
    </div>
    <div class="gauge-divider"></div>
    <div class="gauge-item">
      <span class="gauge-num">60M</span>
      <span class="gauge-label">COASTAL BASIN</span>
    </div>
  </div>

  <!-- Atmospheric Soil & Mist Overlay -->
  <div class="hero-atmosphere" aria-hidden="true"></div>

</section>

<script>
  import { gsap } from 'gsap';

  function initHero() {
    const tl = gsap.timeline({ delay: 0.1 });

    tl.fromTo('#hero-telemetry',
      { opacity: 0, y: -16 },
      { opacity: 1, y: 0, duration: 1.0, ease: 'power3.out' }
    );

    tl.fromTo('.hero-title',
      { opacity: 0, y: 32, filter: 'blur(6px)' },
      { opacity: 1, y: 0, filter: 'blur(0px)', duration: 1.2, ease: 'power2.out' },
      '-=0.6'
    );

    tl.fromTo('.hero-subtitle',
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 1.0, ease: 'power2.out' },
      '-=0.7'
    );

    tl.fromTo('.hero-actions',
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.9, ease: 'power2.out' },
      '-=0.5'
    );

    tl.fromTo('.hero-gauge',
      { opacity: 0 },
      { opacity: 1, duration: 1.2, ease: 'power1.out' },
      '-=0.4'
    );
  }

  initHero();
  document.addEventListener('astro:after-swap', initHero);
  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(6.5rem, 14vh, 10rem) clamp(1.5rem, 6vw, 6rem) clamp(4rem, 8vh, 6rem);
    overflow: hidden;
    background: transparent;
    z-index: 1;
  }

  /* Atmospheric Radial Soil Glow */
  .hero-atmosphere {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 55% at 20% 40%, rgba(139, 37, 0, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 70% 60% at 85% 65%, rgba(212, 139, 22, 0.06) 0%, transparent 65%),
      radial-gradient(circle at 50% 50%, rgba(26, 46, 22, 0.15) 0%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  /* Telemetry Datum */
  .hero-telemetry {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: clamp(1.8rem, 4vh, 3rem);
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-warm-cream);
  }

  .telemetry-pulse {
    width: 7px;
    height: 7px;
    background: var(--color-gold);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--color-gold);
    animation: pulseGlow 2s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .telemetry-coord {
    color: var(--color-gold);
    letter-spacing: 0.15em;
    font-weight: 500;
  }

  .telemetry-sep {
    color: var(--color-cream-whisper);
  }

  .telemetry-soil {
    color: var(--color-cream-muted);
    letter-spacing: 0.12em;
    font-size: var(--type-whisper);
  }

  .telemetry-status {
    color: var(--color-laterite);
    border: 1px solid rgba(139, 37, 0, 0.4);
    padding: 2px 6px;
    font-size: 10px;
    letter-spacing: 0.15em;
    background: rgba(139, 37, 0, 0.1);
  }

  /* Hero Statement */
  .hero-core-statement {
    position: relative;
    z-index: 2;
    max-width: 960px;
  }

  .hero-ancient-tag {
    display: inline-block;
    font-family: var(--font-evidence);
    font-size: var(--type-whisper);
    letter-spacing: 0.3em;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
  }

  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-monumental);
    line-height: 1.05;
    font-weight: 400;
    color: var(--color-warm-cream);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-title-accent {
    color: var(--color-gold-bright);
    font-style: italic;
    font-family: var(--font-narrative);
    font-weight: 300;
    letter-spacing: 0;
  }

  .hero-subtitle {
    margin: clamp(1.2rem, 3vh, 2rem) 0 0;
    font-family: var(--font-narrative);
    font-size: var(--type-narrative);
    line-height: 1.65;
    color: var(--color-cream-muted);
    max-width: 640px;
    font-weight: 300;
  }

  /* Actions */
  .hero-actions {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.9rem 1.6rem;
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--color-border-subtle);
    transition: all var(--duration-standard) var(--ease-settle);
    cursor: pointer;
  }

  .btn-hero--descend {
    background: rgba(212, 139, 22, 0.12);
    border-color: var(--color-gold);
    color: var(--color-warm-cream);
  }

  .btn-hero--descend:hover {
    background: var(--color-gold);
    color: var(--color-forest-deep);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(212, 139, 22, 0.25);
  }

  .btn-hero--vault {
    background: rgba(240, 234, 214, 0.03);
    border-color: var(--color-border-subtle);
    color: var(--color-cream-muted);
  }

  .btn-hero--vault:hover {
    border-color: var(--color-warm-cream);
    color: var(--color-warm-cream);
    background: rgba(240, 234, 214, 0.08);
    transform: translateY(-2px);
  }

  .btn-arrow {
    transition: transform var(--duration-quick) ease;
  }

  .btn-hero:hover .btn-arrow {
    transform: translateX(4px);
  }

  .btn-hero--descend:hover .btn-arrow {
    transform: translateY(4px);
  }

  /* Elevation Gauge */
  .hero-gauge {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(3rem, 7vh, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border-subtle);
    width: 100%;
    max-width: 800px;
  }

  .gauge-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .gauge-num {
    font-family: var(--font-evidence);
    font-size: var(--type-evidence);
    color: var(--color-gold);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .gauge-label {
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-cream-whisper);
    letter-spacing: 0.15em;
  }

  .gauge-divider {
    height: 24px;
    width: 1px;
    background: var(--color-border-subtle);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1.25rem 4rem;
    }
    .hero-telemetry .telemetry-soil,
    .hero-telemetry .telemetry-sep:nth-of-type(2) {
      display: none;
    }
    .hero-gauge {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .gauge-divider {
      display: none;
    }
  }
</style>
