---
---
<section class="hero-section">
  <div class="hero-container">
    <div class="hero-tagline">
      <span>Hand-picked. Soil-honest. First Hands only.</span>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">Grown by the First Hands. Proven by the Soil.</h1>
      
      <p class="hero-copy">
        Sourced single-origin from the Western Ghats. OurOrigin makes the most indigenous yields feel undeniably real.
      </p>

      <div class="hero-desc">
        <span class="highlight">The world's most</span>
        <span class="highlight">rigorously</span>
        <span class="highlight">traceable single-origin yield.</span>
      </div>
    </div>

    <div class="hero-video-wrapper glass-panel">
      <!-- Placeholder for video thumbnail, maintaining original dimensions approximately -->
      <div class="video-placeholder">
        <div class="play-button">PLAY</div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1200px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .hero-tagline {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-2xl);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    line-height: var(--line-height-tight);
    font-weight: 300;
    margin: 0;
    color: var(--color-warm-cream);
  }

  .hero-copy {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: var(--line-height-loose);
    color: rgba(235, 229, 217, 0.8);
    max-width: 480px;
    margin: 0;
  }

  .hero-desc {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    color: rgba(235, 229, 217, 0.5);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-left: 1px solid rgba(198, 156, 82, 0.3);
    padding-left: var(--space-md);
  }

  .hero-desc .highlight {
    color: var(--color-gold);
  }

  .hero-video-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform var(--duration-standard) var(--ease-settle);
  }

  .hero-video-wrapper:hover {
    transform: scale(1.02);
  }

  .video-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(12, 21, 9, 0.8) 0%, rgba(198, 156, 82, 0.1) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-button {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    padding: var(--space-md) var(--space-xl);
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    border-radius: 20px;
    background: rgba(12, 21, 9, 0.5);
    backdrop-filter: blur(4px);
    transition: all var(--duration-standard) var(--ease-settle);
  }

  .hero-video-wrapper:hover .play-button {
    background: var(--color-gold);
    color: var(--color-forest-deep);
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-desc {
      border-left: none;
      border-top: 1px solid rgba(198, 156, 82, 0.3);
      padding-left: 0;
      padding-top: var(--space-md);
      align-items: center;
    }

    .hero-copy {
      margin: 0 auto;
    }
  }
</style>
