---
---
<section class="hero-section">
  <!-- Dynamic Background: Auto-playing silent video or high-res image -->
  <div class="hero-background">
    <!-- Using a placeholder image that looks cinematic, since we don't have a video yet -->
    <div class="bg-image" style="background-image: url('/assets/origins/idukki-canopy.webp');"></div>
    <div class="bg-overlay"></div>
  </div>

  <div class="hero-container">
    <div class="hero-tagline" data-reveal="fade" data-delay="100">
      <span class="tag-dot"></span> Hand-picked. Soil-honest. First Hands only.
    </div>

    <div class="hero-content" data-reveal="stagger" data-delay="300">
      <h1 class="hero-title">
        Grown by the First Hands.<br />
        <span class="title-accent">Proven by the Soil.</span>
      </h1>
      
      <p class="hero-copy">
        Sourced single-origin from the Western Ghats. OurOrigin makes the most indigenous yields feel undeniably real.
      </p>

      <div class="hero-actions">
        <a href="#yields" class="btn-primary" onclick="document.getElementById('all-yields-trigger')?.click(); return false;">
          <span class="btn-text">Explore the Yields</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Cinematic floating stats/evidence -->
    <div class="hero-evidence" data-reveal="up" data-delay="600">
      <div class="evidence-box raw-panel">
        <div class="evidence-stat">
          <span class="stat-value">05</span>
          <span class="stat-label">Verified Origins</span>
        </div>
        <div class="evidence-divider"></div>
        <div class="evidence-desc">
          The world's most rigorously traceable single-origin yields.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    height: 100vh;
    min-height: 800px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    position: relative;
    overflow: hidden;
  }

  .hero-background {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    z-index: 0;
  }

  .bg-image {
    width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    transform: scale(1.05); /* Slight scale for potential parallax/pan effect */
    animation: slowPan 30s linear infinite alternate;
  }

  .bg-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(12, 21, 9, 0.4) 0%,
      rgba(12, 21, 9, 0.8) 50%,
      var(--color-forest-deep) 100%
    );
  }

  @keyframes slowPan {
    0% { transform: scale(1.05) translate(0, 0); }
    100% { transform: scale(1.05) translate(-1%, -1%); }
  }

  .hero-container {
    max-width: 1400px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
    position: relative;
    z-index: 10;
    margin-top: 5vh;
  }

  .hero-tagline {
    grid-column: 1 / -1;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 10px var(--color-gold);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-massive);
    line-height: var(--line-height-tight);
    font-weight: 300;
    margin: 0;
    color: var(--color-warm-cream);
  }

  .title-accent {
    font-style: italic;
    color: var(--color-gold);
  }

  .hero-copy {
    font-family: var(--font-sans);
    font-size: var(--text-lead);
    line-height: var(--line-height-loose);
    color: rgba(235, 229, 217, 0.8);
    max-width: 500px;
    margin: 0;
  }

  .hero-actions {
    margin-top: var(--space-md);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 2rem;
    background: transparent;
    border: 1px solid var(--color-gold);
    color: var(--color-warm-cream);
    text-decoration: none;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.9rem;
    transition: all var(--duration-standard) var(--ease-settle);
    position: relative;
    overflow: hidden;
  }

  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: var(--color-gold);
    transform: translateX(-100%);
    transition: transform var(--duration-standard) var(--ease-settle);
    z-index: 0;
  }

  .btn-primary:hover::before {
    transform: translateX(0);
  }

  .btn-text, .btn-arrow {
    position: relative;
    z-index: 1;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .btn-primary:hover .btn-text, .btn-primary:hover .btn-arrow {
    color: var(--color-forest-deep);
    font-weight: 600;
  }

  /* Right Side Evidence Box */
  .hero-evidence {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    height: 100%;
  }

  .evidence-box {
    padding: var(--space-2xl);
    max-width: 320px;
    border-radius: 2px;
  }

  .evidence-stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-value {
    font-family: var(--font-institutional);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-gold);
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(235, 229, 217, 0.7);
  }

  .evidence-divider {
    height: 1px;
    width: 100%;
    background: rgba(198, 156, 82, 0.3);
    margin: var(--space-xl) 0;
  }

  .evidence-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: var(--line-height-base);
    color: rgba(235, 229, 217, 0.9);
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-2xl);
    }
    .hero-tagline {
      justify-content: center;
    }
    .hero-copy {
      margin: 0 auto;
    }
    .hero-evidence {
      justify-content: center;
      margin-top: var(--space-2xl);
    }
    .evidence-box {
      text-align: left;
    }
  }
</style>
