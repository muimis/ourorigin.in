---
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="wordmark">OurOrigin</span>
      <p class="tagline">From the earth, with integrity.</p>
    </div>
    
    <div class="footer-links">
      <a href="/terms" class="footer-link">Terms & Conditions</a>
      <a href="/privacy" class="footer-link">Privacy Policy</a>
    </div>

    <div class="footer-copy">
      &copy; {currentYear} OurOrigin. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(235, 229, 217, 0.08);
    padding: var(--space-4xl) var(--space-xl);
    background-color: var(--color-void);
    color: var(--color-warm-cream);
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xl);
    text-align: center;
  }

  .wordmark {
    font-family: var(--font-institutional);
    font-size: 1.25rem;
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: var(--space-sm);
  }

  .tagline {
    font-family: var(--font-narrative);
    font-size: 1rem;
    color: rgba(235, 229, 217, 0.6);
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: var(--space-xl);
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(235, 229, 217, 0.5);
    text-decoration: none;
    transition: color var(--duration-standard) var(--ease-settle);
  }

  .footer-link:hover {
    color: var(--color-warm-cream);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: rgba(235, 229, 217, 0.3);
  }
</style>
