---
import { WHATSAPP_NUMBER, EMAIL_ADDRESS, FSSAI_NUMBER } from '../utils/constants';
import OriginMark from './OriginMark.astro';

const currentYear = new Date().getFullYear();
const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}`;
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top-grid">
      <!-- Col 1: Brand & Ethos -->
      <div class="footer-col-main">
        <a href="/" class="footer-brand" aria-label="OurOrigin">
          <OriginMark size={28} variant="gold" />
          <span class="footer-brand-title">OurOrigin</span>
        </a>
        <p class="footer-description">
          Real Food from Wild Earth. Single-origin spices, high-mountain teas, and native grains sourced directly from indigenous farming families across the Western Ghats.
        </p>
        <div class="footer-coordinates">
          <span>8°29′N, 76°57′E</span> · <span>Western Ghats Terroir</span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="footer-nav-group">
        <h4 class="footer-heading">Harvests</h4>
        <ul class="footer-links">
          <li><a href="/origins/wayanad/black-pepper">Wayanad Black Pepper</a></li>
          <li><a href="/origins/idukki/cardamom">Idukki Cardamom</a></li>
          <li><a href="/origins/nilgiris/green-tea">Nilgiris Mountain Tea</a></li>
          <li><a href="/origins/attappady/finger-millet">Attappady Millets</a></li>
          <li><a href="/origins/thiruvananthapuram/dry-ginger">Sun-Dried Ginger</a></li>
        </ul>
      </div>

      <!-- Col 3: Principles & Traceability -->
      <div class="footer-nav-group">
        <h4 class="footer-heading">Provenance</h4>
        <ul class="footer-links">
          <li><a href="/about">First Hands Ethos</a></li>
          <li><a href="/ledger">The Open Ledger</a></li>
          <li><a href="/observations">Field Notes</a></li>
          <li><a href="/#origins">Origins & Terroir</a></li>
          <li><a href="/contact">Grower Partnerships</a></li>
        </ul>
      </div>

      <!-- Col 4: Direct Contact -->
      <div class="footer-nav-group">
        <h4 class="footer-heading">Direct Contact</h4>
        <ul class="footer-links">
          <li><a href={whatsappLink} target="_blank" rel="noopener noreferrer">Order via WhatsApp</a></li>
          <li><a href={`mailto:${EMAIL_ADDRESS}`}>{EMAIL_ADDRESS}</a></li>
          <li><a href="/contact">Inquiries & Custom Orders</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Trade</a></li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom Bar -->
    <div class="footer-bottom-bar">
      <p class="footer-copy">
        &copy; {currentYear} OurOrigin. Universal Ethical Direct Trade. All rights reserved.
      </p>
      <div class="footer-meta-tags">
        <span class="fssai-badge">FSSAI Reg. No. {FSSAI_NUMBER}</span>
        <span class="dot-sep">·</span>
        <span>Zero Middlemen</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-forest-dark);
    color: var(--color-bone);
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 2rem;
    border-top: 1px solid var(--color-border-dark);
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--gutter-x);
  }

  .footer-top-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--color-border-dark);
  }

  @media (min-width: 640px) {
    .footer-top-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-top-grid {
      grid-template-columns: 2fr 1fr 1fr 1.25fr;
      gap: 3rem;
    }
  }

  .footer-col-main {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer-brand-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--color-bone);
  }

  .footer-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-forest-muted);
    max-width: 360px;
    margin: 0;
  }

  .footer-coordinates {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-mark-gold);
    letter-spacing: 0.05em;
  }

  .footer-heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-mark-gold);
    margin-bottom: 1.25rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--color-forest-muted);
    transition: color var(--duration-base) var(--ease-smooth);
  }

  .footer-links a:hover {
    color: var(--color-bone);
  }

  /* Bottom Bar */
  .footer-bottom-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    font-size: 0.75rem;
    color: var(--color-forest-whisper);
  }

  @media (min-width: 768px) {
    .footer-bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer-copy {
    margin: 0;
  }

  .footer-meta-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
  }

  .fssai-badge {
    color: var(--color-forest-muted);
  }

  .dot-sep {
    color: var(--color-forest-whisper);
  }
</style>
