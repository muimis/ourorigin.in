---
import { WHATSAPP_NUMBER, EMAIL_ADDRESS, FSSAI_NUMBER } from '../utils/constants';
import OriginMark from './OriginMark.astro';

const currentYear = new Date().getFullYear();
const whatsappLink = `https://wa.me/${WHATSAPP_NUMBER}`;
---
<footer class="site-footer">
  <div class="layout-three-marks footer-inner">

    <!-- Pillar 1: Brand & Manifesto -->
    <div class="footer-col-brand">
      <div class="footer-brand-lockup">
        <OriginMark size={24} variant="gold" />
        <span class="wordmark">OurOrigin</span>
      </div>
      <p class="tagline">The first hands. The exact place. Honest harvests straight to your kitchen.</p>
      <p class="footer-manifesto">Real food from the earth. Harvested directly. Transferred intact.</p>
    </div>

    <!-- Pillar 2: Empty or spacing -->
    <div class="footer-col-spacer"></div>

    <!-- Pillar 3: Navigation -->
    <div class="footer-col-nav">
      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="nav-group">
          <span class="footer-col-title">The Archive</span>
          <a href="/" class="footer-link">Home</a>
          <a href="/about" class="footer-link">Why This Exists</a>
          <a href="/observations" class="footer-link">Field Notes</a>
        </div>
        <div class="nav-group">
          <span class="footer-col-title">Reach Us</span>
          <a href={whatsappLink} class="footer-link" target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <a href={`mailto:${EMAIL_ADDRESS}`} class="footer-link">{EMAIL_ADDRESS}</a>
          <a href="/contact" class="footer-link">Contact</a>
        </div>
        <div class="nav-group">
          <span class="footer-col-title">Legal</span>
          <a href="/terms" class="footer-link">Terms & Conditions</a>
          <a href="/privacy" class="footer-link">Privacy Policy</a>
        </div>
      </nav>
      
      <div class="footer-bottom">
        <div class="footer-copy">
          &copy; {currentYear} OurOrigin. All rights reserved.
        </div>
        <div class="footer-fssai">
          FSSAI Reg. No. {FSSAI_NUMBER}
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid rgba(245, 240, 232, 0.06);
    background-color: var(--color-deep-forest);
    color: var(--color-bone);
    margin-top: auto;
  }

  .footer-inner {
    align-items: stretch;
  }

  .footer-col-brand {
    grid-column: span 1;
    padding: var(--space-4xl) 0;
    border-right: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer-col-spacer {
    grid-column: span 1;
    border-right: none;
  }

  .footer-col-nav {
    grid-column: span 1;
    padding: var(--space-4xl) 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer-brand-lockup {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-lg);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0;
  }

  .tagline {
    font-family: var(--font-narrative);
    font-style: italic;
    font-size: var(--type-narrative);
    color: var(--color-bone-muted);
    margin: 0 0 var(--space-2xl) 0;
    line-height: var(--line-height-base);
  }

  .footer-manifesto {
    font-family: var(--font-evidence);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-mark-gold);
    margin: 0;
    line-height: 1.6;
  }

  .footer-nav {
    display: flex;
    justify-content: flex-start;
    gap: 4rem;
    margin-bottom: var(--space-4xl);
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-col-title {
    font-family: var(--font-evidence);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-mark-gold);
    margin-bottom: var(--space-md);
  }

  .footer-link {
    font-family: var(--font-evidence);
    font-size: 12px;
    color: var(--color-bone-whisper);
    text-decoration: none;
    transition: color var(--duration-standard) var(--ease-settle);
    line-height: 1.8;
  }

  .footer-link:hover {
    color: var(--color-bone);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(245, 240, 232, 0.06);
    padding-top: var(--space-xl);
  }

  .footer-copy, .footer-fssai {
    font-family: var(--font-evidence);
    font-size: 10px;
    color: var(--color-bone-whisper);
    letter-spacing: 0.05em;
  }

  @media (max-width: 1024px) {
    .footer-col-brand, .footer-col-spacer, .footer-col-nav {
      grid-column: span 1;
      border-right: none;
    }
    .footer-col-brand {
      border-bottom: 1px solid rgba(245, 240, 232, 0.06);
      padding-bottom: var(--space-2xl);
    }
    .footer-col-spacer {
      display: none;
    }
    .footer-nav {
      flex-wrap: wrap;
      gap: 2rem;
    }
  }
</style>
