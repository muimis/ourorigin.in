---
// src/components/TheCore.astro
import { getCollection } from 'astro:content';
import LiveWeather from './LiveWeather.astro';
import OriginMark from './OriginMark.astro';

const products = await getCollection('products');
const origins = await getCollection('origins');

function parseElevation(elevStr: string) {
  const match = String(elevStr || '').match(/[\d,]+/);
  return match ? parseInt(match[0].replace(/,/g, ''), 10) : 0;
}

const originsBySlug = Object.fromEntries(origins.map(o => [o.data.slug, o]));

// Fixed order of origins
const orderedSlugs = ['nilgiris', 'idukki', 'wayanad', 'thiruvananthapuram'];
const sortedOrigins = orderedSlugs.map(slug => originsBySlug[slug]).filter(Boolean);

// Group products by origin
const productsByOrigin = {};
sortedOrigins.forEach(o => {
  productsByOrigin[o.data.slug] = products.filter(p => {
    const oSlug = typeof p.data.originSlug === 'object' ? p.data.originSlug?.id : p.data.originSlug;
    return oSlug === o.data.slug;
  }).sort((a, b) => (a.data.name || '').localeCompare(b.data.name || ''));
});
---

<section id="the-core" class="the-core-section">
  <!-- Cinematic Ambient Backgrounds -->
  <div class="core-cinematic-bg">
    {sortedOrigins.map(origin => (
      <div 
        class="core-bg-layer" 
        id={`bg-${origin.data.slug}`} 
        style={`background-image: url('${origin.data.images?.canopy || ''}');`}
        aria-hidden="true"
      ></div>
    ))}
  </div>

  <div class="core-content-wrapper">
    <!-- Section Header -->
    <div class="core-header" data-reveal>
      <span class="core-tag">Act III &middot; The Harvest</span>
      <h2 class="core-title">The Yield</h2>
      <p class="core-subtitle">Pure, community-harvested botanical yields from their native soil.</p>
    </div>

    <!-- Jump Links -->
    <div class="core-jump-links">
      {sortedOrigins.map(o => (
        <a href={`#zone-${o.data.slug}`} class="jump-pill">{o.data.name}</a>
      ))}
    </div>

    <!-- The Descent -->
    <div class="descent-container">
      {sortedOrigins.map(o => {
        const originProducts = productsByOrigin[o.data.slug];
        if (!originProducts || originProducts.length === 0) return null;

        return (
          <div id={`zone-${o.data.slug}`} class="origin-zone-block" data-origin={o.data.slug}>
            
            <div class="zone-header">
              <h3 class="zone-title">THE {o.data.name.toUpperCase()} &middot; {o.data.elevation.toUpperCase()}</h3>
            </div>

            <div class="product-gallery-grid">
              {originProducts.map((p, index) => {
                const isHero = index === 0;
                const priceRange = p.data.sizes.length > 1
                  ? `₹${Math.min(...p.data.sizes.map(s => s.priceINR))} - ₹${Math.max(...p.data.sizes.map(s => s.priceINR))}`
                  : `₹${p.data.sizes[0].priceINR}`;
                
                const firstSize = p.data.sizes[0];
                const productDataString = JSON.stringify({
                  id: p.id + '-' + firstSize.label,
                  productId: p.id,
                  name: p.data.name,
                  origin: o.data.name,
                  originId: o.data.slug,
                  price: firstSize.priceINR,
                  size: firstSize.label,
                  weight: firstSize.label,
                  quantity: 1
                });

                const hasRealPackaging = !!(p.data.images?.packaging && p.data.images.packaging.trim() !== '');

                return (
                  <article class={`gallery-card ${isHero ? 'hero-card' : ''}`}>
                    <div class="card-image-wrap">
                      {hasRealPackaging ? (
                        <img 
                          src={p.data.images.packaging} 
                          alt={`Packaging of ${p.data.name}`} 
                          class="card-img" 
                          loading="lazy" 
                          transition:name={`product-img-${p.id}`}
                        />
                      ) : (
                        <div class="card-img-pending" role="img" aria-label={`Photography pending for ${p.data.name}`}>
                          <svg viewBox="0 0 100 100" width="48" height="48" aria-hidden="true">
                            <circle cx="50" cy="50" r="49" stroke="currentColor" stroke-width="1.5" fill="none"/>
                            <circle cx="50" cy="50" r="4" fill="currentColor"/>
                          </svg>
                        </div>
                      )}
                      <div class="card-origin-seal" title={`Verified Origin: ${o.data.name}`}>
                        <OriginMark variant="gold" size={32} />
                      </div>
                      <span class="card-origin-pill">{o.data.name}</span>
                    </div>

                    <div class="card-content">
                      <div class="card-meta">
                        <h3 class="card-title">{p.data.name}</h3>
                        <span class="card-botanical">{p.data.botanicalName}</span>
                      </div>

                      <div class="card-dimensions">
                        <div class="dim-item"><span class="dim-label">Geo</span><span class="dim-value">{o.data.elevation}</span></div>
                        <div class="dim-item"><span class="dim-label">Method</span><span class="dim-value">Hand-Harvested</span></div>
                        <div class="dim-item"><span class="dim-label">Time</span><span class="dim-value">Seasonal Yield</span></div>
                      </div>

                      <div class="card-price-row">
                        <span class="card-price">{priceRange}</span>
                      </div>

                      <div class="card-actions">
                        <button class="add-basket-btn" data-product={productDataString}>
                          Honor the Decision
                        </button>
                        <a href={`/origins/${o.data.slug}/${p.id}`} class="explore-story-link">
                          Enter the Origin &rarr;
                        </a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .the-core-section {
    position: relative;
    background-color: var(--color-forest-deep);
    color: var(--color-warm-cream);
    min-height: 100vh;
  }

  .core-cinematic-bg {
    position: fixed; /* Keep it fixed during scroll */
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .core-bg-layer {
    position: absolute;
    inset: -5%;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
    filter: saturate(0.3) contrast(1.1) brightness(0.2);
    transform: scale(1);
    transform-origin: center center;
  }

  .core-bg-layer.is-active {
    opacity: 1;
    animation: slow-breathe 45s linear infinite alternate;
  }

  @keyframes slow-breathe {
    0% { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.08) translate(-1%, -1%); }
  }

  .core-content-wrapper {
    position: relative;
    z-index: 2;
    padding: clamp(4rem, 10vh, 8rem) clamp(1.5rem, 5vw, 6rem) clamp(4rem, 8vh, 6rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Section Header */
  .core-header {
    margin-bottom: 6rem;
    text-align: left;
  }

  .core-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    color: var(--color-gold);
    text-transform: uppercase;
    display: block;
    margin-bottom: 0.8rem;
    opacity: 0.85;
  }

  .core-title {
    font-family: var(--font-institutional);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    font-weight: 300;
    margin: 0 0 0.8rem 0;
    line-height: 1;
    color: var(--color-warm-cream);
  }

  .core-subtitle {
    font-family: var(--font-narrative);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 300;
    color: rgba(245, 237, 216, 0.7);
    margin: 0;
    line-height: 1.4;
  }

  .core-jump-links {
    display: flex;
    gap: 1rem;
    margin-bottom: 6rem;
    flex-wrap: wrap;
  }

  .jump-pill {
    font-family: var(--font-sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--color-warm-cream);
    background: rgba(12, 21, 9, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(247, 242, 230, 0.1);
    padding: 8px 16px;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 20px;
  }
  
  .jump-pill:hover {
    background: rgba(198, 156, 82, 0.15);
    border-color: rgba(198, 156, 82, 0.3);
    color: var(--color-gold);
  }

  /* Descent Architecture */
  .descent-container {
    display: flex;
    flex-direction: column;
    gap: 10rem;
  }

  .origin-zone-block {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .zone-header {
    border-bottom: 1px solid rgba(247, 242, 230, 0.1);
    padding-bottom: 1rem;
  }

  .zone-title {
    font-family: var(--font-institutional);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 300;
    color: var(--color-warm-cream);
    margin: 0;
    letter-spacing: 0.05em;
  }

  /* Removed old gesture and elevation styles */

  /* Direct Product Gallery Grid */
  .product-gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  .gallery-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallery-card:hover {
    transform: translateY(-6px);
  }

  .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    background: rgba(3, 5, 3, 0.45);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(247, 242, 230, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 1.5rem;
    border-radius: var(--stratum-border-radius);
    transition: all 0.5s var(--ease-fluid);
    box-shadow: 0 12px 30px -10px rgba(0,0,0,0.3);
  }

  .gallery-card:hover .card-image-wrap {
    border-color: rgba(198, 156, 82, 0.25);
    box-shadow: 0 20px 50px -10px rgba(198, 156, 82, 0.18);
  }

  .card-img {
    max-width: 75%;
    max-height: 75%;
    object-fit: contain;
    filter: brightness(0.95) contrast(1.05) drop-shadow(0 10px 20px rgba(0,0,0,0.5));
    transition: transform 0.6s var(--ease-fluid);
  }

  .hero-card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-card .card-image-wrap {
    margin-bottom: 0;
    aspect-ratio: 16/9;
  }

  .gallery-card:hover .card-img {
    transform: scale(1.08) translateY(-4px);
  }

  .card-img-pending {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-warm-cream);
    opacity: 0.3;
    width: 100%;
    height: 100%;
  }

  .card-origin-seal {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    opacity: 0.9;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .gallery-card:hover .card-origin-seal {
    opacity: 1;
    transform: scale(1.1);
  }

  .card-origin-pill {
    position: absolute;
    bottom: 12px;
    left: 12px;
    font-family: var(--font-sans);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--color-warm-cream);
    background: rgba(12, 21, 9, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(247, 242, 230, 0.1);
    padding: 6px 14px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  
  .gallery-card:hover .card-origin-pill {
    background: rgba(198, 156, 82, 0.15);
    border-color: rgba(198, 156, 82, 0.3);
    color: var(--color-gold);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
  }

  .card-title {
    font-family: var(--font-institutional);
    font-size: 1.6rem;
    font-weight: 300;
    color: var(--color-warm-cream);
    margin: 0 0 0.2rem 0;
    line-height: 1.1;
  }

  .card-botanical {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: rgba(245, 237, 216, 0.5);
  }

  .card-dimensions {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid rgba(198, 156, 82, 0.1);
    border-bottom: 1px solid rgba(198, 156, 82, 0.1);
    margin: 0.5rem 0;
  }

  .dim-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .dim-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.15em;
    color: var(--color-gold-muted);
    text-transform: uppercase;
  }

  .dim-value {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-warm-cream);
  }

  .card-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
  }

  .card-price {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .card-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .add-basket-btn {
    flex: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    background: transparent;
    border: 1px solid rgba(166, 124, 60, 0.4);
    padding: 12px 14px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
  }

  .add-basket-btn:hover,
  .add-basket-btn.is-added {
    background: var(--color-gold);
    color: var(--color-forest-deep);
    border-color: var(--color-gold);
  }

  .explore-story-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(245, 237, 216, 0.6);
    text-decoration: none;
    padding: 10px 14px;
    transition: color 0.3s ease;
  }

  .explore-story-link:hover {
    color: var(--color-warm-cream);
  }

  /* Responsive Grid */
  @media (max-width: 1024px) {
    .product-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .product-gallery-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .hero-card {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initTheCore() {
    const blocks = document.querySelectorAll('.origin-zone-block');
    const bgLayers = document.querySelectorAll('.core-bg-layer');

    // Scroll Observer to change ambient background based on active origin block
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const origin = entry.target.getAttribute('data-origin');
          bgLayers.forEach(layer => {
            if (layer.id === `bg-${origin}`) {
              layer.classList.add('is-active');
            } else {
              layer.classList.remove('is-active');
            }
          });
        }
      });
    }, {
      rootMargin: '-30% 0px -40% 0px' // Trigger when block is near middle of viewport
    });

    blocks.forEach(block => observer.observe(block));

    // Add to Basket Event Trigger
    document.querySelectorAll('.add-basket-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const data = JSON.parse(btn.getAttribute('data-product') || '{}');
        window.dispatchEvent(new CustomEvent('add-to-ledger', { detail: data }));

        const original = btn.textContent;
        btn.textContent = 'Honored \u2713';
        btn.classList.add('is-added');
        setTimeout(() => {
          btn.textContent = original;
          btn.classList.remove('is-added');
        }, 1200);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTheCore);
  } else {
    initTheCore();
  }
  document.addEventListener('astro:page-load', initTheCore);
</script>
