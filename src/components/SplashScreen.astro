---
import OriginMark from './OriginMark.astro';
import OriginWordmark from './OriginWordmark.astro';
---

<div id="splash-screen" class="splash-screen">
  <div class="splash-content" id="splash-content">
    <div class="splash-lockup">
      <OriginMark size={150} variant="gold" animate={true} id="splash-mark" />
      <div class="splash-wordmark-container" id="splash-wordmark">
        <OriginWordmark size={300} variant="gold" animate={true} id="splash-wordmark-svg" />
      </div>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  // Inline script to add is-splashing immediately to prevent flashes
  const hasSeenSplash = sessionStorage.getItem('hasSeenSplash');
  const splashScreen = document.getElementById('splash-screen');
  
  if (hasSeenSplash !== 'true' && splashScreen) {
    document.body.classList.add('is-splashing');
  }

  document.addEventListener('DOMContentLoaded', () => {
    if (!splashScreen) return;

    if (hasSeenSplash === 'true') {
      splashScreen.style.display = 'none';
      return;
    }

    const wordmark = document.getElementById('splash-wordmark');
    const splashMark = document.getElementById('splash-mark');
    const headerMark = document.querySelector('.site-header .origin-mark');

    // Create cinematic timeline
    const tl = gsap.timeline({
      onComplete: () => {
        splashScreen.style.display = 'none';
        document.body.classList.remove('is-splashing');
        sessionStorage.setItem('hasSeenSplash', 'true');
        // Dispatch event for any other scripts (like reveal.js) to know splash is done
        window.dispatchEvent(new Event('splashComplete'));
      }
    });

    // 1. Wait for tally CSS animation to finish (approx 1.2s)
    tl.to(wordmark, {
      opacity: 1,
      x: 0,
      duration: 0.8,
      ease: "power2.out",
      delay: 1.2
    });

    // 2. Hold for reading
    tl.to({}, { duration: 0.6 });

    // 3. Fade out wordmark
    tl.to(wordmark, {
      opacity: 0,
      duration: 0.4,
      ease: "power2.in"
    });

    // 4. Glide logo to header and fade background
    tl.add(() => {
      if (splashMark && headerMark) {
        const splashRect = splashMark.getBoundingClientRect();
        const headerRect = headerMark.getBoundingClientRect();

        const scale = headerRect.width / splashRect.width;
        const dx = headerRect.left - splashRect.left;
        const dy = headerRect.top - splashRect.top;

        // Animate the mark to the header position
        gsap.to(splashMark, {
          x: dx,
          y: dy,
          scale: scale,
          transformOrigin: "top left",
          duration: 1.2,
          ease: "power3.inOut"
        });
      }
      
      // Fade out the splash background
      gsap.to(splashScreen, {
        backgroundColor: "rgba(12, 21, 9, 0)",
        duration: 1.2,
        ease: "power3.inOut"
      });
    });
  });
</script>

<style>
  .splash-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--color-forest-deep);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: all; /* Block clicks during splash */
  }

  .splash-lockup {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .splash-wordmark-container {
    opacity: 0; /* Hidden initially, GSAP fades it in */
    transform: translateX(-20px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(body.is-splashing) {
    overflow: hidden;
  }
</style>
