---
// src/components/YieldZone.astro
import { getCollection } from 'astro:content';

const products = await getCollection('products');
const origins = await getCollection('origins');

const originsBySlug = Object.fromEntries(origins.map(o => [o.data.slug, o]));

// Fixed order of origins
const orderedSlugs = ['nilgiris', 'idukki', 'wayanad', 'thiruvananthapuram'];
const sortedOrigins = orderedSlugs.map(slug => originsBySlug[slug]).filter(Boolean);

// Group products by origin
const productsByOrigin = {};
sortedOrigins.forEach(o => {
  productsByOrigin[o.data.slug] = products.filter(p => {
    const oSlug = typeof p.data.originSlug === 'object' ? p.data.originSlug?.id : p.data.originSlug;
    return oSlug === o.data.slug;
  }).sort((a, b) => (a.data.name || '').localeCompare(b.data.name || ''));
});
---

<section class="yield-zone">
  <!-- Dynamic Image Reveal Element -->
  <div class="yield-hover-reveal" id="yield-hover-reveal" aria-hidden="true">
    <img src="" alt="" id="yield-hover-img" />
  </div>

  <div class="yield-content">
    <div class="yield-header">
      <h2 class="yield-title">The Yield</h2>
      <p class="yield-subtitle">Pure botanical output. Directly from the First Hands.</p>
    </div>

    <div class="yield-data-stream">
      {sortedOrigins.map(o => {
        const originProducts = productsByOrigin[o.data.slug];
        if (!originProducts || originProducts.length === 0) return null;

        return (
          <div class="origin-dataset">
            <h3 class="dataset-title">[{o.data.name.toUpperCase()} &middot; {o.data.elevation.toUpperCase()}]</h3>
            <div class="dataset-list">
              {originProducts.map((p) => {
                const firstSize = p.data.sizes[0];
                const productDataString = JSON.stringify({
                  id: p.id + '-' + firstSize.label,
                  productId: p.id,
                  name: p.data.name,
                  origin: o.data.name,
                  originId: o.data.slug,
                  price: firstSize.priceINR,
                  size: firstSize.label,
                  weight: firstSize.label,
                  quantity: 1
                });

                const hoverImage = p.data.images?.packaging || p.data.images?.product || '';

                return (
                  <article class="data-row" data-hover-img={hoverImage}>
                    <div class="data-col data-primary">
                      <span class="data-name">{p.data.name}</span>
                      <span class="data-botanical">{p.data.botanicalName}</span>
                    </div>
                    
                    <div class="data-col data-specs">
                      <span class="data-batch">{p.data.batchRef}</span>
                      <span class="data-chem">{p.data.chemistry?.activeCompound || 'N/A'}</span>
                    </div>

                    <div class="data-col data-price">
                      <span>₹{firstSize.priceINR}</span>
                    </div>

                    <div class="data-col data-action">
                      <button 
                        class="data-add-btn magnetic-btn" 
                        data-product={productDataString}
                        aria-label={`Add ${p.data.name} to transfer`}
                      >
                        <span class="btn-text">Transfer</span>
                        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M6 1V11M1 6H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                      </button>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Add to ledger functionality
    document.querySelectorAll('.data-add-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const productDataStr = (e.currentTarget as HTMLElement).getAttribute('data-product');
        if (productDataStr) {
          const product = JSON.parse(productDataStr);
          window.dispatchEvent(new CustomEvent('cart-add', { detail: product }));
        }
      });
    });

    // Hover Image Reveal Logic
    const revealContainer = document.getElementById('yield-hover-reveal');
    const revealImg = document.getElementById('yield-hover-img') as HTMLImageElement;
    const rows = document.querySelectorAll('.data-row');

    if (revealContainer && revealImg) {
      rows.forEach(row => {
        row.addEventListener('mouseenter', (e) => {
          const imgSrc = (e.currentTarget as HTMLElement).getAttribute('data-hover-img');
          if (imgSrc) {
            revealImg.src = imgSrc;
            revealContainer.classList.add('is-active');
          }
        });
        
        row.addEventListener('mouseleave', () => {
          revealContainer.classList.remove('is-active');
        });
      });
    }
  });
</script>

<style>
  .yield-zone {
    width: 50vw;
    height: 100vh;
    overflow-y: auto;
    background-color: var(--color-warm-cream);
    color: var(--color-forest-deep);
    position: relative;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .yield-zone::-webkit-scrollbar {
    display: none;
  }

  /* Fixed Image Reveal */
  .yield-hover-reveal {
    position: fixed;
    top: 50%;
    right: 5vw;
    transform: translateY(-50%);
    width: 300px;
    height: 400px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    mix-blend-mode: multiply; /* Blends beautifully with cream */
  }

  .yield-hover-reveal.is-active {
    opacity: 1;
    transform: translateY(-50%) scale(1.05);
  }

  .yield-hover-reveal img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .yield-content {
    position: relative;
    z-index: 2; /* Sits above hover reveal */
    padding: clamp(3rem, 6vw, 8rem) clamp(2rem, 5vw, 6rem);
    padding-bottom: 25vh;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10vh;
  }

  .yield-header {
    margin-top: 5vh;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .yield-title {
    font-family: var(--font-institutional);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 300;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .yield-subtitle {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    color: rgba(12, 21, 9, 0.6);
    text-transform: uppercase;
  }

  .yield-data-stream {
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .dataset-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    color: rgba(12, 21, 9, 0.4);
    margin: 0 0 2rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(12, 21, 9, 0.1);
  }

  .dataset-list {
    display: flex;
    flex-direction: column;
  }

  .data-row {
    display: grid;
    grid-template-columns: 2.5fr 1.5fr 1fr 1fr;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(12, 21, 9, 0.05);
    transition: all 0.3s ease;
    cursor: default;
  }
  
  .data-row:hover {
    border-bottom-color: rgba(12, 21, 9, 0.3);
    transform: translateX(10px);
  }

  .data-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .data-primary {
    gap: 0.3rem;
  }

  .data-name {
    font-family: var(--font-institutional);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .data-botanical {
    font-family: var(--font-mono);
    font-size: 10px;
    font-style: italic;
    color: rgba(12, 21, 9, 0.5);
    letter-spacing: 0.05em;
  }

  .data-specs {
    font-family: var(--font-mono);
    font-size: 10px;
    gap: 0.3rem;
    color: rgba(12, 21, 9, 0.6);
    letter-spacing: 0.05em;
  }

  .data-price {
    font-family: var(--font-mono);
    font-size: 1rem;
    text-align: right;
  }

  .data-action {
    text-align: right;
    display: flex;
    justify-content: flex-end;
  }

  /* Magnetic Button Style */
  .magnetic-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: transparent;
    border: 1px solid rgba(12, 21, 9, 0.2);
    border-radius: 40px;
    padding: 0.6rem 1.2rem;
    color: var(--color-forest-deep);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .magnetic-btn svg {
    transition: transform 0.3s ease;
  }

  .magnetic-btn:hover {
    background: var(--color-forest-deep);
    color: var(--color-warm-cream);
    border-color: var(--color-forest-deep);
    transform: scale(1.05);
  }
  
  .magnetic-btn:hover svg {
    transform: rotate(90deg);
  }

  @media (max-width: 900px) {
    .yield-zone {
      width: 100vw;
      height: auto;
      min-height: 100vh;
      overflow-y: visible;
    }
    .data-row {
      grid-template-columns: 1fr auto;
      gap: 1rem;
    }
    .data-row:hover {
      transform: translateX(0);
    }
    .data-specs {
      display: none;
    }
    .yield-hover-reveal {
      display: none;
    }
    .btn-text {
      display: none;
    }
    .magnetic-btn {
      padding: 0.6rem;
      border-radius: 50%;
    }
  }
</style>
