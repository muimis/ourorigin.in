---
import { WHATSAPP_NUMBER, FSSAI_NUMBER } from '../utils/constants';
import OriginMark from './OriginMark.astro';
---

<!-- Basket Backdrop -->
<div id="basket-backdrop" class="basket-backdrop" aria-hidden="true"></div>

<!-- Basket Slide-over Panel -->
<aside id="basket-drawer" class="basket-drawer" aria-label="Shopping Basket" aria-hidden="true">
  <div class="basket-container">
    
    <!-- Drawer Header -->
    <div class="basket-header">
      <div class="basket-header-title">
        <OriginMark size={20} variant="gold" />
        <h2 class="basket-heading font-serif">Your Harvest Basket</h2>
      </div>
      <button type="button" id="basket-close-btn" class="basket-close-btn" aria-label="Close basket">
        ✕
      </button>
    </div>

    <!-- Basket Body -->
    <div class="basket-body">
      <!-- Empty State -->
      <div id="basket-empty" class="basket-empty-state">
        <div class="empty-icon font-mono">∅</div>
        <p class="empty-title font-serif">Your harvest is empty</p>
        <p class="empty-desc text-muted">Explore our native spices, mountain teas, and heritage grains.</p>
        <a href="/#harvest" class="btn-primary btn-sm" id="empty-explore-btn">Browse Harvests</a>
      </div>

      <!-- Items List -->
      <div id="basket-items-list" class="basket-items-list">
        <!-- Dynamically rendered by JS -->
      </div>
    </div>

    <!-- Drawer Footer / Checkout -->
    <div id="basket-footer" class="basket-footer">
      <!-- Price Breakdown -->
      <div class="basket-summary">
        <div class="summary-row">
          <span class="text-muted">Subtotal</span>
          <span id="summary-subtotal" class="font-mono font-bold">₹0</span>
        </div>
        <div class="summary-row">
          <span class="text-muted">Direct Farm Dispatch</span>
          <span id="summary-shipping" class="font-mono text-gold">FREE</span>
        </div>
        <div class="summary-row summary-total">
          <span class="font-serif">Total</span>
          <span id="summary-total" class="font-mono total-amount">₹0</span>
        </div>
      </div>

      <!-- Shipping Information Form -->
      <form id="basket-checkout-form" class="checkout-form">
        <div class="form-title font-mono">DELIVERY INFORMATION</div>
        
        <input 
          type="text" 
          id="cust-name" 
          placeholder="Your full name" 
          required 
          class="form-input" 
        />
        
        <input 
          type="tel" 
          id="cust-phone" 
          placeholder="WhatsApp phone number" 
          required 
          class="form-input" 
        />

        <textarea 
          id="cust-address" 
          placeholder="Delivery address & Pincode" 
          rows="2" 
          required 
          class="form-input form-textarea"
        ></textarea>

        <!-- Action: WhatsApp Checkout -->
        <button type="submit" class="btn-primary btn-checkout">
          <span>Complete Order on WhatsApp</span>
          <span aria-hidden="true">→</span>
        </button>

        <!-- UPI Direct Note -->
        <div class="upi-box">
          <div class="upi-header">
            <span class="upi-tag font-mono">DIRECT UPI</span>
            <span class="upi-id font-mono">ourorigin@ybl</span>
            <button type="button" id="copy-upi-btn" class="upi-copy-btn font-mono">Copy</button>
          </div>
          <p class="upi-note">You will receive instant dispatch confirmation once ordered.</p>
        </div>
      </form>
    </div>

  </div>
</aside>

<style>
  /* Backdrop */
  .basket-backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(12, 21, 10, 0.45);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s var(--ease-smooth), visibility 0.3s;
  }

  .basket-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* Drawer Panel */
  .basket-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 440px;
    background-color: var(--color-bone);
    box-shadow: -10px 0 40px rgba(12, 21, 10, 0.2);
    z-index: 210;
    transform: translateX(100%);
    transition: transform 0.35s var(--ease-smooth);
    display: flex;
    flex-direction: column;
  }

  .basket-drawer.is-open {
    transform: translateX(0%);
  }

  .basket-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* Header */
  .basket-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    background-color: var(--color-bone-card);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .basket-header-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .basket-heading {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
  }

  .basket-close-btn {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 1rem;
    color: var(--color-ink-muted);
    background-color: var(--color-bone-warm);
    transition: all 0.2s ease;
  }

  .basket-close-btn:hover {
    background-color: var(--color-deep-forest);
    color: var(--color-bone);
  }

  /* Body */
  .basket-body {
    flex-grow: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  /* Empty State */
  .basket-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 240px;
    text-align: center;
    gap: 0.75rem;
  }

  .empty-icon {
    font-size: 2.5rem;
    color: var(--color-mark-gold);
    opacity: 0.6;
  }

  .empty-title {
    font-size: 1.35rem;
    margin: 0;
  }

  .empty-desc {
    font-size: 0.875rem;
    max-width: 260px;
    margin: 0;
  }

  .btn-sm {
    padding: 0.5rem 1.2rem;
    font-size: 0.8125rem;
    margin-top: 0.5rem;
  }

  /* Items List */
  .basket-items-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Item Card (Generated via JS) */
  :global(.basket-item-card) {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background-color: var(--color-bone-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    align-items: center;
  }

  :global(.basket-item-img) {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    background-color: var(--color-bone-warm);
    flex-shrink: 0;
  }

  :global(.basket-item-info) {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.basket-item-title) {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
    color: var(--color-deep-forest);
  }

  :global(.basket-item-origin) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
  }

  :global(.basket-item-price) {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  :global(.basket-item-qty-wrap) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-bone-warm);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  :global(.qty-btn) {
    font-size: 0.875rem;
    font-weight: 600;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-deep-forest);
  }

  :global(.qty-num) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    min-width: 14px;
    text-align: center;
  }

  :global(.remove-item-btn) {
    color: var(--color-ink-whisper);
    font-size: 1rem;
    padding: 0.25rem;
    line-height: 1;
  }

  :global(.remove-item-btn:hover) {
    color: #C23B22;
  }

  /* Footer */
  .basket-footer {
    padding: 1.25rem 1.5rem 1.5rem;
    background-color: var(--color-bone-card);
    border-top: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 50vh;
    overflow-y: auto;
  }

  .basket-summary {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
  }

  .summary-total {
    font-size: 1.15rem;
    font-weight: 600;
    padding-top: 0.4rem;
    color: var(--color-deep-forest);
  }

  .total-amount {
    color: var(--color-deep-forest);
  }

  /* Checkout Form */
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .form-title {
    font-size: 0.6875rem;
    color: var(--color-ink-whisper);
    letter-spacing: 0.08em;
  }

  .form-input {
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: 4px;
    background-color: var(--color-bone);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-deep-forest);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .form-input:focus {
    border-color: var(--color-mark-gold);
  }

  .form-textarea {
    resize: none;
  }

  .btn-checkout {
    width: 100%;
    padding: 0.85rem;
    margin-top: 0.25rem;
  }

  /* UPI Box */
  .upi-box {
    padding: 0.75rem;
    background-color: var(--color-bone-warm);
    border: 1px dashed var(--color-border-gold);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .upi-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .upi-tag {
    color: var(--color-ink-whisper);
    font-size: 0.625rem;
  }

  .upi-id {
    font-weight: 600;
    color: var(--color-deep-forest);
  }

  .upi-copy-btn {
    font-size: 0.6875rem;
    color: var(--color-mark-gold);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    border: 1px solid var(--color-border-gold);
  }

  .upi-copy-btn:hover {
    background-color: var(--color-mark-gold);
    color: #0C150A;
  }

  .upi-note {
    font-size: 0.6875rem;
    color: var(--color-ink-muted);
    margin: 0;
  }
</style>

<script define:vars={{ WHATSAPP_NUMBER }}>
  function initBasket() {
    const drawer = document.getElementById('basket-drawer');
    const backdrop = document.getElementById('basket-backdrop');
    const closeBtn = document.getElementById('basket-close-btn');
    const emptyState = document.getElementById('basket-empty');
    const itemsList = document.getElementById('basket-items-list');
    const footer = document.getElementById('basket-footer');
    const subtotalEl = document.getElementById('summary-subtotal');
    const totalEl = document.getElementById('summary-total');
    const checkoutForm = document.getElementById('basket-checkout-form');
    const copyUpiBtn = document.getElementById('copy-upi-btn');
    const emptyExploreBtn = document.getElementById('empty-explore-btn');

    function openBasket() {
      if (drawer && backdrop) {
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
        renderBasket();
      }
    }

    function closeBasket() {
      if (drawer && backdrop) {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        backdrop.setAttribute('aria-hidden', 'true');
      }
    }

    function toggleBasket() {
      if (drawer?.classList.contains('is-open')) {
        closeBasket();
      } else {
        openBasket();
      }
    }

    if (closeBtn) closeBtn.addEventListener('click', closeBasket);
    if (backdrop) backdrop.addEventListener('click', closeBasket);
    if (emptyExploreBtn) emptyExploreBtn.addEventListener('click', closeBasket);

    window.addEventListener('open-basket', openBasket);
    window.addEventListener('close-basket', closeBasket);
    window.addEventListener('toggle-basket', toggleBasket);
    window.addEventListener('basket-updated', renderBasket);

    // Render Basket Items
    function getStoredItems() {
      try {
        const stored = localStorage.getItem('ourorigin_basket');
        return stored ? JSON.parse(stored) : [];
      } catch (e) {
        return [];
      }
    }

    function saveItems(items) {
      localStorage.setItem('ourorigin_basket', JSON.stringify(items));
      window.dispatchEvent(new CustomEvent('basket-updated'));
    }

    function renderBasket() {
      const items = getStoredItems();
      if (!itemsList || !emptyState || !footer) return;

      if (items.length === 0) {
        emptyState.style.display = 'flex';
        itemsList.style.display = 'none';
        footer.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      itemsList.style.display = 'flex';
      footer.style.display = 'flex';

      let subtotal = 0;
      itemsList.innerHTML = '';

      items.forEach((item, index) => {
        const qty = Number(item.quantity) || 1;
        const price = Number(item.price) || 0;
        const itemTotal = price * qty;
        subtotal += itemTotal;

        const card = document.createElement('div');
        card.className = 'basket-item-card';
        card.innerHTML = `
          <img src="${item.image || '/assets/products/minimal-packaging-pouch.jpg'}" alt="${item.name}" class="basket-item-img" />
          <div class="basket-item-info">
            <h4 class="basket-item-title">${item.name}</h4>
            <span class="basket-item-origin">${item.origin || ''} · ${item.size || ''}</span>
            <span class="basket-item-price">₹${itemTotal}</span>
          </div>
          <div class="basket-item-qty-wrap">
            <button type="button" class="qty-btn" data-action="decrease" data-index="${index}" aria-label="Decrease quantity">−</button>
            <span class="qty-num">${qty}</span>
            <button type="button" class="qty-btn" data-action="increase" data-index="${index}" aria-label="Increase quantity">+</button>
          </div>
          <button type="button" class="remove-item-btn" data-action="remove" data-index="${index}" aria-label="Remove item">✕</button>
        `;
        itemsList.appendChild(card);
      });

      if (subtotalEl) subtotalEl.textContent = `₹${subtotal}`;
      if (totalEl) totalEl.textContent = `₹${subtotal}`;

      // Attach item controls
      itemsList.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.dataset.action;
          const index = Number(btn.dataset.index);
          const currentItems = getStoredItems();
          if (action === 'increase') {
            currentItems[index].quantity = (currentItems[index].quantity || 1) + 1;
          } else if (action === 'decrease') {
            if ((currentItems[index].quantity || 1) > 1) {
              currentItems[index].quantity -= 1;
            } else {
              currentItems.splice(index, 1);
            }
          }
          saveItems(currentItems);
        });
      });

      itemsList.querySelectorAll('.remove-item-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const index = Number(btn.dataset.index);
          const currentItems = getStoredItems();
          currentItems.splice(index, 1);
          saveItems(currentItems);
        });
      });
    }

    // Handle WhatsApp Checkout
    if (checkoutForm) {
      checkoutForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const items = getStoredItems();
        if (items.length === 0) return;

        const name = (document.getElementById('cust-name') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('cust-phone') as HTMLInputElement)?.value.trim();
        const address = (document.getElementById('cust-address') as HTMLTextAreaElement)?.value.trim();

        let subtotal = 0;
        let itemsText = '';

        items.forEach((item) => {
          const qty = Number(item.quantity) || 1;
          const price = Number(item.price) || 0;
          const itemTotal = price * qty;
          subtotal += itemTotal;
          itemsText += `• ${item.name} (${item.size}) × ${qty} = ₹${itemTotal}\n`;
        });

        const message = `🌿 *OurOrigin — Harvest Order Request*\n\n` +
          `*Customer Details:*\n` +
          `Name: ${name}\n` +
          `Phone: ${phone}\n` +
          `Delivery Address: ${address}\n\n` +
          `*Harvest Items:*\n${itemsText}\n` +
          `*Total Amount:* ₹${subtotal}\n` +
          `*Dispatch:* Direct Farm Dispatch (Free)\n\n` +
          `_Please confirm availability and dispatch schedule._`;

        const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      });
    }

    // Copy UPI ID
    if (copyUpiBtn) {
      copyUpiBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('ourorigin@ybl').then(() => {
          copyUpiBtn.textContent = 'Copied!';
          setTimeout(() => {
            copyUpiBtn.textContent = 'Copy';
          }, 2000);
        });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initBasket);
  document.addEventListener('astro:page-load', initBasket);
</script>
