---
import { getCollection } from 'astro:content';
import { WHATSAPP_NUMBER, FSSAI_NUMBER, GOOGLE_SHEET_API_URL } from '../utils/constants';
import OriginMark from './OriginMark.astro';

const products = await getCollection('products');

// Build a map of originId -> companion product names
const companionProductsMap: Record<string, any[]> = {};
const proofMap: Record<string, any> = {};

products.forEach(product => {
  if (product.data.proofSystem) {
    proofMap[product.id] = product.data.proofSystem;
  }
  if (!product.data.isAnchorProduct) {
    const originId = typeof (product.data.originSlug as any) === 'object' ? (product.data.originSlug as any).id : product.data.originSlug;
    if (!companionProductsMap[originId]) {
      companionProductsMap[originId] = [];
    }
    companionProductsMap[originId].push({
      id: product.id,
      name: product.data.name
    });
  }
});

const companionsJson = JSON.stringify(companionProductsMap);
const proofsJson = JSON.stringify(proofMap);
---

<!-- Global Toast Removed -->

<!-- Persistent Trigger -->
<div id="basket-trigger" class="basket-trigger hidden" aria-live="polite" role="button" tabindex="0">
  <span id="basket-count"></span> in Harvest
</div>

<!-- Slide-up Panel -->
<div id="basket-overlay" class="basket-overlay hidden" data-whatsapp={WHATSAPP_NUMBER} data-api-url={GOOGLE_SHEET_API_URL} data-companions={companionsJson} data-proofs={proofsJson}>
  <div class="basket-backdrop" id="basket-close-backdrop"></div>
  <div class="basket-panel" role="complementary" aria-label="Your Basket">
    <div class="basket-header">
      <h2 class="basket-title">Your Harvest</h2>
      <button id="basket-close-btn" class="basket-close" aria-label="Close Basket">Close</button>
    </div>
    
    <div class="basket-content">
      <div id="basket-items-container" class="basket-items">
        <!-- JS will populate items here -->
      </div>
      
      <div id="basket-empty-state" class="basket-empty hidden">
        Your Harvest is empty.<br>Explore our origins.
      </div>
      
      <div id="basket-footer" class="basket-footer hidden">
        <div class="basket-total">
          <span>Subtotal</span>
          <span id="basket-subtotal-price" class="price-font">₹0</span>
        </div>
        
        <!-- Order Summary (Gap 2) -->
        <div id="basket-order-summary" class="basket-order-summary">
          <p class="summary-heading">YOUR ORDER</p>
          <div id="summary-items" class="summary-items"></div>
          <hr class="summary-divider" />
          <div class="summary-row">
            <span>Subtotal</span>
            <span id="summary-subtotal">₹0</span>
          </div>
          <div class="summary-row">
            <span>Shipping</span>
            <span id="summary-shipping">Free</span>
          </div>
          <div id="shipping-prompt-note" class="shipping-prompt-note hidden"></div>
          <hr class="summary-divider-solid" />
          <div class="summary-row total-row">
            <span>Total</span>
            <span id="summary-total">₹0</span>
          </div>
          <p class="dispatch-timeline">DISPATCH WITHIN 2–3 WORKING DAYS · THIRUVANANTHAPURAM</p>
        </div>
        <!-- Community Impact Summary -->
        <div id="basket-community-summary" class="basket-community-summary">
          <span class="community-summary-tag">SUPPORTED ORIGINS</span>
          <span id="community-origins-list" class="community-origins-list">First Hands · Western Ghats Community</span>
        </div>

        <div class="basket-observation-guide">
          <p class="observation-title">THE FINAL INCH</p>
          <p class="observation-text">
            This harvest reflects a journey deep into the forest. It reflects the First Hands leaving the unripened—and whatever the wild animals claim—to nature with joy, not compromise. Their dignity is inherent. By completing this transfer, you take your place as the final link in this origin system.
          </p>
        </div>

        <p class="summary-heading">WHERE TO SEND THIS</p>        
        <!-- Shipping Form -->
        <form id="shipping-form" class="shipping-form">
          <input type="text" id="ship-name" name="name" placeholder="Full name" required />
          <input type="text" id="ship-house" name="house" placeholder="House/Flat number" required />
          <input type="text" id="ship-street" name="street" placeholder="Street/Locality" required />
          <div class="form-row">
            <input type="text" id="ship-city" name="city" placeholder="City" required />
            <input type="text" id="ship-state" name="state" placeholder="State" required />
          </div>
          <div class="form-row">
            <input type="text" id="ship-pin" name="pin" placeholder="PIN Code (6 digits)" pattern="[0-9]{6}" required />
            <input type="tel" id="ship-phone" name="phone" placeholder="Phone (for delivery updates)" pattern="[0-9]{10,12}" required />
          </div>
          <div class="shipping-actions">
            <p id="shipping-saved-note" class="shipping-saved-note hidden">Saved from your last order. Tap any field to change.</p>
            <button type="button" id="clear-shipping-btn" class="clear-shipping-btn hidden">Clear saved details</button>
          </div>
        </form>

        <!-- What happens next (Gap 3) -->
        <p class="human-note">You will receive a payment link via WhatsApp. No account required.</p>

        <!-- UPI Option -->
        <div class="basket-upi-section">
          <p class="upi-prompt">Prefer to pay directly?</p>
          <p class="upi-id">UPI: <span id="upi-text">ourorigin@ybl</span> <button type="button" id="copy-upi-btn" class="copy-upi-btn" aria-label="Copy UPI ID">Copy</button></p>
          <p class="upi-note human-note-small">Paid via UPI? Include your payment reference in the message and we'll confirm immediately.</p>
        </div>

        <button id="basket-connect-btn" class="basket-connect" aria-label="Transmit manifest via WhatsApp">Complete the Transfer</button>
        
        <div class="basket-fssai">FSSAI Reg. No. {FSSAI_NUMBER}</div>
      </div>
      
      <!-- Post-checkout state (Gap 4) -->
      <div id="basket-post-checkout" class="basket-post-checkout hidden">
        <div class="post-mark-container" style="margin-bottom: 2rem;">
          <OriginMark id="post-checkout-mark" variant="gold" size={80} hideDot={true} />
        </div>
        <p class="post-title">Honored &#x2713;</p>
        <p class="post-subtitle">We'll reply on WhatsApp.</p>
        <div class="post-copy-fallback">
          <p class="fallback-note">If WhatsApp did not open, you can copy the order details manually to paste:</p>
          <button type="button" id="copy-order-details-btn" class="copy-order-details-btn">[ COPY ORDER TEXT ]</button>
        </div>
        <p id="post-reinvite" class="post-reinvite hidden">Four other origins are still waiting.</p>
      </div>
      
      <!-- Secondary Discovery -->
      <div id="basket-discovery" class="basket-discovery hidden">
        <p id="discovery-text" class="discovery-text"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { cartState } from '../scripts/cart.js';
  import gsap from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('basket-overlay');
    if (!overlay) return;

    const whatsappNumber = overlay.getAttribute('data-whatsapp') || '';
    const googleSheetUrl = overlay.getAttribute('data-api-url') || '';
    const companionsMap = JSON.parse(overlay.getAttribute('data-companions') || '{}');
    const proofsMap = JSON.parse(overlay.getAttribute('data-proofs') || '{}');

    const trigger = document.getElementById('basket-trigger');
    const countDisplay = document.getElementById('basket-count');
    const closeBtn = document.getElementById('basket-close-btn');
    const backdrop = document.getElementById('basket-close-backdrop');
    const itemsContainer = document.getElementById('basket-items-container');
    const emptyState = document.getElementById('basket-empty-state');
    const footer = document.getElementById('basket-footer');
    const discoverySection = document.getElementById('basket-discovery');
    const discoveryText = document.getElementById('discovery-text');
    const connectBtn = document.getElementById('basket-connect-btn');
    const shippingForm = document.getElementById('shipping-form') as HTMLFormElement;
    const savedNote = document.getElementById('shipping-saved-note');
    const clearBtn = document.getElementById('clear-shipping-btn');
    const copyUpiBtn = document.getElementById('copy-upi-btn');
    
    // Load shipping details
    const savedShipping = localStorage.getItem('ourorigin_shipping_v1');
    if (savedShipping && shippingForm) {
      try {
        const data = JSON.parse(savedShipping);
        Object.keys(data).forEach(key => {
          const el = shippingForm.elements.namedItem(key) as HTMLInputElement;
          if (el) el.value = data[key];
        });
        if (savedNote) savedNote.classList.remove('hidden');
        if (clearBtn) clearBtn.classList.remove('hidden');
      } catch (e) {}
    }
    
    if (clearBtn && shippingForm) {
      clearBtn.addEventListener('click', () => {
        shippingForm.reset();
        localStorage.removeItem('ourorigin_shipping_v1');
        if (savedNote) savedNote.classList.add('hidden');
        clearBtn.classList.add('hidden');
      });
    }

    if (copyUpiBtn) {
      copyUpiBtn.addEventListener('click', () => {
        const upiText = document.getElementById('upi-text')?.textContent || '';
        navigator.clipboard.writeText(upiText).then(() => {
          const originalText = copyUpiBtn.textContent;
          copyUpiBtn.textContent = 'Copied.';
          setTimeout(() => copyUpiBtn.textContent = originalText, 1500);
        });
      });
    }
    
    function generateTallyHTML(count: number, size = 24) {
      if (count === 0) return '0';
      const fullGroups = Math.floor(count / 5);
      const remainder = count % 5;
      
      let html = `<div style="display:inline-flex;align-items:center;gap:4px;height:${size}px;color:var(--color-mark-gold)">`;
      
      const groupSvg = `
        <svg style="height:100%;width:auto" viewBox="0 0 60 60" fill="none">
          <g stroke="currentColor" stroke-width="4" stroke-linecap="round">
            <path d="M 10 10 C 8 25, 12 40, 9 50" />
            <path d="M 22 8 C 19 25, 23 40, 20 52" />
            <path d="M 34 12 C 37 25, 32 35, 35 48" />
            <path d="M 46 6 C 43 20, 47 40, 44 55" />
            <path d="M 2 45 C 20 35, 35 20, 52 10" />
          </g>
        </svg>
      `;
      
      for (let i = 0; i < fullGroups; i++) html += groupSvg;
      
      if (remainder > 0) {
        let remainderPaths = '';
        if (remainder >= 1) remainderPaths += '<path d="M 10 10 C 8 25, 12 40, 9 50" />';
        if (remainder >= 2) remainderPaths += '<path d="M 22 8 C 19 25, 23 40, 20 52" />';
        if (remainder >= 3) remainderPaths += '<path d="M 34 12 C 37 25, 32 35, 35 48" />';
        if (remainder >= 4) remainderPaths += '<path d="M 46 6 C 43 20, 47 40, 44 55" />';
        html += `
          <svg style="height:100%;width:auto" viewBox="0 0 ${remainder * 15 + 15} 60" fill="none">
            <g stroke="currentColor" stroke-width="4" stroke-linecap="round">
              ${remainderPaths}
            </g>
          </svg>
        `;
      }
      html += '</div>';
      return html;
    }

    function updateTrigger(count: number) {
      if (!trigger || !countDisplay) return;
      if (count > 0) {
        // Update the header Basket wrapper and the floating trigger
        const countWrapper = document.getElementById('basket-count-wrapper');
        if (countWrapper) countWrapper.innerHTML = generateTallyHTML(count, 24);
        
        countDisplay.innerHTML = generateTallyHTML(count, 18);
        trigger.classList.remove('hidden');
        trigger.setAttribute('aria-label', `Open Basket — ${count} items held`);
      } else {
        const countWrapper = document.getElementById('basket-count-wrapper');
        if (countWrapper) countWrapper.innerHTML = '0';
        trigger.classList.add('hidden');
        trigger.removeAttribute('aria-label');
      }
      
      // Update global Dossier counts and toggle depth basket visibility
      document.querySelectorAll('.dossier-count').forEach(el => {
        el.textContent = String(count);
      });
      
      const depthBasket = document.getElementById('depth-basket-trigger');
      if (depthBasket) {
        depthBasket.style.display = count > 0 ? 'block' : 'none';
      }
      
      const depthYields = document.getElementById('depth-yields-trigger');
      if (depthYields) {
        depthYields.textContent = count > 0 ? '[ ALL YIELDS ]' : '[ EXPLORE YIELDS ]';
      }
      const ccYields = document.getElementById('trigger-yields');
      if (ccYields) {
        ccYields.textContent = count > 0 ? '[ ALL YIELDS ]' : '[ EXPLORE YIELDS ]';
      }
    }
    
    function renderItems(items: any[]) {
      if (!itemsContainer || !emptyState || !footer || !discoverySection) return;
      itemsContainer.innerHTML = '';
      
      if (!items || items.length === 0) {
        emptyState.classList.remove('hidden');
        footer.classList.add('hidden');
        discoverySection.classList.add('hidden');
        return;
      }
      
      emptyState.classList.add('hidden');
      footer.classList.remove('hidden');
      
      let total = 0;
      let originsInBasket = new Set<{id: string, name: string}>();
      let summaryHtml = '';
      
      items.forEach((item: any) => {
        const lineTotal = item.price * item.quantity;
        total += lineTotal;
        originsInBasket.add({id: item.originId, name: item.origin});
        
        const el = document.createElement('div');
        el.className = 'basket-item';
        el.innerHTML = `
          <div class="item-info">
            <span class="item-name">${item.name}</span>
            <div class="qty-controls">
              <button class="qty-btn dec" data-id="${item.id}" aria-label="Decrease quantity of ${item.name}">-</button>
              <span class="qty-val price-font">${generateTallyHTML(item.quantity, 16)}</span>
              <button class="qty-btn inc" data-id="${item.id}" aria-label="Increase quantity of ${item.name}">+</button>
            </div>
            <span class="item-size">${item.size || item.weight} · ₹${item.price}</span>
            <span class="item-line-total price-font"><span style="display:inline-flex;align-items:center;gap:4px;">${generateTallyHTML(item.quantity, 14)} &times; ₹${item.price} = ₹${lineTotal}</span></span>
          </div>
        `;
        itemsContainer.appendChild(el);
        
        summaryHtml += `
          <div class="summary-item-row">
            <span style="display:flex;align-items:center;gap:6px;">${item.name} (${item.size || item.weight}) &times; ${generateTallyHTML(item.quantity, 12)}</span>
            <span>₹${lineTotal}</span>
          </div>
        `;
      });
      
      const subtotalPriceEl = document.getElementById('basket-subtotal-price');
      if (subtotalPriceEl) subtotalPriceEl.textContent = `₹${total}`;
      
      // Update Invoice Summary
      const summaryItems = document.getElementById('summary-items');
      const summarySub = document.getElementById('summary-subtotal');
      const summaryShip = document.getElementById('summary-shipping');
      const summaryTot = document.getElementById('summary-total');
      const shipNote = document.getElementById('shipping-prompt-note');
      
      if (summaryItems) summaryItems.innerHTML = summaryHtml;
      if (summarySub) summarySub.textContent = `₹${total}`;
      
      const cityVal = ((shippingForm?.elements.namedItem('city') as HTMLInputElement)?.value || '').toLowerCase();
      const isLocal = cityVal.includes('thiruvananthapuram') || cityVal.includes('trivandrum');
      
      let shippingCost = 0;
      let shippingText = '';
      
      if (isLocal) {
        shippingText = 'Free — local delivery';
        if (shipNote) shipNote.classList.add('hidden');
      } else if (total < 399) {
        shippingCost = 60;
        shippingText = `₹${shippingCost}`;
        if (shipNote) {
          shipNote.textContent = `Add ₹${399 - total} more for free shipping.`;
          shipNote.classList.remove('hidden');
        }
      } else {
        shippingText = 'Free';
        if (shipNote) shipNote.classList.add('hidden');
      }
      
      if (summaryShip) summaryShip.textContent = shippingText;
      if (summaryTot) summaryTot.textContent = `₹${total + shippingCost}`;
      
      if (shippingForm) {
        shippingForm.setAttribute('data-shipping-cost', shippingCost.toString());
        shippingForm.setAttribute('data-shipping-text', shippingText);
        shippingForm.setAttribute('data-total', (total + shippingCost).toString());
      }
      
      // Wire up qty buttons
      document.querySelectorAll('.qty-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = (e.target as HTMLElement).getAttribute('data-id');
          const isInc = (e.target as HTMLElement).classList.contains('inc');
          if (id) {
            cartState.updateQuantity(id, isInc ? 1 : -1);
          }
        });
      });
      
      // Handle Secondary Discovery
      let discoveryHtmlChunks: string[] = [];
      const uniqueOriginsMap = new Map();
      Array.from(originsInBasket).forEach(o => uniqueOriginsMap.set(o.id, o.name));
      
      uniqueOriginsMap.forEach((originName, originId) => {
        const companions = companionsMap[originId];
        if (companions && companions.length > 0) {
          const availableCompanions = companions.filter((c: any) => !items.some((i: any) => i.productId === c.id));
          if (availableCompanions.length > 0) {
            const linksHtml = availableCompanions.map((c: any) => 
              `<a href="#" class="discovery-link" data-origin="${originId}" data-product="${c.id}" aria-label="Browse more yields from ${originName}">${c.name}</a>`
            ).join(', ');
            discoveryHtmlChunks.push(`Also from ${originName}: ${linksHtml}`);
          }
        }
      });
      
      if (discoveryHtmlChunks.length > 0 && discoveryText) {
        discoveryText.innerHTML = discoveryHtmlChunks.join('<br>');
        discoverySection.classList.remove('hidden');
        
        document.querySelectorAll('.discovery-link').forEach(link => {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            const originId = (e.target as HTMLElement).getAttribute('data-origin');
            closeBasket();
            window.dispatchEvent(new CustomEvent('open-carousel', { detail: { originId: originId, excludeAnchor: true } }));
          });
        });
      } else {
        discoverySection.classList.add('hidden');
      }
    }
    
    // Re-render when shipping city changes to update shipping logic instantly
    const cityInput = document.getElementById('ship-city');
    if (cityInput) {
      cityInput.addEventListener('input', () => renderItems(cartState.items));
    }
    
    // Connection logic
    if (connectBtn) {
      connectBtn.addEventListener('click', (e) => {
        e.preventDefault();
        
        if (cartState.items.length === 0) return;
        
        if (shippingForm && !shippingForm.checkValidity()) {
          shippingForm.reportValidity();
          return;
        }
        
        const formData = new FormData(shippingForm);
        const data = Object.fromEntries(formData.entries());
        localStorage.setItem('ourorigin_shipping_v1', JSON.stringify(data));
        if (savedNote) savedNote.classList.remove('hidden');
        if (clearBtn) clearBtn.classList.remove('hidden');

        // const shippingCost = parseInt(shippingForm?.getAttribute('data-shipping-cost') || '0', 10);
        const shippingText = shippingForm?.getAttribute('data-shipping-text') || 'Free';
        const orderTotal = shippingForm?.getAttribute('data-total') || '0';

        let currentOrderMessage = '';

        if (cartState.items.length === 1 && cartState.items[0].quantity === 1) {
          const item = cartState.items[0];
          currentOrderMessage = `Hi — I'd like to order ${item.name} (${item.size || item.weight}) from OurOrigin.\nTotal: ₹${orderTotal}. Shipping: ${shippingText}.\n\nName: ${data.name}\nAddress: ${data.house}, ${data.street}, ${data.city}, ${data.state} – ${data.pin}\nPhone: ${data.phone}\n\nFound you at ourorigin.in.`;
        } else {
          currentOrderMessage = `Hi — I'd like to order the following from OurOrigin.\n\n`;
          cartState.items.forEach(item => {
            currentOrderMessage += `– ${item.name} (${item.size || item.weight}) × ${item.quantity} · ₹${item.price * item.quantity}\n`;
          });
          currentOrderMessage += `\nTotal: ₹${orderTotal}\nShipping: ${shippingText}\n\nName: ${data.name}\nAddress: ${data.house}, ${data.street}, ${data.city}, ${data.state} – ${data.pin}\nPhone: ${data.phone}\n\nFound you at ourorigin.in.`;
        }
        
        const encodedMessage = encodeURIComponent(currentOrderMessage);
        
        // POST to Google Sheets API (if configured)
        if (googleSheetUrl) {
          const orderPayload = {
            name: data.name,
            phone: data.phone,
            address: `${data.house}, ${data.street}, ${data.city}, ${data.state} - ${data.pin}`,
            items: cartState.items.map(i => `${i.name} (${i.size || i.weight}) x ${i.quantity}`).join(', '),
            totalPrice: `₹${orderTotal}`,
            shippingCost: shippingText
          };

          fetch(googleSheetUrl, {
            method: 'POST',
            mode: 'no-cors', // Apps Script web apps often require no-cors for simple posts
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderPayload)
          }).catch(console.error); // Fire and forget
        }

        window.open(`https://wa.me/${whatsappNumber}?text=${encodedMessage}`, '_blank');
        
        if (itemsContainer) itemsContainer.classList.add('hidden');
        if (footer) footer.classList.add('hidden');
        if (discoverySection) discoverySection.classList.add('hidden');
        const postCheckout = document.getElementById('basket-post-checkout');
        if (postCheckout) {
          postCheckout.classList.remove('hidden');
          const svg = postCheckout.querySelector('.origin-mark');
          if (svg) {
            const strokes = svg.querySelectorAll('.tally-strokes path');
            strokes.forEach(s => {
              const len = (s as SVGPathElement).getTotalLength?.() || 60;
              gsap.set(s, { strokeDashoffset: len });
            });
            const tl = gsap.timeline({ delay: 0.1 });
            strokes.forEach((s, i) => {
              tl.to(s, { strokeDashoffset: 0, duration: 0.28, ease: 'power2.out' }, i * 0.08);
            });
          }
        }
        
        // Save to Ledger
        try {
          const ledgerRaw = localStorage.getItem('ourorigin_ledger_v1');
          const ledger = ledgerRaw ? JSON.parse(ledgerRaw) : [];
          const now = new Date().toISOString();
          cartState.items.forEach(item => {
            const proof = proofsMap[item.id] || {};
            ledger.push({
              date: now,
              name: item.name,
              size: item.size || item.weight,
              price: item.price,
              quantity: item.quantity,
              origin: item.origin,
              firstHands: proof.firstHands || 'The Farmers',
              directPricePaid: proof.directPricePaid || `₹${item.price}/kg`,
              naturesShare: proof.naturesShare || 'Harvested responsibly.',
              proofLink: proof.fssaiCertLink || '#',
              proofImage: proof.yieldPhoto || ''
            });
          });
          localStorage.setItem('ourorigin_ledger_v1', JSON.stringify(ledger));
        } catch (e) {}

        setTimeout(() => {
          const reinvite = document.getElementById('post-reinvite');
          if (reinvite) reinvite.classList.remove('hidden');
        }, 1500);

        const copyOrderBtn = document.getElementById('copy-order-details-btn');
        if (copyOrderBtn) {
          copyOrderBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(currentOrderMessage).then(() => {
              const originalText = copyOrderBtn.textContent;
              copyOrderBtn.textContent = '[ COPIED TO CLIPBOARD ]';
              setTimeout(() => {
                copyOrderBtn.textContent = originalText;
              }, 1500);
            });
          });
        }
        
        // Clear cart
        cartState.clear();
        
        // Close after 15s to give the user enough time to copy order details manually if needed
        setTimeout(() => {
          closeBasket();
          setTimeout(() => {
            if (postCheckout) postCheckout.classList.add('hidden');
            if (itemsContainer) itemsContainer.classList.remove('hidden');
            const reinvite = document.getElementById('post-reinvite');
            if (reinvite) reinvite.classList.add('hidden');
          }, 500);
        }, 15000);
      });
    }
    
    // Listen to cart-updated broadcasts from cartState
    window.addEventListener('cart-updated', (e: any) => {
      const { items, totalItems } = e.detail;
      updateTrigger(totalItems);
      renderItems(items);
      
      // Pulse trigger on add
      if (trigger && totalItems > 0) {
        trigger.classList.add('pulse-anim');
        setTimeout(() => {
          trigger.classList.remove('pulse-anim');
        }, 500);
      }

      // Removed global toast firing logic

      trigger?.setAttribute('data-prev-total', totalItems.toString());
    });
    
    const openBasket = () => {
      renderItems(cartState.items);
      if (overlay) overlay.classList.remove('hidden');
    };
    
    const closeBasket = () => {
      if (overlay) overlay.classList.add('hidden');
    };
    
    if (trigger) trigger.addEventListener('click', openBasket);
    if (closeBtn) closeBtn.addEventListener('click', closeBasket);
    if (backdrop) backdrop.addEventListener('click', closeBasket);
    
    const triggerDossier = document.getElementById('trigger-dossier');
    if (triggerDossier) {
      triggerDossier.addEventListener('click', openBasket);
    }

    // Global listeners for direct open-cart/close-cart calls
    window.addEventListener('open-cart', openBasket);
    window.addEventListener('close-cart', closeBasket);
    window.addEventListener('trigger-dossier', openBasket);
    
    // Initial sync
    updateTrigger(cartState.getTotalItems());
  });
</script>

