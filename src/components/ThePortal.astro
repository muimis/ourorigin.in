---
// src/components/ThePortal.astro
---
<section class="portal-section">
  <!-- The Void (Absolute Truth) -->
  <div class="the-void">
    <div class="chiaroscuro-spotlight"></div>
    <div class="the-12km-thread"></div>
  </div>

  <div class="portal-content">
    <span class="community-tag">The Invaluable Transfer</span>
    <h1 class="portal-title">The Final Inch of a Very Long Journey.</h1>
    <a href="#the-manifesto" class="portal-cta">Honor the First Hands</a>
  </div>
</section>

<style>
  .portal-section {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-forest-deep);
    overflow: hidden;
  }

  .community-tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.25em;
    color: var(--color-gold);
    text-transform: uppercase;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  .the-void {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background-color: var(--color-forest-deep);
  }

  .chiaroscuro-spotlight {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    height: 80vh;
    background: radial-gradient(circle at center, rgba(245, 237, 216, 0.08) 0%, transparent 60%);
    opacity: 0;
    animation: spotlight-fade-in 4s ease-out forwards 1s;
  }

  @keyframes spotlight-fade-in {
    0% { opacity: 0; transform: translate(-50%, -45%) scale(0.95); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }

  /* The 12km Thread */
  .the-12km-thread {
    position: absolute;
    top: 50%; /* Starts near the center */
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 100vh; /* Continues down offscreen */
    background: linear-gradient(to bottom, transparent, var(--color-gold) 20%, var(--color-gold) 100%);
    opacity: 0.3;
    animation: thread-drop 3s cubic-bezier(0.2, 1, 0.3, 1) forwards 1.5s;
    transform-origin: top;
    scale: 1 0;
  }

  @keyframes thread-drop {
    to { scale: 1 1; }
  }

  .portal-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 900px;
    padding: 0 2rem;
  }

  .portal-title {
    font-family: var(--font-institutional);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 300;
    color: var(--color-warm-cream);
    line-height: 1.1;
    margin-bottom: 3rem;
  }

  .portal-cta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid rgba(198, 156, 82, 0.4);
    padding: 14px 28px;
    transition: all 0.4s var(--ease-fluid);
  }

  .portal-cta:hover {
    background-color: rgba(198, 156, 82, 0.15);
    color: var(--color-warm-cream);
    border-color: var(--color-warm-cream);
  }
</style>
