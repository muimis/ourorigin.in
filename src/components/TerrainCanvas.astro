<canvas id="terrain-canvas" aria-hidden="true"></canvas>

<script>
(function() {
  const canvas = document.getElementById('terrain-canvas');
  if (!canvas) return;

  const ctx = canvas.getContext('2d');
  let W, H, animFrame;
  let mouseX = 0.5, mouseY = 0.5;
  let targetMouseX = 0.5, targetMouseY = 0.5;
  let time = 0;

  // ── Contour line definitions ──
  // Each line has a base Y position (0–1), color, opacity, and harmonic mix
  const NUM_LINES = 38;

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }

  // ── Multi-harmonic wave: organic, non-repeating elevation contour ──
  function getLineY(x, lineIndex, t) {
    const norm = lineIndex / (NUM_LINES - 1); // 0 (top) → 1 (bottom)
    const baseY = norm * H;

    // Frequencies chosen to avoid obvious repetition
    const f1 = 0.0028, f2 = 0.0071, f3 = 0.0148, f4 = 0.0253, f5 = 0.0401;

    // Each line has a unique phase offset so they don't mirror each other
    const phase = lineIndex * 0.618; // golden ratio phase spacing

    // Amplitudes taper: stronger in the middle of the canvas, quieter at edges
    const amp = Math.sin(norm * Math.PI) * 0.85 + 0.15;

    const w1 = Math.sin(x * f1 + t * 0.22 + phase * 0.7)  * 38 * amp;
    const w2 = Math.sin(x * f2 - t * 0.18 + phase * 1.1)  * 19 * amp;
    const w3 = Math.sin(x * f3 + t * 0.14 + phase * 1.6)  * 10 * amp;
    const w4 = Math.sin(x * f4 - t * 0.09 + phase * 0.3)  *  5 * amp;
    const w5 = Math.sin(x * f5 + t * 0.06 + phase * 2.1)  *  3 * amp;

    // Mouse parallax — deeper lines shift more (sense of 3D terrain depth)
    const parallaxStrength = 28;
    const parallax = (mouseX - 0.5) * parallaxStrength * (norm * 0.8 + 0.2);
    const parallaxY  = (mouseY - 0.5) * parallaxStrength * 0.4 * norm;

    return baseY + w1 + w2 + w3 + w4 + w5 + parallax + parallaxY;
  }

    // ── Color: elevation-based, mostly invisible except at peaks ──
  function getLineStyle(lineIndex) {
    const norm = lineIndex / (NUM_LINES - 1);

    // Every 5th line is a "index contour" — more visible, bolder
    const isIndexContour = lineIndex % 5 === 0;
    const isMajorContour = lineIndex % 10 === 0;

    // Opacity: contour lines need to be readable
    const baseOpacity = isMajorContour ? 0.32 : isIndexContour ? 0.18 : 0.07;

    // Color: upper lines (canopy) lean gold/amber; lower lines (soil) lean deep brown
    let r, g, b;
    if (norm < 0.35) {
      // Upper — amber/gold (canopy light, high elevation)
      r = 198; g = 156; b = 82;
    } else if (norm < 0.65) {
      // Mid — forest green (the understory)
      r = 88; g = 110; b = 68;
    } else {
      // Lower — deep earth/brown (soil layer)
      r = 110; g = 68; b = 38;
    }

    return { r, g, b, opacity: baseOpacity, lineWidth: isMajorContour ? 1.1 : isIndexContour ? 0.7 : 0.45 };
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    // Smooth mouse interpolation
    mouseX += (targetMouseX - mouseX) * 0.04;
    mouseY += (targetMouseY - mouseY) * 0.04;

    for (let li = 0; li < NUM_LINES; li++) {
      const style = getLineStyle(li);
      ctx.strokeStyle = `rgba(${style.r},${style.g},${style.b},${style.opacity})`;
      ctx.lineWidth = style.lineWidth;
      ctx.lineJoin = 'round';

      ctx.beginPath();

      // Sample the contour line across the canvas width
      const STEP = 4; // px per sample — smaller = smoother curve
      for (let x = 0; x <= W; x += STEP) {
        const y = getLineY(x, li, time);
        if (x === 0) {
          ctx.moveTo(x, y);
        } else {
          ctx.lineTo(x, y);
        }
      }

      ctx.stroke();
    }

    time += 0.008;
    animFrame = requestAnimationFrame(draw);
  }

  function init() {
    resize();
    if (animFrame) cancelAnimationFrame(animFrame);
    draw();
  }

  window.addEventListener('mousemove', (e) => {
    targetMouseX = e.clientX / window.innerWidth;
    targetMouseY = e.clientY / window.innerHeight;
  });

  window.addEventListener('resize', () => {
    resize();
  });

  // Handle Astro's client-side navigation
  init();
  document.addEventListener('astro:after-swap', init);
  document.addEventListener('astro:page-load', init);
})();
</script>

<style>
  #terrain-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 0;
    pointer-events: none;
    opacity: 1;
  }
</style>
