---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
  animate = false,
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`origin-mark variant-${variant} ${animate ? 'is-breathing' : ''}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
  fill="none"
>
  <!-- The Tally (The Ledger of Distance) -->
  <!-- 5 hash marks representing the arduous walk, 1 dot representing the yield -->
  <g transform="translate(10, 35)">
    <!-- Hash marks -->
    <rect x="0" y="10" width="6" height="30" fill={strokeColor} />
    <rect x="16" y="0" width="6" height="50" fill={strokeColor} />
    <rect x="32" y="15" width="6" height="20" fill={strokeColor} />
    <rect x="48" y="5" width="6" height="40" fill={strokeColor} />
    <rect x="64" y="20" width="6" height="10" fill={strokeColor} />
    
    <!-- The Origin / The Yield -->
    <circle cx="94" cy="25" r="8" fill="var(--color-gold)" />
  </g>
</svg>

<style>
  .origin-mark {
    overflow: visible;
    transform-origin: center;
  }
  
  .origin-mark.is-breathing g {
    animation: breatheOrigin 4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }
  
  @keyframes breatheOrigin {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
  }
</style>
