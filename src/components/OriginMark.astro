---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
  animate = false,
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`origin-mark variant-${variant} ${animate ? 'is-breathing' : ''}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
  fill="none"
>
  <!-- The Unbroken Circuit (Copyrightable Monolithic Mark) -->
  <g transform="translate(60, 60)">
    <path 
      stroke={strokeColor} 
      stroke-width="8" 
      stroke-linecap="square"
      stroke-linejoin="miter"
      d="M -30, -30 
         L 30, -30 
         L 30, 30 
         L -15, 30 
         L -15, 0 
         L 10, 0 
         L 10, 15 
         L -30, 15 
         Z" 
    />
    <rect x="-6" y="-6" width="12" height="12" fill={strokeColor} />
  </g>
</svg>

<style>
  .origin-mark {
    overflow: visible;
    transform-origin: center;
  }
  
  .origin-mark.is-breathing path {
    stroke-dasharray: 400;
    stroke-dashoffset: 400;
    animation: drawCircuit 4s cubic-bezier(0.645, 0.045, 0.355, 1) infinite alternate;
  }

  .origin-mark.is-breathing rect {
    animation: pulseKnot 4s ease-in-out infinite alternate;
  }

  @keyframes drawCircuit {
    0% { stroke-dashoffset: 400; }
    40% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes pulseKnot {
    0% { opacity: 0; transform: scale(0.5); }
    30% { opacity: 0; transform: scale(0.5); }
    50% { opacity: 1; transform: scale(1); }
    100% { opacity: 1; transform: scale(1); }
  }
</style>
