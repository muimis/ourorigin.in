---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`open-axis variant-${variant}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
>
  <g transform="translate(60, 60)">
    <!-- Right Form (The Yield) -->
    <path fill={strokeColor} d="M 2, -22 A 22 22 0 0 1 18, 18 A 28 28 0 0 0 2, -22 Z" />
             
    <!-- Left Form (The Origin) -->
    <path fill={strokeColor} d="M -2, 22 A 22 22 0 0 1 -18, -18 A 28 28 0 0 0 -2, 22 Z" />
  </g>
</svg>

<style>
  .open-axis {
    overflow: visible;
    transform-origin: center;
    /* The tension of stillness */
  }
</style>
