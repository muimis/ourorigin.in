---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
  animate = false
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`origin-knot variant-${variant} ${animate ? 'ok-animate' : ''}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
>
  <defs>
    <!-- Vertical Leaf Clips -->
    <clipPath id={`knotClipLeft-${id}`}>
      <circle cx="30" cy="60" r="60" />
    </clipPath>
    <clipPath id={`knotClipRight-${id}`}>
      <circle cx="90" cy="60" r="60" />
    </clipPath>
    
    <!-- Horizontal Leaf Clips -->
    <clipPath id={`knotClipTop-${id}`}>
      <circle cx="60" cy="30" r="60" />
    </clipPath>
    <clipPath id={`knotClipBottom-${id}`}>
      <circle cx="60" cy="90" r="60" />
    </clipPath>
  </defs>

  <!-- Outer Boundary -->
  <circle class="ok-outer" cx="60" cy="60" r="56" stroke={strokeColor} stroke-width="0.5" opacity="0.4"/>
  
  <g class="ok-weave" stroke={strokeColor} stroke-width="1.5" opacity="0.85" stroke-linecap="round">
    <!-- Vertical Leaf -->
    <circle cx="90" cy="60" r="60" fill="none" clip-path={`url(#knotClipLeft-${id})`} />
    <circle cx="30" cy="60" r="60" fill="none" clip-path={`url(#knotClipRight-${id})`} />
    
    <!-- Horizontal Leaf -->
    <circle cx="60" cy="90" r="60" fill="none" clip-path={`url(#knotClipTop-${id})`} />
    <circle cx="60" cy="30" r="60" fill="none" clip-path={`url(#knotClipBottom-${id})`} />
  </g>

  <!-- Diagonal Threads -->
  <g class="ok-threads" stroke={strokeColor} stroke-width="0.5" opacity="0.3">
    <line x1="31" y1="31" x2="89" y2="89" />
    <line x1="89" y1="31" x2="31" y2="89" />
  </g>

  <!-- The Origin (The Core Dot) -->
  <circle class="ok-core" cx="60" cy="60" r="2.5" fill={strokeColor} opacity="0.9"/>
</svg>

<style>
  .origin-knot {
    overflow: visible;
    transform-origin: center;
    animation: knot-breathe 8s ease-in-out infinite;
  }

  @keyframes knot-breathe {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.04); opacity: 1; }
  }

  /* Draw-on entrance only when explicitly animated */
  .ok-animate .ok-weave circle {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: knot-draw 2.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .ok-animate .ok-weave circle:nth-child(2),
  .ok-animate .ok-weave circle:nth-child(4) {
    animation-delay: 0.4s;
  }

  .ok-animate .ok-threads line {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: knot-draw 1.5s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.8s;
  }

  .ok-animate .ok-core {
    transform-origin: center;
    transform: scale(0);
    animation: core-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards 1.8s;
  }

  @keyframes knot-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes core-pop {
    to { transform: scale(1); }
  }
</style>
