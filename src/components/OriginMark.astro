---
export interface Props {
  size?: number;
  variant?: "primary" | "reversed" | "gold" | "monochrome";
  id?: string;
  hideDot?: boolean;
}

const {
  size = 64,
  variant = "primary",
  id = Math.random().toString(36).substring(7),
  hideDot = false,
} = Astro.props;

const palette = {
  primary: {
    verticals: "var(--color-deep-forest, #0C1509)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  reversed: {
    verticals: "var(--color-bone, #EFE6D3)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  gold: {
    verticals: "var(--color-mark-gold, #C99A5B)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  monochrome: {
    verticals: "currentColor",
    cross: "currentColor"
  }
};
const colors = palette[variant] || palette.primary;

let opticalVariant = "display";
if (size <= 24) opticalVariant = "micro";
else if (size <= 48) opticalVariant = "small";
else if (size < 80) opticalVariant = "standard";

// Unique IDs for the masks so multiple SVGs on a page don't conflict
const maskIdV1 = `mask-v1-${id}`;
const maskIdDot = `mask-dot-${id}`;
---

<svg
  id={`origin-mark-${id}`}
  class={`origin-mark variant-${variant} optical-${opticalVariant}`}
  width={size}
  viewBox="100 0 250 540"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="OurOrigin — Brand Mark"
  role="img"
  style={`height: auto; max-width: ${size}px; display: block;`}
>
  <defs>
    <!-- GSAP Animation Masks -->
    <mask id={maskIdV1}>
      <path class="anim-mask" d="M 170 10 L 170 530" stroke="white" stroke-width="120" stroke-linecap="round" fill="none" />
    </mask>
    <mask id={maskIdDot}>
      <path class="anim-mask" d="M 282 248 L 283 248" stroke="white" stroke-width="80" stroke-linecap="round" fill="none" />
    </mask>
  </defs>

  <!-- The Single Stroke (Presence) -->
  <g fill={colors.verticals}>
    <g mask={`url(#${maskIdV1})`}>
      <path d="M160,23 L153,23 L147,26 L142,32 L137,43 L131,69 L127,111 L127,169 L132,238 L142,330 L151,381 L205,357 L202,308 L200,210 L193,126 L187,88 L178,49 L170,30 L165,25 Z"/>
      <path d="M208,392 L158,414 L165,448 L177,491 L183,505 L193,515 L202,515 L208,511 L212,503 L214,491 L214,447 Z"/>
    </g>
  </g>

  <!-- The Origin Dot (Gold) -->
  <g fill={colors.cross}>
    <g mask={`url(#${maskIdDot})`} style={`display: ${hideDot ? 'none' : 'block'}`} transform="translate(-250, -100)">
      <path d="M527,324 L515,330 L511,335 L507,345 L508,357 L510,362 L517,369 L525,373 L540,373 L553,363 L557,352 L557,344 L552,333 L541,325 Z"/>
    </g>
  </g>
</svg>

<script>
  import gsap from "gsap";

  function initTallyMark() {
    document.querySelectorAll(".origin-mark").forEach((svg) => {
      if (svg.hasAttribute("data-animated")) return;
      svg.setAttribute("data-animated", "true");

      const masks = svg.querySelectorAll(".anim-mask");

      masks.forEach((m) => {
        const len = (m as SVGPathElement).getTotalLength?.() || 1000;
        gsap.set(m, { strokeDasharray: len, strokeDashoffset: len });
      });

      const tl = gsap.timeline({ delay: 0.1 });
      masks.forEach((m, i) => {
        tl.to(
          m,
          {
            strokeDashoffset: 0,
            duration: 0.4, 
            ease: "power2.out",
          },
          i * 0.12 
        );
      });
    });
  }

  if (!(window as any)["originMarkTallyInit"]) {
    (window as any)["originMarkTallyInit"] = true;
    document.addEventListener("DOMContentLoaded", initTallyMark);
    document.addEventListener("astro:page-load", initTallyMark);
  } else {
    document.addEventListener("astro:page-load", initTallyMark);
  }
</script>
