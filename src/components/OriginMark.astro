---
export interface Props {
  size?: number;
  variant?: "primary" | "reversed" | "gold" | "monochrome";
  id?: string;
  hideDot?: boolean;
}

const {
  size = 64,
  variant = "primary",
  id = Math.random().toString(36).substring(7),
  hideDot = false,
} = Astro.props;

const palette = {
  primary: {
    verticals: "var(--color-deep-forest, #0C1509)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  reversed: {
    verticals: "var(--color-bone, #EFE6D3)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  gold: {
    verticals: "var(--color-mark-gold, #C99A5B)",
    cross: "var(--color-mark-gold, #C99A5B)"
  },
  monochrome: {
    verticals: "currentColor",
    cross: "currentColor"
  }
};
const colors = palette[variant] || palette.primary;

let opticalVariant = "display";
if (size <= 24) opticalVariant = "micro";
else if (size <= 48) opticalVariant = "small";
else if (size < 80) opticalVariant = "standard";

// Unique IDs for the masks so multiple SVGs on a page don't conflict
const maskIdV1 = `mask-v1-${id}`;
const maskIdV2 = `mask-v2-${id}`;
const maskIdV3 = `mask-v3-${id}`;
const maskIdCross = `mask-cross-${id}`;
const maskIdDot = `mask-dot-${id}`;
---

<svg
  id={`origin-mark-${id}`}
  class={`origin-mark variant-${variant} optical-${opticalVariant}`}
  width={size}
  viewBox="0 0 580 540"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="OurOrigin — Brand Mark"
  role="img"
  style={`height: auto; max-width: ${size}px; display: block;`}
>
  <defs>
    <!-- GSAP Animation Masks: Using <mask id="..."> to allow animating thick strokes -->
    <mask id={maskIdV1}>
      <path class="anim-mask" d="M 170 10 L 170 530" stroke="white" stroke-width="120" stroke-linecap="round" fill="none" />
    </mask>
    <mask id={maskIdV2}>
      <path class="anim-mask" d="M 290 110 L 290 480" stroke="white" stroke-width="120" stroke-linecap="round" fill="none" />
    </mask>
    <mask id={maskIdV3}>
      <path class="anim-mask" d="M 405 180 L 405 440" stroke="white" stroke-width="120" stroke-linecap="round" fill="none" />
    </mask>
    <mask id={maskIdCross}>
      <path class="anim-mask" d="M 30 470 L 530 250" stroke="white" stroke-width="100" stroke-linecap="round" fill="none" />
    </mask>
    <mask id={maskIdDot}>
      <path class="anim-mask" d="M 532 348 L 533 348" stroke="white" stroke-width="80" stroke-linecap="round" fill="none" />
    </mask>
  </defs>

  <!-- Black Structure (The Human Record) -->
  <g fill={colors.verticals}>
    <g mask={`url(#${maskIdV1})`}>
      <path d="M160,23 L153,23 L147,26 L142,32 L137,43 L131,69 L127,111 L127,169 L132,238 L142,330 L151,381 L205,357 L202,308 L200,210 L193,126 L187,88 L178,49 L170,30 L165,25 Z"/>
      <path d="M208,392 L158,414 L165,448 L177,491 L183,505 L193,515 L202,515 L208,511 L212,503 L214,491 L214,447 Z"/>
    </g>
    <g mask={`url(#${maskIdV2})`}>
      <path d="M291,131 L281,132 L274,143 L265,196 L262,277 L266,334 L311,319 L313,225 L310,185 L306,161 L301,144 L297,136 Z"/>
      <path d="M311,348 L270,365 L273,390 L282,433 L290,455 L295,459 L300,459 L304,456 L309,441 L311,423 Z"/>
    </g>
    <g mask={`url(#${maskIdV3})`}>
      <path d="M415,203 L407,204 L403,208 L400,215 L391,269 L389,295 L428,284 L430,261 L429,233 L425,215 L421,207 Z"/>
      <path d="M426,307 L386,321 L382,372 L377,408 L378,420 L385,419 L391,413 L406,386 L416,357 Z"/>
    </g>
  </g>

  <!-- Cross Gesture & Origin Dot (The Connection) -->
  <g fill={colors.cross}>
    <g mask={`url(#${maskIdCross})`}>
      <path d="M519,269 L502,269 L473,274 L429,286 L424,286 L421,288 L416,288 L412,291 L409,290 L402,294 L399,293 L393,296 L391,295 L356,307 L342,310 L327,316 L310,320 L293,326 L291,328 L287,328 L279,332 L278,331 L271,335 L269,334 L262,338 L203,359 L200,362 L198,361 L195,364 L186,366 L180,370 L179,369 L176,372 L174,371 L172,374 L166,376 L165,375 L162,378 L154,380 L153,382 L152,381 L152,383 L149,383 L127,394 L94,413 L62,435 L51,446 L50,454 L52,457 L57,459 L70,456 L89,445 L158,412 L159,413 L169,407 L181,403 L234,378 L277,361 L283,357 L287,357 L307,349 L308,347 L310,348 L316,344 L348,333 L350,331 L365,327 L375,322 L386,320 L403,314 L404,312 L408,312 L411,309 L414,310 L419,307 L423,307 L425,305 L446,299 L474,288 L494,282 L499,279 L503,279 L519,272 Z"/>
    </g>
    <g mask={`url(#${maskIdDot})`} style={`display: ${hideDot ? 'none' : 'block'}`}>
      <path d="M527,324 L515,330 L511,335 L507,345 L508,357 L510,362 L517,369 L525,373 L540,373 L553,363 L557,352 L557,344 L552,333 L541,325 Z"/>
    </g>
  </g>
</svg>

<script>
  import gsap from "gsap";

  function initTallyMark() {
    document.querySelectorAll(".origin-mark").forEach((svg) => {
      if (svg.hasAttribute("data-animated")) return;
      svg.setAttribute("data-animated", "true");

      const masks = svg.querySelectorAll(".anim-mask");

      masks.forEach((m) => {
        const len = (m as SVGPathElement).getTotalLength?.() || 1000;
        gsap.set(m, { strokeDasharray: len, strokeDashoffset: len });
      });

      const tl = gsap.timeline({ delay: 0.1 });
      masks.forEach((m, i) => {
        tl.to(
          m,
          {
            strokeDashoffset: 0,
            duration: 0.4, 
            ease: "power2.out",
          },
          i * 0.12 
        );
      });
    });
  }

  if (!(window as any)["originMarkTallyInit"]) {
    (window as any)["originMarkTallyInit"] = true;
    document.addEventListener("DOMContentLoaded", initTallyMark);
    document.addEventListener("astro:page-load", initTallyMark);
  } else {
    document.addEventListener("astro:page-load", initTallyMark);
  }
</script>
