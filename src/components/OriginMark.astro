---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
  hideDot?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
  animate = false,
  hideDot = false,
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`origin-mark variant-${variant} ${animate ? 'is-breathing' : ''}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
  fill="none"
>
  <!-- The Tally (The Ledger of Distance) -->
  <!-- 5 primitive, hand-drawn hash marks representing the arduous walk, 1 irregular dot representing the yield -->
  <g transform="translate(10, 35)" stroke={strokeColor} stroke-width="5" stroke-linecap="round" fill="none">
    <!-- Primitive hash marks -->
    <path d="M 2 10 Q 4 25 1 38" />
    <path d="M 18 0 Q 16 25 17 48" />
    <path d="M 34 15 Q 35 25 32 33" />
    <path d="M 50 5 Q 48 25 51 43" />
    <path d="M 66 18 Q 65 24 67 29" />
    
    <!-- Primitive, irregular yield dot -->
    {!hideDot && (
      <path d="M 90 22 C 93 18, 98 22, 97 26 C 96 30, 90 32, 87 27 C 84 22, 87 19, 90 22 Z" fill="var(--color-gold)" stroke="none" />
    )}
  </g>
</svg>

<style>
  .origin-mark {
    overflow: visible;
    transform-origin: center;
  }
  
  .origin-mark.is-breathing g {
    animation: breatheOrigin 4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }
  
  @keyframes breatheOrigin {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
  }
</style>
