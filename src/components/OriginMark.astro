---
export interface Props {
  size?: number;
  variant?: 'primary' | 'reversed' | 'gold';
  id?: string;
  animate?: boolean;
}

const { 
  size = 32, 
  variant = 'gold', 
  id = Math.random().toString(36).substring(7),
  animate = false
} = Astro.props;

const colorMap = {
  primary: 'var(--color-warm-cream)',
  reversed: 'var(--color-forest-deep)',
  gold: 'var(--color-gold, #c8a04d)'
};
const strokeColor = colorMap[variant];
---

<svg 
  id={`origin-mark-${id}`}
  class={`origin-knot variant-${variant} ${animate ? 'ok-animate' : ''}`} 
  width={size} 
  height={size} 
  viewBox="0 0 120 120" 
  aria-hidden="true"
>
  <defs>
    <clipPath id={`knotClipLeft-${id}`}>
      <circle cx="30" cy="60" r="60" />
    </clipPath>
    <clipPath id={`knotClipRight-${id}`}>
      <circle cx="90" cy="60" r="60" />
    </clipPath>
  </defs>
  <circle cx="90" cy="60" r="60" fill="none" stroke={strokeColor}
          stroke-width="1.5" clip-path={`url(#knotClipLeft-${id})`} />
  <circle cx="30" cy="60" r="60" fill="none" stroke={strokeColor}
          stroke-width="1.5" clip-path={`url(#knotClipRight-${id})`} />
</svg>

<style>
  .origin-knot {
    animation: knot-breathe 6s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes knot-breathe {
    0%, 100% { opacity: 0.75; transform: scale(1); }
    50%      { opacity: 1;    transform: scale(1.04); }
  }
</style>
