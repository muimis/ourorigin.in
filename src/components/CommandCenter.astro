---
import OriginMark from './OriginMark.astro';

export interface Props {
  variant?: 'dark' | 'light';
}

const { variant = 'dark' } = Astro.props;
---

<header class="brutalist-hud">
  <div class="hud-left">
    <a href="/" aria-label="OurOrigin Home">
      <OriginMark variant={variant === 'light' ? 'reversed' : 'gold'} size={32} />
    </a>
  </div>

  <nav class="hud-center">
    <a href="/" class="hud-link">[ THE WALK ]</a>
    <a href="/#scene-yield" class="hud-link">[ THE YIELD ]</a>
    <a href="/observations" class="hud-link">[ THE TRUTH ]</a>
  </nav>

  <div class="hud-right">
    <button id="trigger-dossier" class="hud-link" aria-label="Open Ledger" onclick="window.dispatchEvent(new Event('open-cart'))">
      [ LEDGER <span id="header-basket-count">0</span> ]
    </button>
  </div>
</header>

<style>
  .brutalist-hud {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    padding: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 9000;
    pointer-events: none;
    box-sizing: border-box;
  }

  .hud-left, .hud-center, .hud-right {
    pointer-events: auto;
  }

  .hud-center {
    display: flex;
    gap: 3rem;
  }

  .hud-link {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    color: var(--color-warm-cream);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    text-transform: uppercase;
    transition: color 0.3s ease;
    mix-blend-mode: difference;
  }

  .hud-link:hover {
    color: var(--color-gold);
  }
</style>
