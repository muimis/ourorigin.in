---
// src/components/OriginZone.astro
import TheManifesto from './TheManifesto.astro';
import OriginMark from './OriginMark.astro';
---

<section class="origin-zone">
  <div class="origin-cinematic-bg"></div>
  
  <div class="origin-content">
    <div class="origin-header">
      <OriginMark size="80px" class="origin-mark-left" />
      <h1 class="origin-title">The First Hands</h1>
      <p class="origin-subtitle">An Unbroken Lineage</p>
    </div>
    
    <div class="origin-body">
      <TheManifesto />
    </div>
  </div>
  <div class="axis-line"></div>
</section>

<style>
  .origin-zone {
    position: relative;
    width: 50vw;
    height: 100vh;
    overflow-y: auto;
    background-color: var(--color-forest-deep);
    color: var(--color-warm-cream);
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  
  .origin-zone::-webkit-scrollbar {
    display: none;
  }

  /* Monumental Tribute Background */
  .origin-cinematic-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 50vw;
    height: 100vh;
    background-image: url('/assets/origins/wayanad-hand.webp');
    background-size: cover;
    background-position: center;
    opacity: 0.35;
    z-index: 0;
    pointer-events: none;
    filter: grayscale(100%) contrast(1.2);
    mix-blend-mode: multiply;
  }

  .origin-content {
    position: relative;
    z-index: 2;
    padding: clamp(3rem, 6vw, 8rem) clamp(2rem, 5vw, 6rem);
    padding-bottom: 25vh;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10vh;
  }

  .origin-header {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 5vh;
  }

  .origin-title {
    font-family: var(--font-institutional);
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 300;
    line-height: 1;
    text-transform: uppercase;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .origin-subtitle {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--color-gold);
    text-transform: uppercase;
    border-left: 1px solid var(--color-gold);
    padding-left: 1rem;
  }

  .axis-line {
    position: fixed;
    top: 0;
    left: 50vw;
    width: 1px;
    height: 100vh;
    background: linear-gradient(to bottom, rgba(245, 237, 216, 0) 0%, rgba(245, 237, 216, 0.4) 50%, rgba(245, 237, 216, 0) 100%);
    z-index: 50;
    pointer-events: none;
    box-shadow: 0 0 10px rgba(245, 237, 216, 0.2);
  }

  @media (max-width: 900px) {
    .origin-zone, .origin-cinematic-bg {
      width: 100vw;
      height: auto;
      min-height: 100vh;
      overflow-y: visible;
      position: relative;
    }
    .origin-cinematic-bg {
      position: absolute;
    }
    .axis-line {
      display: none;
    }
    .origin-content {
      padding-top: 15vh;
    }
  }
</style>
