---
// src/components/DepthExperience.astro
import OriginMark from './OriginMark.astro';

export interface Props {
  origin?: any;
  product?: any;
}

const { origin, product } = Astro.props;

const sizes = product ? product.data.sizes : [];
const hasRealPackaging = !!(product?.data.images?.packaging && product.data.images.packaging.trim() !== '');
const displayImage = hasRealPackaging ? product.data.images.packaging : product.data.image;
---

<div class="story-scroll-container">
  <!-- The Traveling Element (Golden Thread) -->
  <div id="golden-thread">
      <svg viewBox="0 0 120 120" width="120" height="120">
          <path d="M 90 22 C 93 18, 98 22, 97 26 C 96 30, 90 32, 87 27 C 84 22, 87 19, 90 22 Z" fill="var(--color-gold)" />
      </svg>
  </div>

  <!-- SCENE 1: THE ORIGIN -->
  <section class="story-scene" id="scene-hero">
      <div class="scene-content">
          <div id="hero-mark-container">
              <OriginMark size={120} variant="gold" hideDot={true} />
          </div>
          <h1 class="indigenous-truth hero-headline">
              {product.data.name}
          </h1>
          <p class="origin-tag">from {origin?.data.name}</p>
      </div>
  </section>

  <!-- SCENE 2: THE SOIL / CANOPY -->
  <section class="story-scene" id="scene-soil">
      {origin?.data.images.canopy && !origin?.data.images.isPlaceholderImagery && (
        <div class="scene-bg" id="soil-bg" style={`background-image: url('${origin.data.images.canopy}')`}></div>
      )}
      <div class="scene-content">
          <h2 class="indigenous-truth">
              {origin?.data.narrative?.canopy || origin?.data.narrative?.land}
          </h2>
          <div class="brutalist-data-row">
            <span>{origin?.data.elevation}</span>
            <span class="dot-separator">&middot;</span>
            <span>{origin?.data.method}</span>
          </div>
      </div>
  </section>

  <!-- SCENE 3: THE HANDS -->
  <section class="story-scene" id="scene-hands">
      {origin?.data.images.hand && !origin?.data.images.isPlaceholderImagery && (
        <div class="scene-bg" id="hands-bg" style={`background-image: url('${origin.data.images.hand}')`}></div>
      )}
      <div class="scene-content">
          <h2 class="indigenous-truth">
              {origin?.data.narrative?.hand}
          </h2>
          <p class="specimen-intro-copy">{product?.data.specimenCopy}</p>
      </div>
  </section>

  <!-- SCENE 4: THE YIELD (PURCHASE) -->
  <section class="story-scene product-arrival" id="scene-yield">
      <div class="scene-content yield-content">
          <div class="massive-artifact-wrapper">
              <img src={displayImage} alt={product.data.name} class="massive-artifact" />
          </div>

          <h2 class="indigenous-truth section-title">Honor the harvest.</h2>
          
          <div class="purchase-ledger">
              <div class="size-ledger">
                {sizes.map((size: any, index: number) => (
                  <button 
                    class={`size-ledger-row ${index === 0 ? 'selected' : ''}`} 
                    data-size={size.label} 
                    data-price={size.priceINR}
                    aria-label={`Select size ${size.label} for ₹${size.priceINR}`}
                  >
                    <span class="spec-size">{size.label}</span>
                    <span class="spec-val">₹{size.priceINR}</span>
                  </button>
                ))}
              </div>

              <div class="purchase-actions">
                <button class="honor-decision-btn" id="add-to-ledger-btn" aria-label="Honor the Decision">
                  [ Honor the Decision ]
                </button>
              </div>
          </div>
      </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Set initial states
  gsap.set("#scene-soil .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#soil-bg", { autoAlpha: 0, scale: 1.1 });
  
  gsap.set("#scene-hands .scene-content", { autoAlpha: 0, y: 50 });
  gsap.set("#hands-bg", { autoAlpha: 0, scale: 1.1 });
  
  gsap.set("#scene-yield .scene-content", { autoAlpha: 0, y: 100 });

  // The Golden Thread Animation
  const tl = gsap.timeline({
      scrollTrigger: {
          trigger: ".story-scroll-container",
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
      }
  });

  // Scene 1 to Scene 2
  tl.to("#golden-thread", {
      y: "30vh", 
      scale: 1.5,
      ease: "power1.inOut"
  }, 0)
  .to(".hero-headline, .origin-tag", { autoAlpha: 0, y: -50 }, 0)
  .to("#soil-bg", { autoAlpha: 0.3, scale: 1, ease: "power2.out" }, 0.1)
  .to("#scene-soil .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.1);

  // Scene 2 to Scene 3
  tl.to("#golden-thread", {
      y: "60vh",
      scale: 2,
      ease: "power1.inOut"
  }, 0.3)
  .to("#scene-soil .scene-content", { autoAlpha: 0, y: -50 }, 0.3)
  .to("#soil-bg", { autoAlpha: 0 }, 0.3)
  .to("#hands-bg", { autoAlpha: 0.3, scale: 1, ease: "power2.out" }, 0.4)
  .to("#scene-hands .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out" }, 0.4);

  // Scene 3 to Scene 4 (Yield)
  tl.to("#golden-thread", {
      y: "85vh",
      scale: 1,
      ease: "power1.inOut"
  }, 0.6)
  .to("#scene-hands .scene-content", { autoAlpha: 0, y: -50 }, 0.6)
  .to("#hands-bg", { autoAlpha: 0 }, 0.6)
  .to("#scene-yield .scene-content", { autoAlpha: 1, y: 0, ease: "power2.out", pointerEvents: "auto" }, 0.7);

  // Purchase Logic
  let selectedPrice = 0;
  let selectedSize = '';
  
  const sizeBtns = document.querySelectorAll('.size-ledger-row');
  const addBtn = document.getElementById('add-to-ledger-btn');

  if (sizeBtns.length > 0) {
    const firstBtn = sizeBtns[0] as HTMLElement;
    selectedPrice = parseInt(firstBtn.dataset.price || '0', 10);
    selectedSize = firstBtn.dataset.size || '';
  }

  sizeBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      sizeBtns.forEach(b => b.classList.remove('selected'));
      const target = e.currentTarget as HTMLElement;
      target.classList.add('selected');
      selectedPrice = parseInt(target.dataset.price || '0', 10);
      selectedSize = target.dataset.size || '';
    });
  });

  if (addBtn) {
    addBtn.addEventListener('click', () => {
      const originalText = addBtn.innerText;
      addBtn.innerText = '[ Honored ✓ ]';
      addBtn.style.color = 'var(--color-gold)';
      addBtn.style.borderColor = 'var(--color-gold)';
      
      setTimeout(() => {
        addBtn.innerText = originalText;
        addBtn.style.color = '';
        addBtn.style.borderColor = '';
      }, 2000);

      const productId = document.querySelector('.depth-experience-container')?.getAttribute('data-product-slug') || 'unknown';
      const productName = document.querySelector('.depth-experience-container')?.getAttribute('data-product-name') || 'Product';

      const event = new CustomEvent('cart-add', {
        detail: {
          id: `${productId}-${selectedSize.replace(/\s+/g, '-').toLowerCase()}`,
          name: `${productName} (${selectedSize})`,
          price: selectedPrice,
          image: document.querySelector('.massive-artifact')?.getAttribute('src'),
          quantity: 1
        }
      });
      window.dispatchEvent(event);
    });
  }
</script>

<style>
    .story-scroll-container {
        position: relative;
        background-color: var(--color-void);
        color: var(--color-warm-cream);
        min-height: 400vh;
    }

    #golden-thread {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 120px;
        z-index: 100;
        pointer-events: none;
    }

    .story-scene {
        position: relative;
        height: 100vh;
        width: 100vw;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
    }

    .scene-content {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        max-width: 1000px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        z-index: 10;
        pointer-events: none;
    }

    #scene-yield .scene-content {
        pointer-events: auto;
        position: relative;
        transform: none;
        top: auto;
        left: auto;
        margin-top: 50vh;
    }

    .scene-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-size: cover;
        background-position: center;
        z-index: 1;
        opacity: 0;
        filter: grayscale(80%) contrast(1.2);
    }

    #hero-mark-container {
        margin-bottom: 3rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .indigenous-truth {
        font-family: var(--font-institutional);
        font-size: clamp(1.8rem, 4vw, 3.5rem);
        font-weight: 300;
        line-height: 1.3;
        letter-spacing: 0.02em;
        color: var(--color-warm-cream);
        margin: 0;
    }
    
    .origin-tag {
        font-family: var(--font-mono);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-gold);
        margin-top: 1rem;
    }

    .brutalist-data-row {
        margin-top: 2rem;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(245, 237, 216, 0.6);
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .dot-separator {
        color: var(--color-gold);
    }

    .specimen-intro-copy {
        margin-top: 2rem;
        font-family: var(--font-evidence);
        font-size: 1.1rem;
        max-width: 600px;
        line-height: 1.6;
        color: rgba(245, 237, 216, 0.8);
    }

    .section-title {
        margin-top: 2rem;
        margin-bottom: 3rem;
        color: var(--color-gold);
    }

    /* YIELD WRAPPER */
    .massive-artifact-wrapper {
        width: 100%;
        max-width: 600px;
        aspect-ratio: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .massive-artifact {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 30px 40px rgba(0,0,0,0.8));
    }

    .purchase-ledger {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2rem;
        width: 100%;
        max-width: 400px;
    }

    .size-ledger {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .size-ledger-row {
        background: transparent;
        border: 1px solid rgba(198, 156, 82, 0.2);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: var(--color-warm-cream);
        font-family: var(--font-mono);
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .size-ledger-row:hover, .size-ledger-row.selected {
        border-color: var(--color-gold);
    }

    .honor-decision-btn {
        background: transparent;
        border: none;
        color: var(--color-warm-cream);
        font-family: var(--font-mono);
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        cursor: pointer;
        padding: 1rem 2rem;
        transition: color 0.3s ease;
    }

    .honor-decision-btn:hover {
        color: var(--color-gold);
    }
</style>
