---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AllYieldsPanel from '../components/AllYieldsPanel.astro';
import Basket from '../components/Basket.astro';
import CustomCursor from '../components/CustomCursor.astro';
import { SITE_URL } from '../utils/constants';

interface Props {
	title: string;
    description?: string;
    ogImage?: string;
    noHeaderPadding?: boolean;
}

const { 
    title, 
    description = "A provenance record for what the land gives. The coordinate, the community, the first hands — that is the product.",
    ogImage = "/og-image.jpg",
    noHeaderPadding = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL);
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalURL} />
		<meta name="generator" content={Astro.generator} />
		
        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={fullOgImage} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="OurOrigin" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={fullOgImage} />
        <meta name="theme-color" content="#0c1509" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400..900&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=DM+Mono:ital,wght@0,300;0,400;0,500&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
        
        <ClientRouter fallback="swap" />
        <title>{title}</title>
	</head>
	<body>
        <Header />
        
        <!-- Unified global UI navigation and checkout system -->
        <AllYieldsPanel />
        <Basket />
        <CustomCursor />

        <!-- ── The Pillar Grid (Background Structure) ── -->
        <div class="global-pillars" aria-hidden="true">
            <div class="pillar"></div>
            <div class="pillar"></div>
            <div class="pillar"></div>
            <div class="pillar"></div>
        </div>

        <!-- ── The Crossing Gesture (Global Diagonal) ── -->
        <svg class="global-crossing" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100">
            <line x1="0" y1="100" x2="100" y2="0" stroke="var(--color-mark-gold)" stroke-width="0.1" opacity="0.4" />
            <circle cx="80" cy="20" r="0.8" fill="var(--color-mark-gold)" />
        </svg>

        <script>
            import '../scripts/reveal.js';
        </script>
		
        <main class:list={["main-content", { "main-content--no-pad": noHeaderPadding }]}>
            <slot />
        </main>

        <Footer />
	</body>
</html>

<style>
    body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        position: relative;
    }

    /* ── Global Pillar Lines ── */
    .global-pillars {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: -1;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: var(--content-max-width);
        margin: 0 auto;
        left: 50%;
        transform: translateX(-50%);
    }

    .pillar {
        border-right: 1px solid var(--color-border-subtle);
    }
    
    .pillar:first-child {
        border-left: 1px solid var(--color-border-subtle);
    }
    
    /* ── Global Crossing (Diagonal) ── */
    .global-crossing {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 0;
    }

    .main-content {
        flex: 1;
        width: 100%;
        max-width: var(--content-max-width);
        margin: 0 auto;
        padding: 120px 0 0; /* Align with pillars, no horizontal padding */
        position: relative;
        z-index: 1;
    }

    /* Homepage and cinematic pages override this */
    .main-content--no-pad {
        padding-top: 0;
        padding-left: 0;
        padding-right: 0;
        max-width: 100%;
    }
</style>
