---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Basket from '../components/Basket.astro';
import { SITE_URL } from '../utils/constants';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noHeaderPadding?: boolean;
}

const { 
  title = "OurOrigin — Real Food from Wild Earth", 
  description = "Single-origin forest spices, mountain teas, and heritage grains. Harvested by native farming families across the Western Ghats, shipped direct.",
  ogImage = "/og-image.jpg",
  noHeaderPadding = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE_URL || 'https://ourorigin.in');
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL || 'https://ourorigin.in'}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OurOrigin" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="theme-color" content="#FAF7F2" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,300;1,9..144,400&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <ClientRouter fallback="swap" />
  </head>
  <body class="site-body">
    <Header />
    
    <main id="main-content" class={noHeaderPadding ? 'main-no-pad' : 'main-with-pad'}>
      <slot />
    </main>

    <Footer />
    
    <!-- Seamless Shopping Basket Slide-over -->
    <Basket />
  </body>
</html>

<style>
  .site-body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: var(--color-bone);
  }

  main {
    flex: 1 0 auto;
  }

  .main-with-pad {
    padding-top: 5rem;
  }

  .main-no-pad {
    padding-top: 0;
  }
</style>
